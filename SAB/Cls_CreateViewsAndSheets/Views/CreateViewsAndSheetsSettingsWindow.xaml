<?xml version='1.0' encoding='utf-8'?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:design="clr-namespace:SAB.UI.FluentLight;assembly=SAB" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Настройки создания видов и листов" Height="900" Width="1200" MinHeight="760" MinWidth="1040" WindowStartupLocation="CenterScreen" ResizeMode="CanResizeWithGrip" FontFamily="Segoe UI" FontSize="13" Background="{DynamicResource SabBrush.WindowBackground}">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../../UI/Styles/SABFluentLight.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>
  <Border Background="{DynamicResource SabBrush.WindowBackground}">
    <Grid x:Name="CreateViewsAndSheetsSettingsRoot" Margin="20">
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Grid Grid.Row="0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="380" />
          <ColumnDefinition Width="16" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Style="{StaticResource SabPanelBorderStyle}">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14" Visibility="Collapsed">
              <TextBlock Text="" Style="{StaticResource SabPanelHeaderTextStyle}" />
            </StackPanel>
            <ScrollViewer Style="{StaticResource SabFormScrollViewerStyle}" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" design:ScrollEdges.Enabled="True">
              <StackPanel>
                <Expander Style="{StaticResource SabPanelExpanderStyle}" IsExpanded="True" Margin="0,0,0,16" Template="{StaticResource SabSectionCardTemplate}">
                  <Expander.Header>
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="Размещение" Style="{StaticResource SabPanelHeaderTextStyle}" />
                    </StackPanel>
                  </Expander.Header>
                  <StackPanel>
                    <Grid Margin="0,0,0,12" design:Capsule.IsGroup="True" Height="Auto" MinHeight="34">
                      <Border Background="{DynamicResource SabBrush.TableHeaderBackground}" BorderBrush="{DynamicResource SabBrush.Border}" BorderThickness="1" CornerRadius="20" />
                      <Border Tag="CapsuleIndicator" Background="{DynamicResource SabBrush.Accent}" CornerRadius="18" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False" />
                      <UniformGrid Rows="1" Columns="0" Margin="2">
                        <RadioButton x:Name="SourceSheetPlacementToggle" Content="Как на образце" GroupName="SettingsViewportPlacementMode" IsChecked="{Binding IsSourceSheetViewportPlacementMode, Mode=TwoWay}" Style="{StaticResource SabStructureModeRadioButtonStyle}" Margin="0" ToolTip="Размещать вид как на листе-образце" />
                        <RadioButton x:Name="PointPlacementToggle" Content="По координатам" GroupName="SettingsViewportPlacementMode" IsChecked="{Binding IsPointViewportPlacementMode, Mode=TwoWay}" Margin="0" ToolTip="Размещать вид по точкам">
                          <RadioButton.Style>
                            <Style TargetType="{x:Type RadioButton}" BasedOn="{StaticResource SabStructureModeRadioButtonStyle}">
                              <Setter Property="Visibility" Value="Visible" />
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMultiViewStructure}" Value="True">
                                  <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </RadioButton.Style>
                        </RadioButton>
                      </UniformGrid>
                    </Grid>
                    <StackPanel x:Name="ManualViewportPlacementPanel">
                      <TextBlock Text="Размещение вида" Style="{StaticResource SabFieldLabelTextStyle}" />
                      <StackPanel Orientation="Vertical" Margin="0,2,0,10">
                        <Grid Margin="0,0,0,12" design:Capsule.IsGroup="True" Height="Auto" MinHeight="34">
                          <Border Background="{DynamicResource SabBrush.TableHeaderBackground}" BorderBrush="{DynamicResource SabBrush.Border}" BorderThickness="1" CornerRadius="20" />
                          <Border Tag="CapsuleIndicator" Background="{DynamicResource SabBrush.Accent}" CornerRadius="18" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False" />
                          <UniformGrid Rows="1" Columns="0" Margin="2">
                            <RadioButton Content="Ручной ввод" GroupName="SettingsViewCenterPlacementMode" IsChecked="{Binding IsViewCenterManualMode, Mode=TwoWay}" Style="{StaticResource SabRadioButtonStyle}" Margin="0" ToolTip="Ручной ввод" />
                            <RadioButton Content="Указать точку" GroupName="SettingsViewCenterPlacementMode" IsChecked="{Binding IsViewCenterPointMode, Mode=TwoWay}" Style="{StaticResource SabRadioButtonStyle}" Margin="0" ToolTip="Указать точку" />
                          </UniformGrid>
                        </Grid>
                      </StackPanel>
                      <Grid Margin="0,0,0,14">
                        <Grid.Style>
                          <Style TargetType="{x:Type Grid}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding IsViewCenterManualMode}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Grid.Style>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="12" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                          <TextBlock Text="X центра вида" Style="{StaticResource SabFieldLabelTextStyle}" />
                          <TextBox Text="{Binding ViewCenterXText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SabTextBoxStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                          <TextBlock Text="Y центра вида" Style="{StaticResource SabFieldLabelTextStyle}" />
                          <TextBox Text="{Binding ViewCenterYText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SabTextBoxStyle}" />
                        </StackPanel>
                      </Grid>
                      <StackPanel Margin="0,0,0,14">
                        <StackPanel.Style>
                          <Style TargetType="{x:Type StackPanel}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding IsViewCenterPointMode}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </StackPanel.Style>
                        <Button Content="Указать точку размещения вида" Command="{Binding PickViewCenterPointCommand}" Style="{StaticResource SabOutlineButtonStyle}" HorizontalAlignment="Stretch" />
                        <TextBlock Text="{Binding ViewCenterPointSummary}" Style="{StaticResource SabFieldHintTextStyle}" Margin="0,6,0,0" />
                      </StackPanel>
                      <TextBlock Text="Размещение заголовка" Style="{StaticResource SabFieldLabelTextStyle}" />
                      <StackPanel Orientation="Vertical" Margin="0,2,0,10">
                        <Grid Margin="0,0,0,12" design:Capsule.IsGroup="True" Height="Auto" MinHeight="34">
                          <Border Background="{DynamicResource SabBrush.TableHeaderBackground}" BorderBrush="{DynamicResource SabBrush.Border}" BorderThickness="1" CornerRadius="20" />
                          <Border Tag="CapsuleIndicator" Background="{DynamicResource SabBrush.Accent}" CornerRadius="18" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False" />
                          <UniformGrid Rows="1" Columns="0" Margin="2">
                            <RadioButton Content="Ручной ввод" GroupName="SettingsViewTitlePlacementMode" IsChecked="{Binding IsViewTitleManualMode, Mode=TwoWay}" Style="{StaticResource SabRadioButtonStyle}" Margin="0" ToolTip="Ручной ввод" />
                            <RadioButton Content="Указать точку" GroupName="SettingsViewTitlePlacementMode" IsChecked="{Binding IsViewTitlePointMode, Mode=TwoWay}" Style="{StaticResource SabRadioButtonStyle}" Margin="0" ToolTip="Указать точку" />
                          </UniformGrid>
                        </Grid>
                      </StackPanel>
                      <Grid Margin="0,0,0,14">
                        <Grid.Style>
                          <Style TargetType="{x:Type Grid}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding IsViewTitleManualMode}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Grid.Style>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="12" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                          <TextBlock Text="X заголовка" Style="{StaticResource SabFieldLabelTextStyle}" />
                          <TextBox Text="{Binding ViewTitleXText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SabTextBoxStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                          <TextBlock Text="Y заголовка" Style="{StaticResource SabFieldLabelTextStyle}" />
                          <TextBox Text="{Binding ViewTitleYText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SabTextBoxStyle}" />
                        </StackPanel>
                      </Grid>
                      <StackPanel Margin="0,0,0,14">
                        <StackPanel.Style>
                          <Style TargetType="{x:Type StackPanel}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding IsViewTitlePointMode}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </StackPanel.Style>
                        <Button Content="Указать точку размещения заголовка" Command="{Binding PickViewTitlePointCommand}" Style="{StaticResource SabOutlineButtonStyle}" HorizontalAlignment="Stretch" />
                        <TextBlock Text="{Binding ViewTitlePointSummary}" Style="{StaticResource SabFieldHintTextStyle}" Margin="0,6,0,0" />
                      </StackPanel>
                    </StackPanel>
                    <CheckBox Content="Сохранять настройки" IsChecked="{Binding SaveSettings}" Style="{StaticResource SabCheckBoxStyle}" />
                  </StackPanel>
                </Expander>
                <Expander Style="{StaticResource SabPanelExpanderStyle}" IsExpanded="True" Template="{StaticResource SabSectionCardTemplate}" Margin="0,0,0,16">
                  <Expander.Header>
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="Копирование" Style="{StaticResource SabPanelHeaderTextStyle}" />
                    </StackPanel>
                  </Expander.Header>
                  <StackPanel>
                    <Border Style="{StaticResource SabPrimarySettingBorderStyle}">
                      <CheckBox Content="Копировать лист с детализацией" IsChecked="{Binding CopySheetWithDetailing}" Style="{StaticResource SabCheckBoxStyle}" />
                    </Border>
                    <StackPanel IsEnabled="{Binding CopySheetWithDetailing}">
                      <CheckBox Content="Ведомости" IsChecked="{Binding CopySchedules}" Style="{StaticResource SabCheckBoxStyle}" Margin="0,0,0,8" />
                      <CheckBox Content="Легенды" IsChecked="{Binding CopyLegends}" Style="{StaticResource SabCheckBoxStyle}" Margin="0,0,0,8" />
                      <CheckBox Content="Чертежные виды" IsChecked="{Binding CopyDraftingViews}" Style="{StaticResource SabCheckBoxStyle}" Margin="0,0,0,8" />
                      <CheckBox Content="Линии детализации" IsChecked="{Binding CopyDetailLines}" Style="{StaticResource SabCheckBoxStyle}" Margin="0,0,0,8" />
                      <CheckBox Content="Области заливки" IsChecked="{Binding CopyFilledRegions}" Style="{StaticResource SabCheckBoxStyle}" Margin="0,0,0,8" />
                      <CheckBox Content="Текстовые примечания" IsChecked="{Binding CopyTextNotes}" Style="{StaticResource SabCheckBoxStyle}" Margin="0,0,0,8" />
                      <CheckBox Content="Типовые аннотации" IsChecked="{Binding CopyGenericAnnotations}" Style="{StaticResource SabCheckBoxStyle}" Margin="0,0,0,8" />
                      <CheckBox Content="Изображения" IsChecked="{Binding CopyImages}" Style="{StaticResource SabCheckBoxStyle}" />
                    </StackPanel>
                  </StackPanel>
                </Expander>
              </StackPanel>
            </ScrollViewer>
          </Grid>
        </Border>
        <Border Grid.Column="2" Style="{StaticResource SabPanelBorderStyle}">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14" Visibility="Collapsed">
              <TextBlock Text="" Style="{StaticResource SabPanelHeaderTextStyle}" />
            </StackPanel>
            <ScrollViewer Style="{StaticResource SabFormScrollViewerStyle}" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" design:ScrollEdges.Enabled="True">
              <StackPanel>
                <Expander Style="{StaticResource SabPanelExpanderStyle}" IsExpanded="True" Margin="0,0,0,16" Template="{StaticResource SabSectionCardTemplate}">
                  <Expander.Header>
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="Структура" Style="{StaticResource SabPanelHeaderTextStyle}" />
                    </StackPanel>
                  </Expander.Header>
                  <StackPanel>
                    <StackPanel>
                      <Grid Margin="0,0,0,12" design:Capsule.IsGroup="True" Height="Auto" MinHeight="34">
                        <Border Background="{DynamicResource SabBrush.TableHeaderBackground}" BorderBrush="{DynamicResource SabBrush.Border}" BorderThickness="1" CornerRadius="20" />
                        <Border Tag="CapsuleIndicator" Background="{DynamicResource SabBrush.Accent}" CornerRadius="18" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False" />
                        <UniformGrid Rows="1" Columns="0" Margin="2">
                          <RadioButton Content="Один этаж" GroupName="SettingsStructureMode" IsChecked="{Binding IsSingleStoryStructure, Mode=TwoWay}" Style="{StaticResource SabStructureModeRadioButtonStyle}" Margin="0" ToolTip="Одноэтажная структура" />
                          <RadioButton Content="Несколько этажей" GroupName="SettingsStructureMode" IsChecked="{Binding IsMultiStoryStructure, Mode=TwoWay}" Style="{StaticResource SabStructureModeRadioButtonStyle}" Margin="0" ToolTip="Многоэтажная структура" />
                          <RadioButton Content="Несколько видов" GroupName="SettingsStructureMode" IsChecked="{Binding IsMultiViewStructure, Mode=TwoWay}" Style="{StaticResource SabStructureModeRadioButtonStyle}" Margin="0" ToolTip="Многовидовая структура" />
                        </UniformGrid>
                      </Grid>
                    </StackPanel>
                    <TextBlock Text="Группирование и сортировка листов" Style="{StaticResource SabFieldLabelTextStyle}" Margin="0,14,0,4" />
                    <Border Style="{StaticResource SabItemsCollectionBorderStyle}" Tag="CollectionFrame" Margin="0">
                      <ItemsControl ItemsSource="{Binding SheetBrowserParameterLevels}" Margin="0">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Border Style="{StaticResource SabSettingRowBorderStyle}">
                              <Grid>
                                <Grid.ColumnDefinitions>
                                  <ColumnDefinition Width="78" />
                                  <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding LevelTitle}" Style="{StaticResource SabFieldHintTextStyle}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding ParameterName}" Style="{StaticResource SabFieldLabelTextStyle}" TextWrapping="Wrap" VerticalAlignment="Center" />
                              </Grid>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </Border>
                  </StackPanel>
                </Expander>
                <Expander IsExpanded="True" Margin="0,0,0,16" Template="{StaticResource SabSectionCardTemplate}">
                  <Expander.Style>
                    <Style TargetType="{x:Type Expander}" BasedOn="{StaticResource SabPanelExpanderStyle}">
                      <Setter Property="Visibility" Value="Collapsed" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSingleStoryStructure}" Value="True">
                          <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Expander.Style>
                  <Expander.Header>
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="Образец" Style="{StaticResource SabPanelHeaderTextStyle}" />
                    </StackPanel>
                  </Expander.Header>
                  <StackPanel>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <StackPanel Grid.Column="0">
                        <TextBlock Text="План стандартный" Style="{StaticResource SabFieldLabelTextStyle}" />
                        <TextBlock Text="Вид-образец" Style="{StaticResource SabFieldHintTextStyle}" Margin="0,0,0,3" />
                        <ComboBox ItemsSource="{Binding StandardSourceViews}" SelectedItem="{Binding SelectedSourceView}" DisplayMemberPath="Name" ToolTip="{Binding SelectedSourceView.Name}" Style="{StaticResource SabComboBoxStyle}" Margin="0,0,0,8" />
                        <TextBlock Text="Лист-образец" Style="{StaticResource SabFieldHintTextStyle}" Margin="0,0,0,3" />
                        <ComboBox ItemsSource="{Binding SourceSheets}" SelectedItem="{Binding SelectedSourceSheet}" DisplayMemberPath="Name" ToolTip="{Binding SelectedSourceSheet.Name}" Style="{StaticResource SabComboBoxStyle}" Margin="0,0,0,12" />
                      </StackPanel>
                      <StackPanel Grid.Column="2">
                        <TextBlock Text="План потолков" Style="{StaticResource SabFieldLabelTextStyle}" />
                        <TextBlock Text="Вид-образец" Style="{StaticResource SabFieldHintTextStyle}" Margin="0,0,0,3" />
                        <ComboBox ItemsSource="{Binding CeilingSourceViews}" SelectedItem="{Binding SelectedCeilingSourceView}" DisplayMemberPath="Name" ToolTip="{Binding SelectedCeilingSourceView.Name}" Style="{StaticResource SabComboBoxStyle}" Margin="0,0,0,8" />
                        <TextBlock Text="Лист-образец" Style="{StaticResource SabFieldHintTextStyle}" Margin="0,0,0,3" />
                        <ComboBox ItemsSource="{Binding SourceSheets}" SelectedItem="{Binding SelectedCeilingSourceSheet}" DisplayMemberPath="Name" ToolTip="{Binding SelectedCeilingSourceSheet.Name}" Style="{StaticResource SabComboBoxStyle}" Margin="0,0,0,12" />
                      </StackPanel>
                    </Grid>
                    <TextBlock Text="Тип видового экрана" Style="{StaticResource SabFieldLabelTextStyle}" />
                    <ComboBox ItemsSource="{Binding ViewportTypes}" SelectedItem="{Binding SelectedViewportType}" DisplayMemberPath="Name" ToolTip="{Binding SelectedViewportType.Name}" Style="{StaticResource SabComboBoxStyle}" Margin="0,0,0,12" />
                    <TextBlock Text="Основная надпись" Style="{StaticResource SabFieldLabelTextStyle}" />
                    <ComboBox ItemsSource="{Binding TitleBlockTypes}" SelectedItem="{Binding SelectedTitleBlockType}" DisplayMemberPath="Name" ToolTip="{Binding SelectedTitleBlockType.Name}" Style="{StaticResource SabComboBoxStyle}" />
                  </StackPanel>
                </Expander>
                <Expander IsExpanded="True" Template="{StaticResource SabSectionCardTemplate}" Margin="0,0,0,16">
                  <Expander.Style>
                    <Style TargetType="{x:Type Expander}" BasedOn="{StaticResource SabPanelExpanderStyle}">
                      <Setter Property="Visibility" Value="Collapsed" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsMultiStoryStructure}" Value="True">
                          <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Expander.Style>
                  <Expander.Header>
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="Этажи" Style="{StaticResource SabPanelHeaderTextStyle}" />
                    </StackPanel>
                  </Expander.Header>
                  <StackPanel>
                    <Border Style="{StaticResource SabItemsCollectionBorderStyle}" Tag="CollectionFrame" Margin="0">
                      <ItemsControl ItemsSource="{Binding FloorMappings}" Margin="0">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Border Style="{StaticResource SabSettingRowBorderStyle}">
                              <Grid>
                                <Grid.RowDefinitions>
                                  <RowDefinition Height="Auto" />
                                  <RowDefinition Height="Auto" />
                                  <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                  <ColumnDefinition Width="*" />
                                  <ColumnDefinition Width="12" />
                                  <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Row="0" Grid.ColumnSpan="3">
                                  <TextBlock Text="Этаж" Style="{StaticResource SabFieldLabelTextStyle}" />
                                  <TextBox Text="{Binding FloorName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SabTextBoxStyle}" Margin="0,0,0,10" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="0">
                                  <TextBlock Text="План стандартный" Style="{StaticResource SabFieldLabelTextStyle}" />
                                  <TextBlock Text="Вид-образец" Style="{StaticResource SabFieldHintTextStyle}" Margin="0,0,0,3" />
                                  <ComboBox ItemsSource="{Binding DataContext.StandardSourceViews, RelativeSource={RelativeSource AncestorType=ItemsControl}}" SelectedItem="{Binding SelectedSourceView}" DisplayMemberPath="Name" ToolTip="{Binding SelectedSourceView.Name}" Style="{StaticResource SabComboBoxStyle}" Margin="0,0,0,8" />
                                  <TextBlock Text="Лист-образец" Style="{StaticResource SabFieldHintTextStyle}" Margin="0,0,0,3" />
                                  <ComboBox ItemsSource="{Binding DataContext.SourceSheets, RelativeSource={RelativeSource AncestorType=ItemsControl}}" SelectedItem="{Binding SelectedSourceSheet}" DisplayMemberPath="Name" ToolTip="{Binding SelectedSourceSheet.Name}" Style="{StaticResource SabComboBoxStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="2">
                                  <TextBlock Text="План потолков" Style="{StaticResource SabFieldLabelTextStyle}" />
                                  <TextBlock Text="Вид-образец" Style="{StaticResource SabFieldHintTextStyle}" Margin="0,0,0,3" />
                                  <ComboBox ItemsSource="{Binding DataContext.CeilingSourceViews, RelativeSource={RelativeSource AncestorType=ItemsControl}}" SelectedItem="{Binding SelectedCeilingSourceView}" DisplayMemberPath="Name" ToolTip="{Binding SelectedCeilingSourceView.Name}" Style="{StaticResource SabComboBoxStyle}" Margin="0,0,0,8" />
                                  <TextBlock Text="Лист-образец" Style="{StaticResource SabFieldHintTextStyle}" Margin="0,0,0,3" />
                                  <ComboBox ItemsSource="{Binding DataContext.SourceSheets, RelativeSource={RelativeSource AncestorType=ItemsControl}}" SelectedItem="{Binding SelectedCeilingSourceSheet}" DisplayMemberPath="Name" ToolTip="{Binding SelectedCeilingSourceSheet.Name}" Style="{StaticResource SabComboBoxStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                                  <Button ToolTip="Добавить сопоставление этажа" Command="{Binding DataContext.AddFloorMappingCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Style="{StaticResource SabRowAddButtonStyle}" Margin="4,0" VerticalAlignment="Center">
                                    <Path Data="M1 6 H11 M6 1 V11" Stroke="{DynamicResource SabBrush.TextSecondary}" StrokeThickness="1.4" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                  </Button>
                                  <Button ToolTip="Удалить сопоставление этажа" Command="{Binding DataContext.DeleteFloorMappingCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Style="{StaticResource SabRowDeleteButtonStyle}" Margin="4,0" VerticalAlignment="Center">
                                    <Path Data="M2 3 H10 M4 3 V1 H8 V3 M3 4 V11 H9 V4 M5 5 V9 M7 5 V9" Stroke="{DynamicResource SabBrush.TextSecondary}" StrokeThickness="1.4" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                  </Button>
                                </StackPanel>
                              </Grid>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </Border>
                    <TextBlock Text="Тип видового экрана" Style="{StaticResource SabFieldLabelTextStyle}" />
                    <ComboBox ItemsSource="{Binding ViewportTypes}" SelectedItem="{Binding SelectedViewportType}" DisplayMemberPath="Name" ToolTip="{Binding SelectedViewportType.Name}" Style="{StaticResource SabComboBoxStyle}" Margin="0,0,0,12" />
                    <TextBlock Text="Основная надпись" Style="{StaticResource SabFieldLabelTextStyle}" />
                    <ComboBox ItemsSource="{Binding TitleBlockTypes}" SelectedItem="{Binding SelectedTitleBlockType}" DisplayMemberPath="Name" ToolTip="{Binding SelectedTitleBlockType.Name}" Style="{StaticResource SabComboBoxStyle}" />
                  </StackPanel>
                </Expander>
                <Expander IsExpanded="True" Template="{StaticResource SabSectionCardTemplate}" Margin="0,0,0,16">
                  <Expander.Style>
                    <Style TargetType="{x:Type Expander}" BasedOn="{StaticResource SabPanelExpanderStyle}">
                      <Setter Property="Visibility" Value="Collapsed" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsMultiViewStructure}" Value="True">
                          <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Expander.Style>
                  <Expander.Header>
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="Зоны" Style="{StaticResource SabPanelHeaderTextStyle}" />
                    </StackPanel>
                  </Expander.Header>
                  <StackPanel>
                    <Border Style="{StaticResource SabItemsCollectionBorderStyle}" Tag="CollectionFrame" Margin="0">
                      <ItemsControl ItemsSource="{Binding MultiViewZoneMappings}" Margin="0">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Border Style="{StaticResource SabSettingRowBorderStyle}">
                              <StackPanel>
                                <TextBlock Text="Зона" Style="{StaticResource SabFieldLabelTextStyle}" />
                                <TextBox Text="{Binding ZoneName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SabTextBoxStyle}" Margin="0,0,0,10" />
                                <Grid>
                                  <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                  </Grid.ColumnDefinitions>
                                  <StackPanel Grid.Column="0">
                                    <TextBlock Text="Лист-образец зоны" Style="{StaticResource SabFieldLabelTextStyle}" />
                                    <ComboBox ItemsSource="{Binding DataContext.SourceSheets, RelativeSource={RelativeSource AncestorType=Window}}" SelectedItem="{Binding SelectedSourceSheet}" DisplayMemberPath="Name" ToolTip="{Binding SelectedSourceSheet.Name}" Style="{StaticResource SabComboBoxStyle}" Margin="0,0,0,10" />
                                    <TextBlock Text="Основная надпись" Style="{StaticResource SabFieldLabelTextStyle}" />
                                    <ComboBox ItemsSource="{Binding DataContext.TitleBlockTypes, RelativeSource={RelativeSource AncestorType=Window}}" SelectedItem="{Binding SelectedTitleBlockType}" DisplayMemberPath="Name" ToolTip="{Binding SelectedTitleBlockType.Name}" Style="{StaticResource SabComboBoxStyle}" />
                                  </StackPanel>
                                  <StackPanel Grid.Column="2">
                                    <TextBlock Text="Тип видового экрана" Style="{StaticResource SabFieldLabelTextStyle}" />
                                    <ComboBox ItemsSource="{Binding DataContext.ViewportTypes, RelativeSource={RelativeSource AncestorType=Window}}" SelectedItem="{Binding SelectedViewportType}" DisplayMemberPath="Name" ToolTip="{Binding SelectedViewportType.Name}" Style="{StaticResource SabComboBoxStyle}" />
                                  </StackPanel>
                                </Grid>
                                <TextBlock Text="Этажи зоны" Style="{StaticResource SabFieldLabelTextStyle}" Margin="0,12,0,5" />
                                <Border Style="{StaticResource SabItemsCollectionBorderStyle}" Tag="CollectionFrame" Margin="0">
                                  <ItemsControl ItemsSource="{Binding Floors}" Margin="0">
                                    <ItemsControl.ItemTemplate>
                                      <DataTemplate>
                                        <Border BorderBrush="{StaticResource SabBrush.BorderWeak}" BorderThickness="0,0,0,1" CornerRadius="0" Padding="8" Margin="0,0,0,8">
                                          <Grid>
                                            <Grid.RowDefinitions>
                                              <RowDefinition Height="Auto" />
                                              <RowDefinition Height="34" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                              <ColumnDefinition Width="1*" />
                                              <ColumnDefinition Width="12" />
                                              <ColumnDefinition Width="3*" />
                                              <ColumnDefinition Width="36" />
                                              <ColumnDefinition Width="36" />
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="3" ToolTip="Добавить этаж ниже" Command="{Binding DataContext.AddMultiViewZoneFloorCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Style="{StaticResource SabRowAddButtonStyle}" VerticalAlignment="Center" Margin="4,0" Grid.Row="1">
                                              <Path Data="M1 6 H11 M6 1 V11" Stroke="{DynamicResource SabBrush.TextSecondary}" StrokeThickness="1.4" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Button>
                                            <Button Grid.Column="4" ToolTip="Удалить этаж зоны" Command="{Binding DataContext.DeleteMultiViewZoneFloorCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Style="{StaticResource SabRowDeleteButtonStyle}" VerticalAlignment="Center" Margin="4,0" Grid.Row="1">
                                              <Path Data="M2 3 H10 M4 3 V1 H8 V3 M3 4 V11 H9 V4 M5 5 V9 M7 5 V9" Stroke="{DynamicResource SabBrush.TextSecondary}" StrokeThickness="1.4" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Button>
                                            <TextBlock Text="Этаж" Style="{StaticResource SabFieldHintTextStyle}" Grid.Column="0" Grid.Row="0" />
                                            <TextBox Text="{Binding FloorName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SabTextBoxStyle}" Grid.Column="0" Grid.Row="1" />
                                            <TextBlock Text="Вид-образец" Style="{StaticResource SabFieldHintTextStyle}" Grid.Column="2" Grid.Row="0" />
                                            <ComboBox ItemsSource="{Binding DataContext.MultiViewSourceViews, RelativeSource={RelativeSource AncestorType=Window}}" SelectedItem="{Binding SelectedSourceView}" DisplayMemberPath="Name" ToolTip="{Binding SelectedSourceView.Name}" Style="{StaticResource SabComboBoxStyle}" Grid.Column="2" Grid.Row="1" />
                                          </Grid>
                                        </Border>
                                      </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                  </ItemsControl>
                                </Border>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                  <Button ToolTip="Добавить зону" Command="{Binding DataContext.AddMultiViewZoneCommand, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource SabRowAddButtonStyle}" Margin="4,0" VerticalAlignment="Center">
                                    <Path Data="M1 6 H11 M6 1 V11" Stroke="{DynamicResource SabBrush.TextSecondary}" StrokeThickness="1.4" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                  </Button>
                                  <Button ToolTip="Удалить зону" Command="{Binding DataContext.DeleteMultiViewZoneCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Style="{StaticResource SabRowDeleteButtonStyle}" Margin="4,0" VerticalAlignment="Center">
                                    <Path Data="M2 3 H10 M4 3 V1 H8 V3 M3 4 V11 H9 V4 M5 5 V9 M7 5 V9" Stroke="{DynamicResource SabBrush.TextSecondary}" StrokeThickness="1.4" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                  </Button>
                                </StackPanel>
                              </StackPanel>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </Border>
                  </StackPanel>
                </Expander>
              </StackPanel>
            </ScrollViewer>
          </Grid>
        </Border>
      </Grid>
      <Grid Grid.Row="1" Margin="0,16,0,0">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0">
          <Button x:Name="CloseButton" Content="Закрыть" Width="120" IsCancel="True" Style="{StaticResource SabPrimaryButtonStyle}" />
        </StackPanel>
        <Button Content="Инструкция" Height="34" HorizontalAlignment="Left" design:Instructions.File="SAB_HTML_Sozdat_vidy_i_listy.html" />
      </Grid>
    </Grid>
  </Border>
</Window>