<?xml version='1.0' encoding='utf-8'?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:design="clr-namespace:SAB.UI.FluentLight;assembly=SAB" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="SAB — Создание видов и листов" Width="1480" Height="940" MinWidth="1100" MinHeight="760" FontFamily="Segoe UI" FontSize="13" Background="{DynamicResource SabBrush.WindowBackground}">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../../UI/Styles/SABFluentLight.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>
  <Grid x:Name="CreateViewsAndSheetsRoot" Background="{DynamicResource SabBrush.WindowBackground}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Border Background="White" BorderBrush="{DynamicResource SabBrush.Border}" BorderThickness="0,0,0,1" Padding="24,14">
      <StackPanel Orientation="Horizontal">
        <Border Width="28" Height="28" CornerRadius="5" Background="{DynamicResource SabBrush.Accent}">
          <TextBlock Text="S" Foreground="White" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <TextBlock Text="SAB" FontWeight="SemiBold" Margin="10,0,24,0" VerticalAlignment="Center" />
        <TextBlock Text="Создание видов и листов" VerticalAlignment="Center" />
      </StackPanel>
    </Border>
    <Grid Grid.Row="1" Margin="24,18,24,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Margin="0,0,16,0">
        <TextBlock Text="Создание видов и листов" Style="{StaticResource SabWindowTitleTextStyle}" />
      </StackPanel>
      <Button x:Name="SettingsButton" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" Width="Auto" MinWidth="0" Height="34" Padding="12,0" Command="{Binding OpenSettingsWindowCommand}" Style="{StaticResource SabPrimaryButtonStyle}" Margin="0" ToolTip="Открыть настройки" Content="Настройки">
                </Button>
    </Grid>
    <Grid Grid.Row="2" Margin="24,0,24,18">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="380" />
        <ColumnDefinition Width="20" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Border Padding="12" Style="{StaticResource SabPanelBorderStyle}">
        <ScrollViewer Style="{StaticResource SabFormScrollViewerStyle}" x:Name="SettingsDrawerPanel" Width="Auto" Margin="0" Visibility="Visible" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" design:ScrollEdges.Enabled="True">
          <StackPanel>
            <Expander Style="{StaticResource SabPanelExpanderStyle}" IsExpanded="True" Margin="0,0,0,16" Template="{StaticResource SabSectionCardTemplate}">
              <Expander.Header>
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="Структура" Style="{StaticResource SabPanelHeaderTextStyle}" />
                </StackPanel>
              </Expander.Header>
              <StackPanel>
                <Grid Margin="0,0,0,12" design:Capsule.IsGroup="True" Height="Auto" MinHeight="34">
                  <Border Background="{DynamicResource SabBrush.TableHeaderBackground}" BorderBrush="{DynamicResource SabBrush.Border}" BorderThickness="1" CornerRadius="20" />
                  <Border Tag="CapsuleIndicator" Background="{DynamicResource SabBrush.Accent}" CornerRadius="18" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False" />
                  <UniformGrid Rows="1" Columns="0" Margin="2">
                    <RadioButton Content="Один этаж" GroupName="StructureMode" IsChecked="{Binding IsSingleStoryStructure, Mode=TwoWay}" Style="{StaticResource SabStructureModeRadioButtonStyle}" Margin="0" ToolTip="Одноэтажная структура" />
                    <RadioButton Content="Несколько этажей" GroupName="StructureMode" IsChecked="{Binding IsMultiStoryStructure, Mode=TwoWay}" Style="{StaticResource SabStructureModeRadioButtonStyle}" Margin="0" ToolTip="Многоэтажная структура" />
                    <RadioButton Content="Несколько видов" GroupName="StructureMode" IsChecked="{Binding IsMultiViewStructure, Mode=TwoWay}" Style="{StaticResource SabStructureModeRadioButtonStyle}" Margin="0" ToolTip="Многовидовая структура" />
                  </UniformGrid>
                </Grid>
                <TextBlock Text="Группирование и сортировка листов" Style="{StaticResource SabFieldLabelTextStyle}" Margin="0,12,0,4" />
                <Border Style="{StaticResource SabItemsCollectionBorderStyle}" Tag="CollectionFrame" Margin="0">
                  <ItemsControl ItemsSource="{Binding SheetBrowserParameterLevels}" Margin="0">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Style="{StaticResource SabSettingRowBorderStyle}">
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="78" />
                              <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding LevelTitle}" Style="{StaticResource SabFieldHintTextStyle}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding ParameterName}" Style="{StaticResource SabFieldLabelTextStyle}" TextWrapping="Wrap" VerticalAlignment="Center" />
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Border>
              </StackPanel>
            </Expander>
            <Expander IsExpanded="True" Margin="0,0,0,16" Template="{StaticResource SabSectionCardTemplate}">
              <Expander.Style>
                <Style TargetType="{x:Type Expander}" BasedOn="{StaticResource SabPanelExpanderStyle}">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsSingleStoryStructure}" Value="True">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Expander.Style>
              <Expander.Header>
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="Образец" Style="{StaticResource SabPanelHeaderTextStyle}" />
                </StackPanel>
              </Expander.Header>
              <StackPanel>
                <TextBlock Text="Вид-образец" Style="{StaticResource SabFieldLabelTextStyle}" />
                <ComboBox ItemsSource="{Binding SourceViews}" SelectedItem="{Binding SelectedSourceView}" DisplayMemberPath="Name" ToolTip="{Binding SelectedSourceView.Name}" Style="{StaticResource SabComboBoxStyle}" Margin="0,0,0,12" />
                <TextBlock Text="Лист-образец" Style="{StaticResource SabFieldLabelTextStyle}" />
                <ComboBox ItemsSource="{Binding SourceSheets}" SelectedItem="{Binding SelectedSourceSheet}" DisplayMemberPath="Name" ToolTip="{Binding SelectedSourceSheet.Name}" Style="{StaticResource SabComboBoxStyle}" Margin="0,0,0,12" />
                <TextBlock Text="Тип видового экрана" Style="{StaticResource SabFieldLabelTextStyle}" />
                <ComboBox ItemsSource="{Binding ViewportTypes}" SelectedItem="{Binding SelectedViewportType}" DisplayMemberPath="Name" ToolTip="{Binding SelectedViewportType.Name}" Style="{StaticResource SabComboBoxStyle}" Margin="0,0,0,12" />
                <TextBlock Text="Основная надпись" Style="{StaticResource SabFieldLabelTextStyle}" />
                <ComboBox ItemsSource="{Binding TitleBlockTypes}" SelectedItem="{Binding SelectedTitleBlockType}" DisplayMemberPath="Name" ToolTip="{Binding SelectedTitleBlockType.Name}" Style="{StaticResource SabComboBoxStyle}" />
              </StackPanel>
            </Expander>
            <Expander IsExpanded="True" Margin="0,0,0,16" Template="{StaticResource SabSectionCardTemplate}">
              <Expander.Style>
                <Style TargetType="{x:Type Expander}" BasedOn="{StaticResource SabPanelExpanderStyle}">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsMultiStoryStructure}" Value="True">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Expander.Style>
              <Expander.Header>
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="Этажи" Style="{StaticResource SabPanelHeaderTextStyle}" />
                </StackPanel>
              </Expander.Header>
              <StackPanel>
                <Border Style="{StaticResource SabItemsCollectionBorderStyle}" Tag="CollectionFrame" Margin="0">
                  <ItemsControl ItemsSource="{Binding FloorMappings}" Margin="0">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Style="{StaticResource SabSettingRowBorderStyle}">
                          <StackPanel>
                            <TextBlock Text="Этаж" Style="{StaticResource SabFieldLabelTextStyle}" />
                            <TextBox Text="{Binding FloorName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SabTextBoxStyle}" Margin="0,0,0,10" />
                            <TextBlock Text="Вид-образец" Style="{StaticResource SabFieldLabelTextStyle}" />
                            <ComboBox ItemsSource="{Binding DataContext.SourceViews, RelativeSource={RelativeSource AncestorType=ItemsControl}}" SelectedItem="{Binding SelectedSourceView}" DisplayMemberPath="Name" ToolTip="{Binding SelectedSourceView.Name}" Style="{StaticResource SabComboBoxStyle}" Margin="0,0,0,10" />
                            <TextBlock Text="Лист-образец" Style="{StaticResource SabFieldLabelTextStyle}" />
                            <ComboBox ItemsSource="{Binding DataContext.SourceSheets, RelativeSource={RelativeSource AncestorType=ItemsControl}}" SelectedItem="{Binding SelectedSourceSheet}" DisplayMemberPath="Name" ToolTip="{Binding SelectedSourceSheet.Name}" Style="{StaticResource SabComboBoxStyle}" Margin="0,0,0,10" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                              <Button ToolTip="Добавить сопоставление этажа" Command="{Binding DataContext.AddFloorMappingCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Style="{StaticResource SabRowAddButtonStyle}" AutomationProperties.Name="Добавить сопоставление этажа" Margin="4,0" VerticalAlignment="Center">
                                <Path Data="M1 6 H11 M6 1 V11" Stroke="{DynamicResource SabBrush.TextSecondary}" StrokeThickness="1.4" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                              </Button>
                              <Button ToolTip="Удалить сопоставление этажа" Command="{Binding DataContext.DeleteFloorMappingCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Style="{StaticResource SabRowDeleteButtonStyle}" AutomationProperties.Name="Удалить сопоставление этажа" Margin="4,0" VerticalAlignment="Center">
                                <Path Data="M2 3 H10 M4 3 V1 H8 V3 M3 4 V11 H9 V4 M5 5 V9 M7 5 V9" Stroke="{DynamicResource SabBrush.TextSecondary}" StrokeThickness="1.4" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                              </Button>
                            </StackPanel>
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Border>
                <TextBlock Text="Тип видового экрана" Style="{StaticResource SabFieldLabelTextStyle}" />
                <ComboBox ItemsSource="{Binding ViewportTypes}" SelectedItem="{Binding SelectedViewportType}" DisplayMemberPath="Name" ToolTip="{Binding SelectedViewportType.Name}" Style="{StaticResource SabComboBoxStyle}" Margin="0,0,0,12" />
                <TextBlock Text="Основная надпись" Style="{StaticResource SabFieldLabelTextStyle}" />
                <ComboBox ItemsSource="{Binding TitleBlockTypes}" SelectedItem="{Binding SelectedTitleBlockType}" DisplayMemberPath="Name" ToolTip="{Binding SelectedTitleBlockType.Name}" Style="{StaticResource SabComboBoxStyle}" />
              </StackPanel>
            </Expander>
            <Expander IsExpanded="True" Margin="0,0,0,16" Template="{StaticResource SabSectionCardTemplate}">
              <Expander.Style>
                <Style TargetType="{x:Type Expander}" BasedOn="{StaticResource SabPanelExpanderStyle}">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsMultiViewStructure}" Value="True">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Expander.Style>
              <Expander.Header>
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="Зоны" Style="{StaticResource SabPanelHeaderTextStyle}" />
                </StackPanel>
              </Expander.Header>
              <StackPanel>
                <Border Style="{StaticResource SabItemsCollectionBorderStyle}" Tag="CollectionFrame" Margin="0">
                  <ItemsControl ItemsSource="{Binding MultiViewZoneMappings}" Margin="0">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Style="{StaticResource SabSettingRowBorderStyle}">
                          <StackPanel>
                            <TextBlock Text="Зона" Style="{StaticResource SabFieldLabelTextStyle}" />
                            <TextBox Text="{Binding ZoneName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SabTextBoxStyle}" Margin="0,0,0,10" />
                            <TextBlock Text="Лист-образец зоны" Style="{StaticResource SabFieldLabelTextStyle}" />
                            <ComboBox ItemsSource="{Binding DataContext.SourceSheets, RelativeSource={RelativeSource AncestorType=Window}}" SelectedItem="{Binding SelectedSourceSheet}" DisplayMemberPath="Name" ToolTip="{Binding SelectedSourceSheet.Name}" Style="{StaticResource SabComboBoxStyle}" Margin="0,0,0,10" />
                            <TextBlock Text="Тип видового экрана" Style="{StaticResource SabFieldLabelTextStyle}" />
                            <ComboBox ItemsSource="{Binding DataContext.ViewportTypes, RelativeSource={RelativeSource AncestorType=Window}}" SelectedItem="{Binding SelectedViewportType}" DisplayMemberPath="Name" ToolTip="{Binding SelectedViewportType.Name}" Style="{StaticResource SabComboBoxStyle}" Margin="0,0,0,10" />
                            <TextBlock Text="Основная надпись" Style="{StaticResource SabFieldLabelTextStyle}" />
                            <ComboBox ItemsSource="{Binding DataContext.TitleBlockTypes, RelativeSource={RelativeSource AncestorType=Window}}" SelectedItem="{Binding SelectedTitleBlockType}" DisplayMemberPath="Name" ToolTip="{Binding SelectedTitleBlockType.Name}" Style="{StaticResource SabComboBoxStyle}" Margin="0,0,0,12" />
                            <TextBlock Text="Этажи зоны" Style="{StaticResource SabFieldLabelTextStyle}" />
                            <Border Style="{StaticResource SabItemsCollectionBorderStyle}" Tag="CollectionFrame" Margin="0">
                              <ItemsControl ItemsSource="{Binding Floors}" Margin="0">
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate>
                                    <Border BorderBrush="{StaticResource SabBrush.BorderWeak}" BorderThickness="0,0,0,1" CornerRadius="0" Padding="8" Margin="0,0,0,8">
                                      <Grid>
                                        <Grid.RowDefinitions>
                                          <RowDefinition Height="Auto" />
                                          <RowDefinition Height="34" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                          <ColumnDefinition Width="*" />
                                          <ColumnDefinition Width="8" />
                                          <ColumnDefinition Width="*" />
                                          <ColumnDefinition Width="36" />
                                          <ColumnDefinition Width="36" />
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="3" ToolTip="Добавить этаж ниже" Command="{Binding DataContext.AddMultiViewZoneFloorCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Style="{StaticResource SabRowAddButtonStyle}" VerticalAlignment="Center" Margin="4,0" AutomationProperties.Name="Добавить этаж ниже" Grid.Row="1">
                                          <Path Data="M1 6 H11 M6 1 V11" Stroke="{DynamicResource SabBrush.TextSecondary}" StrokeThickness="1.4" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Button>
                                        <Button Grid.Column="4" ToolTip="Удалить этаж зоны" Command="{Binding DataContext.DeleteMultiViewZoneFloorCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Style="{StaticResource SabRowDeleteButtonStyle}" VerticalAlignment="Center" Margin="4,0" AutomationProperties.Name="Удалить этаж зоны" Grid.Row="1">
                                          <Path Data="M2 3 H10 M4 3 V1 H8 V3 M3 4 V11 H9 V4 M5 5 V9 M7 5 V9" Stroke="{DynamicResource SabBrush.TextSecondary}" StrokeThickness="1.4" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Button>
                                        <TextBlock Text="Этаж" Style="{StaticResource SabFieldHintTextStyle}" Grid.Column="0" Grid.Row="0" />
                                        <TextBox Text="{Binding FloorName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SabTextBoxStyle}" Grid.Column="0" Grid.Row="1" />
                                        <TextBlock Text="Вид-образец" Style="{StaticResource SabFieldHintTextStyle}" Grid.Column="2" Grid.Row="0" />
                                        <ComboBox ItemsSource="{Binding DataContext.MultiViewSourceViews, RelativeSource={RelativeSource AncestorType=Window}}" SelectedItem="{Binding SelectedSourceView}" DisplayMemberPath="Name" ToolTip="{Binding SelectedSourceView.Name}" Style="{StaticResource SabComboBoxStyle}" Grid.Column="2" Grid.Row="1" />
                                      </Grid>
                                    </Border>
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                            </Border>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                              <Button ToolTip="Добавить зону" Command="{Binding DataContext.AddMultiViewZoneCommand, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource SabRowAddButtonStyle}" AutomationProperties.Name="Добавить зону" Margin="4,0" VerticalAlignment="Center">
                                <Path Data="M1 6 H11 M6 1 V11" Stroke="{DynamicResource SabBrush.TextSecondary}" StrokeThickness="1.4" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                              </Button>
                              <Button ToolTip="Удалить зону" Command="{Binding DataContext.DeleteMultiViewZoneCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Style="{StaticResource SabRowDeleteButtonStyle}" AutomationProperties.Name="Удалить зону" Margin="4,0" VerticalAlignment="Center">
                                <Path Data="M2 3 H10 M4 3 V1 H8 V3 M3 4 V11 H9 V4 M5 5 V9 M7 5 V9" Stroke="{DynamicResource SabBrush.TextSecondary}" StrokeThickness="1.4" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                              </Button>
                            </StackPanel>
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Border>
              </StackPanel>
            </Expander>
            <Expander Style="{StaticResource SabPanelExpanderStyle}" IsExpanded="True" Margin="0,0,0,16" Template="{StaticResource SabSectionCardTemplate}">
              <Expander.Header>
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="Размещение" Style="{StaticResource SabPanelHeaderTextStyle}" />
                </StackPanel>
              </Expander.Header>
              <StackPanel>
                <Grid Margin="0,0,0,12" design:Capsule.IsGroup="True" Height="Auto" MinHeight="34">
                  <Border Background="{DynamicResource SabBrush.TableHeaderBackground}" BorderBrush="{DynamicResource SabBrush.Border}" BorderThickness="1" CornerRadius="20" />
                  <Border Tag="CapsuleIndicator" Background="{DynamicResource SabBrush.Accent}" CornerRadius="18" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False" />
                  <UniformGrid Rows="1" Columns="0" Margin="2">
                    <RadioButton x:Name="SourceSheetPlacementToggle" Content="Как на образце" GroupName="ViewportPlacementMode" IsChecked="{Binding IsSourceSheetViewportPlacementMode, Mode=TwoWay}" Style="{StaticResource SabStructureModeRadioButtonStyle}" Margin="0" ToolTip="Размещать вид как на листе-образце" />
                    <RadioButton x:Name="PointPlacementToggle" Content="По координатам" GroupName="ViewportPlacementMode" IsChecked="{Binding IsPointViewportPlacementMode, Mode=TwoWay}" Margin="0" ToolTip="Размещать вид по точкам">
                      <RadioButton.Style>
                        <Style TargetType="{x:Type RadioButton}" BasedOn="{StaticResource SabStructureModeRadioButtonStyle}">
                          <Setter Property="Visibility" Value="Visible" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMultiViewStructure}" Value="True">
                              <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </RadioButton.Style>
                    </RadioButton>
                  </UniformGrid>
                </Grid>
                <StackPanel x:Name="ManualViewportPlacementPanel">
                  <TextBlock Text="Размещение вида" Style="{StaticResource SabFieldLabelTextStyle}" />
                  <StackPanel Orientation="Vertical" Margin="0,2,0,10">
                    <Grid Margin="0,0,0,12" design:Capsule.IsGroup="True" Height="Auto" MinHeight="34">
                      <Border Background="{DynamicResource SabBrush.TableHeaderBackground}" BorderBrush="{DynamicResource SabBrush.Border}" BorderThickness="1" CornerRadius="20" />
                      <Border Tag="CapsuleIndicator" Background="{DynamicResource SabBrush.Accent}" CornerRadius="18" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False" />
                      <UniformGrid Rows="1" Columns="0" Margin="2">
                        <RadioButton Content="Ручной ввод" GroupName="ViewCenterPlacementMode" IsChecked="{Binding IsViewCenterManualMode, Mode=TwoWay}" Style="{StaticResource SabRadioButtonStyle}" Margin="0" ToolTip="Ручной ввод" />
                        <RadioButton Content="Указать точку" GroupName="ViewCenterPlacementMode" IsChecked="{Binding IsViewCenterPointMode, Mode=TwoWay}" Style="{StaticResource SabRadioButtonStyle}" Margin="0" ToolTip="Указать точку" />
                      </UniformGrid>
                    </Grid>
                  </StackPanel>
                  <Grid Margin="0,0,0,14">
                    <Grid.Style>
                      <Style TargetType="{x:Type Grid}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsViewCenterManualMode}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Grid.Style>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="12" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="X центра вида" Style="{StaticResource SabFieldLabelTextStyle}" />
                    <TextBox Grid.Row="1" Grid.Column="0" Text="{Binding ViewCenterXText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SabTextBoxStyle}" />
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Y центра вида" Style="{StaticResource SabFieldLabelTextStyle}" />
                    <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding ViewCenterYText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SabTextBoxStyle}" />
                  </Grid>
                  <StackPanel Margin="0,0,0,14">
                    <StackPanel.Style>
                      <Style TargetType="{x:Type StackPanel}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsViewCenterPointMode}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </StackPanel.Style>
                    <TextBlock Text="{Binding ViewCenterPointSummary}" Style="{StaticResource SabFieldHintTextStyle}" Margin="0,0,0,8" />
                    <Button Content="Указать точку размещения вида" Command="{Binding PickViewCenterPointCommand}" Style="{StaticResource SabOutlineButtonStyle}" />
                  </StackPanel>
                  <TextBlock Text="Размещение заголовка" Style="{StaticResource SabFieldLabelTextStyle}" />
                  <StackPanel Orientation="Vertical" Margin="0,2,0,10">
                    <Grid Margin="0,0,0,12" design:Capsule.IsGroup="True" Height="Auto" MinHeight="34">
                      <Border Background="{DynamicResource SabBrush.TableHeaderBackground}" BorderBrush="{DynamicResource SabBrush.Border}" BorderThickness="1" CornerRadius="20" />
                      <Border Tag="CapsuleIndicator" Background="{DynamicResource SabBrush.Accent}" CornerRadius="18" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False" />
                      <UniformGrid Rows="1" Columns="0" Margin="2">
                        <RadioButton Content="Ручной ввод" GroupName="ViewTitlePlacementMode" IsChecked="{Binding IsViewTitleManualMode, Mode=TwoWay}" Style="{StaticResource SabRadioButtonStyle}" Margin="0" ToolTip="Ручной ввод" />
                        <RadioButton Content="Указать точку" GroupName="ViewTitlePlacementMode" IsChecked="{Binding IsViewTitlePointMode, Mode=TwoWay}" Style="{StaticResource SabRadioButtonStyle}" Margin="0" ToolTip="Указать точку" />
                      </UniformGrid>
                    </Grid>
                  </StackPanel>
                  <Grid Margin="0,0,0,14">
                    <Grid.Style>
                      <Style TargetType="{x:Type Grid}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsViewTitleManualMode}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Grid.Style>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="12" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="X заголовка" Style="{StaticResource SabFieldLabelTextStyle}" />
                    <TextBox Grid.Row="1" Grid.Column="0" Text="{Binding ViewTitleXText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SabTextBoxStyle}" />
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Y заголовка" Style="{StaticResource SabFieldLabelTextStyle}" />
                    <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding ViewTitleYText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SabTextBoxStyle}" />
                  </Grid>
                  <StackPanel Margin="0,0,0,14">
                    <StackPanel.Style>
                      <Style TargetType="{x:Type StackPanel}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsViewTitlePointMode}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </StackPanel.Style>
                    <TextBlock Text="{Binding ViewTitlePointSummary}" Style="{StaticResource SabFieldHintTextStyle}" Margin="0,0,0,8" />
                    <Button Content="Указать точку размещения заголовка" Command="{Binding PickViewTitlePointCommand}" Style="{StaticResource SabOutlineButtonStyle}" />
                  </StackPanel>
                </StackPanel>
                <CheckBox Content="Сохранить настройки" IsChecked="{Binding SaveSettings}" Style="{StaticResource SabCheckBoxStyle}" />
              </StackPanel>
            </Expander>
            <Expander Style="{StaticResource SabPanelExpanderStyle}" IsExpanded="True" Template="{StaticResource SabSectionCardTemplate}" Margin="0,0,0,16">
              <Expander.Header>
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="Копирование" Style="{StaticResource SabPanelHeaderTextStyle}" />
                </StackPanel>
              </Expander.Header>
              <StackPanel>
                <Border Style="{StaticResource SabPrimarySettingBorderStyle}">
                  <CheckBox Content="Копировать лист с детализацией" IsChecked="{Binding CopySheetWithDetailing}" Style="{StaticResource SabCheckBoxStyle}" />
                </Border>
                <StackPanel IsEnabled="{Binding CopySheetWithDetailing}">
                  <StackPanel.Style>
                    <Style TargetType="{x:Type StackPanel}">
                      <Setter Property="Opacity" Value="1" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding CopySheetWithDetailing}" Value="False">
                          <Setter Property="Opacity" Value="0.55" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </StackPanel.Style>
                  <CheckBox Content="Ведомости" IsChecked="{Binding CopySchedules}" Style="{StaticResource SabCheckBoxStyle}" Margin="0,0,0,8" />
                  <CheckBox Content="Легенды" IsChecked="{Binding CopyLegends}" Style="{StaticResource SabCheckBoxStyle}" Margin="0,0,0,8" />
                  <CheckBox Content="Чертежные виды" IsChecked="{Binding CopyDraftingViews}" Style="{StaticResource SabCheckBoxStyle}" Margin="0,0,0,8" />
                  <CheckBox Content="Линии детализации" IsChecked="{Binding CopyDetailLines}" Style="{StaticResource SabCheckBoxStyle}" Margin="0,0,0,8" />
                  <CheckBox Content="Области заливки" IsChecked="{Binding CopyFilledRegions}" Style="{StaticResource SabCheckBoxStyle}" Margin="0,0,0,8" />
                  <CheckBox Content="Текстовые примечания" IsChecked="{Binding CopyTextNotes}" Style="{StaticResource SabCheckBoxStyle}" Margin="0,0,0,8" />
                  <CheckBox Content="Типовые аннотации" IsChecked="{Binding CopyGenericAnnotations}" Style="{StaticResource SabCheckBoxStyle}" Margin="0,0,0,8" />
                  <CheckBox Content="Изображения" IsChecked="{Binding CopyImages}" Style="{StaticResource SabCheckBoxStyle}" />
                </StackPanel>
              </StackPanel>
            </Expander>
          </StackPanel>
        </ScrollViewer>
      </Border>
      <Grid Grid.Column="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Style="{StaticResource SabDataGridContainerBorderStyle}">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Margin="16,14,16,12">
              <TextBlock Text="Создаваемые виды и листы" Style="{StaticResource SabPanelHeaderTextStyle}" Margin="0,0,0,12" />
              <WrapPanel>
                <Button Content="Загрузить таблицу" Command="{Binding ImportSheetTableCommand}" Style="{StaticResource SabOutlineButtonStyle}" Margin="0,0,8,8" />
                <Button Content="Имя листа → Имя вида" Command="{Binding CopySheetNamesToViewNamesCommand}" Style="{StaticResource SabOutlineButtonStyle}" Margin="0,0,8,8" />
                <Button Content="Удалить все строки" Command="{Binding ClearRowsCommand}" Style="{StaticResource SabNeutralButtonStyle}" Margin="0,0,8,8" />
              </WrapPanel>
            </StackPanel>
            <Border Style="{StaticResource SabCollectionBorderStyle}" Tag="CollectionFrame" Margin="16,0,16,16" Grid.Row="1">
              <DataGrid x:Name="CreationRowsDataGrid" ItemsSource="{Binding Rows}" Style="{StaticResource SabDataGridStyle}" BorderThickness="0" SelectionMode="Extended" SelectionUnit="FullRow" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" VirtualizingPanel.IsVirtualizingWhenGrouping="True" RowHeight="44" Margin="0">
                <DataGrid.GroupStyle>
                  <GroupStyle>
                    <GroupStyle.ContainerStyle>
                      <Style TargetType="{x:Type GroupItem}">
                        <Setter Property="Template">
                          <Setter.Value>
                            <ControlTemplate TargetType="{x:Type GroupItem}">
                              <StackPanel>
                                <ToggleButton x:Name="GroupToggle" IsChecked="True" Focusable="False" BorderThickness="0" Background="Transparent" Cursor="Hand">
                                  <ToggleButton.Template>
                                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                                      <Border Background="{StaticResource SabBrush.TableHeaderBackground}" BorderBrush="{StaticResource SabBrush.Border}" BorderThickness="0,0,0,1" Padding="0" Height="36">
                                        <Grid>
                                          <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="34" />
                                            <ColumnDefinition Width="*" />
                                          </Grid.ColumnDefinitions>
                                          <TextBlock Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource SabBrush.Accent}">
                                            <TextBlock.Style>
                                              <Style TargetType="{x:Type TextBlock}">
                                                <Setter Property="Text" Value="-" />
                                                <Style.Triggers>
                                                  <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="False">
                                                    <Setter Property="Text" Value="+" />
                                                  </DataTrigger>
                                                </Style.Triggers>
                                              </Style>
                                            </TextBlock.Style>
                                          </TextBlock>
                                          <ContentPresenter Grid.Column="1" VerticalAlignment="Center" Content="{TemplateBinding Content}" />
                                        </Grid>
                                      </Border>
                                    </ControlTemplate>
                                  </ToggleButton.Template>
                                  <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource SabBrush.Text}" TextTrimming="CharacterEllipsis" />
                                </ToggleButton>
                                <ItemsPresenter x:Name="GroupItems" />
                              </StackPanel>
                              <ControlTemplate.Triggers>
                                <Trigger SourceName="GroupToggle" Property="IsChecked" Value="False">
                                  <Setter TargetName="GroupItems" Property="Visibility" Value="Collapsed" />
                                </Trigger>
                              </ControlTemplate.Triggers>
                            </ControlTemplate>
                          </Setter.Value>
                        </Setter>
                      </Style>
                    </GroupStyle.ContainerStyle>
                  </GroupStyle>
                </DataGrid.GroupStyle>
                <DataGrid.Columns>
                  <DataGridTemplateColumn Header="" Width="34" MinWidth="34" MaxWidth="34" CanUserResize="False" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <Border Style="{StaticResource SabDataGridDragHandleBorderStyle}">
                          <Path Data="M5 1 H7 M5 6 H7 M5 11 H7" Stroke="{DynamicResource SabBrush.TextSecondary}" StrokeThickness="1.4" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTextColumn Header="№" Binding="{Binding RowNumber}" IsReadOnly="True" Width="44" MinWidth="44" ElementStyle="{StaticResource SabDataGridCenteredTextBlockStyle}" EditingElementStyle="{StaticResource SabDataGridTextBoxEditingStyle}" HeaderStyle="{StaticResource SabCenteredHeaderStyle}" />
                  <DataGridTemplateColumn Header="Этаж" SortMemberPath="FloorName" Width="140" MinWidth="110">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <ComboBox ItemsSource="{Binding DataContext.FloorNames, RelativeSource={RelativeSource AncestorType=DataGrid}}" Text="{Binding FloorName, UpdateSourceTrigger=PropertyChanged}" IsEditable="True" IsTextSearchEnabled="False" Style="{StaticResource SabDataGridComboBoxStyle}" />
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTemplateColumn Header="Тип плана" SortMemberPath="PlanKind" Width="150" MinWidth="130">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <ComboBox ItemsSource="{Binding DataContext.PlanKindOptions, RelativeSource={RelativeSource AncestorType=DataGrid}}" SelectedValue="{Binding PlanKind, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Kind" DisplayMemberPath="DisplayName" TextSearch.TextPath="DisplayName" Style="{StaticResource SabDataGridComboBoxStyle}" />
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTemplateColumn Header="Имя вида" SortMemberPath="ViewName" Width="1.25*" MinWidth="130">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <Grid>
                          <TextBox Text="{Binding ViewName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SabDataGridInlineTextBoxStyle}" Margin="0" Padding="9,0" />
                          <TextBlock Text="Введите имя вида" Margin="4,0,0,0">
                            <TextBlock.Style>
                              <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource SabPlaceholderTextStyle}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding ViewName}" Value="">
                                    <Setter Property="Visibility" Value="Visible" />
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </TextBlock.Style>
                          </TextBlock>
                        </Grid>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTemplateColumn Header="Масштаб" SortMemberPath="ViewScaleText" Width="84" MinWidth="84" HeaderStyle="{StaticResource SabCenteredHeaderStyle}">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <ComboBox ItemsSource="{Binding DataContext.ScaleOptions, RelativeSource={RelativeSource AncestorType=DataGrid}}" Text="{Binding ViewScaleText, UpdateSourceTrigger=PropertyChanged}" IsEditable="True" IsEnabled="{Binding IsScaleEnabled}" Style="{StaticResource SabNumericComboBoxStyle}" />
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTemplateColumn Header="Шаблон вида" SortMemberPath="SelectedViewTemplate.Name" Width="1.55*" MinWidth="140">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <ComboBox ItemsSource="{Binding DataContext.ViewTemplates, RelativeSource={RelativeSource AncestorType=DataGrid}}" SelectedItem="{Binding SelectedViewTemplate, UpdateSourceTrigger=PropertyChanged}" DisplayMemberPath="Name" ToolTip="{Binding SelectedViewTemplate.Name}" Style="{StaticResource SabDataGridComboBoxStyle}" />
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTemplateColumn Header="№ листа" SortMemberPath="SheetNumber" Width="90" MinWidth="90" HeaderStyle="{StaticResource SabCenteredHeaderStyle}">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <Grid>
                          <TextBox Text="{Binding SheetNumber, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SabDataGridInlineTextBoxStyle}" TextAlignment="Center" Margin="0" Padding="9,0" />
                          <TextBlock Text="Введите №" Margin="4,0,0,0">
                            <TextBlock.Style>
                              <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource SabPlaceholderTextStyle}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding SheetNumber}" Value="">
                                    <Setter Property="Visibility" Value="Visible" />
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </TextBlock.Style>
                          </TextBlock>
                        </Grid>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTemplateColumn Header="Имя листа" SortMemberPath="SheetName" Width="*" MinWidth="120">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <Grid>
                          <TextBox Text="{Binding SheetName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SabDataGridInlineTextBoxStyle}" Margin="0" Padding="9,0" />
                          <TextBlock Text="Введите имя листа" Margin="4,0,0,0">
                            <TextBlock.Style>
                              <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource SabPlaceholderTextStyle}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding SheetName}" Value="">
                                    <Setter Property="Visibility" Value="Visible" />
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </TextBlock.Style>
                          </TextBlock>
                        </Grid>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTemplateColumn Header="Действия" Width="88" MinWidth="88" MaxWidth="88" CanUserResize="False" HeaderStyle="{StaticResource SabCenteredHeaderStyle}" CellStyle="{StaticResource SabDataGridLastColumnCellStyle}">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <StackPanel Style="{StaticResource SabDataGridActionsPanelStyle}">
                          <Button ToolTip="Добавить строку ниже" Command="{Binding DataContext.InsertRowAfterCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Style="{StaticResource SabRowAddButtonStyle}" AutomationProperties.Name="Добавить строку ниже" Margin="4,0" VerticalAlignment="Center">
                            <Path Data="M1 6 H11 M6 1 V11" Stroke="{DynamicResource SabBrush.TextSecondary}" StrokeThickness="1.4" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                          </Button>
                          <Button ToolTip="Удалить строку" Command="{Binding DataContext.DeleteRowCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Style="{StaticResource SabRowDeleteButtonStyle}" AutomationProperties.Name="Удалить строку" Margin="4,0" VerticalAlignment="Center">
                            <Path Data="M2 3 H10 M4 3 V1 H8 V3 M3 4 V11 H9 V4 M5 5 V9 M7 5 V9" Stroke="{DynamicResource SabBrush.TextSecondary}" StrokeThickness="1.4" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                          </Button>
                        </StackPanel>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                </DataGrid.Columns>
              </DataGrid>
            </Border>
          </Grid>
        </Border>
        <Border x:Name="ValidationPanelBorder" Grid.Row="1" Style="{StaticResource SabValidationPanelStyle}" BorderBrush="{Binding ValidationBorderBrush}" BorderThickness="2" Margin="0,14,0,0" Height="Auto">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="170" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Top" Margin="0,0,14,0">
              <TextBlock Text="{Binding StatusRowsText}" Style="{StaticResource SabStatusTextStyle}" Margin="0,0,0,7" />
              <TextBlock Text="{Binding StatusFilledText}" Style="{StaticResource SabStatusTextStyle}" Margin="0,0,0,7" />
              <TextBlock Text="{Binding StatusWarningsText}" Style="{StaticResource SabStatusTextStyle}" Margin="0,0,0,7" />
              <TextBlock Text="{Binding StatusErrorsText}" Style="{StaticResource SabStatusTextStyle}" />
            </StackPanel>
            <Border Grid.Column="1" Width="1" Background="{StaticResource SabBrush.Border}" Margin="0,0,14,0" />
            <Border Grid.Column="2" Width="22" Height="22" CornerRadius="11" Background="{Binding ValidationIconBackground}" Margin="0,0,10,0" VerticalAlignment="Top">
              <TextBlock Text="{Binding ValidationIconText}" FontFamily="Segoe UI Symbol" FontSize="14" FontWeight="SemiBold" Foreground="{Binding ValidationIconForeground}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" />
            </Border>
            <ScrollViewer Style="{StaticResource SabFormScrollViewerStyle}" Grid.Column="3" VerticalScrollBarVisibility="Auto">
              <TextBlock Text="{Binding ValidationSummary}" Foreground="{Binding ValidationSummaryForeground}" FontSize="13" TextWrapping="Wrap" />
            </ScrollViewer>
          </Grid>
        </Border>
      </Grid>
    </Grid>
    <Border Grid.Row="3" Background="White" BorderBrush="{DynamicResource SabBrush.BorderWeak}" BorderThickness="0,1,0,0" Padding="24,14">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Grid.Row="1">
          <Button Content="Отмена" Width="120" Command="{Binding CancelCommand}" Style="{StaticResource SabNeutralButtonStyle}" Margin="0,0,10,0" />
          <Button x:Name="CreateButton" Content="Создать" Width="130" Command="{Binding CreateCommand}" IsEnabled="{Binding CanCreate}" Style="{StaticResource SabPrimaryButtonStyle}" />
        </StackPanel>
        <TextBlock Text="{Binding StatusText}" Style="{StaticResource SabFieldHintTextStyle}" VerticalAlignment="Center" Margin="0,0,0,8" Grid.Row="0" Grid.ColumnSpan="2" />
        <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Content="Инструкция" Height="34" Margin="0,0,16,0" design:Instructions.File="SAB_HTML_Sozdat_vidy_i_listy.html" />
          <TextBlock Text="Настройки" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="{DynamicResource SabBrush.TextSecondary}" />
          <Button Content="Импорт настроек" Command="{Binding ImportSettingsCommand}" Style="{StaticResource SabOutlineButtonStyle}" Margin="0,0,8,0" />
          <Button Content="Экспорт настроек" Command="{Binding ExportSettingsCommand}" Style="{StaticResource SabOutlineButtonStyle}" Margin="0,0,8,0" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>