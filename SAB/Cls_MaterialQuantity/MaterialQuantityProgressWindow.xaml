<Window x:Class="SAB.MaterialQuantity.MaterialQuantityProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SAB — материалы по слоям"
        Width="560"
        MinWidth="520"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        FontFamily="Segoe UI"
        FontSize="13"
        Background="{DynamicResource SabBrush.WindowBackground}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../UI/Styles/SABWindowStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="18" Background="{StaticResource SabBrush.PanelBackground}">
        <StackPanel>
            <TextBlock Text="Обновление материалов и спецификаций"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource SabBrush.Accent}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,12" />

            <TextBlock x:Name="StageTextBlock"
                       Text="Подготовка"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource SabBrush.Text}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,4" />

            <TextBlock x:Name="DetailsTextBlock"
                       Text="Готовим служебное семейство."
                       Foreground="{StaticResource SabBrush.TextSecondary}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,12" />

            <ProgressBar x:Name="MainProgressBar"
                         Height="16"
                         Minimum="0"
                         Maximum="100"
                         Value="0"
                         IsIndeterminate="True"
                         Foreground="{StaticResource SabBrush.Accent}"
                         Background="{StaticResource SabBrush.DisabledBackground}"
                         Margin="0,0,0,8" />

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="ItemsTextBlock"
                           Grid.Column="0"
                           Text="Операция выполняется"
                           Foreground="{StaticResource SabBrush.Accent}"
                           TextWrapping="Wrap" />

                <TextBlock x:Name="PercentTextBlock"
                           Grid.Column="1"
                           Text=""
                           FontWeight="SemiBold"
                           Foreground="{StaticResource SabBrush.Accent}"
                           Margin="12,0,0,0" />
            </Grid>

            <Border Padding="12"
                    Background="{StaticResource SabBrush.AccentLight}"
                    BorderBrush="{StaticResource SabBrush.Accent}"
                    BorderThickness="1"
                    CornerRadius="6">
                <TextBlock x:Name="CountersTextBlock"
                           Text="Создано: 0  ·  Обновлено: 0  ·  Проверить: 0  ·  Устарело: 0"
                           Foreground="{StaticResource SabBrush.Accent}"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           TextAlignment="Center" />
            </Border>
        </StackPanel>
    </Grid>
</Window>
