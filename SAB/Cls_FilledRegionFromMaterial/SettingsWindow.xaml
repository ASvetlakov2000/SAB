<Window x:Class="SAB.FilledRegionFromMaterial.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="SAB Область заливки из материала"
        Width="1120" Height="700" MinWidth="880" MinHeight="610"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True"
        ResizeMode="CanResizeWithGrip"
        Background="Transparent"
        FontFamily="Segoe UI" FontSize="13">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="7"
                            CornerRadius="8"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../UI/Styles/SABWindowStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border Style="{StaticResource SabWindowFrameStyle}">
        <Grid ClipToBounds="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="32" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border x:Name="TitleBar"
                    Grid.Row="0"
                    Background="{StaticResource SabBrush.PanelBackground}"
                    BorderBrush="{StaticResource SabBrush.BorderWeak}"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBarMouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                        <Border Width="21" Height="21" CornerRadius="4"
                                Background="{StaticResource SabBrush.Accent}">
                            <TextBlock Text="S" Foreground="White" FontWeight="Bold" FontSize="12"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="SAB  ОБЛАСТЬ ЗАЛИВКИ ИЗ МАТЕРИАЛА"
                                   Margin="8,0,0,0" VerticalAlignment="Center"
                                   Foreground="{StaticResource SabBrush.Text}"
                                   FontSize="12" FontWeight="SemiBold" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="─" ToolTip="Свернуть"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                Style="{StaticResource SabWindowChromeButtonStyle}"
                                Click="MinimizeWindowClick" />
                        <Button Content="✕" ToolTip="Закрыть"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                Style="{StaticResource SabWindowCloseButtonStyle}"
                                Click="CloseWindowClick" />
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel Grid.Row="1" Margin="18,15,18,14">
                <TextBlock Text="Настройки областей заливки"
                           Style="{StaticResource SabWindowTitleTextStyle}" />
                <TextBlock Text="Выберите материалы, графику сечения и правила переноса параметров."
                           Margin="0,3,0,0"
                           Style="{StaticResource SabWindowSubtitleTextStyle}" />
            </StackPanel>

            <Grid Grid.Row="2" Margin="18,0,18,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320" MinWidth="290" MaxWidth="400" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <ScrollViewer Style="{StaticResource SabFormScrollViewerStyle}" Grid.Column="0"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,8,0">
                        <Border Style="{StaticResource SabPanelBorderStyle}" Margin="0,0,0,10">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <Border Style="{StaticResource SabPanelIconBorderStyle}">
                                        <TextBlock Text="◫" Style="{StaticResource SabPanelIconTextStyle}" />
                                    </Border>
                                    <TextBlock Text="Снимок модели" Style="{StaticResource SabPanelHeaderTextStyle}" />
                                </StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="8" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="8" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="8" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Используемые материалы" Style="{StaticResource SabFieldHintTextStyle}" />
                                    <TextBlock x:Name="UsedMaterialsText" Grid.Column="1"
                                               FontWeight="SemiBold" Foreground="{StaticResource SabBrush.Text}" />
                                    <TextBlock Grid.Row="2" Text="Всего материалов" Style="{StaticResource SabFieldHintTextStyle}" />
                                    <TextBlock x:Name="TotalMaterialsText" Grid.Row="2" Grid.Column="1"
                                               FontWeight="SemiBold" Foreground="{StaticResource SabBrush.Text}" />
                                    <TextBlock Grid.Row="4" Text="Типы областей" Style="{StaticResource SabFieldHintTextStyle}" />
                                    <TextBlock x:Name="RegionTypesText" Grid.Row="4" Grid.Column="1"
                                               FontWeight="SemiBold" Foreground="{StaticResource SabBrush.Text}" />
                                    <TextBlock Grid.Row="6" Text="Размещённые области" Style="{StaticResource SabFieldHintTextStyle}" />
                                    <TextBlock x:Name="RegionInstancesText" Grid.Row="6" Grid.Column="1"
                                               FontWeight="SemiBold" Foreground="{StaticResource SabBrush.Text}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SabPanelBorderStyle}" Margin="0,0,0,10">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <Border Style="{StaticResource SabPanelIconBorderStyle}">
                                        <TextBlock Text="⚙" Style="{StaticResource SabPanelIconTextStyle}" />
                                    </Border>
                                    <TextBlock Text="Общие настройки" Style="{StaticResource SabPanelHeaderTextStyle}" />
                                </StackPanel>
                                <TextBlock Text="Префикс типов" Style="{StaticResource SabFieldLabelTextStyle}" />
                                <TextBox x:Name="PrefixTextBox" Style="{StaticResource SabTextBoxStyle}" />
                                <CheckBox x:Name="IncludeUnusedMaterialsCheckBox"
                                          Content="Обрабатывать все материалы документа"
                                          Style="{StaticResource SabCheckBoxStyle}" Margin="0,14,0,0" />
                                <CheckBox x:Name="IncludePaintedMaterialsCheckBox"
                                          Content="Учитывать материалы покраски"
                                          Style="{StaticResource SabCheckBoxStyle}" Margin="0,9,0,0" />
                                <CheckBox x:Name="SkipWithoutPatternCheckBox"
                                          Content="Пропускать материалы без штриховки"
                                          Style="{StaticResource SabCheckBoxStyle}" Margin="0,9,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SabPanelBorderStyle}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <Border Style="{StaticResource SabPanelIconBorderStyle}">
                                        <TextBlock Text="▨" Style="{StaticResource SabPanelIconTextStyle}" />
                                    </Border>
                                    <TextBlock Text="Графика сечения" Style="{StaticResource SabPanelHeaderTextStyle}" />
                                </StackPanel>
                                <CheckBox x:Name="CopyForegroundCheckBox"
                                          Content="Передняя штриховка"
                                          Style="{StaticResource SabCheckBoxStyle}" />
                                <CheckBox x:Name="CopyBackgroundCheckBox"
                                          Content="Фоновая штриховка"
                                          Style="{StaticResource SabCheckBoxStyle}" Margin="0,9,0,0" />
                                <CheckBox x:Name="CopyColorsCheckBox"
                                          Content="Цвета штриховок"
                                          Style="{StaticResource SabCheckBoxStyle}" Margin="0,9,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Column="2" Style="{StaticResource SabPanelBorderStyle}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Margin="14,14,14,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Style="{StaticResource SabPanelIconBorderStyle}">
                                    <TextBlock Text="≡" Style="{StaticResource SabPanelIconTextStyle}" />
                                </Border>
                                <TextBlock Text="Сопоставление параметров"
                                           Style="{StaticResource SabPanelHeaderTextStyle}" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="Добавить соответствие"
                                    Style="{StaticResource SabOutlineButtonStyle}"
                                    MinWidth="170" Click="AddMappingClick" />
                        </Grid>

                        <TextBlock Grid.Row="1"
                                   Margin="14,8,14,12"
                                   Text="Источник берётся из материала. Назначение может быть параметром типа или экземпляра области заливки."
                                   Style="{StaticResource SabFieldHintTextStyle}" />

                        <Border Grid.Row="2" Margin="14,0,14,12"
                                Style="{StaticResource SabDataGridContainerBorderStyle}">
                            <DataGrid x:Name="MappingGrid"
                                      Style="{StaticResource SabDataGridStyle}"
                                      SelectionMode="Single"
                                      SizeChanged="MappingGridSizeChanged"
                                      HorizontalScrollBarVisibility="Disabled">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn x:Name="SourceMappingColumn"
                                                            Header="Параметр материала" Width="*" MinWidth="150">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ComboBox ItemsSource="{Binding DataContext.MaterialParameterOptions, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                          SelectedValue="{Binding SourceKey, UpdateSourceTrigger=PropertyChanged}"
                                                          SelectedValuePath="Key"
                                                          DisplayMemberPath="DisplayName"
                                                          ToolTip="{Binding SourceKey}"
                                                          Style="{StaticResource SabDataGridComboBoxStyle}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="" Width="44" MinWidth="44" MaxWidth="44" CanUserResize="False">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="→" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Foreground="{StaticResource SabBrush.TextSecondary}" FontSize="16" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn x:Name="TargetMappingColumn"
                                                            Header="Параметр области заливки" Width="*" MinWidth="180">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ComboBox ItemsSource="{Binding DataContext.TargetParameterOptions, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                          SelectedValue="{Binding TargetSelectionKey, UpdateSourceTrigger=PropertyChanged}"
                                                          SelectedValuePath="SelectionKey"
                                                          DisplayMemberPath="DisplayName"
                                                          ToolTip="{Binding TargetSelectionKey}"
                                                          Style="{StaticResource SabDataGridComboBoxStyle}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="Действия"
                                                            Width="84" MinWidth="84" MaxWidth="84"
                                                            CanUserResize="False"
                                                            HeaderStyle="{StaticResource SabDataGridLastColumnHeaderStyle}"
                                                            CellStyle="{StaticResource SabDataGridLastColumnCellStyle}">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Style="{StaticResource SabDataGridActionsPanelStyle}">
                                                    <Button Content="+" ToolTip="Добавить строку ниже"
                                                            Tag="{Binding}" Click="InsertMappingClick"
                                                            Style="{StaticResource SabRowAddButtonStyle}" />
                                                    <Button Content="×" ToolTip="Удалить строку"
                                                            Tag="{Binding}" Click="RemoveMappingClick"
                                                            Style="{StaticResource SabRowDeleteButtonStyle}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>

                        <Border Grid.Row="3" Margin="14,0,14,14"
                                Style="{StaticResource SabValidationPanelStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="22" Height="22" CornerRadius="11"
                                        Background="{StaticResource SabBrush.AccentLight}"
                                        Margin="0,0,10,0">
                                    <TextBlock Text="i" FontWeight="SemiBold"
                                               Foreground="{StaticResource SabBrush.Accent}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock x:Name="StatusText" Style="{StaticResource SabStatusTextStyle}" />
                                    <TextBlock x:Name="ValidationText" Margin="0,3,0,0"
                                               Foreground="{StaticResource SabBrush.Error}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="3"
                    Background="{StaticResource SabBrush.PanelBackground}"
                    BorderBrush="{StaticResource SabBrush.Border}"
                    BorderThickness="0,1,0,0"
                    Padding="18,9">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Настройки сохраняются в проекте Revit."
                               VerticalAlignment="Center"
                               Style="{StaticResource SabWindowSubtitleTextStyle}" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="Отмена" Width="110" IsCancel="True"
                                Style="{StaticResource SabNeutralButtonStyle}"
                                Margin="0,0,10,0" Click="CancelClick" />
                        <Button Content="Сохранить" Width="110"
                                Style="{StaticResource SabNeutralButtonStyle}"
                                Margin="0,0,10,0" Click="SaveClick" />
                        <Button Content="Создать / обновить" Width="180" IsDefault="True"
                                Style="{StaticResource SabPrimaryButtonStyle}"
                                ToolTip="Сохранить настройки и создать или обновить области заливки из материалов."
                                Click="RunClick" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
