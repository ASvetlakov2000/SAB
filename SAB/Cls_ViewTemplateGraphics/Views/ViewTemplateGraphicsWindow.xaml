<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SAB Пакетное редактирование шаблонов видов"
        Width="1380"
        Height="820"
        MinWidth="1120"
        MinHeight="650"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        FontFamily="Segoe UI"
        FontSize="13"
        Background="{DynamicResource SabBrush.WindowBackground}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../UI/Styles/SABWindowStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="TemplateListBoxStyle" TargetType="{x:Type ListBox}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            </Style>

            <Style x:Key="TemplateListBoxItemStyle" TargetType="{x:Type ListBoxItem}">
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0,0,0,4" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ListBoxItem}">
                            <Border x:Name="ItemBorder"
                                    Padding="8"
                                    CornerRadius="5"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{DynamicResource SabBrush.BorderWeak}"
                                    BorderThickness="1">
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SabBrush.AccentLight}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SabBrush.AccentLight}" />
                                    <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource SabBrush.Accent}" />
                                </Trigger>
                                <DataTrigger Binding="{Binding IsVisibleInList}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="GraphicsTabControlStyle" TargetType="{x:Type TabControl}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0" />
            </Style>

            <Style x:Key="GraphicsTabItemStyle" TargetType="{x:Type TabItem}">
                <Setter Property="Foreground" Value="{DynamicResource SabBrush.TextSecondary}" />
                <Setter Property="Background" Value="White" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Padding" Value="15,8" />
                <Setter Property="Margin" Value="0,0,7,0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type TabItem}">
                            <Border x:Name="TabBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{DynamicResource SabBrush.Border}"
                                    BorderThickness="1"
                                    CornerRadius="5"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource SabBrush.AccentLight}" />
                                    <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource SabBrush.Accent}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource SabBrush.Accent}" />
                                    <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource SabBrush.AccentLight}" />
                                    <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource SabBrush.Accent}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="CompactSearchButtonStyle"
                   TargetType="{x:Type Button}"
                   BasedOn="{StaticResource SabOutlineButtonStyle}">
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Height" Value="32" />
                <Setter Property="Padding" Value="10,0" />
            </Style>

            <Style x:Key="GraphicsCellButtonStyle"
                   TargetType="{x:Type Button}"
                   BasedOn="{StaticResource SabOutlineButtonStyle}">
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Height" Value="30" />
                <Setter Property="Margin" Value="6,4" />
                <Setter Property="Padding" Value="7,0" />
            </Style>

            <Style x:Key="TreeToggleButtonStyle" TargetType="{x:Type Button}">
                <Setter Property="Width" Value="16" />
                <Setter Property="Height" Value="20" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0,0,4,0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="{DynamicResource SabBrush.Accent}" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border x:Name="ToggleBackground"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="3">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ToggleBackground" Property="Background" Value="{DynamicResource SabBrush.AccentLight}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Opacity" Value="0.7" />
                                </Trigger>
                                <DataTrigger Binding="{Binding HasChildren}" Value="False">
                                    <Setter Property="Visibility" Value="Hidden" />
                                </DataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ModifiedStatusStyle" TargetType="{x:Type TextBlock}">
                <Setter Property="Text" Value="" />
                <Setter Property="Foreground" Value="{DynamicResource SabBrush.Accent}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsModified}" Value="True">
                        <Setter Property="Text" Value="Изменено" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="FilterStatusStyle" TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="{DynamicResource SabBrush.Accent}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="CategoryDataGridRowStyle"
                   TargetType="{x:Type DataGridRow}"
                   BasedOn="{StaticResource SabDataGridRowStyle}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsVisibleInTree}" Value="False">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding HasChildren}" Value="True">
                        <Setter Property="FontWeight" Value="SemiBold" />
                    </DataTrigger>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding IsComparisonActive}" Value="True" />
                            <Condition Binding="{Binding HasMixedTemplateValues}" Value="False" />
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Background" Value="#EEF6FF" />
                    </MultiDataTrigger>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding IsComparisonActive}" Value="True" />
                            <Condition Binding="{Binding HasMixedTemplateValues}" Value="True" />
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Background" Value="#FFF4D6" />
                    </MultiDataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="SearchableDataGridRowStyle"
                   TargetType="{x:Type DataGridRow}"
                   BasedOn="{StaticResource SabDataGridRowStyle}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsVisibleInList}" Value="False">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <DataTemplate x:Key="CategoryTabTemplate">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="{DynamicResource SabBrush.TableHeaderBackground}"
                            BorderBrush="{DynamicResource SabBrush.BorderWeak}"
                            BorderThickness="1"
                            CornerRadius="5"
                            Padding="10"
                            Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                                <CheckBox Content="Включить в шаблон"
                                          IsChecked="{Binding Section.IncludedState, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          IsThreeState="True"
                                          Style="{StaticResource SabCheckBoxStyle}"
                                          VerticalAlignment="Center"
                                          Margin="0,0,18,0" />
                                <CheckBox Content="Показывать эту группу категорий"
                                          IsChecked="{Binding GroupVisibilityState, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          IsThreeState="True"
                                          Style="{StaticResource SabCheckBoxStyle}"
                                          VerticalAlignment="Center" />
                            </WrapPanel>
                            <TextBlock Grid.Column="1"
                                       Text="Голубая строка — настройки совпадают. Жёлтая — отличаются."
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap"
                                       MaxWidth="390"
                                       Margin="18,0,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource SabFieldHintTextStyle}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsComparisonActive}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1" Margin="0,0,0,12" MinHeight="32">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="96" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Tag="CategorySearchInput"
                                 Style="{StaticResource SabTextBoxStyle}"
                                 ToolTip="Поиск по категориям и подкатегориям" />
                        <Button Grid.Column="2"
                                Content="Найти"
                                Tag="FindCategories"
                                CommandParameter="{Binding}"
                                Style="{StaticResource CompactSearchButtonStyle}" />
                    </Grid>

                    <Border Grid.Row="2" Style="{StaticResource SabDataGridContainerBorderStyle}">
                        <DataGrid ItemsSource="{Binding Rows}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  CanUserReorderColumns="False"
                                  CanUserSortColumns="True"
                                  SelectionMode="Extended"
                                  SelectionUnit="FullRow"
                                  RowHeight="44"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  RowStyle="{StaticResource CategoryDataGridRowStyle}"
                                  Style="{StaticResource SabDataGridStyle}">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Видимость" Width="76">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding VisibilityState, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      IsThreeState="True"
                                                      IsEnabled="{Binding AllowsVisibilityControl}"
                                                      Tag="BatchCategoryVisibility"
                                                      CommandParameter="{Binding}"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Style="{StaticResource SabCheckBoxStyle}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Категория" Width="260">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Width="{Binding NameIndent}" />
                                                <Button Content="{Binding ExpansionGlyph}"
                                                        Tag="ToggleCategory"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource TreeToggleButtonStyle}" />
                                                <TextBlock Text="{Binding HierarchyGuide}"
                                                           Foreground="{DynamicResource SabBrush.TextSecondary}"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,3,0" />
                                                <TextBlock Text="{Binding DisplayName}"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Проекция&#x0a;Линии" Width="*" MinWidth="140">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding Graphics.ProjectionLinesSummary}"
                                                    Tag="EditCategoryProjectionLines"
                                                    CommandParameter="{Binding}"
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Center"
                                                    Style="{StaticResource GraphicsCellButtonStyle}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Проекция&#x0a;Штриховки" Width="*" MinWidth="150">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding Graphics.SurfacePatternsSummary}"
                                                    Tag="EditCategorySurfacePatterns"
                                                    CommandParameter="{Binding}"
                                                    IsEnabled="{Binding SupportsSurfacePatterns}"
                                                    HorizontalAlignment="Stretch"
                                                    Style="{StaticResource GraphicsCellButtonStyle}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Прозрачность" Width="*" MinWidth="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding Graphics.TransparencySummary}"
                                                    Tag="EditCategoryTransparency"
                                                    CommandParameter="{Binding}"
                                                    IsEnabled="{Binding SupportsTransparency}"
                                                    HorizontalAlignment="Stretch"
                                                    Style="{StaticResource GraphicsCellButtonStyle}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Сечение&#x0a;Линии" Width="*" MinWidth="140">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding Graphics.CutLinesSummary}"
                                                    Tag="EditCategoryCutLines"
                                                    CommandParameter="{Binding}"
                                                    IsEnabled="{Binding SupportsCut}"
                                                    HorizontalAlignment="Stretch"
                                                    Style="{StaticResource GraphicsCellButtonStyle}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Сечение&#x0a;Штриховки" Width="*" MinWidth="150">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding Graphics.CutPatternsSummary}"
                                                    Tag="EditCategoryCutPatterns"
                                                    CommandParameter="{Binding}"
                                                    IsEnabled="{Binding SupportsCut}"
                                                    HorizontalAlignment="Stretch"
                                                    Style="{StaticResource GraphicsCellButtonStyle}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Полутона" Width="82">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding Graphics.HalftoneState, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      IsThreeState="True"
                                                      Tag="BatchCategoryHalftone"
                                                      CommandParameter="{Binding}"
                                                      HorizontalAlignment="Center"
                                                      Style="{StaticResource SabCheckBoxStyle}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Детализация" Width="125">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox ItemsSource="{Binding DataContext.GraphicsData.DetailLevels, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      DisplayMemberPath="Name"
                                                      SelectedValuePath="Value"
                                                      SelectedValue="{Binding Graphics.DetailLevelState, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      IsEnabled="{Binding SupportsDetailLevel}"
                                                      Tag="BatchCategoryDetailLevel"
                                                      Style="{StaticResource SabDataGridComboBoxStyle}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Статус" Width="90">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Style="{StaticResource ModifiedStatusStyle}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="White"
                BorderBrush="{DynamicResource SabBrush.BorderWeak}"
                BorderThickness="0,0,0,1"
                Padding="20,15">
                <StackPanel>
                    <TextBlock Text="Пакетное редактирование шаблонов видов"
                               Style="{StaticResource SabWindowTitleTextStyle}" />
                    <TextBlock Text="Переопределение графики и видимости для выбранных шаблонов"
                               Style="{StaticResource SabWindowSubtitleTextStyle}" />
                </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="20,16,20,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="310" MinWidth="270" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" MinWidth="720" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource SabPanelBorderStyle}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="Шаблоны видов" Style="{StaticResource SabPanelHeaderTextStyle}" />
                    </StackPanel>

                    <Grid Grid.Row="1" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="Тип шаблона"
                                   Style="{StaticResource SabFieldLabelTextStyle}"
                                   VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding TemplateTypeOptions}"
                                  DisplayMemberPath="Name"
                                  SelectedValuePath="Value"
                                  SelectedValue="{Binding SelectedTemplateTypeValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Style="{StaticResource SabComboBoxStyle}" />
                    </Grid>

                    <Grid Grid.Row="2" Margin="0,0,0,10" MinHeight="32">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="96" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TemplateSearchTextBox"
                                 Grid.Column="0"
                                 Tag="TemplateSearchInput"
                                 Style="{StaticResource SabTextBoxStyle}"
                                 ToolTip="Поиск по имени или типу шаблона" />
                        <Button x:Name="FindTemplatesButton"
                                Grid.Column="2"
                                Content="Найти"
                                Style="{StaticResource CompactSearchButtonStyle}" />
                    </Grid>

                    <Grid Grid.Row="3" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="SelectAllTemplatesButton"
                                Grid.Column="0"
                                Content="Выбрать все"
                                Padding="8,5"
                                Style="{StaticResource SabOutlineButtonStyle}" />
                        <Button x:Name="ClearTemplatesButton"
                                Grid.Column="2"
                                Content="Снять все"
                                Padding="8,5"
                                Style="{StaticResource SabOutlineButtonStyle}" />
                    </Grid>

                    <ListBox x:Name="TemplatesListBox"
                             Grid.Row="4"
                             ItemsSource="{Binding Templates}"
                             SelectionMode="Extended"
                             Style="{StaticResource TemplateListBoxStyle}"
                             ItemContainerStyle="{StaticResource TemplateListBoxItemStyle}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0"
                                              IsChecked="{Binding IsTarget, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              Tag="BatchTemplateTarget"
                                              Style="{StaticResource SabCheckBoxStyle}"
                                              VerticalAlignment="Center"
                                              ToolTip="Применить изменения к этому шаблону" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Name}"
                                                   Foreground="{DynamicResource SabBrush.Text}"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Name}" />
                                        <TextBlock Text="{Binding ViewTypeName}"
                                                   Style="{StaticResource SabFieldHintTextStyle}"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>
                                    <Border Grid.Column="2"
                                            Background="{DynamicResource SabBrush.Accent}"
                                            CornerRadius="4"
                                            Padding="5,2"
                                            Margin="6,0,0,0"
                                            VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="{x:Type Border}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSource}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="База" Foreground="White" FontSize="11" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource SabPanelBorderStyle}" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="Переопределение графики/видимости"
                                       Style="{StaticResource SabPanelHeaderTextStyle}" />
                            <TextBlock Text="{Binding GraphicsData.SourceTemplateName}"
                                       Style="{StaticResource SabFieldHintTextStyle}"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                    </Grid>

                    <TabControl Grid.Row="1" Style="{StaticResource GraphicsTabControlStyle}">
                        <TabItem Header="Модель" Style="{StaticResource GraphicsTabItemStyle}"
                                 Content="{Binding GraphicsData.ModelCategories}"
                                 ContentTemplate="{StaticResource CategoryTabTemplate}" />
                        <TabItem Header="Аннотации" Style="{StaticResource GraphicsTabItemStyle}"
                                 Content="{Binding GraphicsData.AnnotationCategories}"
                                 ContentTemplate="{StaticResource CategoryTabTemplate}" />
                        <TabItem Header="Аналитика" Style="{StaticResource GraphicsTabItemStyle}"
                                 Content="{Binding GraphicsData.AnalyticalCategories}"
                                 ContentTemplate="{StaticResource CategoryTabTemplate}" />
                        <TabItem Header="Импорт" Style="{StaticResource GraphicsTabItemStyle}"
                                 Content="{Binding GraphicsData.ImportedCategories}"
                                 ContentTemplate="{StaticResource CategoryTabTemplate}" />

                        <TabItem Header="Фильтры" Style="{StaticResource GraphicsTabItemStyle}">
                            <Grid Margin="0,12,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0"
                                        Background="{DynamicResource SabBrush.TableHeaderBackground}"
                                        BorderBrush="{DynamicResource SabBrush.BorderWeak}"
                                        BorderThickness="1"
                                        CornerRadius="5"
                                        Padding="8"
                                        Margin="0,0,0,8">
                                    <WrapPanel Orientation="Horizontal">
                                        <CheckBox Content="Включить в шаблон"
                                                  IsChecked="{Binding GraphicsData.FiltersSection.IncludedState, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  IsThreeState="True"
                                                  Style="{StaticResource SabCheckBoxStyle}"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,14,0" />
                                        <Button x:Name="AddSelectedFiltersButton"
                                                Content="Добавить фильтр…"
                                                Style="{StaticResource SabOutlineButtonStyle}"
                                                Padding="10,5"
                                                Margin="0,0,8,0" />
                                        <Button x:Name="RemoveSelectedFiltersButton"
                                                Content="Удалить из шаблона"
                                                Style="{StaticResource SabOutlineButtonStyle}"
                                                Padding="10,5"
                                                Margin="0,0,8,0" />
                                        <Button x:Name="MoveFilterUpButton"
                                                Content="↑ Выше"
                                                Style="{StaticResource SabOutlineButtonStyle}"
                                                Padding="10,5"
                                                Margin="0,0,8,0" />
                                        <Button x:Name="MoveFilterDownButton"
                                                Content="↓ Ниже"
                                                Style="{StaticResource SabOutlineButtonStyle}"
                                                Padding="10,5" />
                                        <TextBlock Text="Порядок применяется сверху вниз, как в штатном окне Revit."
                                                   Style="{StaticResource SabFieldHintTextStyle}"
                                                   VerticalAlignment="Center"
                                                   Margin="12,0,0,0" />
                                    </WrapPanel>
                                </Border>

                                <Grid Grid.Row="1" Margin="0,0,0,12" MinHeight="32">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="96" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="FiltersSearchTextBox"
                                             Grid.Column="0"
                                             Tag="FilterSearchInput"
                                             Style="{StaticResource SabTextBoxStyle}"
                                             ToolTip="Поиск по фильтрам" />
                                    <Button Grid.Column="2"
                                            Content="Найти"
                                            Tag="FindFilters"
                                            Style="{StaticResource CompactSearchButtonStyle}" />
                                </Grid>

                                <Border Grid.Row="2" Style="{StaticResource SabDataGridContainerBorderStyle}">
                                    <DataGrid x:Name="FiltersDataGrid"
                                              ItemsSource="{Binding GraphicsData.Filters}"
                                              AutoGenerateColumns="False"
                                              CanUserAddRows="False"
                                              CanUserDeleteRows="False"
                                              CanUserReorderColumns="False"
                                              SelectionMode="Extended"
                                              SelectionUnit="FullRow"
                                              RowHeight="44"
                                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                              RowStyle="{StaticResource SearchableDataGridRowStyle}"
                                              Style="{StaticResource SabDataGridStyle}">
                                        <DataGrid.Columns>
                                            <DataGridTemplateColumn Header="Включён" Width="72">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <CheckBox IsChecked="{Binding EnabledState, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                  IsThreeState="True"
                                                                  Tag="BatchFilterEnabled"
                                                                  CommandParameter="{Binding}"
                                                                  HorizontalAlignment="Center"
                                                                  Style="{StaticResource SabCheckBoxStyle}" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="Видимость" Width="82">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <CheckBox IsChecked="{Binding VisibilityState, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                  IsThreeState="True"
                                                                  Tag="BatchFilterVisibility"
                                                                  CommandParameter="{Binding}"
                                                                  HorizontalAlignment="Center"
                                                                  Style="{StaticResource SabCheckBoxStyle}" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="Фильтр" Binding="{Binding Name}" IsReadOnly="True" Width="230" />
                                            <DataGridTemplateColumn Header="Проекция&#x0a;Линии" Width="*" MinWidth="140">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Button Content="{Binding Graphics.ProjectionLinesSummary}"
                                                                Tag="EditFilterProjectionLines"
                                                                CommandParameter="{Binding}"
                                                                IsEnabled="{Binding CanEditGraphics}"
                                                                HorizontalAlignment="Stretch"
                                                                HorizontalContentAlignment="Center"
                                                                Style="{StaticResource GraphicsCellButtonStyle}" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="Проекция&#x0a;Штриховки" Width="*" MinWidth="150">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Button Content="{Binding Graphics.SurfacePatternsSummary}"
                                                                Tag="EditFilterSurfacePatterns"
                                                                CommandParameter="{Binding}"
                                                                IsEnabled="{Binding CanEditGraphics}"
                                                                HorizontalAlignment="Stretch"
                                                                Style="{StaticResource GraphicsCellButtonStyle}" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="Прозрачность" Width="*" MinWidth="120">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Button Content="{Binding Graphics.TransparencySummary}"
                                                                Tag="EditFilterTransparency"
                                                                CommandParameter="{Binding}"
                                                                IsEnabled="{Binding CanEditGraphics}"
                                                                HorizontalAlignment="Stretch"
                                                                Style="{StaticResource GraphicsCellButtonStyle}" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="Сечение&#x0a;Линии" Width="*" MinWidth="140">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Button Content="{Binding Graphics.CutLinesSummary}"
                                                                Tag="EditFilterCutLines"
                                                                CommandParameter="{Binding}"
                                                                IsEnabled="{Binding CanEditGraphics}"
                                                                HorizontalAlignment="Stretch"
                                                                Style="{StaticResource GraphicsCellButtonStyle}" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="Сечение&#x0a;Штриховки" Width="*" MinWidth="150">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Button Content="{Binding Graphics.CutPatternsSummary}"
                                                                Tag="EditFilterCutPatterns"
                                                                CommandParameter="{Binding}"
                                                                IsEnabled="{Binding CanEditGraphics}"
                                                                HorizontalAlignment="Stretch"
                                                                Style="{StaticResource GraphicsCellButtonStyle}" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="Полутона" Width="82">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <CheckBox IsChecked="{Binding Graphics.HalftoneState, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                  IsThreeState="True"
                                                                  Tag="BatchFilterHalftone"
                                                                  CommandParameter="{Binding}"
                                                                  HorizontalAlignment="Center"
                                                                  Style="{StaticResource SabCheckBoxStyle}" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="Статус" Width="90">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding StatusText}"
                                                                   Style="{StaticResource FilterStatusStyle}" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Border>
                            </Grid>
                        </TabItem>

                        <TabItem Header="Рабочие наборы" Style="{StaticResource GraphicsTabItemStyle}">
                            <Grid Margin="0,12,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0"
                                        Background="{DynamicResource SabBrush.TableHeaderBackground}"
                                        BorderBrush="{DynamicResource SabBrush.BorderWeak}"
                                        BorderThickness="1"
                                        CornerRadius="5"
                                        Padding="10"
                                        Margin="0,0,0,8">
                                    <CheckBox Content="Включить настройки рабочих наборов в шаблон"
                                              IsChecked="{Binding GraphicsData.WorksetsSection.IncludedState, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              IsThreeState="True"
                                              Style="{StaticResource SabCheckBoxStyle}" />
                                </Border>
                                <Grid Grid.Row="1" Margin="0,0,0,12" MinHeight="32">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="96" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="WorksetsSearchTextBox"
                                             Grid.Column="0"
                                             Tag="WorksetSearchInput"
                                             Style="{StaticResource SabTextBoxStyle}"
                                             ToolTip="Поиск по рабочим наборам" />
                                    <Button Grid.Column="2"
                                            Content="Найти"
                                            Tag="FindWorksets"
                                            Style="{StaticResource CompactSearchButtonStyle}" />
                                </Grid>
                                <Border Grid.Row="2" Style="{StaticResource SabDataGridContainerBorderStyle}">
                                    <DataGrid ItemsSource="{Binding GraphicsData.Worksets}"
                                              AutoGenerateColumns="False"
                                              CanUserAddRows="False"
                                              CanUserDeleteRows="False"
                                              CanUserReorderColumns="False"
                                              SelectionMode="Extended"
                                              SelectionUnit="FullRow"
                                              RowStyle="{StaticResource SearchableDataGridRowStyle}"
                                              Style="{StaticResource SabDataGridStyle}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Рабочий набор" Binding="{Binding Name}" IsReadOnly="True" Width="400" />
                                            <DataGridTemplateColumn Header="Видимость" Width="*">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <ComboBox ItemsSource="{Binding DataContext.GraphicsData.WorksetVisibilities, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                  DisplayMemberPath="Name"
                                                                  SelectedValuePath="Value"
                                                                  SelectedValue="{Binding VisibilityValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                  Tag="BatchWorksetVisibility"
                                                                  Style="{StaticResource SabDataGridComboBoxStyle}" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="Статус" Width="90">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Style="{StaticResource ModifiedStatusStyle}" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Border>
                                <Border Grid.Row="2"
                                        Background="{DynamicResource SabBrush.AccentLight}"
                                        BorderBrush="{DynamicResource SabBrush.Accent}"
                                        BorderThickness="1"
                                        CornerRadius="5"
                                        Padding="14"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="{x:Type Border}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding GraphicsData.Worksets.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="Документ не является совместно используемым — пользовательские рабочие наборы отсутствуют."
                                               Foreground="{DynamicResource SabBrush.Accent}"
                                               TextWrapping="Wrap" />
                                </Border>
                            </Grid>
                        </TabItem>

                        <TabItem Header="Связанные файлы" Style="{StaticResource GraphicsTabItemStyle}">
                            <Grid Margin="0,12,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0"
                                        Background="{DynamicResource SabBrush.TableHeaderBackground}"
                                        BorderBrush="{DynamicResource SabBrush.BorderWeak}"
                                        BorderThickness="1"
                                        CornerRadius="5"
                                        Padding="10"
                                        Margin="0,0,0,8">
                                    <CheckBox Content="Включить настройки связанных файлов в шаблон"
                                              IsChecked="{Binding GraphicsData.RevitLinksSection.IncludedState, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              IsThreeState="True"
                                              Style="{StaticResource SabCheckBoxStyle}" />
                                </Border>
                                <Border Grid.Row="1"
                                        Background="#FFF8E7"
                                        BorderBrush="{DynamicResource SabBrush.Warning}"
                                        BorderThickness="1"
                                        CornerRadius="5"
                                        Padding="12"
                                        Margin="0,0,0,8">
                                    <Border.Style>
                                        <Style TargetType="{x:Type Border}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding GraphicsData.SupportsRevitLinkOverrides}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <TextBlock Text="Ограничение Revit API 2023"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource SabBrush.Text}" />
                                        <TextBlock Text="В Revit 2023 настройки отдельных связей не опубликованы в API. Общую видимость и графику категории «Связи Revit» можно редактировать на вкладке «Модель». В Revit 2024 эта таблица автоматически становится редактируемой."
                                                   Foreground="{DynamicResource SabBrush.TextSecondary}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Row="1"
                                        Background="{DynamicResource SabBrush.AccentLight}"
                                        BorderBrush="{DynamicResource SabBrush.Accent}"
                                        BorderThickness="1"
                                        CornerRadius="5"
                                        Padding="12"
                                        Margin="0,0,0,8">
                                    <Border.Style>
                                        <Style TargetType="{x:Type Border}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding GraphicsData.SupportsRevitLinkOverrides}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="Revit 2024: API позволяет пакетно менять режим отображения связи и связанный вид. Детальные параметры режима «Пользовательские» Autodesk в API 2024 не публикует; общие переопределения доступны через категорию «Связи Revit» на вкладке «Модель»."
                                               Foreground="{DynamicResource SabBrush.Accent}"
                                               TextWrapping="Wrap" />
                                </Border>
                                <Grid Grid.Row="2" Margin="0,0,0,12" MinHeight="32">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="96" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="RevitLinksSearchTextBox"
                                             Grid.Column="0"
                                             Tag="RevitLinkSearchInput"
                                             Style="{StaticResource SabTextBoxStyle}"
                                             ToolTip="Поиск по связанным файлам и состоянию" />
                                    <Button Grid.Column="2"
                                            Content="Найти"
                                            Tag="FindRevitLinks"
                                            Style="{StaticResource CompactSearchButtonStyle}" />
                                </Grid>
                                <Border Grid.Row="3" Style="{StaticResource SabDataGridContainerBorderStyle}">
                                    <DataGrid ItemsSource="{Binding GraphicsData.RevitLinks}"
                                              AutoGenerateColumns="False"
                                              CanUserAddRows="False"
                                              CanUserDeleteRows="False"
                                              SelectionMode="Extended"
                                              SelectionUnit="FullRow"
                                              RowStyle="{StaticResource SearchableDataGridRowStyle}"
                                              Style="{StaticResource SabDataGridStyle}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Связанный файл" Binding="{Binding DisplayName}" IsReadOnly="True" Width="300" />
                                            <DataGridTextColumn Header="Состояние" Binding="{Binding Status}" IsReadOnly="True" Width="125" />
                                            <DataGridTemplateColumn Header="Отображение" Width="190">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <ComboBox ItemsSource="{Binding DataContext.GraphicsData.RevitLinkVisibilityTypes, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                  DisplayMemberPath="Name"
                                                                  SelectedValuePath="Value"
                                                                  SelectedValue="{Binding VisibilityTypeName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                  IsEnabled="{Binding IsApiSupported}"
                                                                  Tag="BatchLinkVisibilityType"
                                                                  Style="{StaticResource SabDataGridComboBoxStyle}" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="Связанный вид" Width="*">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <ComboBox ItemsSource="{Binding LinkedViews}"
                                                                  DisplayMemberPath="Name"
                                                                  SelectedValuePath="IdValue"
                                                                  SelectedValue="{Binding LinkedViewIdValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                  IsEnabled="{Binding CanSelectLinkedView}"
                                                                  Tag="BatchLinkView"
                                                                  Style="{StaticResource SabDataGridComboBoxStyle}" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="Статус" Width="90">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Style="{StaticResource ModifiedStatusStyle}" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Border>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2"
                Background="White"
                BorderBrush="{DynamicResource SabBrush.BorderWeak}"
                BorderThickness="0,1,0,0"
                Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource SabValidationPanelStyle}" Margin="0" Padding="10,7">
                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource SabStatusTextStyle}" />
                </Border>
                <Button x:Name="CancelButton"
                        Grid.Column="1"
                        Content="Закрыть"
                        MinWidth="110"
                        Padding="16,8"
                        Style="{StaticResource SabOutlineButtonStyle}" />
                <Button x:Name="ApplyButton"
                        Grid.Column="3"
                        Content="Применить"
                        MinWidth="150"
                        Padding="18,8"
                        IsEnabled="{Binding CanApply}"
                        Style="{StaticResource SabPrimaryButtonStyle}" />
            </Grid>
        </Border>
    </Grid>
</Window>
