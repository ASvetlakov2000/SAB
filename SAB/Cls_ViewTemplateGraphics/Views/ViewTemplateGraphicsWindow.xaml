                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Тип шаблона" Style="{StaticResource SabFieldLabelTextStyle}" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1" ItemsSource="{Binding TemplateTypeOptions}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding SelectedTemplateTypeValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SabComboBoxStyle}" />
                    </Grid>
                    <Grid Grid.Row="2" Margin="0,0,0,10" MinHeight="32">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="58" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="96" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TemplateSearchTextBox" Grid.Column="1" Tag="TemplateSearchInput" Style="{StaticResource SabTextBoxStyle}" ToolTip="Поиск по имени или типу шаблона" MinHeight="34" />
                        <Button x:Name="FindTemplatesButton" Grid.Column="3" Content="Найти" Style="{StaticResource CompactSearchButtonStyle}" />
                        <TextBlock Text="Поиск" VerticalAlignment="Center" Foreground="{DynamicResource SabBrush.TextSecondary}" />
                    </Grid>
                    <Grid Grid.Row="3" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="SelectAllTemplatesButton" Grid.Column="0" Content="Выбрать все" Padding="8,5" Style="{StaticResource SabOutlineButtonStyle}" />
                        <Button x:Name="ClearTemplatesButton" Grid.Column="2" Content="Снять все" Padding="8,5" Style="{StaticResource SabOutlineButtonStyle}" />
                    </Grid>
                    <Border Style="{StaticResource SabDataGridContainerBorderStyle}" Grid.Row="4">
                        <ListBox x:Name="TemplatesListBox" ItemsSource="{Binding Templates}" SelectionMode="Extended" Style="{StaticResource TemplateListBoxStyle}" ItemContainerStyle="{StaticResource TemplateListBoxItemStyle}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsTarget, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Tag="BatchTemplateTarget" Style="{StaticResource SabCheckBoxStyle}" VerticalAlignment="Center" ToolTip="Применить изменения к этому шаблону" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Name}" Foreground="{DynamicResource SabBrush.Text}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                            <TextBlock Text="{Binding ViewTypeName}" Style="{StaticResource SabFieldHintTextStyle}" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <Border Grid.Column="2" Background="{DynamicResource SabBrush.Accent}" CornerRadius="4" Padding="5,2" Margin="6,0,0,0" VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="{x:Type Border}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSource}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="База" Foreground="White" FontSize="11" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Grid>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource SabPanelBorderStyle}" Padding="16" x:Name="SettingsCard">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TabControl x:Name="GraphicsTabControl" Grid.Row="0" Style="{StaticResource GraphicsTabControlStyle}">
                        <TabItem Header="Свойства вида" Style="{StaticResource GraphicsTabItemStyle}">
                            <Grid Margin="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,8">
                                    <TextBlock Text="Число видов, которым назначен этот шаблон: " Foreground="{DynamicResource SabBrush.Text}" />
                                    <TextBlock Text="{Binding GraphicsData.AssignedViewCount}" FontWeight="Bold" Foreground="{DynamicResource SabBrush.Text}" />
                                </StackPanel>
                                <Border Grid.Row="1" Style="{StaticResource SabDataGridContainerBorderStyle}">
                                    <DataGrid ItemsSource="{Binding GraphicsData.ViewProperties}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False" CanUserSortColumns="False" SelectionMode="Single" SelectionUnit="FullRow" RowHeight="44" ScrollViewer.HorizontalScrollBarVisibility="Disabled" RowStyle="{StaticResource ViewPropertyDataGridRowStyle}" Style="{StaticResource SabDataGridStyle}" ColumnHeaderHeight="38">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Параметр" Binding="{Binding Name}" Width="290" IsReadOnly="True" ElementStyle="{StaticResource SabDataGridTextBlockStyle}" MinWidth="290" />
                                            <DataGridTemplateColumn Header="Значение" Width="*">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0">
                                                            <TextBox Text="{Binding ValueText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsValueReadOnly}" ToolTip="{Binding ValueText}">
                                                                <TextBox.Style>
