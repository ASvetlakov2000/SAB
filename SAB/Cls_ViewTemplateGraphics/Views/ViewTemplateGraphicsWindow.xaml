<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:ns1="clr-namespace:SAB.ViewTemplateGraphics.Views;assembly=SAB" xmlns:ns3="clr-namespace:SAB.UI.FluentLight;assembly=SAB" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="SAB Пакетное редактирование шаблонов видов" Width="1780" Height="940" MinWidth="1240" MinHeight="760" WindowStartupLocation="CenterScreen" ResizeMode="CanResizeWithGrip" ShowInTaskbar="False" FontFamily="Segoe UI" FontSize="13" Background="{DynamicResource SabBrush.WindowBackground}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../UI/Styles/SABFluentLight.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <ns1:SearchActiveConverter x:Key="TreeSearchActive" />
            <BooleanToVisibilityConverter x:Key="CategoryCapabilityVisibility" />
            <Style x:Key="TemplateListBoxStyle" TargetType="{x:Type ListBox}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
                <Setter Property="BorderBrush" Value="{DynamicResource SabBrush.Border}" />
            </Style>
            <Style x:Key="TemplateListBoxItemStyle" TargetType="{x:Type ListBoxItem}">
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0,0,0,4" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ListBoxItem}">
                            <Border x:Name="ItemBorder" Padding="10,6" CornerRadius="5" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource SabBrush.BorderWeak}" BorderThickness="0">
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SabBrush.AccentLight}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SabBrush.AccentLight}" />
                                    <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource SabBrush.Accent}" />
                                </Trigger>
                                <DataTrigger Binding="{Binding IsVisibleInList}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="GraphicsTabControlStyle" TargetType="{x:Type TabControl}" BasedOn="{StaticResource SabWrappingTabControlStyle}">
                </Style>
            <Style x:Key="GraphicsTabItemStyle" TargetType="{x:Type TabItem}" BasedOn="{StaticResource {x:Type TabItem}}" />
            <Style x:Key="CompactSearchButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource SabOutlineButtonStyle}">
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="34" />
                <Setter Property="Padding" Value="10,0" />
            </Style>
            <Style x:Key="GraphicsCellButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource SabOutlineButtonStyle}">
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="34" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="Padding" Value="10,0" />
                <Setter Property="Height" Value="Auto" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="HorizontalAlignment" Value="Left" />
            </Style>
            <Style x:Key="TreeToggleButtonStyle" TargetType="{x:Type Button}">
                <Setter Property="Width" Value="28" />
                <Setter Property="Height" Value="28" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0,0,4,0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="{DynamicResource SabBrush.Accent}" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border x:Name="ToggleBackground" Background="{TemplateBinding Background}" CornerRadius="3">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ToggleBackground" Property="Background" Value="{DynamicResource SabBrush.AccentLight}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Opacity" Value="0.7" />
                                </Trigger>
                                <DataTrigger Binding="{Binding HasChildren}" Value="False">
                                    <Setter Property="Visibility" Value="Hidden" />
                                </DataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="ModifiedStatusStyle" TargetType="{x:Type TextBlock}">
                <Setter Property="Text" Value="" />
                <Setter Property="Foreground" Value="{DynamicResource SabBrush.Accent}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsModified}" Value="True">
                        <Setter Property="Text" Value="Изменено" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="FilterStatusStyle" TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="{DynamicResource SabBrush.Accent}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="CategoryDataGridRowStyle" TargetType="{x:Type DataGridRow}" BasedOn="{StaticResource SabDataGridRowStyle}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsVisibleInTree}" Value="False">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding HasChildren}" Value="True">
                        <Setter Property="FontWeight" Value="SemiBold" />
                    </DataTrigger>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding IsComparisonActive}" Value="True" />
                            <Condition Binding="{Binding HasMixedTemplateValues}" Value="False" />
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Background" Value="#EEF6FF" />
                    </MultiDataTrigger>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding IsComparisonActive}" Value="True" />
                            <Condition Binding="{Binding HasMixedTemplateValues}" Value="True" />
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Background" Value="#FFF4D6" />
                    </MultiDataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="SearchableDataGridRowStyle" TargetType="{x:Type DataGridRow}" BasedOn="{StaticResource SabDataGridRowStyle}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsVisibleInList}" Value="False">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="ViewPropertyDataGridRowStyle" TargetType="{x:Type DataGridRow}" BasedOn="{StaticResource SearchableDataGridRowStyle}" />
            <DataTemplate x:Key="CategoryTabTemplate">
                <Grid Margin="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="{DynamicResource SabBrush.TableHeaderBackground}" BorderBrush="{DynamicResource SabBrush.BorderWeak}" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                                <CheckBox Content="Включить в шаблон" IsChecked="{Binding Section.IncludedState, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsThreeState="True" Style="{StaticResource SabCheckBoxStyle}" VerticalAlignment="Center" Margin="0,0,18,0" />
                                <CheckBox Content="Показывать эту группу категорий" IsChecked="{Binding GroupVisibilityState, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsThreeState="True" Style="{StaticResource SabCheckBoxStyle}" VerticalAlignment="Center" />
                            </WrapPanel>
                        </Grid>
                    </Border>
                    <Grid Grid.Row="1" Margin="0,0,0,12" MinHeight="32">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="58" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="96" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="1" Tag="CategorySearchInput" Style="{StaticResource SabTextBoxStyle}" ToolTip="Поиск по категориям и подкатегориям" MinHeight="34" />
                        <Button Grid.Column="3" Content="Найти" Tag="FindCategories" CommandParameter="{Binding}" Style="{StaticResource CompactSearchButtonStyle}" />
                        <TextBlock Text="Поиск" VerticalAlignment="Center" Foreground="{DynamicResource SabBrush.TextSecondary}" />
                    </Grid>
                    <Border Grid.Row="2" Style="{StaticResource SabDataGridContainerBorderStyle}">
                        <DataGrid ItemsSource="{Binding Rows}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False" CanUserSortColumns="True" SelectionMode="Extended" SelectionUnit="FullRow" RowHeight="44" ScrollViewer.HorizontalScrollBarVisibility="Auto" RowStyle="{StaticResource CategoryDataGridRowStyle}" Style="{StaticResource SabDataGridStyle}" ColumnHeaderHeight="38" ns1:CategoryPresentation.Enabled="True">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Видимость" Width="100" HeaderStyle="{StaticResource SabCenteredHeaderStyle}" MinWidth="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding VisibilityState, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsThreeState="True" IsEnabled="{Binding AllowsVisibilityControl}" Tag="BatchCategoryVisibility" CommandParameter="{Binding}" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource SabCheckBoxStyle}" Visibility="{Binding AllowsVisibilityControl, Converter={StaticResource CategoryCapabilityVisibility}}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Категория" Width="*" MinWidth="250">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <ns1:TreeGuides HorizontalAlignment="Stretch" IsHitTestVisible="False" Margin="10,0,0,0" />
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,6,0">
                                                    <Border Width="{Binding NameIndent}" />
                                                    <Button Content="{Binding ExpansionGlyph}" Tag="ToggleCategory" CommandParameter="{Binding}" Style="{StaticResource TreeToggleButtonStyle}">
                                                        <Button.ContentTemplate>
                                                            <DataTemplate>
                                                                <Path Data="M 3,1 L 8,6 L 3,11" Stroke="{DynamicResource SabBrush.TextSecondary}" StrokeThickness="1.5" Width="12" Height="12" Stretch="None" RenderTransformOrigin="0.5,0.5">
                                                                    <Path.Style>
                                                                        <Style TargetType="{x:Type Path}">
                                                                            <Setter Property="RenderTransform">
                                                                                <Setter.Value>
                                                                                    <RotateTransform Angle="0" />
                                                                                </Setter.Value>
                                                                            </Setter>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding DataContext.IsExpanded, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" Value="True">
                                                                                    <Setter Property="RenderTransform">
                                                                                        <Setter.Value>
                                                                                            <RotateTransform Angle="90" />
                                                                                        </Setter.Value>
                                                                                    </Setter>
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding DataContext.SearchText, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}, Converter={StaticResource TreeSearchActive}}" Value="True">
                                                                                    <Setter Property="RenderTransform">
                                                                                        <Setter.Value>
                                                                                            <RotateTransform Angle="90" />
                                                                                        </Setter.Value>
                                                                                    </Setter>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Path.Style>
                                                                </Path>
                                                            </DataTemplate>
                                                        </Button.ContentTemplate>
                                                    </Button>
                                                    <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Проекция&#10;Линии" Width="*" MinWidth="118">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding Graphics.ProjectionLinesSummary}" Tag="EditCategoryProjectionLines" CommandParameter="{Binding}" Style="{StaticResource GraphicsCellButtonStyle}" Visibility="{Binding SupportsProjectionLines, Converter={StaticResource CategoryCapabilityVisibility}}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Проекция&#10;Штриховки" Width="*" MinWidth="128">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding Graphics.SurfacePatternsSummary}" Tag="EditCategorySurfacePatterns" CommandParameter="{Binding}" IsEnabled="{Binding SupportsSurfacePatterns}" Style="{StaticResource GraphicsCellButtonStyle}" Visibility="{Binding SupportsSurfacePatterns, Converter={StaticResource CategoryCapabilityVisibility}}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Прозрачность" Width="*" MinWidth="116">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding Graphics.TransparencySummary}" Tag="EditCategoryTransparency" CommandParameter="{Binding}" IsEnabled="{Binding SupportsTransparency}" Style="{StaticResource GraphicsCellButtonStyle}" Visibility="{Binding SupportsTransparency, Converter={StaticResource CategoryCapabilityVisibility}}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Сечение&#10;Линии" Width="*" MinWidth="118">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding Graphics.CutLinesSummary}" Tag="EditCategoryCutLines" CommandParameter="{Binding}" IsEnabled="{Binding SupportsCut}" Style="{StaticResource GraphicsCellButtonStyle}" Visibility="{Binding SupportsCut, Converter={StaticResource CategoryCapabilityVisibility}}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Сечение&#10;Штриховки" Width="*" MinWidth="128">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding Graphics.CutPatternsSummary}" Tag="EditCategoryCutPatterns" CommandParameter="{Binding}" IsEnabled="{Binding SupportsCut}" Style="{StaticResource GraphicsCellButtonStyle}" Visibility="{Binding SupportsCut, Converter={StaticResource CategoryCapabilityVisibility}}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Полутона" Width="94" HeaderStyle="{StaticResource SabCenteredHeaderStyle}" MinWidth="94">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding Graphics.HalftoneState, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsThreeState="True" Tag="BatchCategoryHalftone" CommandParameter="{Binding}" HorizontalAlignment="Center" Style="{StaticResource SabCheckBoxStyle}" Visibility="{Binding SupportsHalftone, Converter={StaticResource CategoryCapabilityVisibility}}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Детализация" Width="130" MinWidth="130">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox ItemsSource="{Binding DataContext.GraphicsData.DetailLevels, RelativeSource={RelativeSource AncestorType=Window}}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding Graphics.DetailLevelState, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding SupportsDetailLevel}" Tag="BatchCategoryDetailLevel" Style="{StaticResource SabDataGridComboBoxStyle}" Visibility="{Binding SupportsDetailLevel, Converter={StaticResource CategoryCapabilityVisibility}}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Статус" Width="96" HeaderStyle="{StaticResource SabCenteredHeaderStyle}" MinWidth="96">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Style="{StaticResource ModifiedStatusStyle}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Background="{DynamicResource SabBrush.WindowBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="White" BorderBrush="{DynamicResource SabBrush.BorderWeak}" BorderThickness="0,0,0,1" Padding="24,14">
            <Grid>
                <StackPanel>
                    <TextBlock Text="Редактор шаблонов" Style="{StaticResource SabWindowTitleTextStyle}" />
                    <TextBlock Text="" Style="{StaticResource SabWindowSubtitleTextStyle}" />
                </StackPanel>
                <TextBlock Text="{Binding GraphicsData.SourceTemplateName}" TextTrimming="CharacterEllipsis" MaxWidth="600" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource SabBrush.TextSecondary}" />
            </Grid>
        </Border>
        <Grid Grid.Row="1" Margin="24,16,24,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="345.6" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource SabPanelBorderStyle}" Padding="16" x:Name="TemplateCard">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="Шаблоны видов" Style="{StaticResource SabPanelHeaderTextStyle}" />
                    </StackPanel>
                    <Grid Grid.Row="1" Margin="0,0,0,8">
