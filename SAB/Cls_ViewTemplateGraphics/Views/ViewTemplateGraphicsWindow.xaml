                                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding IsNavigationRow}" Value="True">
                                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBox.Style>
                                                            </TextBox>
                                                            <ComboBox ItemsSource="{Binding ElementOptions}" DisplayMemberPath="Name" SelectedValuePath="IdValue" SelectedValue="{Binding SelectedElementIdValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditValue}" ToolTip="{Binding ValueText}">
                                                                <ComboBox.Style>
                                                                    <Style TargetType="{x:Type ComboBox}" BasedOn="{StaticResource SabDataGridComboBoxStyle}">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                        <Setter Property="MinHeight" Value="34" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsElementIdValue}" Value="True">
                                                                                <Setter Property="Visibility" Value="Visible" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </ComboBox.Style>
                                                            </ComboBox>
                                                            <ComboBox ItemsSource="{Binding ValueOptions}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding ValueText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditValue}">
                                                                <ComboBox.Style>
                                                                    <Style TargetType="{x:Type ComboBox}" BasedOn="{StaticResource SabDataGridComboBoxStyle}">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                        <Setter Property="MinHeight" Value="34" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding UsesValueOptions}" Value="True">
                                                                                <Setter Property="Visibility" Value="Visible" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </ComboBox.Style>
                                                            </ComboBox>
                                                            <Button Content="{Binding ValueText}" Tag="OpenViewPropertyEditor" CommandParameter="{Binding}" Padding="6,0" MinHeight="34" BorderBrush="Transparent" Background="Transparent" HorizontalContentAlignment="Left" HorizontalAlignment="Left">
                                                                <Button.Style>
                                                                    <Style TargetType="{x:Type Button}" BasedOn="{StaticResource SabOutlineButtonStyle}">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                        <Setter Property="MinHeight" Value="34" />
                                                                        <Setter Property="Padding" Value="6,0" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsNavigationRow}" Value="True">
                                                                                <Setter Property="Visibility" Value="Visible" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Button.Style>
                                                            </Button>
                                                        </Grid>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="Включить" Width="90" HeaderStyle="{StaticResource SabCenteredHeaderStyle}" MinWidth="90">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <CheckBox IsChecked="{Binding IncludeState.IncludedState, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsThreeState="True" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="Управлять этим параметром через шаблон">
                                                            <CheckBox.Style>
                                                                <Style TargetType="{x:Type CheckBox}" BasedOn="{StaticResource SabCheckBoxStyle}">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding ShowIncludeToggle}" Value="False">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </CheckBox.Style>
                                                        </CheckBox>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Border>
                            </Grid>
                        </TabItem>
                        <TabItem Header="Модель" Style="{StaticResource GraphicsTabItemStyle}" Content="{Binding GraphicsData.ModelCategories}" ContentTemplate="{StaticResource CategoryTabTemplate}" />
                        <TabItem Header="Аннотации" Style="{StaticResource GraphicsTabItemStyle}" Content="{Binding GraphicsData.AnnotationCategories}" ContentTemplate="{StaticResource CategoryTabTemplate}" />
                        <TabItem Header="Аналитика" Style="{StaticResource GraphicsTabItemStyle}" Content="{Binding GraphicsData.AnalyticalCategories}" ContentTemplate="{StaticResource CategoryTabTemplate}" />
                        <TabItem Header="Импорт" Style="{StaticResource GraphicsTabItemStyle}" Content="{Binding GraphicsData.ImportedCategories}" ContentTemplate="{StaticResource CategoryTabTemplate}" />
                        <TabItem Header="Фильтры" Style="{StaticResource GraphicsTabItemStyle}">
                            <Grid Margin="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Background="{DynamicResource SabBrush.TableHeaderBackground}" BorderBrush="{DynamicResource SabBrush.BorderWeak}" BorderThickness="1" CornerRadius="5" Padding="8" Margin="0,0,0,8">
                                    <WrapPanel Orientation="Horizontal">
                                        <CheckBox Content="Включить в шаблон" IsChecked="{Binding GraphicsData.FiltersSection.IncludedState, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsThreeState="True" Style="{StaticResource SabCheckBoxStyle}" VerticalAlignment="Center" Margin="0,0,14,0" />
                                        <Button x:Name="AddSelectedFiltersButton" Content="Добавить фильтр…" Style="{StaticResource SabOutlineButtonStyle}" Padding="10,5" Margin="0,0,8,0" />
                                        <Button x:Name="RemoveSelectedFiltersButton" Content="Удалить из шаблона" Style="{StaticResource SabOutlineButtonStyle}" Padding="10,5" Margin="0,0,8,0" />
                                        <Button x:Name="MoveFilterUpButton" Content="↑ Выше" Style="{StaticResource SabOutlineButtonStyle}" Padding="10,5" Margin="0,0,8,0" />
                                        <Button x:Name="MoveFilterDownButton" Content="↓ Ниже" Style="{StaticResource SabOutlineButtonStyle}" Padding="10,5" />
                                    </WrapPanel>
                                </Border>
                                <Grid Grid.Row="1" Margin="0,0,0,12" MinHeight="32">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="58" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="96" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="FiltersSearchTextBox" Grid.Column="1" Tag="FilterSearchInput" Style="{StaticResource SabTextBoxStyle}" ToolTip="Поиск по фильтрам" MinHeight="34" />
                                    <Button Grid.Column="3" Content="Найти" Tag="FindFilters" Style="{StaticResource CompactSearchButtonStyle}" />
                                    <TextBlock Text="Поиск" VerticalAlignment="Center" Foreground="{DynamicResource SabBrush.TextSecondary}" />
                                </Grid>
                                <Border Grid.Row="2" Style="{StaticResource SabDataGridContainerBorderStyle}">
                                    <DataGrid x:Name="FiltersDataGrid" ItemsSource="{Binding GraphicsData.Filters}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False" SelectionMode="Extended" SelectionUnit="FullRow" RowHeight="44" ScrollViewer.HorizontalScrollBarVisibility="Auto" RowStyle="{StaticResource SearchableDataGridRowStyle}" Style="{StaticResource SabDataGridStyle}" ColumnHeaderHeight="38">
                                        <DataGrid.Columns>
                                            <DataGridTemplateColumn Header="Включён" Width="90" HeaderStyle="{StaticResource SabCenteredHeaderStyle}" MinWidth="90">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <CheckBox IsChecked="{Binding EnabledState, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsThreeState="True" Tag="BatchFilterEnabled" CommandParameter="{Binding}" HorizontalAlignment="Center" Style="{StaticResource SabCheckBoxStyle}" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="Видимость" Width="100" HeaderStyle="{StaticResource SabCenteredHeaderStyle}" MinWidth="100">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <CheckBox IsChecked="{Binding VisibilityState, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsThreeState="True" Tag="BatchFilterVisibility" CommandParameter="{Binding}" HorizontalAlignment="Center" Style="{StaticResource SabCheckBoxStyle}" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="Фильтр" Binding="{Binding Name}" IsReadOnly="True" Width="230" ElementStyle="{StaticResource SabDataGridTextBlockStyle}" MinWidth="230" />
                                            <DataGridTemplateColumn Header="Проекция&#10;Линии" Width="*" MinWidth="118">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Button Content="{Binding Graphics.ProjectionLinesSummary}" Tag="EditFilterProjectionLines" CommandParameter="{Binding}" IsEnabled="{Binding CanEditGraphics}" Style="{StaticResource GraphicsCellButtonStyle}" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="Проекция&#10;Штриховки" Width="*" MinWidth="128">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Button Content="{Binding Graphics.SurfacePatternsSummary}" Tag="EditFilterSurfacePatterns" CommandParameter="{Binding}" IsEnabled="{Binding CanEditGraphics}" Style="{StaticResource GraphicsCellButtonStyle}" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="Прозрачность" Width="*" MinWidth="116">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Button Content="{Binding Graphics.TransparencySummary}" Tag="EditFilterTransparency" CommandParameter="{Binding}" IsEnabled="{Binding CanEditGraphics}" Style="{StaticResource GraphicsCellButtonStyle}" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="Сечение&#10;Линии" Width="*" MinWidth="118">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Button Content="{Binding Graphics.CutLinesSummary}" Tag="EditFilterCutLines" CommandParameter="{Binding}" IsEnabled="{Binding CanEditGraphics}" Style="{StaticResource GraphicsCellButtonStyle}" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="Сечение&#10;Штриховки" Width="*" MinWidth="128">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Button Content="{Binding Graphics.CutPatternsSummary}" Tag="EditFilterCutPatterns" CommandParameter="{Binding}" IsEnabled="{Binding CanEditGraphics}" Style="{StaticResource GraphicsCellButtonStyle}" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="Полутона" Width="94" HeaderStyle="{StaticResource SabCenteredHeaderStyle}" MinWidth="94">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <CheckBox IsChecked="{Binding Graphics.HalftoneState, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsThreeState="True" Tag="BatchFilterHalftone" CommandParameter="{Binding}" HorizontalAlignment="Center" Style="{StaticResource SabCheckBoxStyle}" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="Статус" Width="96" HeaderStyle="{StaticResource SabCenteredHeaderStyle}" MinWidth="96">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource FilterStatusStyle}" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Border>
                            </Grid>
                        </TabItem>
                        <TabItem Header="Рабочие наборы" Style="{StaticResource GraphicsTabItemStyle}">
                            <Grid Margin="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Background="{DynamicResource SabBrush.TableHeaderBackground}" BorderBrush="{DynamicResource SabBrush.BorderWeak}" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,8">
                                    <CheckBox Content="Включить настройки рабочих наборов в шаблон" IsChecked="{Binding GraphicsData.WorksetsSection.IncludedState, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsThreeState="True" Style="{StaticResource SabCheckBoxStyle}" />
                                </Border>
                                <Grid Grid.Row="1" Margin="0,0,0,12" MinHeight="32">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="58" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="96" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="WorksetsSearchTextBox" Grid.Column="1" Tag="WorksetSearchInput" Style="{StaticResource SabTextBoxStyle}" ToolTip="Поиск по рабочим наборам" MinHeight="34" />
                                    <Button Grid.Column="3" Content="Найти" Tag="FindWorksets" Style="{StaticResource CompactSearchButtonStyle}" />
                                    <TextBlock Text="Поиск" VerticalAlignment="Center" Foreground="{DynamicResource SabBrush.TextSecondary}" />
                                </Grid>
                                <Border Grid.Row="2" Style="{StaticResource SabDataGridContainerBorderStyle}">
                                    <DataGrid ItemsSource="{Binding GraphicsData.Worksets}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False" SelectionMode="Extended" SelectionUnit="FullRow" RowStyle="{StaticResource SearchableDataGridRowStyle}" Style="{StaticResource SabDataGridStyle}" ColumnHeaderHeight="38" RowHeight="44">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Рабочий набор" Binding="{Binding Name}" IsReadOnly="True" Width="*" ElementStyle="{StaticResource SabDataGridTextBlockStyle}" MinWidth="240" />
                                            <DataGridTemplateColumn Header="Видимость" Width="*" MinWidth="240">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <ComboBox ItemsSource="{Binding DataContext.GraphicsData.WorksetVisibilities, RelativeSource={RelativeSource AncestorType=DataGrid}}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding VisibilityValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Tag="BatchWorksetVisibility" Style="{StaticResource SabDataGridComboBoxStyle}" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="Статус" Width="96" HeaderStyle="{StaticResource SabCenteredHeaderStyle}" MinWidth="96">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Style="{StaticResource ModifiedStatusStyle}" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Border>
                                <Border Grid.Row="2" Background="{DynamicResource SabBrush.AccentLight}" BorderBrush="{DynamicResource SabBrush.Accent}" BorderThickness="1" CornerRadius="5" Padding="14" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="{x:Type Border}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding GraphicsData.Worksets.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="Документ не является совместно используемым — пользовательские рабочие наборы отсутствуют." Foreground="{DynamicResource SabBrush.Accent}" TextWrapping="Wrap" />
                                </Border>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Border>
        </Grid>
        <Border Grid.Row="2" Background="White" BorderBrush="{DynamicResource SabBrush.BorderWeak}" BorderThickness="0" Padding="24,12,24,12" x:Name="TemplateEditorFooter">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border Style="{StaticResource SabFooterStatusPanelStyle}" Margin="0,0,0,12" x:Name="SelectionStatusBorder">
                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource SabFooterStatusTextStyle}" x:Name="SelectionStatusText" />
                </Border>
                <Grid Grid.Row="2">
                    <Button Content="Инструкция" HorizontalAlignment="Left" MinHeight="34" x:Name="InstructionButton" ns3:Instructions.File="SAB_HTML_Redaktor_shablonov.html" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="CancelButton" Content="Закрыть" MinWidth="110" Padding="16,8" Style="{StaticResource SabOutlineButtonStyle}" Margin="8,0,0,0" MinHeight="34" IsCancel="True" />
                        <Button x:Name="ApplyButton" Content="Применить" MinWidth="150" Padding="18,8" IsEnabled="{Binding CanApply}" Style="{StaticResource SabPrimaryButtonStyle}" Margin="8,0,0,0" MinHeight="34" IsDefault="True" />
                    </StackPanel>
                </Grid>
            <TextBlock Grid.Row="1" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,12" Foreground="{DynamicResource SabBrush.Error}" x:Name="TemplateEditorValidation" /></Grid>
        </Border>
    </Grid>
</Window>
