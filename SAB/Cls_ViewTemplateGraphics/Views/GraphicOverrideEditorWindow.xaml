<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Переопределение графики"
        Width="760"
        Height="520"
        MinWidth="680"
        MinHeight="340"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        FontFamily="Segoe UI"
        FontSize="13"
        Background="{DynamicResource SabBrush.WindowBackground}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../UI/Styles/SABWindowStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="EditorSectionTitleStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource SabPanelHeaderTextStyle}">
                <Setter Property="Margin" Value="0,0,0,10" />
            </Style>

            <Style x:Key="EditorFieldGridStyle" TargetType="{x:Type Grid}">
                <Setter Property="Margin" Value="0,0,0,9" />
            </Style>

            <Style x:Key="EditorValueButtonStyle"
                   TargetType="{x:Type Button}"
                   BasedOn="{StaticResource SabOutlineButtonStyle}">
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Height" Value="32" />
                <Setter Property="Padding" Value="8,0" />
            </Style>

            <Style x:Key="EditorResetButtonStyle"
                   TargetType="{x:Type Button}"
                   BasedOn="{StaticResource SabNeutralButtonStyle}">
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Height" Value="32" />
                <Setter Property="Padding" Value="8,0" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="White"
                BorderBrush="{DynamicResource SabBrush.BorderWeak}"
                BorderThickness="0,0,0,1"
                Padding="18,14">
            <StackPanel>
                <TextBlock Text="{Binding EditorTitle}" Style="{StaticResource SabWindowTitleTextStyle}" />
                <TextBlock Text="Пустое значение означает использование настроек стилей объектов."
                           Style="{StaticResource SabWindowSubtitleTextStyle}" />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="18,14">
            <StackPanel>
                <Border Background="{DynamicResource SabBrush.AccentLight}"
                        BorderBrush="{DynamicResource SabBrush.Accent}"
                        BorderThickness="1"
                        CornerRadius="5"
                        Padding="12"
                        Margin="0,0,0,10">
                    <Border.Style>
                        <Style TargetType="{x:Type Border}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Data.HasMixedValues}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="В выделенных строках есть разные значения. Будут изменены только поля, которые вы явно отредактируете."
                               Foreground="{DynamicResource SabBrush.Accent}"
                               TextWrapping="Wrap" />
                </Border>

                <Border x:Name="ProjectionLinesPanel" Style="{StaticResource SabPanelBorderStyle}" Padding="14" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="Линии проекции/поверхности" Style="{StaticResource EditorSectionTitleStyle}" />

                        <Grid Style="{StaticResource EditorFieldGridStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="210" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Вес линии" Style="{StaticResource SabFieldLabelTextStyle}" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding LineWeights}"
                                      DisplayMemberPath="Name"
                                      SelectedValuePath="Value"
                                      SelectedValue="{Binding Data.ProjectionLineWeightState, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Style="{StaticResource SabComboBoxStyle}" />
                        </Grid>

                        <Grid Style="{StaticResource EditorFieldGridStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="210" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="96" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Цвет линии" Style="{StaticResource SabFieldLabelTextStyle}" VerticalAlignment="Center" />
                            <Button Grid.Column="1"
                                    Content="{Binding Data.ProjectionLineColorText}"
                                    Tag="PickColor"
                                    CommandParameter="ProjectionLineColorValue"
                                    HorizontalContentAlignment="Left"
                                    Style="{StaticResource EditorValueButtonStyle}" />
                            <Button Grid.Column="3"
                                    Content="Сбросить"
                                    Tag="ClearColor"
                                    CommandParameter="ProjectionLineColorValue"
                                    Style="{StaticResource EditorResetButtonStyle}" />
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="210" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Образец линии" Style="{StaticResource SabFieldLabelTextStyle}" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding LinePatterns}"
                                      DisplayMemberPath="Name"
                                      SelectedValuePath="IdValue"
                                      SelectedValue="{Binding Data.ProjectionLinePatternIdState, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Style="{StaticResource SabComboBoxStyle}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border x:Name="SurfacePanel" Style="{StaticResource SabPanelBorderStyle}" Padding="14" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="Образцы поверхности" Style="{StaticResource EditorSectionTitleStyle}" />

                        <Border Background="{DynamicResource SabBrush.TableHeaderBackground}"
                                BorderBrush="{DynamicResource SabBrush.BorderWeak}"
                                BorderThickness="1"
                                CornerRadius="5"
                                Padding="10"
                                Margin="0,0,0,10">
                            <StackPanel>
                                <CheckBox Content="Показывать передний план"
                                          IsChecked="{Binding Data.SurfaceForegroundPatternVisibleState, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          IsThreeState="True"
                                          Style="{StaticResource SabCheckBoxStyle}"
                                          Margin="0,0,0,9" />
                                <Grid Style="{StaticResource EditorFieldGridStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="190" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Образец" Style="{StaticResource SabFieldLabelTextStyle}" VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="1"
                                              ItemsSource="{Binding FillPatterns}"
                                              DisplayMemberPath="Name"
                                              SelectedValuePath="IdValue"
                                              SelectedValue="{Binding Data.SurfaceForegroundPatternIdState, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              Style="{StaticResource SabComboBoxStyle}" />
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="190" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="96" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Цвет" Style="{StaticResource SabFieldLabelTextStyle}" VerticalAlignment="Center" />
                                    <Button Grid.Column="1"
                                            Content="{Binding Data.SurfaceForegroundPatternColorText}"
                                            Tag="PickColor"
                                            CommandParameter="SurfaceForegroundPatternColorValue"
                                            HorizontalContentAlignment="Left"
                                            Style="{StaticResource EditorValueButtonStyle}" />
                                    <Button Grid.Column="3"
                                            Content="Сбросить"
                                            Tag="ClearColor"
                                            CommandParameter="SurfaceForegroundPatternColorValue"
                                            Style="{StaticResource EditorResetButtonStyle}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource SabBrush.TableHeaderBackground}"
                                BorderBrush="{DynamicResource SabBrush.BorderWeak}"
                                BorderThickness="1"
                                CornerRadius="5"
                                Padding="10">
                            <StackPanel>
                                <CheckBox Content="Показывать фон"
                                          IsChecked="{Binding Data.SurfaceBackgroundPatternVisibleState, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          IsThreeState="True"
                                          Style="{StaticResource SabCheckBoxStyle}"
                                          Margin="0,0,0,9" />
                                <Grid Style="{StaticResource EditorFieldGridStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="190" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Образец" Style="{StaticResource SabFieldLabelTextStyle}" VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="1"
                                              ItemsSource="{Binding FillPatterns}"
                                              DisplayMemberPath="Name"
                                              SelectedValuePath="IdValue"
                                              SelectedValue="{Binding Data.SurfaceBackgroundPatternIdState, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              Style="{StaticResource SabComboBoxStyle}" />
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="190" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="96" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Цвет" Style="{StaticResource SabFieldLabelTextStyle}" VerticalAlignment="Center" />
                                    <Button Grid.Column="1"
                                            Content="{Binding Data.SurfaceBackgroundPatternColorText}"
                                            Tag="PickColor"
                                            CommandParameter="SurfaceBackgroundPatternColorValue"
                                            HorizontalContentAlignment="Left"
                                            Style="{StaticResource EditorValueButtonStyle}" />
                                    <Button Grid.Column="3"
                                            Content="Сбросить"
                                            Tag="ClearColor"
                                            CommandParameter="SurfaceBackgroundPatternColorValue"
                                            Style="{StaticResource EditorResetButtonStyle}" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Border x:Name="TransparencyPanel" Style="{StaticResource SabPanelBorderStyle}" Padding="14" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="210" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="72" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Прозрачность поверхности" Style="{StaticResource SabFieldLabelTextStyle}" VerticalAlignment="Center" />
                        <Slider Grid.Column="1"
                                Minimum="0"
                                Maximum="100"
                                TickFrequency="5"
                                IsSnapToTickEnabled="False"
                                Value="{Binding Data.Transparency, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                VerticalAlignment="Center"
                                Margin="0,0,10,0" />
                        <TextBox Grid.Column="2"
                                    Text="{Binding Data.TransparencyEditorText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                 Style="{StaticResource SabTextBoxStyle}"
                                 HorizontalContentAlignment="Center" />
                    </Grid>
                </Border>

                <Border x:Name="CutPanel" Style="{StaticResource SabPanelBorderStyle}" Padding="14" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="Разрез" Style="{StaticResource EditorSectionTitleStyle}" />

                        <Grid x:Name="CutLineWeightPanel" Style="{StaticResource EditorFieldGridStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="210" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Вес линии" Style="{StaticResource SabFieldLabelTextStyle}" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding LineWeights}"
                                      DisplayMemberPath="Name"
                                      SelectedValuePath="Value"
                                      SelectedValue="{Binding Data.CutLineWeightState, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Style="{StaticResource SabComboBoxStyle}" />
                        </Grid>

                        <Grid x:Name="CutLineColorPanel" Style="{StaticResource EditorFieldGridStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="210" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="96" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Цвет линии" Style="{StaticResource SabFieldLabelTextStyle}" VerticalAlignment="Center" />
                            <Button Grid.Column="1"
                                    Content="{Binding Data.CutLineColorText}"
                                    Tag="PickColor"
                                    CommandParameter="CutLineColorValue"
                                    HorizontalContentAlignment="Left"
                                    Style="{StaticResource EditorValueButtonStyle}" />
                            <Button Grid.Column="3"
                                    Content="Сбросить"
                                    Tag="ClearColor"
                                    CommandParameter="CutLineColorValue"
                                    Style="{StaticResource EditorResetButtonStyle}" />
                        </Grid>

                        <Grid x:Name="CutLinePatternPanel" Style="{StaticResource EditorFieldGridStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="210" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Образец линии" Style="{StaticResource SabFieldLabelTextStyle}" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding LinePatterns}"
                                      DisplayMemberPath="Name"
                                      SelectedValuePath="IdValue"
                                      SelectedValue="{Binding Data.CutLinePatternIdState, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Style="{StaticResource SabComboBoxStyle}" />
                        </Grid>

                        <Border x:Name="CutForegroundPatternPanel"
                                Background="{DynamicResource SabBrush.TableHeaderBackground}"
                                BorderBrush="{DynamicResource SabBrush.BorderWeak}"
                                BorderThickness="1"
                                CornerRadius="5"
                                Padding="10"
                                Margin="0,0,0,10">
                            <StackPanel>
                                <CheckBox Content="Показывать передний план разреза"
                                          IsChecked="{Binding Data.CutForegroundPatternVisibleState, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          IsThreeState="True"
                                          Style="{StaticResource SabCheckBoxStyle}"
                                          Margin="0,0,0,9" />
                                <Grid Style="{StaticResource EditorFieldGridStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="190" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Образец" Style="{StaticResource SabFieldLabelTextStyle}" VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="1"
                                              ItemsSource="{Binding FillPatterns}"
                                              DisplayMemberPath="Name"
                                              SelectedValuePath="IdValue"
                                              SelectedValue="{Binding Data.CutForegroundPatternIdState, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              Style="{StaticResource SabComboBoxStyle}" />
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="190" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="96" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Цвет" Style="{StaticResource SabFieldLabelTextStyle}" VerticalAlignment="Center" />
                                    <Button Grid.Column="1"
                                            Content="{Binding Data.CutForegroundPatternColorText}"
                                            Tag="PickColor"
                                            CommandParameter="CutForegroundPatternColorValue"
                                            HorizontalContentAlignment="Left"
                                            Style="{StaticResource EditorValueButtonStyle}" />
                                    <Button Grid.Column="3"
                                            Content="Сбросить"
                                            Tag="ClearColor"
                                            CommandParameter="CutForegroundPatternColorValue"
                                            Style="{StaticResource EditorResetButtonStyle}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border x:Name="CutBackgroundPatternPanel"
                                Background="{DynamicResource SabBrush.TableHeaderBackground}"
                                BorderBrush="{DynamicResource SabBrush.BorderWeak}"
                                BorderThickness="1"
                                CornerRadius="5"
                                Padding="10">
                            <StackPanel>
                                <CheckBox Content="Показывать фон разреза"
                                          IsChecked="{Binding Data.CutBackgroundPatternVisibleState, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          IsThreeState="True"
                                          Style="{StaticResource SabCheckBoxStyle}"
                                          Margin="0,0,0,9" />
                                <Grid Style="{StaticResource EditorFieldGridStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="190" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Образец" Style="{StaticResource SabFieldLabelTextStyle}" VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="1"
                                              ItemsSource="{Binding FillPatterns}"
                                              DisplayMemberPath="Name"
                                              SelectedValuePath="IdValue"
                                              SelectedValue="{Binding Data.CutBackgroundPatternIdState, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              Style="{StaticResource SabComboBoxStyle}" />
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="190" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="96" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Цвет" Style="{StaticResource SabFieldLabelTextStyle}" VerticalAlignment="Center" />
                                    <Button Grid.Column="1"
                                            Content="{Binding Data.CutBackgroundPatternColorText}"
                                            Tag="PickColor"
                                            CommandParameter="CutBackgroundPatternColorValue"
                                            HorizontalContentAlignment="Left"
                                            Style="{StaticResource EditorValueButtonStyle}" />
                                    <Button Grid.Column="3"
                                            Content="Сбросить"
                                            Tag="ClearColor"
                                            CommandParameter="CutBackgroundPatternColorValue"
                                            Style="{StaticResource EditorResetButtonStyle}" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Border x:Name="AdditionalPanel" Style="{StaticResource SabPanelBorderStyle}" Padding="14">
                    <StackPanel>
                        <TextBlock Text="Дополнительно" Style="{StaticResource EditorSectionTitleStyle}" />
                        <CheckBox Content="Полутона"
                                      IsChecked="{Binding Data.HalftoneState, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      IsThreeState="True"
                                  Style="{StaticResource SabCheckBoxStyle}"
                                  Margin="0,0,0,10" />
                        <Grid x:Name="DetailLevelPanel">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="210" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Уровень детализации" Style="{StaticResource SabFieldLabelTextStyle}" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding DetailLevels}"
                                      DisplayMemberPath="Name"
                                      SelectedValuePath="Value"
                                      SelectedValue="{Binding Data.DetailLevelState, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Style="{StaticResource SabComboBoxStyle}" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2"
                Background="White"
                BorderBrush="{DynamicResource SabBrush.BorderWeak}"
                BorderThickness="0,1,0,0"
                Padding="18,11">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton"
                        Content="Отмена"
                        MinWidth="105"
                        Padding="14,7"
                        Margin="0,0,10,0"
                        Style="{StaticResource SabOutlineButtonStyle}" />
                <Button x:Name="ApplyButton"
                        Content="Применить"
                        MinWidth="125"
                        Padding="16,7"
                        Style="{StaticResource SabPrimaryButtonStyle}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
