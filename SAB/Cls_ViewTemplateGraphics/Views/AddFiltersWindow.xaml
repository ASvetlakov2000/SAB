<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Добавить фильтры"
        Width="680"
        Height="620"
        MinWidth="560"
        MinHeight="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        FontFamily="Segoe UI"
        FontSize="13"
        Background="{DynamicResource SabBrush.WindowBackground}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../UI/Styles/SABWindowStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="FilterSelectionRowStyle"
                   TargetType="{x:Type DataGridRow}"
                   BasedOn="{StaticResource SabDataGridRowStyle}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsVisibleInList}" Value="False">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsAlreadyInTemplate}" Value="True">
                        <Setter Property="IsEnabled" Value="False" />
                        <Setter Property="Opacity" Value="0.55" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="CompactSearchButtonStyle"
                   TargetType="{x:Type Button}"
                   BasedOn="{StaticResource SabOutlineButtonStyle}">
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Height" Value="32" />
                <Setter Property="Padding" Value="10,0" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="White"
                BorderBrush="{DynamicResource SabBrush.BorderWeak}"
                BorderThickness="0,0,0,1"
                Padding="18,14">
            <StackPanel>
                <TextBlock Text="Добавить фильтры"
                           Style="{StaticResource SabWindowTitleTextStyle}" />
                <TextBlock Text="Отметьте галочками один или несколько фильтров."
                           Style="{StaticResource SabWindowSubtitleTextStyle}" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="18,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,12" MinHeight="32">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="96" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="FilterSearchTextBox"
                         Grid.Column="0"
                         Style="{StaticResource SabTextBoxStyle}"
                         ToolTip="Поиск по имени фильтра" />
                <Button x:Name="FindButton"
                        Grid.Column="2"
                        Content="Найти"
                        Style="{StaticResource CompactSearchButtonStyle}" />
            </Grid>

            <Border Grid.Row="1" Style="{StaticResource SabDataGridContainerBorderStyle}">
                <DataGrid x:Name="FiltersDataGrid"
                          ItemsSource="{Binding Items}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserReorderColumns="False"
                          SelectionMode="Extended"
                          SelectionUnit="FullRow"
                          RowStyle="{StaticResource FilterSelectionRowStyle}"
                          Style="{StaticResource SabDataGridStyle}">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Выбор" Width="58">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Style="{StaticResource SabCheckBoxStyle}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Фильтр"
                                            Binding="{Binding Name}"
                                            IsReadOnly="True"
                                            Width="*" />
                        <DataGridTextColumn Header="Статус"
                                            Binding="{Binding Status}"
                                            IsReadOnly="True"
                                            Width="130" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>

        <Border Grid.Row="2"
                Background="White"
                BorderBrush="{DynamicResource SabBrush.BorderWeak}"
                BorderThickness="0,1,0,0"
                Padding="18,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="Уже добавленные фильтры показаны для справки."
                           Style="{StaticResource SabFieldHintTextStyle}"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,0,14,0" />
                <Button x:Name="CancelButton"
                        Grid.Column="1"
                        Content="Отмена"
                        MinWidth="100"
                        Padding="14,7"
                        Style="{StaticResource SabOutlineButtonStyle}" />
                <Button x:Name="AddButton"
                        Grid.Column="3"
                        Content="Добавить выбранные"
                        MinWidth="160"
                        Padding="16,7"
                        Style="{StaticResource SabPrimaryButtonStyle}" />
            </Grid>
        </Border>
    </Grid>
</Window>
