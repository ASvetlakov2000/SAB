<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Проверка геометрии помещений"
        Height="760"
        Width="1040"
        MinHeight="680"
        MinWidth="920"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        Background="#F2F2F2">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../UI/Styles/SABWindowStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

        <SolidColorBrush x:Key="SectionBackgroundBrush" Color="#FCFCFC" />
        <SolidColorBrush x:Key="SectionBorderBrush" Color="#000000" />
        <SolidColorBrush x:Key="FieldBorderBrush" Color="#000000" />
        <SolidColorBrush x:Key="FieldTitleBackgroundBrush" Color="#EBEBEB" />
        <SolidColorBrush x:Key="FieldInputBackgroundBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="FieldHoverBackgroundBrush" Color="#E1E1E1" />
        <SolidColorBrush x:Key="ActionButtonBrush" Color="#E1E1E1" />

        <Style x:Key="SectionBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SectionBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource SectionBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <Style x:Key="SectionTitleTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Foreground" Value="#111111" />
        </Style>

        <Style x:Key="SettingCardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="{StaticResource FieldBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="SettingTitleBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource FieldTitleBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource FieldBorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="CornerRadius" Value="8,8,0,0" />
            <Setter Property="Padding" Value="10,6" />
        </Style>

        <Style x:Key="SettingTitleTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="#202020" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="SettingInputHostStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource FieldInputBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource FieldBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Margin" Value="8" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource FieldHoverBackgroundBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FlatTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="#202020" />
        </Style>

        <Style x:Key="FlatComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="#202020" />
        </Style>

        <Style x:Key="GrayActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource ActionButtonBrush}" />
            <Setter Property="BorderBrush" Value="#000000" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#101010" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="DataGridCellStyle" TargetType="DataGridCell">
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="6,4" />
        </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="16,14,16,10">
            <TextBlock Text="Проверка геометрии помещений" Style="{StaticResource SectionTitleTextStyle}" Margin="0,0,0,4" />
            <TextBlock Text="Проверка углов, размещения, изменения площади и создание осей помещений."
                       FontSize="14"
                       Foreground="#333333"
                       TextWrapping="Wrap" />
        </StackPanel>

        <Border Grid.Row="1" Margin="16,0,16,0" Style="{StaticResource SectionBorderStyle}">
            <StackPanel>
                <TextBlock Text="Параметры" Style="{StaticResource SectionTitleTextStyle}" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <Border Style="{StaticResource SettingCardBorderStyle}">
                            <StackPanel>
                                <Border Style="{StaticResource SettingTitleBorderStyle}">
                                    <TextBlock Text="Допустимое изменение площади, %" Style="{StaticResource SettingTitleTextStyle}" />
                                </Border>
                                <Border Style="{StaticResource SettingInputHostStyle}">
                                    <TextBox Style="{StaticResource FlatTextBoxStyle}" Text="{Binding AreaDeviationThresholdPercentText, UpdateSourceTrigger=PropertyChanged}" />
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="4,0,4,0">
                        <Border Style="{StaticResource SettingCardBorderStyle}">
                            <StackPanel>
                                <Border Style="{StaticResource SettingTitleBorderStyle}">
                                    <TextBlock Text="Тип линии для осей" Style="{StaticResource SettingTitleTextStyle}" />
                                </Border>
                                <Border Style="{StaticResource SettingInputHostStyle}">
                                    <ComboBox Style="{StaticResource FlatComboBoxStyle}"
                                              ItemsSource="{Binding AxisLineStyles}"
                                              SelectedItem="{Binding SelectedAxisLineStyle}"
                                              DisplayMemberPath="Name" />
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Margin="8,0,0,0">
                        <Border Style="{StaticResource SettingCardBorderStyle}">
                            <StackPanel>
                                <Border Style="{StaticResource SettingTitleBorderStyle}">
                                    <TextBlock Text="Угловой размерный стиль" Style="{StaticResource SettingTitleTextStyle}" />
                                </Border>
                                <Border Style="{StaticResource SettingInputHostStyle}">
                                    <ComboBox Style="{StaticResource FlatComboBoxStyle}"
                                              ItemsSource="{Binding AngularDimensionTypes}"
                                              SelectedItem="{Binding SelectedAngularDimensionType}"
                                              DisplayMemberPath="Name" />
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <StackPanel Orientation="Vertical" Margin="2,4,0,0">
                    <CheckBox Content="Удалять ранее созданные оси перед построением новых"
                              IsChecked="{Binding DeletePreviousAxesBeforeCreation}"
                              FontSize="14"
                              Margin="0,2,0,2" />
                    <CheckBox Content="Пропускать помещения с ошибками геометрии"
                              IsChecked="{Binding SkipRoomsWithGeometryErrors}"
                              FontSize="14"
                              Margin="0,2,0,0" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Margin="16,10,16,0" Style="{StaticResource SectionBorderStyle}">
            <StackPanel>
                <TextBlock Text="Команды" Style="{StaticResource SectionTitleTextStyle}" />

                <UniformGrid Columns="3" Rows="3" Margin="0,0,0,4">
                    <Button Style="{StaticResource GrayActionButtonStyle}" Content="Проверить углы помещений" Margin="4" Command="{Binding CheckAnglesCommand}" />
                    <Button Style="{StaticResource GrayActionButtonStyle}" Content="Проверить неразмещённые помещения" Margin="4" Command="{Binding CheckUnplacedRoomsCommand}" />
                    <Button Style="{StaticResource GrayActionButtonStyle}" Content="Проверить изменение площади" Margin="4" Command="{Binding CheckAreaChangesCommand}" />

                    <Button Style="{StaticResource GrayActionButtonStyle}" Content="Показать помещения с проблемными углами" Margin="4" Command="{Binding ShowProblematicAnglesCommand}" />
                    <Button Style="{StaticResource GrayActionButtonStyle}" Content="Создать оси по выбранному помещению" Margin="4" Command="{Binding CreateAxesForSelectedRoomCommand}" />
                    <Button Style="{StaticResource GrayActionButtonStyle}" Content="Создать оси по всем помещениям на активном виде" Margin="4" Command="{Binding CreateAxesForActiveViewRoomsCommand}" />

                    <Button Style="{StaticResource GrayActionButtonStyle}" Content="Экспорт CSV" Margin="4" Command="{Binding ExportCsvCommand}" />
                    <Border Margin="4" Background="Transparent" />
                    <Border Margin="4" Background="Transparent" />
                </UniformGrid>
            </StackPanel>
        </Border>

        <Border Grid.Row="3" Margin="16,10,16,10" Style="{StaticResource SectionBorderStyle}">
            <StackPanel>
                <TextBlock Text="Результаты" Style="{StaticResource SectionTitleTextStyle}" />

                <TabControl Height="290">
                    <TabItem Header="Проблемные углы">
                        <DataGrid ItemsSource="{Binding AngleIssues}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  CellStyle="{StaticResource DataGridCellStyle}"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  VerticalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Level" Binding="{Binding LevelName}" Width="120" />
                                <DataGridTextColumn Header="Room Number" Binding="{Binding RoomNumber}" Width="100" />
                                <DataGridTextColumn Header="Room Name" Binding="{Binding RoomName}" Width="180" />
                                <DataGridTextColumn Header="Room ElementId" Binding="{Binding RoomId.IntegerValue}" Width="110" />
                                <DataGridTextColumn Header="Angle" Binding="{Binding ActualAngleDegrees, StringFormat=0.######}" Width="90" />
                                <DataGridTextColumn Header="Deviation" Binding="{Binding DeviationFrom90Degrees, StringFormat=0.######}" Width="100" />
                                <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>

                    <TabItem Header="Неразмещённые помещения">
                        <DataGrid ItemsSource="{Binding PlacementIssues}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  CellStyle="{StaticResource DataGridCellStyle}"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  VerticalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Level" Binding="{Binding LevelName}" Width="120" />
                                <DataGridTextColumn Header="Room Number" Binding="{Binding RoomNumber}" Width="100" />
                                <DataGridTextColumn Header="Room Name" Binding="{Binding RoomName}" Width="180" />
                                <DataGridTextColumn Header="Room ElementId" Binding="{Binding RoomId.IntegerValue}" Width="110" />
                                <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>

                    <TabItem Header="Изменение площади">
                        <DataGrid ItemsSource="{Binding AreaIssues}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  CellStyle="{StaticResource DataGridCellStyle}"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  VerticalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Level" Binding="{Binding LevelName}" Width="120" />
                                <DataGridTextColumn Header="Room Number" Binding="{Binding RoomNumber}" Width="100" />
                                <DataGridTextColumn Header="Room Name" Binding="{Binding RoomName}" Width="180" />
                                <DataGridTextColumn Header="Room ElementId" Binding="{Binding RoomId.IntegerValue}" Width="110" />
                                <DataGridTextColumn Header="Approved Area" Binding="{Binding ApprovedAreaSquareMeters, StringFormat=0.###}" Width="95" />
                                <DataGridTextColumn Header="Current Area" Binding="{Binding CurrentAreaSquareMeters, StringFormat=0.###}" Width="95" />
                                <DataGridTextColumn Header="Delta Area" Binding="{Binding DeltaAreaSquareMeters, StringFormat=0.###}" Width="95" />
                                <DataGridTextColumn Header="Delta Percent" Binding="{Binding DeltaPercent, StringFormat=0.###}" Width="95" />
                                <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>

                    <TabItem Header="Оси помещений">
                        <DataGrid ItemsSource="{Binding AxisResults}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  CellStyle="{StaticResource DataGridCellStyle}"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  VerticalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Level" Binding="{Binding LevelName}" Width="120" />
                                <DataGridTextColumn Header="Room Number" Binding="{Binding RoomNumber}" Width="100" />
                                <DataGridTextColumn Header="Room Name" Binding="{Binding RoomName}" Width="180" />
                                <DataGridTextColumn Header="Room ElementId" Binding="{Binding RoomId.IntegerValue}" Width="110" />
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90" />
                                <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                </TabControl>
            </StackPanel>
        </Border>

        <DockPanel Grid.Row="4" Margin="16,0,16,14" LastChildFill="False">
            <TextBlock Text="{Binding StatusText}"
                       FontSize="14"
                       TextWrapping="Wrap"
                       Foreground="#222222"
                       VerticalAlignment="Center"
                       Margin="0,0,12,0"
                       Width="780" />
            <Button Style="{StaticResource GrayActionButtonStyle}"
                    Width="160"
                    Content="Закрыть"
                    Command="{Binding CloseCommand}" />
        </DockPanel>
    </Grid>
</Window>
