<Window x:Class="SAB.Cls_RevitLibraryBuilder.UI.Dialogs.ConfirmViewCreationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirm"
        Width="320"
        Height="150"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True">

    <Border CornerRadius="8"
            Background="#676C73"
            BorderBrush="White"
            BorderThickness="3"
            Padding="20">

        <Border.Resources>
            <Style x:Key="ConfirmButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="#676C73"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="BorderBrush" Value="White"/>
                <Setter Property="BorderThickness" Value="2"/>
                <Setter Property="Padding" Value="6,2"/>
                <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                <Setter Property="RenderTransform">
                    <Setter.Value>
                        <ScaleTransform ScaleX="1" ScaleY="1"/>
                    </Setter.Value>
                </Setter>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsPressed" Value="True">
                        <Trigger.EnterActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <!-- Блок отвечает за анимацию нажатия кнопки -->
                                    <!-- Здесь можно изменить длительность и масштаб анимации -->
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                     To="0.96"
                                                     Duration="0:0:0.08"/>
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                     To="0.96"
                                                     Duration="0:0:0.08"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </Trigger.EnterActions>
                        <Trigger.ExitActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                     To="1"
                                                     Duration="0:0:0.08"/>
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                     To="1"
                                                     Duration="0:0:0.08"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </Trigger.ExitActions>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Border.Resources>

        <StackPanel Width="300" HorizontalAlignment="Center" VerticalAlignment="Center" Height="90">

            <TextBlock x:Name="TitleText"
                       Text="Создать план с категорией?"
                       FontSize="20"
                       FontWeight="Bold"
                       Foreground="White"
                       Margin="0,0,0,10" HorizontalAlignment="Center"/>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,20,0,0">


                <Button x:Name="NoButton"
                        Content="Нет"
                        Style="{StaticResource ConfirmButtonStyle}"
                        Width="80"
                        Margin="0,0,0,10"
                        Click="No_Click" HorizontalAlignment="Center" VerticalAlignment="Center" Height="30" FontSize="18">

                </Button>

                <Button x:Name="YesButton"
                        Content="Да"
                        Style="{StaticResource ConfirmButtonStyle}"
                        Width="80"
                        Click="Yes_Click" HorizontalAlignment="Center" VerticalAlignment="Center" Height="30" RenderTransformOrigin="0.75,1.093" FontSize="18" Margin="30,0,0,10"/>

            </StackPanel>

        </StackPanel>
    </Border>
</Window>
