  <Style TargetType="TabControl">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TabControl">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid HorizontalAlignment="Left" Height="Auto" design:Capsule.IsGroup="True" MinHeight="34">
              <Border CornerRadius="17" Background="{DynamicResource SabBrush.TableHeaderBackground}" BorderBrush="{DynamicResource SabBrush.Border}" BorderThickness="1" />
              <Border Tag="CapsuleIndicator" CornerRadius="15" Background="{DynamicResource SabBrush.Accent}" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False" />
              <TabPanel IsItemsHost="True" Margin="2" />
            </Grid>
            <ContentPresenter Grid.Row="1" ContentSource="SelectedContent" x:Name="SelectedBody" Margin="0,12,0,0" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
