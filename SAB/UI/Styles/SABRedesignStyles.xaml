<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:wui="clr-namespace:Wpf.Ui.Controls;assembly=Wpf.Ui"
                    xmlns:markup="clr-namespace:Wpf.Ui.Markup;assembly=Wpf.Ui">
    <ResourceDictionary.MergedDictionaries>
        <markup:ThemesDictionary Theme="Light" />
        <markup:ControlsDictionary />
        <ResourceDictionary Source="SABWindowStyles.xaml" />
    </ResourceDictionary.MergedDictionaries>
    <!-- Scoped to the approved modules; unrelated SAB windows keep their own resources. -->
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#0F6CBD" />
    <SolidColorBrush x:Key="AccentButtonBackground" Color="#0F6CBD" />
    <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#0B5EA8" />
    <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#084B86" />
    <!-- WPF-UI toggle-switch defaults must not size the native combo-box toggle. -->
    <Style TargetType="ToggleButton" />
    <Style TargetType="Button" BasedOn="{StaticResource SabNeutralButtonStyle}" />
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource SabBrush.Text}" /></Style>
    <Style TargetType="wui:Button" BasedOn="{StaticResource DefaultUiButtonStyle}">
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="Margin" Value="4,0" />
    </Style>
    <Style x:Key="SabReviewPanelStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SabBrush.PanelBackground}" />
        <Setter Property="BorderBrush" Value="{StaticResource SabBrush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16" />
    </Style>
    <Style x:Key="SabWindowTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource SabBrush.Text}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="SabLayeredTabSurfaceStyle" TargetType="Border">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style x:Key="SabLayeredSettingsGroupStyle" TargetType="GroupBox">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Margin" Value="0,0,0,16" />
        <Setter Property="Template"><Setter.Value>
            <ControlTemplate TargetType="GroupBox">
                <StackPanel>
                    <ContentPresenter ContentSource="Header" Margin="0,4,0,10"
                                      TextElement.FontSize="16" TextElement.FontWeight="SemiBold"
                                      TextElement.Foreground="{StaticResource SabBrush.Text}" />
                    <ContentPresenter HorizontalAlignment="Stretch" />
                </StackPanel>
            </ControlTemplate>
        </Setter.Value></Setter>
    </Style>
    <Style x:Key="SabReviewTabItemStyle" TargetType="TabItem">
        <Setter Property="Padding" Value="9,9" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource SabBrush.TextSecondary}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template"><Setter.Value>
            <ControlTemplate TargetType="TabItem">
                <Border x:Name="Tab" Background="Transparent" CornerRadius="5" BorderThickness="1" BorderBrush="Transparent" Padding="{TemplateBinding Padding}">
                    <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" />
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Tab" Property="Background" Value="#F2F4F7" /></Trigger>
                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="Tab" Property="Background" Value="{StaticResource SabBrush.AccentLight}" /><Setter Property="Foreground" Value="{StaticResource SabBrush.Accent}" /><Setter Property="FontWeight" Value="SemiBold" /></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Tab" Property="BorderBrush" Value="#1F2937" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Setter.Value></Setter>
    </Style>
    <Style x:Key="SabCheckBoxStyle" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource SabBrush.Text}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template"><Setter.Value>
            <ControlTemplate TargetType="CheckBox">
                <Grid Background="Transparent">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="20" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Border x:Name="Box" Width="20" Height="20" CornerRadius="4" Background="White" BorderBrush="#667085" BorderThickness="1" VerticalAlignment="Center">
                        <Grid>
                            <!-- Normalized geometry is centered independently of its original path bounds. -->
                            <Path x:Name="Tick" Data="M 0,4 L 4,8 L 12,0" Width="12" Height="8" Stretch="Fill"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" Stroke="White"
                                  StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed" />
                            <Border x:Name="Mixed" Width="10" Height="2" Background="White" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                        </Grid>
                    </Border>
                    <ContentPresenter x:Name="Label" Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="Box" Property="Background" Value="{StaticResource SabBrush.Accent}" /><Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource SabBrush.Accent}" /><Setter TargetName="Tick" Property="Visibility" Value="Visible" /></Trigger>
                    <Trigger Property="IsChecked" Value="{x:Null}"><Setter TargetName="Box" Property="Background" Value="{StaticResource SabBrush.Accent}" /><Setter TargetName="Mixed" Property="Visibility" Value="Visible" /></Trigger>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource SabBrush.Accent}" /></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="#1F2937" /><Setter TargetName="Box" Property="BorderThickness" Value="2" /></Trigger>
                    <Trigger Property="HasContent" Value="False"><Setter TargetName="Label" Property="Margin" Value="0" /></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Setter.Value></Setter>
    </Style>
    <Style TargetType="CheckBox" BasedOn="{StaticResource SabCheckBoxStyle}" />
</ResourceDictionary>
