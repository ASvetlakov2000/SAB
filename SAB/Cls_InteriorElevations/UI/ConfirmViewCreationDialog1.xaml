<Window x:Class="InteriorElevations.UI.ConfirmViewCreationDialog1"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки развертки" Height="300" Width="350" WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,5">
            <Label Content="Отступ сверху (мм):" Width="150"/>
            <TextBox Name="TopOffsetTextBox" Width="100" Text="2500"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Grid.Row="1" Margin="0,5">
            <Label Content="Отступ снизу (мм):" Width="150"/>
            <TextBox Name="BottomOffsetTextBox" Width="100" Text="0"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Grid.Row="2" Margin="0,5">
            <Label Content="Боковой отступ (мм):" Width="150"/>
            <TextBox Name="SideOffsetTextBox" Width="100" Text="100"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Grid.Row="3" Margin="0,5">
            <Label Content="Отступ от линии (мм):" Width="150"/>
            <TextBox Name="LineOffsetTextBox" Width="100" Text="150"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Grid.Row="4" Margin="0,5">
            <Label Content="Шаблон имени вида:" Width="150"/>
            <ComboBox Name="ViewNameTemplateComboBox" Width="150">
                <ComboBoxItem Content="Развертка пом {0}_{1}-{2}" IsSelected="True"/>
                <ComboBoxItem Content="View {0} {1}-{2}"/>
            </ComboBox>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Grid.Row="5" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Name="OkButton" Width="70" Margin="5,0" Content="OK" Click="OkButton_Click"/>
            <Button Name="CancelButton" Width="70" Margin="5,0" Content="Отмена" Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>