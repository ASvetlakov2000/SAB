<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Выравнивание марок углов на плане"
        Height="340
        "
        Width="372"
        MinHeight="300"
        MinWidth="348"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F2F2F2">
    <Window.Resources>
        <SolidColorBrush x:Key="SectionBackgroundBrush" Color="#FCFCFC" />
        <SolidColorBrush x:Key="SectionBorderBrush" Color="#000000" />
        <SolidColorBrush x:Key="FieldBorderBrush" Color="#000000" />
        <SolidColorBrush x:Key="FieldTitleBackgroundBrush" Color="#EBEBEB" />
        <SolidColorBrush x:Key="FieldInputBackgroundBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="FieldHoverBackgroundBrush" Color="#E1E1E1" />
        <SolidColorBrush x:Key="ActionButtonBrush" Color="#E1E1E1" />

        <Style x:Key="SectionBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SectionBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource SectionBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <Style x:Key="SectionTitleTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="19" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Foreground" Value="#111111" />
        </Style>

        <Style x:Key="SettingCardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="{StaticResource FieldBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="SettingTitleBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource FieldTitleBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource FieldBorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="CornerRadius" Value="8,8,0,0" />
            <Setter Property="Padding" Value="10,7" />
        </Style>

        <Style x:Key="SettingTitleTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="#202020" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="SettingInputHostStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource FieldInputBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource FieldBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Margin" Value="8" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource FieldHoverBackgroundBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FlatTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="#202020" />
        </Style>

        <Style x:Key="GrayActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource ActionButtonBrush}" />
            <Setter Property="BorderBrush" Value="#000000" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#101010" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <Grid>
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Margin="2" />
                                <Border x:Name="ButtonDarkOverlay"
                                        Background="#000000"
                                        Opacity="0"
                                        CornerRadius="6"
                                        IsHitTestVisible="False" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ButtonDarkOverlay"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0.08"
                                                         Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ButtonDarkOverlay"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0"
                                                         Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="PreviewMouseLeftButtonDown">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ButtonDarkOverlay"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0.16"
                                                         Duration="0:0:0.06" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="PreviewMouseLeftButtonUp">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ButtonDarkOverlay"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0.08"
                                                         Duration="0:0:0.08" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="16,16,16,8">
            <Border Style="{StaticResource SectionBorderStyle}">
                <StackPanel>
                    <TextBlock Text="Параметры выравнивания" Style="{StaticResource SectionTitleTextStyle}" />
                    <TextBlock FontSize="14"
                               Foreground="#202020"
                               Margin="0,0,0,10"
                               TextWrapping="Wrap">
                        <Run Text="Введите отступ марки от угла в миллиметрах." />
                        <LineBreak />
                        <Run Text="Выноска будет создана автоматически." />
                    </TextBlock>

                    <Border Style="{StaticResource SettingCardBorderStyle}">
                        <StackPanel>
                            <Border Style="{StaticResource SettingTitleBorderStyle}">
                                <TextBlock Text="Отступ марки от угла (мм)" Style="{StaticResource SettingTitleTextStyle}" />
                            </Border>
                            <Border Style="{StaticResource SettingInputHostStyle}">
                                <TextBox x:Name="CornerOffsetTextBox"
                                         Style="{StaticResource FlatTextBoxStyle}" />
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>

        <DockPanel Grid.Row="1" Margin="16,8,16,16" LastChildFill="False">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" DockPanel.Dock="Bottom">
                <Button x:Name="CancelButton"
                        Style="{StaticResource GrayActionButtonStyle}"
                        Width="140"
                        Height="38"
                        Margin="0,0,8,0"
                        Content="Отмена" />
                <Button x:Name="OkButton"
                        Style="{StaticResource GrayActionButtonStyle}"
                        Width="160"
                        Height="38"
                        Content="Применить" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
