<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Выравнивание марок углов на плане"
        Height="294"
        Width="430"
        MinHeight="294"
        MinWidth="430"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        FontFamily="Segoe UI"
        FontSize="13"
        Background="{DynamicResource SabBrush.WindowBackground}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../UI/Styles/SABWindowStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Style="{StaticResource SabPanelBorderStyle}"
                Margin="20,18,20,14">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                    <Border Style="{StaticResource SabPanelIconBorderStyle}">
                        <TextBlock Text="⌖" Style="{StaticResource SabPanelIconTextStyle}" />
                    </Border>
                    <TextBlock Text="Параметры выравнивания" Style="{StaticResource SabPanelHeaderTextStyle}" />
                </StackPanel>

                <TextBlock Text="Введите отступ марки от угла в миллиметрах. Выноска будет создана автоматически."
                           Style="{StaticResource SabFieldHintTextStyle}"
                           Margin="0,0,0,14" />

                <TextBlock Text="Отступ марки от угла, мм" Style="{StaticResource SabFieldLabelTextStyle}" />
                <TextBox x:Name="CornerOffsetTextBox"
                         Style="{StaticResource SabTextBoxStyle}" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1"
                Background="{StaticResource SabBrush.PanelBackground}"
                BorderBrush="{StaticResource SabBrush.Border}"
                BorderThickness="0,1,0,0"
                Padding="20,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton"
                        Content="Отмена"
                        Width="120"
                        Style="{StaticResource SabNeutralButtonStyle}"
                        Margin="0,0,10,0" />
                <Button x:Name="OkButton"
                        Content="Применить"
                        Width="130"
                        Style="{StaticResource SabPrimaryButtonStyle}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
