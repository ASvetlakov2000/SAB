<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Выравнивание марок углов на плане"
        Height="300"
        Width="560"
        MinHeight="280"
        MinWidth="520"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Style="{DynamicResource MaterialDesignWindow}"
        TextElement.Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
        Background="{DynamicResource MaterialDesign.Brush.Background}"
        TextElement.FontWeight="Medium"
        TextElement.FontSize="14">
    <Window.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.Light.xaml" />
                    <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign2.Defaults.xaml" />
                </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>
        </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <materialDesign:Card Grid.Row="0" Padding="16" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Выравнивание марок углов" FontSize="22" FontWeight="Bold" Margin="0,0,0,8" />
                <TextBlock Text="Укажите отступ смещения марки от угла. Выноска будет построена автоматически." Opacity="0.8" Margin="0,0,0,16" TextWrapping="Wrap" />

                <TextBox x:Name="CornerOffsetTextBox"
                         materialDesign:HintAssist.Hint="Отступ марки от угла (мм)"
                         MinWidth="220" />
            </StackPanel>
        </materialDesign:Card>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="CancelButton" Width="130" Height="36" Margin="0,0,8,0" Content="Отмена" />
            <Button x:Name="OkButton" Width="140" Height="36" Content="Применить" />
        </StackPanel>
    </Grid>
</Window>
