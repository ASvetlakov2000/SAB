<?xml version='1.0' encoding='utf-8'?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:design="clr-namespace:SAB.UI.FluentLight;assembly=SAB" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="SAB · Обрезка по примеру" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" FontSize="13" Background="{DynamicResource SabBrush.WindowBackground}" UseLayoutRounding="True" SizeToContent="WidthAndHeight">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../../UI/Styles/SABFluentLight.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>
  <Grid Background="{DynamicResource SabBrush.WindowBackground}" x:Name="WindowRoot">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Border Visibility="Collapsed" x:Name="TitleBar" />
    <TextBlock Grid.Row="1" Text="Обрезка по примеру" Style="{StaticResource SabWindowTitleTextStyle}" Margin="24,20,24,16" />
    <Button Visibility="Collapsed" x:Name="MinimizeWindowButton" />
    <Button Visibility="Collapsed" x:Name="CloseWindowButton" />
    <Border Style="{StaticResource SabPanelBorderStyle}" Grid.Row="2" Margin="24,0,24,16">
      <StackPanel>
        <WrapPanel Margin="0,12,0,0" HorizontalAlignment="Center">
          <Button Content="Выбрать линию" Margin="0,0,8,8" x:Name="PickLineButton" />
          <Button Content="Создать линию" Margin="0,0,0,8" x:Name="CreateLineButton" Style="{StaticResource SabPrimaryButtonStyle}" />
        </WrapPanel>
      </StackPanel>
    </Border>
    <Border Background="White" BorderBrush="{DynamicResource SabBrush.Border}" BorderThickness="0,1,0,0" Padding="24,12" Grid.Row="3">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="1" HorizontalAlignment="Center">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Button Content="Инструкция" design:Instructions.File="SAB_HTML_Sozdanie_i_korrektirovka_razvertok.html" />
          <WrapPanel Grid.Column="2" HorizontalAlignment="Right">
            <Button Content="Закрыть" Margin="8,0,0,0" x:Name="CloseButton" />
          </WrapPanel>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</Window>
