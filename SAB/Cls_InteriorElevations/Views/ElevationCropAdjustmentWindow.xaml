<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Границы разверток"
        Height="438"
        Width="540"
        MinHeight="438"
        MinWidth="540"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FontFamily="Segoe UI"
        FontSize="13"
        Background="{DynamicResource SabBrush.WindowBackground}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../UI/Styles/SABWindowStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Style="{StaticResource SabPanelBorderStyle}"
                Margin="20,18,20,14">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                    <Border Style="{StaticResource SabPanelIconBorderStyle}">
                        <TextBlock Text="▣" Style="{StaticResource SabPanelIconTextStyle}" />
                    </Border>
                    <TextBlock Text="Смещение границ вида" Style="{StaticResource SabPanelHeaderTextStyle}" />
                </StackPanel>

                <TextBlock Text="Введите смещение каждой границы в миллиметрах. Положительное значение расширяет рамку, отрицательное — подрезает."
                           Style="{StaticResource SabFieldHintTextStyle}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,16" />

                <Grid Width="410" HorizontalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="130" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,12">
                        <TextBlock Text="Сверху, мм" Style="{StaticResource SabFieldLabelTextStyle}" />
                        <TextBox x:Name="TopTextBox"
                                 Text="0"
                                 HorizontalContentAlignment="Center"
                                 Style="{StaticResource SabTextBoxStyle}" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,8,12,8">
                        <TextBlock Text="Слева, мм" Style="{StaticResource SabFieldLabelTextStyle}" />
                        <TextBox x:Name="LeftTextBox"
                                 Text="0"
                                 HorizontalContentAlignment="Center"
                                 Style="{StaticResource SabTextBoxStyle}" />
                    </StackPanel>

                    <Border Grid.Row="1"
                            Grid.Column="1"
                            Height="68"
                            Margin="10,0"
                            Background="{StaticResource SabBrush.AccentLight}"
                            BorderBrush="{StaticResource SabBrush.Accent}"
                            BorderThickness="1"
                            CornerRadius="5">
                        <TextBlock Text="Граница вида"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource SabBrush.TextSecondary}" />
                    </Border>

                    <StackPanel Grid.Row="1" Grid.Column="2" Margin="12,8,0,8">
                        <TextBlock Text="Справа, мм" Style="{StaticResource SabFieldLabelTextStyle}" />
                        <TextBox x:Name="RightTextBox"
                                 Text="0"
                                 HorizontalContentAlignment="Center"
                                 Style="{StaticResource SabTextBoxStyle}" />
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,12,0,0">
                        <TextBlock Text="Снизу, мм" Style="{StaticResource SabFieldLabelTextStyle}" />
                        <TextBox x:Name="BottomTextBox"
                                 Text="0"
                                 HorizontalContentAlignment="Center"
                                 Style="{StaticResource SabTextBoxStyle}" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <Border Grid.Row="1"
                Background="{StaticResource SabBrush.PanelBackground}"
                BorderBrush="{StaticResource SabBrush.Border}"
                BorderThickness="0,1,0,0"
                Padding="20,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton"
                        Content="Отмена"
                        Width="120"
                        Style="{StaticResource SabNeutralButtonStyle}"
                        Margin="0,0,10,0" />
                <Button x:Name="ApplyButton"
                        Content="Применить"
                        Width="130"
                        Style="{StaticResource SabPrimaryButtonStyle}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
