<?xml version='1.0' encoding='utf-8'?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:design="clr-namespace:SAB.UI.FluentLight;assembly=SAB" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="SAB · Смещение границ вида" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" FontSize="13" Background="{DynamicResource SabBrush.WindowBackground}" UseLayoutRounding="True" SizeToContent="WidthAndHeight">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../../UI/Styles/SABFluentLight.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>
  <Grid Background="{DynamicResource SabBrush.WindowBackground}" x:Name="WindowRoot">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Border Background="White" BorderBrush="{DynamicResource SabBrush.Border}" BorderThickness="0,0,0,1" Padding="24,12" x:Name="TitleBar">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="SAB" TextWrapping="Wrap" Style="{StaticResource SabPanelHeaderTextStyle}" />
        <TextBlock Grid.Column="1" Text="Развёртки" Foreground="{DynamicResource SabBrush.TextSecondary}" VerticalAlignment="Center" Margin="20,0,0,0" />
        <StackPanel Grid.Column="2" Orientation="Horizontal">
          <Button Visibility="Collapsed" x:Name="MinimizeWindowButton" />
          <Button Visibility="Collapsed" x:Name="CloseWindowButton" />
        </StackPanel>
      </Grid>
    </Border>
    <TextBlock Grid.Row="1" Text="Смещение границ вида" Style="{StaticResource SabWindowTitleTextStyle}" Margin="24,20,24,16" />
    <Border Style="{StaticResource SabPanelBorderStyle}" Grid.Row="2" Margin="24,0,24,16">
      <StackPanel>
        <Grid HorizontalAlignment="Center">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="130" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="150" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="130" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <StackPanel Grid.Column="2" Grid.Row="0" VerticalAlignment="Center">
            <TextBlock Text="Сверху, мм" TextWrapping="Wrap" Style="{StaticResource SabFieldLabelTextStyle}" TextAlignment="Center" />
            <TextBox Text="0" Margin="0,4,0,0" HorizontalContentAlignment="Center" x:Name="TopTextBox" />
          </StackPanel>
          <StackPanel Grid.Column="2" Grid.Row="4" VerticalAlignment="Center">
            <TextBlock Text="Снизу, мм" TextWrapping="Wrap" Style="{StaticResource SabFieldLabelTextStyle}" TextAlignment="Center" />
            <TextBox Text="0" Margin="0,4,0,0" HorizontalContentAlignment="Center" x:Name="BottomTextBox" />
          </StackPanel>
          <StackPanel Grid.Column="0" Grid.Row="2" VerticalAlignment="Center">
            <TextBlock Text="Слева, мм" TextWrapping="Wrap" Style="{StaticResource SabFieldLabelTextStyle}" TextAlignment="Center" />
            <TextBox Text="0" Margin="0,4,0,0" HorizontalContentAlignment="Center" x:Name="LeftTextBox" />
          </StackPanel>
          <StackPanel Grid.Column="4" Grid.Row="2" VerticalAlignment="Center">
            <TextBlock Text="Справа, мм" TextWrapping="Wrap" Style="{StaticResource SabFieldLabelTextStyle}" TextAlignment="Center" />
            <TextBox Text="0" Margin="0,4,0,0" HorizontalContentAlignment="Center" x:Name="RightTextBox" />
          </StackPanel>
          <Grid Grid.Row="2" Grid.Column="2" Height="68" x:Name="ViewBoundaryDiagram">
            <Rectangle Stroke="{DynamicResource SabBrush.TextSecondary}" StrokeThickness="1" StrokeDashArray="4,3" Fill="Transparent" RadiusX="4" RadiusY="4" />
            <TextBlock Text="Граница вида" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource SabBrush.TextSecondary}" />
          </Grid>
        </Grid>
      </StackPanel>
    </Border>
    <Border Background="White" BorderBrush="{DynamicResource SabBrush.Border}" BorderThickness="0,1,0,0" Padding="24,12" Grid.Row="3">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="1">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Button Content="Инструкция" design:Instructions.File="SAB_HTML_Sozdanie_i_korrektirovka_razvertok.html" />
          <WrapPanel Grid.Column="2" HorizontalAlignment="Right">
            <Button Content="Отмена" Margin="8,0,0,0" x:Name="CancelButton" />
            <Button Content="Применить" Margin="8,0,0,0" x:Name="ApplyButton" Style="{StaticResource SabPrimaryButtonStyle}" />
          </WrapPanel>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</Window>
