<?xml version='1.0' encoding='utf-8'?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:design="clr-namespace:SAB.UI.FluentLight;assembly=SAB" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="SAB · Развёртка-пример" Width="820" Height="360" MinWidth="760" MinHeight="320" ResizeMode="CanResize" WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" FontSize="13" Background="{DynamicResource SabBrush.WindowBackground}" UseLayoutRounding="True">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../../UI/Styles/SABFluentLight.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>
  <Grid Background="{DynamicResource SabBrush.WindowBackground}" x:Name="WindowRoot">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Border Background="White" BorderBrush="{DynamicResource SabBrush.Border}" BorderThickness="0,0,0,1" Padding="24,12" x:Name="TitleBar">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="SAB" TextWrapping="Wrap" Style="{StaticResource SabPanelHeaderTextStyle}" />
        <TextBlock Grid.Column="1" Text="Развёртки" Foreground="{DynamicResource SabBrush.TextSecondary}" VerticalAlignment="Center" Margin="20,0,0,0" />
        <StackPanel Grid.Column="2" Orientation="Horizontal">
          <Button Visibility="Collapsed" x:Name="MinimizeWindowButton" />
          <Button Visibility="Collapsed" x:Name="CloseWindowButton" />
        </StackPanel>
      </Grid>
    </Border>
    <TextBlock Grid.Row="1" Text="Развёртка-пример" Style="{StaticResource SabWindowTitleTextStyle}" Margin="24,20,24,16" />
    <Border Style="{StaticResource SabPanelBorderStyle}" Grid.Row="2" Margin="24,0,24,16">
      <StackPanel>
        <TextBlock Text="Линия ещё не выбрана." TextWrapping="Wrap" Style="{StaticResource SabPanelHeaderTextStyle}" x:Name="StatusHeaderTextBlock" />
        <TextBlock Text="" TextWrapping="Wrap" Style="{StaticResource SabFieldHintTextStyle}" x:Name="StatusDescriptionTextBlock" Visibility="Collapsed" />
      </StackPanel>
    </Border>
    <Border Background="White" BorderBrush="{DynamicResource SabBrush.Border}" BorderThickness="0,1,0,0" Padding="24,12" Grid.Row="3">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="1">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Button Content="Инструкция" design:Instructions.File="SAB_HTML_Sozdanie_i_korrektirovka_razvertok.html" />
          <WrapPanel Grid.Column="2" HorizontalAlignment="Right">
            <Button Content="Отмена" Margin="8,0,0,0" x:Name="CancelButton" />
            <Button Content="Выбрать линию" Margin="8,0,0,0" x:Name="SelectLineButton" />
            <Button Content="Создать вид" Margin="8,0,0,0" x:Name="CreateViewButton" />
            <Button Content="Принять границы" Margin="8,0,0,0" x:Name="AcceptCropButton" Style="{StaticResource SabPrimaryButtonStyle}" />
          </WrapPanel>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</Window>
