<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SAB План-схемы разверток помещений"
        Height="560"
        Width="820"
        MinHeight="540"
        MinWidth="760"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        FontFamily="Segoe UI"
        FontSize="13"
        Background="{DynamicResource SabBrush.WindowBackground}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../UI/Styles/SABWindowStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Style="{StaticResource SabPanelBorderStyle}"
                Margin="20,18,20,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
                    <Border Style="{StaticResource SabPanelIconBorderStyle}">
                        <TextBlock Text="▤" Style="{StaticResource SabPanelIconTextStyle}" />
                    </Border>
                    <TextBlock Text="Настройки план-схемы помещения" Style="{StaticResource SabPanelHeaderTextStyle}" />
                </StackPanel>

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,14,0">
                        <Expander Style="{StaticResource SabPanelExpanderStyle}"
                                  IsExpanded="True"
                                  Margin="0,0,0,10">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal">
                                    <Border Style="{StaticResource SabPanelIconBorderStyle}">
                                        <TextBlock Text="☰" Style="{StaticResource SabPanelIconTextStyle}" />
                                    </Border>
                                    <TextBlock Text="Формула имени вида" Style="{StaticResource SabPanelHeaderTextStyle}" />
                                </StackPanel>
                            </Expander.Header>

                            <StackPanel>
                                <TextBlock Text="Часть 1 (текст-префикс)" Style="{StaticResource SabFieldLabelTextStyle}" />
                                <TextBox Text="{Binding NamePart1Text, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource SabTextBoxStyle}"
                                         Margin="0,0,0,12" />

                                <TextBlock Text="Часть 2 (Номер помещения или токен {Номер помещения})" Style="{StaticResource SabFieldLabelTextStyle}" />
                                <TextBox Text="{Binding NamePart2Text, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource SabTextBoxStyle}"
                                         Margin="0,0,0,12" />

                                <TextBlock Text="Часть 3 (Имя помещения или токен {Имя помещения})" Style="{StaticResource SabFieldLabelTextStyle}" />
                                <TextBox Text="{Binding NamePart3Text, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource SabTextBoxStyle}" />
                            </StackPanel>
                        </Expander>

                        <Expander Style="{StaticResource SabPanelExpanderStyle}"
                                  IsExpanded="True"
                                  Margin="0,0,0,10">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal">
                                    <Border Style="{StaticResource SabPanelIconBorderStyle}">
                                        <TextBlock Text="□" Style="{StaticResource SabPanelIconTextStyle}" />
                                    </Border>
                                    <TextBlock Text="Параметры вида" Style="{StaticResource SabPanelHeaderTextStyle}" />
                                </StackPanel>
                            </Expander.Header>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Шаблон вида" Style="{StaticResource SabFieldLabelTextStyle}" />
                                    <ComboBox ItemsSource="{Binding ViewTemplates}"
                                              SelectedItem="{Binding SelectedViewTemplate}"
                                              DisplayMemberPath="DisplayName"
                                              ToolTip="{Binding SelectedViewTemplate.DisplayName}"
                                              Style="{StaticResource SabComboBoxStyle}" />
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Отступ границы обрезки от контура помещения, мм" Style="{StaticResource SabFieldLabelTextStyle}" />
                                    <TextBox Text="{Binding CropOffsetMmText, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource SabTextBoxStyle}" />
                                </StackPanel>
                            </Grid>
                        </Expander>

                        <Border Style="{StaticResource SabValidationPanelStyle}">
                            <TextBlock Text="Команда работает в режиме выбора помещения. После нажатия ОК выберите одно помещение в модели."
                                       Style="{StaticResource SabFieldHintTextStyle}" />
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Background="{StaticResource SabBrush.PanelBackground}"
                BorderBrush="{StaticResource SabBrush.Border}"
                BorderThickness="0,1,0,0"
                Padding="20,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="Проверьте параметры и нажмите ОК."
                           Style="{StaticResource SabStatusTextStyle}" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CancelButton"
                            Content="Отмена"
                            Width="120"
                            Style="{StaticResource SabNeutralButtonStyle}"
                            Margin="0,0,10,0" />
                    <Button x:Name="OkButton"
                            Content="ОК"
                            Width="120"
                            Style="{StaticResource SabPrimaryButtonStyle}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
