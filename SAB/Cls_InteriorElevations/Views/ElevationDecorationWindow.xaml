<?xml version='1.0' encoding='utf-8'?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:design="clr-namespace:SAB.UI.FluentLight;assembly=SAB" xmlns:ui="clr-namespace:SAB.UI;assembly=SAB" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="SAB · Оформление развёрток" Width="1100" Height="880" MinWidth="860" MinHeight="620" ResizeMode="CanResize" WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" FontSize="13" Background="{DynamicResource SabBrush.WindowBackground}" UseLayoutRounding="True">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../../UI/Styles/SABFluentLight.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>
  <Grid Background="{DynamicResource SabBrush.WindowBackground}" x:Name="WindowRoot">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Border Background="White" BorderBrush="{DynamicResource SabBrush.Border}" BorderThickness="0,0,0,1" Padding="24,12" x:Name="TitleBar">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="SAB" TextWrapping="Wrap" Style="{StaticResource SabPanelHeaderTextStyle}" />
        <TextBlock Grid.Column="1" Text="Развёртки" Foreground="{DynamicResource SabBrush.TextSecondary}" VerticalAlignment="Center" Margin="20,0,0,0" />
        <StackPanel Grid.Column="2" Orientation="Horizontal">
          <Button Visibility="Collapsed" x:Name="MinimizeWindowButton" />
          <Button Visibility="Collapsed" x:Name="CloseWindowButton" />
        </StackPanel>
      </Grid>
    </Border>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,12,0" design:ScrollEdges.Enabled="True" Grid.Row="2" Margin="24,0,24,16">
      <StackPanel>
        <Grid Margin="0,0,0,16">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <GroupBox Margin="0" x:Name="SpotSelectionCard">
            <GroupBox.Header>
              <CheckBox x:Name="PlaceSpotElevationsCheckBox" Content="Высотные отметки" />
            </GroupBox.Header>
            <WrapPanel IsEnabled="{Binding IsChecked, ElementName=PlaceSpotElevationsCheckBox}">
              <CheckBox Content="Полы" IsChecked="True" Margin="0,0,16,0" x:Name="PlaceFloorSpotsCheckBox" />
              <CheckBox Content="Потолки" IsChecked="True" Margin="0,0,16,0" x:Name="PlaceCeilingSpotsCheckBox" />
              <CheckBox Content="Перекрытия" IsChecked="True" Margin="0,0,16,0" x:Name="PlaceSlabSpotsCheckBox" />
            </WrapPanel>
          </GroupBox>
          <GroupBox Grid.Row="2" Margin="0" x:Name="DimensionSelectionCard">
            <GroupBox.Header>
              <CheckBox x:Name="PlaceDimensionsCheckBox" Content="Размеры" />
            </GroupBox.Header>
            <WrapPanel IsEnabled="{Binding IsChecked, ElementName=PlaceDimensionsCheckBox}">
              <CheckBox x:Name="PlaceVerticalDimensionsCheckBox" Content="Вертикальные" Style="{StaticResource SabCheckBoxStyle}" Margin="0,0,16,0" />
              <CheckBox x:Name="PlaceHorizontalDimensionsCheckBox" Content="Горизонтальные" Style="{StaticResource SabCheckBoxStyle}" Margin="0,0,16,0" />
            </WrapPanel>
          </GroupBox>
          <GroupBox Grid.Column="2" Grid.RowSpan="3" Margin="0" x:Name="TagSelectionCard">
            <GroupBox.Header>
              <CheckBox x:Name="PlaceTagsCheckBox" Content="Марки" />
            </GroupBox.Header>
            <Grid IsEnabled="{Binding IsChecked, ElementName=PlaceTagsCheckBox}">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <CheckBox x:Name="PlaceWallTagsCheckBox" Content="Стены" Style="{StaticResource SabCheckBoxStyle}" Grid.Column="0" Grid.Row="0" Margin="0,0,8,8" />
              <CheckBox x:Name="PlaceFloorTagsCheckBox" Content="Полы" Style="{StaticResource SabCheckBoxStyle}" Grid.Column="1" Grid.Row="0" Margin="0,0,8,8" />
              <CheckBox x:Name="PlaceCeilingTagsCheckBox" Content="Потолки" Style="{StaticResource SabCheckBoxStyle}" Grid.Column="2" Grid.Row="0" Margin="0,0,8,8" />
              <CheckBox x:Name="PlacePlinthTagsCheckBox" Content="Плинтусы" Style="{StaticResource SabCheckBoxStyle}" Grid.Column="0" Grid.Row="1" Margin="0,0,8,8" />
              <CheckBox x:Name="PlaceDoorTagsCheckBox" Content="Двери" Style="{StaticResource SabCheckBoxStyle}" Grid.Column="1" Grid.Row="1" Margin="0,0,8,8" />
              <CheckBox x:Name="PlaceWindowTagsCheckBox" Content="Окна" Style="{StaticResource SabCheckBoxStyle}" Grid.Column="2" Grid.Row="1" Margin="0,0,8,8" />
            </Grid>
          </GroupBox>
        </Grid>
        <GroupBox Header="Высотные отметки" IsEnabled="{Binding IsChecked, ElementName=PlaceSpotElevationsCheckBox}" Margin="0,0,0,16">
          <StackPanel>
            <ui:AdaptiveSettingsGrid Margin="0,0,0,12">
              <ui:AdaptiveSettingsGrid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
              </ui:AdaptiveSettingsGrid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <TextBlock Text="Тип отметки пола (вверх)" Style="{StaticResource SabFieldLabelTextStyle}" TextWrapping="Wrap" />
                <ComboBox x:Name="FloorSpotElevationTypeComboBox" DisplayMemberPath="DisplayName" Style="{StaticResource SabComboBoxStyle}" VerticalAlignment="Center" Margin="0,4,0,12" />
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="Тип отметки потолка и ЖБ (вниз)" Style="{StaticResource SabFieldLabelTextStyle}" TextWrapping="Wrap" />
                <ComboBox x:Name="OverheadSpotElevationTypeComboBox" DisplayMemberPath="DisplayName" Style="{StaticResource SabComboBoxStyle}" VerticalAlignment="Center" Margin="0,4,0,12" />
              </StackPanel>
            </ui:AdaptiveSettingsGrid>
            <StackPanel Margin="0,0,0,12">
              <TextBlock Text="Относительная база" Style="{StaticResource SabFieldLabelTextStyle}" TextWrapping="Wrap" />
              <ComboBox x:Name="SpotRelativeBaseLevelComboBox" DisplayMemberPath="DisplayName" Style="{StaticResource SabComboBoxStyle}" VerticalAlignment="Center" Margin="0,4,0,12" />
            </StackPanel>
            <TextBlock Text="Отметки слоёв пола" Style="{StaticResource SabFieldLabelTextStyle}" TextWrapping="Wrap" />
            <WrapPanel Margin="0,0,0,12">
              <CheckBox x:Name="PlaceFinishFloorSpotCheckBox" Content="Чистовой пол (ноль)" Style="{StaticResource SabCheckBoxStyle}" Margin="0,0,18,6" />
              <CheckBox x:Name="PlaceSubfloorSpotsCheckBox" Content="Черновые слои" Style="{StaticResource SabCheckBoxStyle}" Margin="0,0,18,6" />
              <CheckBox x:Name="PlaceStructuralBaseSpotCheckBox" Content="ЖБ-основание" Style="{StaticResource SabCheckBoxStyle}" Margin="0,0,0,6" />
            </WrapPanel>
            <ui:AdaptiveSettingsGrid>
              <ui:AdaptiveSettingsGrid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
              </ui:AdaptiveSettingsGrid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <TextBlock Text="Сторона размещения" Style="{StaticResource SabFieldLabelTextStyle}" TextWrapping="Wrap" />
                <Grid MinHeight="34" Margin="0,4,0,12" design:Capsule.IsGroup="True">
                  <Border CornerRadius="17" Background="{DynamicResource SabBrush.TableHeaderBackground}" BorderBrush="{DynamicResource SabBrush.Border}" BorderThickness="1" />
                  <Border Tag="CapsuleIndicator" CornerRadius="15" Background="{DynamicResource SabBrush.Accent}" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False" />
                  <Grid Margin="2">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <RadioButton x:Name="LeftSideRadioButton" Content="Слева" GroupName="AnnotationSide" Style="{StaticResource SabRadioButtonStyle}" Margin="0" Grid.Column="0" />
                    <RadioButton x:Name="RightSideRadioButton" Content="Справа" GroupName="AnnotationSide" Style="{StaticResource SabRadioButtonStyle}" Grid.Column="1" Margin="0" />
                  </Grid>
                </Grid>
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="Отступ от границы, мм на листе" Style="{StaticResource SabFieldLabelTextStyle}" TextWrapping="Wrap" />
                <TextBox x:Name="SpotOffsetTextBox" Style="{StaticResource SabTextBoxStyle}" VerticalAlignment="Center" Margin="0,4,0,12" />
              </StackPanel>
            </ui:AdaptiveSettingsGrid>
          </StackPanel>
        </GroupBox>
        <GroupBox Header="Размерные линии" IsEnabled="{Binding IsChecked, ElementName=PlaceDimensionsCheckBox}" Margin="0,0,0,16">
          <StackPanel>
            <ui:AdaptiveSettingsGrid IsEnabled="{Binding IsChecked, ElementName=PlaceVerticalDimensionsCheckBox}">
              <ui:AdaptiveSettingsGrid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
              </ui:AdaptiveSettingsGrid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <TextBlock Text="Тип цепочки размеров" Style="{StaticResource SabFieldLabelTextStyle}" TextWrapping="Wrap" />
                <ComboBox x:Name="DetailedDimensionTypeComboBox" DisplayMemberPath="DisplayName" Style="{StaticResource SabComboBoxStyle}" VerticalAlignment="Center" Margin="0,4,0,12" />
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="Отступ цепочки, мм на листе" Style="{StaticResource SabFieldLabelTextStyle}" TextWrapping="Wrap" />
                <TextBox x:Name="DetailedDimensionOffsetTextBox" Style="{StaticResource SabTextBoxStyle}" VerticalAlignment="Center" Margin="0,4,0,12" />
              </StackPanel>
            </ui:AdaptiveSettingsGrid>
            <ui:AdaptiveSettingsGrid Margin="0,12,0,0" IsEnabled="{Binding IsChecked, ElementName=PlaceVerticalDimensionsCheckBox}">
              <ui:AdaptiveSettingsGrid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
              </ui:AdaptiveSettingsGrid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <TextBlock Text="Тип общего размера" Style="{StaticResource SabFieldLabelTextStyle}" TextWrapping="Wrap" />
                <ComboBox x:Name="OverallDimensionTypeComboBox" DisplayMemberPath="DisplayName" Style="{StaticResource SabComboBoxStyle}" VerticalAlignment="Center" Margin="0,4,0,12" />
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="Отступ общего размера, мм на листе" Style="{StaticResource SabFieldLabelTextStyle}" TextWrapping="Wrap" />
                <TextBox x:Name="OverallDimensionOffsetTextBox" Style="{StaticResource SabTextBoxStyle}" VerticalAlignment="Center" Margin="0,4,0,12" />
              </StackPanel>
            </ui:AdaptiveSettingsGrid>
            <ui:AdaptiveSettingsGrid Margin="0,12,0,0" IsEnabled="{Binding IsChecked, ElementName=PlaceHorizontalDimensionsCheckBox}">
              <ui:AdaptiveSettingsGrid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
              </ui:AdaptiveSettingsGrid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <TextBlock Text="Тип размера ширины" Style="{StaticResource SabFieldLabelTextStyle}" TextWrapping="Wrap" />
                <ComboBox x:Name="WidthDimensionTypeComboBox" DisplayMemberPath="DisplayName" Style="{StaticResource SabComboBoxStyle}" VerticalAlignment="Center" Margin="0,4,0,12" />
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="Отступ снизу, мм на листе" Style="{StaticResource SabFieldLabelTextStyle}" TextWrapping="Wrap" />
                <TextBox x:Name="WidthDimensionOffsetTextBox" Style="{StaticResource SabTextBoxStyle}" VerticalAlignment="Center" Margin="0,4,0,12" />
              </StackPanel>
            </ui:AdaptiveSettingsGrid>
          </StackPanel>
        </GroupBox>
        <GroupBox Header="Марки" IsEnabled="{Binding IsChecked, ElementName=PlaceTagsCheckBox}" Margin="0,0,0,16">
          <StackPanel>
            <StackPanel>
              <TextBlock Text="Видимая длина прямой выноски, мм на листе" TextWrapping="Wrap" Style="{StaticResource SabFieldLabelTextStyle}" />
              <TextBox x:Name="TagOffsetTextBox" HorizontalAlignment="Left" Style="{StaticResource SabTextBoxStyle}" VerticalAlignment="Center" Margin="0,4,0,12" Width="220" />
            </StackPanel>
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="16" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" Grid.Row="0">
                <TextBlock Text="Стены" TextWrapping="Wrap" Style="{StaticResource SabFieldLabelTextStyle}" />
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <ComboBox x:Name="WallTagTypeComboBox" DisplayMemberPath="DisplayName" Style="{StaticResource SabComboBoxStyle}" Margin="0" IsEnabled="{Binding IsChecked, ElementName=PlaceWallTagsCheckBox}" VerticalAlignment="Center" />
                  <CheckBox x:Name="WallLeaderCheckBox" Grid.Column="2" Content="Без выноски" IsEnabled="False" ToolTip="Маркируются только фронтальные стены. Боковые стены у границ размера ширины пропускаются." Style="{StaticResource SabCheckBoxStyle}" Margin="0" VerticalAlignment="Center" />
                </Grid>
              </StackPanel>
              <StackPanel Grid.Column="2" Grid.Row="0">
                <TextBlock Text="Полы" TextWrapping="Wrap" Style="{StaticResource SabFieldLabelTextStyle}" />
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <ComboBox x:Name="FloorTagTypeComboBox" DisplayMemberPath="DisplayName" Style="{StaticResource SabComboBoxStyle}" Margin="0" IsEnabled="{Binding IsChecked, ElementName=PlaceFloorTagsCheckBox}" VerticalAlignment="Center" />
                  <CheckBox x:Name="FloorLeaderCheckBox" Grid.Column="2" Content="С выноской" Style="{StaticResource SabCheckBoxStyle}" IsEnabled="{Binding IsChecked, ElementName=PlaceFloorTagsCheckBox}" Margin="0" VerticalAlignment="Center" />
                </Grid>
              </StackPanel>
              <StackPanel Grid.Column="4" Grid.Row="0">
                <TextBlock Text="Потолки" TextWrapping="Wrap" Style="{StaticResource SabFieldLabelTextStyle}" />
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <ComboBox x:Name="CeilingTagTypeComboBox" DisplayMemberPath="DisplayName" Style="{StaticResource SabComboBoxStyle}" Margin="0" IsEnabled="{Binding IsChecked, ElementName=PlaceCeilingTagsCheckBox}" VerticalAlignment="Center" />
                  <CheckBox x:Name="CeilingLeaderCheckBox" Grid.Column="2" Content="С выноской" Style="{StaticResource SabCheckBoxStyle}" IsEnabled="{Binding IsChecked, ElementName=PlaceCeilingTagsCheckBox}" Margin="0" VerticalAlignment="Center" />
                </Grid>
              </StackPanel>
              <StackPanel Grid.Column="0" Grid.Row="2">
                <TextBlock Text="Плинтусы" TextWrapping="Wrap" Style="{StaticResource SabFieldLabelTextStyle}" />
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <ComboBox x:Name="PlinthTagTypeComboBox" DisplayMemberPath="DisplayName" Style="{StaticResource SabComboBoxStyle}" Margin="0" IsEnabled="{Binding IsChecked, ElementName=PlacePlinthTagsCheckBox}" VerticalAlignment="Center" />
                  <CheckBox x:Name="PlinthLeaderCheckBox" Grid.Column="2" Content="С выноской" Style="{StaticResource SabCheckBoxStyle}" IsEnabled="{Binding IsChecked, ElementName=PlacePlinthTagsCheckBox}" Margin="0" VerticalAlignment="Center" />
                </Grid>
              </StackPanel>
              <StackPanel Grid.Column="2" Grid.Row="2">
                <TextBlock Text="Двери" TextWrapping="Wrap" Style="{StaticResource SabFieldLabelTextStyle}" />
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <ComboBox x:Name="DoorTagTypeComboBox" DisplayMemberPath="DisplayName" Style="{StaticResource SabComboBoxStyle}" Margin="0" IsEnabled="{Binding IsChecked, ElementName=PlaceDoorTagsCheckBox}" VerticalAlignment="Center" />
                  <CheckBox x:Name="DoorLeaderCheckBox" Grid.Column="2" Content="С выноской" Style="{StaticResource SabCheckBoxStyle}" IsEnabled="{Binding IsChecked, ElementName=PlaceDoorTagsCheckBox}" Margin="0" VerticalAlignment="Center" />
                </Grid>
              </StackPanel>
              <StackPanel Grid.Column="4" Grid.Row="2">
                <TextBlock Text="Окна" TextWrapping="Wrap" Style="{StaticResource SabFieldLabelTextStyle}" />
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <ComboBox x:Name="WindowTagTypeComboBox" DisplayMemberPath="DisplayName" Style="{StaticResource SabComboBoxStyle}" Margin="0" IsEnabled="{Binding IsChecked, ElementName=PlaceWindowTagsCheckBox}" VerticalAlignment="Center" />
                  <CheckBox x:Name="WindowLeaderCheckBox" Grid.Column="2" Content="С выноской" Style="{StaticResource SabCheckBoxStyle}" IsEnabled="{Binding IsChecked, ElementName=PlaceWindowTagsCheckBox}" Margin="0" VerticalAlignment="Center" />
                </Grid>
              </StackPanel>
            </Grid>
          </StackPanel>
        </GroupBox>
        <GroupBox Header="Готовность каталога" Margin="0,0,0,16">
          <StackPanel>
            <TextBlock x:Name="CatalogStatusTextBlock" TextWrapping="Wrap" Style="{StaticResource SabFieldLabelTextStyle}" />
            <TextBlock x:Name="CatalogDetailsTextBlock" Margin="0,8,0,0" TextWrapping="Wrap" Style="{StaticResource SabFieldHintTextStyle}" />
          </StackPanel>
        </GroupBox>
      </StackPanel>
    </ScrollViewer>
    <Grid Grid.Row="1" Margin="24,20,24,16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Text="Оформление развёрток" Style="{StaticResource SabWindowTitleTextStyle}" Margin="0" />
      <Button x:Name="ConfigureCatalogButton" Content="Каталог" Margin="16,0,0,0" HorizontalAlignment="Left" Style="{StaticResource SabPrimaryButtonStyle}" VerticalAlignment="Center" Grid.Column="1" />
    </Grid>
    <Border Background="White" BorderBrush="{DynamicResource SabBrush.Border}" BorderThickness="0,1,0,0" Padding="24,12" Grid.Row="3">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Style="{StaticResource SabInformationBorderStyle}" Margin="0,0,0,8">
          <TextBlock x:Name="ValidationStatusTextBlock" Text="Настройки готовы." Style="{StaticResource SabStatusTextStyle}" TextWrapping="Wrap" Margin="0,0,14,0" VerticalAlignment="Center" />
        </Border>
        <Grid Grid.Row="1">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Button Content="Инструкция" design:Instructions.File="SAB_HTML_Oformlenie_razvertok.html" />
          <WrapPanel Grid.Column="2" HorizontalAlignment="Right">
            <Button Content="Отмена" Margin="8,0,0,0" x:Name="CancelButton" />
            <Button Content="Оформить" Margin="8,0,0,0" x:Name="OkButton" Style="{StaticResource SabPrimaryButtonStyle}" />
          </WrapPanel>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</Window>
