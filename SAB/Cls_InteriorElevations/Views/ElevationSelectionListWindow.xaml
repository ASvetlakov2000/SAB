<?xml version='1.0' encoding='utf-8'?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:design="clr-namespace:SAB.UI.FluentLight;assembly=SAB" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="SAB · Список помещений" Width="860" Height="520" MinWidth="740" MinHeight="420" ResizeMode="CanResize" WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" FontSize="13" Background="{DynamicResource SabBrush.WindowBackground}" UseLayoutRounding="True">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../../UI/Styles/SABFluentLight.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>
  <Grid Background="{DynamicResource SabBrush.WindowBackground}" x:Name="WindowRoot">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Border Background="White" BorderBrush="{DynamicResource SabBrush.Border}" BorderThickness="0,0,0,1" Padding="24,12" x:Name="TitleBar">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="SAB" TextWrapping="Wrap" Style="{StaticResource SabPanelHeaderTextStyle}" />
        <TextBlock Grid.Column="1" Text="Развёртки" Foreground="{DynamicResource SabBrush.TextSecondary}" VerticalAlignment="Center" Margin="20,0,0,0" />
        <StackPanel Grid.Column="2" Orientation="Horizontal">
          <Button Visibility="Collapsed" x:Name="MinimizeWindowButton" />
          <Button Visibility="Collapsed" x:Name="CloseWindowButton" />
        </StackPanel>
      </Grid>
    </Border>
    <TextBlock Grid.Row="1" Text="Список помещений" Style="{StaticResource SabWindowTitleTextStyle}" Margin="24,20,24,16" />
    <Border Tag="CollectionFrame" Style="{StaticResource SabCollectionBorderStyle}" Grid.Row="2" Margin="24,0,24,16">
      <DataGrid x:Name="RoomsDataGrid" ItemsSource="{Binding Rows}" Style="{StaticResource SabDataGridStyle}" BorderThickness="0" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" SelectionUnit="FullRow" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" RowHeight="44" ColumnHeaderHeight="38" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto">
        <DataGrid.Columns>
          <DataGridTextColumn Header="№" Binding="{Binding Index}" Width="54" IsReadOnly="True" ElementStyle="{StaticResource SabDataGridCenteredTextBlockStyle}" HeaderStyle="{StaticResource SabCenteredHeaderStyle}" />
          <DataGridTextColumn Header="Номер помещения" Binding="{Binding RoomNumber}" Width="*" IsReadOnly="True" MinWidth="140">
            <DataGridTextColumn.ElementStyle>
              <Style TargetType="TextBlock" BasedOn="{StaticResource SabDataGridTextBlockStyle}">
                <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
              </Style>
            </DataGridTextColumn.ElementStyle>
          </DataGridTextColumn>
          <DataGridTextColumn Header="Имя помещения" Binding="{Binding RoomName}" Width="2*" IsReadOnly="True" MinWidth="160">
            <DataGridTextColumn.ElementStyle>
              <Style TargetType="TextBlock" BasedOn="{StaticResource SabDataGridTextBlockStyle}">
                <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
              </Style>
            </DataGridTextColumn.ElementStyle>
          </DataGridTextColumn>
          <DataGridTextColumn Header="Контуры" Binding="{Binding LineGroupsCount}" Width="100" IsReadOnly="True" ElementStyle="{StaticResource SabDataGridCenteredTextBlockStyle}" HeaderStyle="{StaticResource SabCenteredHeaderStyle}" />
          <DataGridTextColumn Header="Линии" Binding="{Binding SelectedLinesCount}" Width="84" IsReadOnly="True" ElementStyle="{StaticResource SabDataGridCenteredTextBlockStyle}" HeaderStyle="{StaticResource SabCenteredHeaderStyle}" />
          <DataGridTextColumn Header="Статус" Binding="{Binding StatusText}" Width="110" IsReadOnly="True" ElementStyle="{StaticResource SabDataGridCenteredTextBlockStyle}" HeaderStyle="{StaticResource SabCenteredHeaderStyle}" />
        </DataGrid.Columns>
      </DataGrid>
    </Border>
    <Border Grid.Row="3" Background="White" BorderBrush="{DynamicResource SabBrush.Border}" BorderThickness="0,1,0,0" Padding="24,12">
      <StackPanel>
        <Border Style="{StaticResource SabInformationBorderStyle}" Margin="0,0,0,8">
          <TextBlock Text="{Binding Totals}" TextWrapping="Wrap" />
        </Border>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Button Content="Инструкция" design:Instructions.File="SAB_HTML_Sozdanie_i_korrektirovka_razvertok.html" />
          <Button Content="Закрыть" Grid.Column="2" Style="{StaticResource SabPrimaryButtonStyle}" x:Name="DoneButton" />
        </Grid>
      </StackPanel>
    </Border>
  </Grid>
</Window>
