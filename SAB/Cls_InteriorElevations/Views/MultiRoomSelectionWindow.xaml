<?xml version='1.0' encoding='utf-8'?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:design="clr-namespace:SAB.UI.FluentLight;assembly=SAB" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="SAB · Список помещений" Width="1280" Height="740" MinWidth="960" MinHeight="520" ResizeMode="CanResize" WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" FontSize="13" Background="{DynamicResource SabBrush.WindowBackground}" UseLayoutRounding="True">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../../UI/Styles/SABFluentLight.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>
  <Grid Background="{DynamicResource SabBrush.WindowBackground}" x:Name="WindowRoot">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Border Background="White" BorderBrush="{DynamicResource SabBrush.Border}" BorderThickness="0,0,0,1" Padding="24,12" x:Name="TitleBar">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="SAB" TextWrapping="Wrap" Style="{StaticResource SabPanelHeaderTextStyle}" />
        <TextBlock Grid.Column="1" Text="Развёртки" Foreground="{DynamicResource SabBrush.TextSecondary}" VerticalAlignment="Center" Margin="20,0,0,0" />
        <StackPanel Grid.Column="2" Orientation="Horizontal">
          <Button Visibility="Collapsed" x:Name="MinimizeWindowButton" />
          <Button Visibility="Collapsed" x:Name="CloseWindowButton" />
        </StackPanel>
      </Grid>
    </Border>
    <TextBlock Grid.Row="1" Text="Список помещений" Style="{StaticResource SabWindowTitleTextStyle}" Margin="24,20,24,16" />
    <Border Tag="CollectionFrame" Style="{StaticResource SabCollectionBorderStyle}" Grid.Row="2" Margin="24,0,24,16">
      <DataGrid x:Name="RoomsDataGrid" ItemsSource="{Binding Rows}" Style="{StaticResource SabDataGridStyle}" BorderThickness="0" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" SelectionUnit="FullRow" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" RowHeight="44" ColumnHeaderHeight="38" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto">
        <DataGrid.Columns>
          <DataGridTextColumn Header="№" Width="54" Binding="{Binding Index}" ElementStyle="{StaticResource SabDataGridCenteredTextBlockStyle}" IsReadOnly="True" HeaderStyle="{StaticResource SabCenteredHeaderStyle}" />
          <DataGridTemplateColumn Header="Номер помещения" Width="*" MinWidth="150">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <Border Style="{StaticResource SabDataGridDisplayFieldBorderStyle}">
                  <TextBlock Text="{Binding RoomNumber}" ToolTip="{Binding RoomNumber}" Style="{StaticResource SabDataGridTextBlockStyle}" TextWrapping="Wrap" />
                </Border>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="Имя помещения" Width="2*" MinWidth="170">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <Border Style="{StaticResource SabDataGridDisplayFieldBorderStyle}">
                  <TextBlock Text="{Binding RoomName}" ToolTip="{Binding RoomName}" Style="{StaticResource SabDataGridTextBlockStyle}" TextWrapping="Wrap" />
                </Border>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Header="Групп линий" Width="105" Binding="{Binding LineGroupsCount}" ElementStyle="{StaticResource SabDataGridCenteredTextBlockStyle}" IsReadOnly="True" HeaderStyle="{StaticResource SabCenteredHeaderStyle}" />
          <DataGridTextColumn Header="Выбрано линий" Width="115" Binding="{Binding SelectedLinesCount}" ElementStyle="{StaticResource SabDataGridCenteredTextBlockStyle}" IsReadOnly="True" HeaderStyle="{StaticResource SabCenteredHeaderStyle}" />
          <DataGridTextColumn Header="Статус" Width="105" Binding="{Binding StatusText}" ElementStyle="{StaticResource SabDataGridCenteredTextBlockStyle}" IsReadOnly="True" HeaderStyle="{StaticResource SabCenteredHeaderStyle}" />
          <DataGridTemplateColumn Header="Действия" Width="200" CanUserResize="False" HeaderStyle="{StaticResource SabCenteredHeaderStyle}">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                  <Button x:Name="SelectRoomButton" Content="Выбрать" Tag="{Binding}" ToolTip="Выбрать линии и помещение для этой строки" Style="{StaticResource SabOutlineButtonStyle}" Margin="0,0,8,0" />
                  <Button x:Name="AddRoomButton" Tag="{Binding}" ToolTip="Добавить помещение" Style="{StaticResource SabRowAddButtonStyle}" Margin="0,0,8,0" Width="28" Height="28" AutomationProperties.Name="Добавить помещение">
                    <Path Data="M1 6 H11 M6 1 V11" Stroke="{DynamicResource SabBrush.TextSecondary}" StrokeThickness="1.4" Width="12" Height="12" Stretch="Uniform" />
                  </Button>
                  <Button x:Name="DeleteRoomButton" Tag="{Binding}" ToolTip="Удалить помещение" Style="{StaticResource SabRowDeleteButtonStyle}" Margin="0" Width="28" Height="28" AutomationProperties.Name="Удалить помещение">
                    <Path Data="M2 3 H10 M4 3 V1 H8 V3 M3 4 V11 H9 V4 M5 5 V9 M7 5 V9" Stroke="{DynamicResource SabBrush.TextSecondary}" StrokeThickness="1.4" Width="12" Height="12" Stretch="Uniform" />
                  </Button>
                </StackPanel>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>
    </Border>
    <Border Background="White" BorderBrush="{DynamicResource SabBrush.Border}" BorderThickness="0,1,0,0" Padding="24,12" Grid.Row="3">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Style="{StaticResource SabInformationBorderStyle}" Margin="0,0,0,8">
          <StackPanel>
            <TextBlock Text="{Binding ValidationText}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
        <Grid Grid.Row="1">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Button Content="Инструкция" design:Instructions.File="SAB_HTML_Sozdanie_i_korrektirovka_razvertok.html" />
          <WrapPanel Grid.Column="2" HorizontalAlignment="Right">
            <Button Content="Отмена" Margin="8,0,0,0" x:Name="CancelButton" />
            <Button Content="Передать список помещений" Margin="8,0,0,0" x:Name="TransferButton" Style="{StaticResource SabPrimaryButtonStyle}" />
          </WrapPanel>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</Window>
