<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="SAB Развертки стен"
        Height="860"
        Width="760"
        MinHeight="700"
        MinWidth="680"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        Style="{DynamicResource MaterialDesignWindow}"
        TextElement.Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
        Background="{DynamicResource MaterialDesign.Brush.Background}"
        TextElement.FontWeight="Medium"
        TextElement.FontSize="14">
    <Window.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.Light.xaml" />
                    <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign2.Defaults.xaml" />
                </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>
        </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="16">
                <TextBlock Text="Настройки создания разверток" FontSize="24" FontWeight="Bold" Margin="0,0,0,6" />
                <TextBlock Text="Заполните параметры вида, обрезки и листа перед созданием." Margin="0,0,0,16" Opacity="0.8" />

                <materialDesign:Card Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Параметры вида" FontSize="18" FontWeight="Bold" Margin="0,0,0,12" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <ComboBox Grid.Row="0" Grid.Column="0" Margin="0,0,8,8"
                                      materialDesign:HintAssist.Hint="Тип вида развертки"
                                      ItemsSource="{Binding ElevationViewFamilyTypes}"
                                      SelectedItem="{Binding SelectedElevationViewFamilyType}"
                                      DisplayMemberPath="DisplayName" />

                            <ComboBox Grid.Row="0" Grid.Column="1" Margin="8,0,0,8"
                                      materialDesign:HintAssist.Hint="Шаблон вида развертки"
                                      ItemsSource="{Binding ViewTemplates}"
                                      SelectedItem="{Binding SelectedViewTemplate}"
                                      DisplayMemberPath="DisplayName" />

                            <TextBox Grid.Row="1" Grid.Column="0" Margin="0,0,8,8"
                                     materialDesign:HintAssist.Hint="Масштаб вида"
                                     Text="{Binding ViewScaleText, UpdateSourceTrigger=PropertyChanged}" />

                            <ComboBox Grid.Row="1" Grid.Column="1" Margin="8,0,0,8"
                                      materialDesign:HintAssist.Hint="Тип марки угла на плане"
                                      ItemsSource="{Binding PlanCornerMarkTypes}"
                                      SelectedItem="{Binding SelectedPlanCornerMarkType}"
                                      DisplayMemberPath="DisplayName" />
                        </Grid>
                    </StackPanel>
                </materialDesign:Card>

                <materialDesign:Card Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Параметры обрезки" FontSize="18" FontWeight="Bold" Margin="0,0,0,12" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBox Grid.Row="0" Grid.Column="0" Margin="0,0,8,8"
                                     materialDesign:HintAssist.Hint="Верхний отступ (мм)"
                                     Text="{Binding TopOffsetMmText, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBox Grid.Row="0" Grid.Column="1" Margin="8,0,0,8"
                                     materialDesign:HintAssist.Hint="Нижний отступ (мм)"
                                     Text="{Binding BottomOffsetMmText, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBox Grid.Row="1" Grid.Column="0" Margin="0,0,8,8"
                                     materialDesign:HintAssist.Hint="Левый отступ (мм)"
                                     Text="{Binding LeftOffsetMmText, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBox Grid.Row="1" Grid.Column="1" Margin="8,0,0,8"
                                     materialDesign:HintAssist.Hint="Правый отступ (мм)"
                                     Text="{Binding RightOffsetMmText, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBox Grid.Row="2" Grid.Column="0" Margin="0,0,8,0"
                                     materialDesign:HintAssist.Hint="Дальний предел секущего диапазона (мм)"
                                     Text="{Binding ViewDepthMmText, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBox Grid.Row="2" Grid.Column="1" Margin="8,0,0,0"
                                     materialDesign:HintAssist.Hint="Отступ вида от линии (мм)"
                                     Text="{Binding MarkerOffsetMmText, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                    </StackPanel>
                </materialDesign:Card>

                <materialDesign:Card Padding="16" Margin="0,0,0,4">
                    <StackPanel>
                        <TextBlock Text="Параметры листа" FontSize="18" FontWeight="Bold" Margin="0,0,0,12" />

                        <CheckBox Content="Создать лист"
                                  IsChecked="{Binding CreateSheet}"
                                  Margin="0,0,0,12" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <ComboBox Grid.Row="0" Grid.Column="0" Margin="0,0,8,8"
                                      materialDesign:HintAssist.Hint="Тип основной надписи"
                                      ItemsSource="{Binding TitleBlockTypes}"
                                      SelectedItem="{Binding SelectedTitleBlockType}"
                                      DisplayMemberPath="DisplayName"
                                      IsEnabled="{Binding CreateSheet}" />

                            <ComboBox Grid.Row="0" Grid.Column="1" Margin="8,0,0,8"
                                      materialDesign:HintAssist.Hint="Тип марки угла на листе"
                                      ItemsSource="{Binding SheetCornerMarkTypes}"
                                      SelectedItem="{Binding SelectedSheetCornerMarkType}"
                                      DisplayMemberPath="DisplayName"
                                      IsEnabled="{Binding CreateSheet}" />

                            <TextBox Grid.Row="1" Grid.Column="0" Margin="0,0,8,8"
                                     materialDesign:HintAssist.Hint="Количество колонок"
                                     Text="{Binding ColumnsCountText, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding CreateSheet}" />

                            <TextBox Grid.Row="1" Grid.Column="1" Margin="8,0,0,8"
                                     materialDesign:HintAssist.Hint="Старт X (мм)"
                                     Text="{Binding StartXmmText, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding CreateSheet}" />

                            <TextBox Grid.Row="2" Grid.Column="0" Margin="0,0,8,8"
                                     materialDesign:HintAssist.Hint="Старт Y (мм)"
                                     Text="{Binding StartYmmText, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding CreateSheet}" />

                            <TextBox Grid.Row="2" Grid.Column="1" Margin="8,0,0,8"
                                     materialDesign:HintAssist.Hint="Шаг X (мм)"
                                     Text="{Binding StepXmmText, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding CreateSheet}" />

                            <TextBox Grid.Row="3" Grid.Column="0" Margin="0,0,8,0"
                                     materialDesign:HintAssist.Hint="Шаг Y (мм)"
                                     Text="{Binding StepYmmText, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding CreateSheet}" />
                        </Grid>
                    </StackPanel>
                </materialDesign:Card>
            </StackPanel>
        </ScrollViewer>

        <DockPanel Grid.Row="1" Margin="16,8,16,16" LastChildFill="False">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                <Button x:Name="CancelButton" Width="130" Height="36" Margin="0,0,8,0" Content="Отмена" />
                <Button x:Name="OkButton" Width="180" Height="36" Content="Создать развертки" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
