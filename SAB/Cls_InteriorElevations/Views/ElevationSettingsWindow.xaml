<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SAB Развертки стен"
        Height="650"
        Width="920"
        MinHeight="560"
        MinWidth="760"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        FontFamily="Segoe UI"
        FontSize="13"
        Background="{DynamicResource SabBrush.WindowBackground}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../UI/Styles/SABWindowStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="SabSelectionPendingPanelStyle"
                   TargetType="{x:Type Border}"
                   BasedOn="{StaticResource SabValidationPanelStyle}">
                <Setter Property="Background" Value="{StaticResource SabBrush.PanelBackground}" />
                <Setter Property="BorderBrush" Value="{StaticResource SabBrush.Border}" />
            </Style>

            <Style x:Key="SabAccentInfoPanelStyle"
                   TargetType="{x:Type Border}"
                   BasedOn="{StaticResource SabValidationPanelStyle}">
                <Setter Property="Background" Value="{StaticResource SabBrush.AccentLight}" />
                <Setter Property="BorderBrush" Value="{StaticResource SabBrush.Accent}" />
                <Setter Property="BorderThickness" Value="1.5" />
            </Style>

            <Style x:Key="SabSelectionPendingTextStyle"
                   TargetType="{x:Type TextBlock}"
                   BasedOn="{StaticResource SabFieldHintTextStyle}">
                <Setter Property="Foreground" Value="{StaticResource SabBrush.TextSecondary}" />
            </Style>

            <Style x:Key="SabAccentInfoTextStyle"
                   TargetType="{x:Type TextBlock}"
                   BasedOn="{StaticResource SabFieldHintTextStyle}">
                <Setter Property="Foreground" Value="{StaticResource SabBrush.Accent}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <Style x:Key="SabCompactSectionStyle"
                   TargetType="{x:Type Border}"
                   BasedOn="{StaticResource SabPanelBorderStyle}">
                <Setter Property="Padding" Value="12" />
                <Setter Property="Margin" Value="0,0,0,10" />
            </Style>

            <SolidColorBrush x:Key="SabBrush.FormulaText" Color="#C65911" />

            <Style x:Key="SabFormulaEditorBorderStyle" TargetType="{x:Type Border}">
                <Setter Property="Background" Value="{StaticResource SabBrush.PanelBackground}" />
                <Setter Property="BorderBrush" Value="{StaticResource SabBrush.Border}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="5" />
                <Style.Triggers>
                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                        <Setter Property="BorderBrush" Value="{StaticResource SabBrush.Accent}" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="SabFormulaEditorStyle" TargetType="{x:Type RichTextBox}">
                <Setter Property="Height" Value="34" />
                <Setter Property="Padding" Value="8,5" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{StaticResource SabBrush.FormulaText}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="AcceptsReturn" Value="False" />
                <Setter Property="VerticalScrollBarVisibility" Value="Disabled" />
                <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
            </Style>

            <Style x:Key="ElevationTabControlStyle" TargetType="{x:Type TabControl}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0" />
            </Style>

            <Style x:Key="ElevationTabItemStyle" TargetType="{x:Type TabItem}">
                <Setter Property="Foreground" Value="{DynamicResource SabBrush.TextSecondary}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="FontWeight" Value="Normal" />
                <Setter Property="Padding" Value="10,7,10,9" />
                <Setter Property="Margin" Value="0,0,6,0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type TabItem}">
                            <Grid Background="Transparent">
                                <ContentPresenter ContentSource="Header"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Margin="{TemplateBinding Padding}" />
                                <Border x:Name="SelectedLine"
                                        Height="2"
                                        Background="{DynamicResource SabBrush.Accent}"
                                        VerticalAlignment="Bottom"
                                        Visibility="Collapsed" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource SabBrush.Accent}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource SabBrush.Accent}" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                    <Setter TargetName="SelectedLine" Property="Visibility" Value="Visible" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Style="{StaticResource SabCompactSectionStyle}"
                Margin="18,16,18,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,9">
                    <Border Style="{StaticResource SabPanelIconBorderStyle}">
                        <TextBlock Text="☷" Style="{StaticResource SabPanelIconTextStyle}" />
                    </Border>
                    <TextBlock Text="Исходные данные" Style="{StaticResource SabPanelHeaderTextStyle}" />
                </StackPanel>

                <Grid Grid.Row="1" Margin="0,0,0,9">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Помещения за один запуск" Style="{StaticResource SabFieldLabelTextStyle}" />
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="Одно помещение"
                                         GroupName="RoomSelectionMode"
                                         IsChecked="{Binding IsSingleRoomPerSheet, Mode=TwoWay}"
                                         Style="{StaticResource SabRadioButtonStyle}"
                                         Margin="0,0,10,0" />
                            <RadioButton Content="Несколько помещений"
                                         GroupName="RoomSelectionMode"
                                         IsChecked="{Binding IsMultipleRoomsOnSheet, Mode=TwoWay}"
                                         Style="{StaticResource SabRadioButtonStyle}"
                                         Margin="0" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Источник помещения" Style="{StaticResource SabFieldLabelTextStyle}" />
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="Текущая модель"
                                         GroupName="RoomSourceMode"
                                         IsChecked="{Binding PickRoomFromHost, Mode=TwoWay}"
                                         Style="{StaticResource SabRadioButtonStyle}"
                                         Margin="0,0,10,0" />
                            <RadioButton Content="Связанный файл"
                                         GroupName="RoomSourceMode"
                                         IsChecked="{Binding PickRoomFromLink, Mode=TwoWay}"
                                         Style="{StaticResource SabRadioButtonStyle}"
                                         Margin="0" />
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="SelectionStatusBorder"
                            Grid.Column="0"
                            Style="{StaticResource SabSelectionPendingPanelStyle}"
                            Padding="10,7">
                        <TextBlock x:Name="SelectionStatusTextBlock"
                                   Text="Линии и помещение не выбраны."
                                   TextTrimming="CharacterEllipsis"
                                   Style="{StaticResource SabSelectionPendingTextStyle}" />
                    </Border>
                    <Button x:Name="PickLinesButton"
                            Grid.Column="2"
                            Content="Выбрать / изменить"
                            Width="155"
                            Style="{StaticResource SabOutlineButtonStyle}" />
                </Grid>
            </Grid>
        </Border>

        <TabControl Grid.Row="1"
                    Margin="18,0,18,10"
                    Style="{StaticResource ElevationTabControlStyle}"
                    ItemContainerStyle="{StaticResource ElevationTabItemStyle}">
            <TabItem Header="Развертки">
                <Border Style="{StaticResource SabPanelBorderStyle}" Margin="0,9,0,0" Padding="0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="14,14,10,4">
                            <Border Style="{StaticResource SabCompactSectionStyle}">
                                <StackPanel>
                                    <TextBlock Text="Наименование вида" Style="{StaticResource SabPanelHeaderTextStyle}" Margin="0,0,0,10" />
                                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,9" Style="{StaticResource SabFieldHintTextStyle}">
                                        <Run Text="Введите обычный текст как есть. Параметры пишите в квадратных скобках. Синий текст — параметр распознан, оранжевый — обычный текст." />
                                    </TextBlock>
                                    <TextBlock Text="Формула имени вида" Style="{StaticResource SabFieldLabelTextStyle}" />
                                    <Border Style="{StaticResource SabFormulaEditorBorderStyle}" Margin="0,0,0,10">
                                        <RichTextBox x:Name="ElevationNameFormulaEditor"
                                                     Style="{StaticResource SabFormulaEditorStyle}" />
                                    </Border>
                                    <TextBlock Text="Заголовок вида" Style="{StaticResource SabFieldLabelTextStyle}" />
                                    <Border Style="{StaticResource SabFormulaEditorBorderStyle}">
                                        <RichTextBox x:Name="ElevationTitleFormulaEditor"
                                                     Style="{StaticResource SabFormulaEditorStyle}" />
                                    </Border>
                                    <TextBlock TextWrapping="Wrap" Margin="0,7,0,0" Style="{StaticResource SabFieldHintTextStyle}">
                                        <Run Text="Доступно: " />
                                        <Run Text="[Номер помещения]" Foreground="{StaticResource SabBrush.Accent}" FontWeight="SemiBold" />
                                        <Run Text="  " />
                                        <Run Text="[Имя помещения]" Foreground="{StaticResource SabBrush.Accent}" FontWeight="SemiBold" />
                                        <Run Text="  " />
                                        <Run Text="[Начальный угол]" Foreground="{StaticResource SabBrush.Accent}" FontWeight="SemiBold" />
                                        <Run Text="  " />
                                        <Run Text="[Конечный угол]" Foreground="{StaticResource SabBrush.Accent}" FontWeight="SemiBold" />
                                    </TextBlock>

                                    <Border BorderBrush="{StaticResource SabBrush.Border}"
                                            BorderThickness="0,1,0,0"
                                            Margin="0,11,0,0"
                                            Padding="0,10,0,0">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Результат наименований"
                                                           Style="{StaticResource SabFieldLabelTextStyle}"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding NamingPreviewStatusText}"
                                                           Style="{StaticResource SabFieldHintTextStyle}" />
                                            </Grid>

                                            <Border MaxHeight="170"
                                                    BorderBrush="{StaticResource SabBrush.Border}"
                                                    BorderThickness="1"
                                                    CornerRadius="5">
                                                <Border.Style>
                                                    <Style TargetType="{x:Type Border}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasNamingPreview}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                              HorizontalScrollBarVisibility="Disabled">
                                                    <ItemsControl ItemsSource="{Binding NamingPreviewItems}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid Margin="8,6">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="100" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="12" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{Binding SequenceText}"
                                                                               Foreground="{StaticResource SabBrush.TextSecondary}"
                                                                               VerticalAlignment="Top" />
                                                                    <StackPanel Grid.Column="1">
                                                                        <TextBlock Text="Имя вида" Style="{StaticResource SabFieldHintTextStyle}" />
                                                                        <TextBlock Text="{Binding ViewName}"
                                                                                   Foreground="{StaticResource SabBrush.Text}"
                                                                                   TextWrapping="Wrap" />
                                                                    </StackPanel>
                                                                    <StackPanel Grid.Column="3">
                                                                        <TextBlock Text="Заголовок вида" Style="{StaticResource SabFieldHintTextStyle}" />
                                                                        <TextBlock Text="{Binding ViewTitle}"
                                                                                   Foreground="{StaticResource SabBrush.Text}"
                                                                                   TextWrapping="Wrap" />
                                                                    </StackPanel>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </ScrollViewer>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SabCompactSectionStyle}">
                                <StackPanel>
                                    <TextBlock Text="Параметры вида" Style="{StaticResource SabPanelHeaderTextStyle}" Margin="0,0,0,10" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="14" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="10" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <StackPanel Grid.Row="0" Grid.Column="0">
                                            <TextBlock Text="Тип вида развертки" Style="{StaticResource SabFieldLabelTextStyle}" />
                                            <ComboBox ItemsSource="{Binding ElevationViewFamilyTypes}"
                                                      SelectedItem="{Binding SelectedElevationViewFamilyType}"
                                                      DisplayMemberPath="DisplayName"
                                                      ToolTip="{Binding SelectedElevationViewFamilyType.DisplayName}"
                                                      Style="{StaticResource SabComboBoxStyle}" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="0" Grid.Column="2">
                                            <TextBlock Text="Шаблон вида" Style="{StaticResource SabFieldLabelTextStyle}" />
                                            <ComboBox ItemsSource="{Binding ViewTemplates}"
                                                      SelectedItem="{Binding SelectedViewTemplate}"
                                                      DisplayMemberPath="DisplayName"
                                                      ToolTip="{Binding SelectedViewTemplate.DisplayName}"
                                                      Style="{StaticResource SabComboBoxStyle}" />
                                        </StackPanel>

                                        <Grid Grid.Row="2" Grid.Column="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="10" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Масштаб" Style="{StaticResource SabFieldLabelTextStyle}" />
                                                <TextBox Text="{Binding ViewScaleText, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource SabTextBoxStyle}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Глубина, мм" Style="{StaticResource SabFieldLabelTextStyle}" />
                                                <TextBox Text="{Binding ViewDepthMmText, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource SabTextBoxStyle}" />
                                            </StackPanel>
                                        </Grid>
                                        <StackPanel Grid.Row="2" Grid.Column="2">
                                            <TextBlock Text="Отступ вида от линии, мм" Style="{StaticResource SabFieldLabelTextStyle}" />
                                            <TextBox Text="{Binding MarkerOffsetMmText, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource SabTextBoxStyle}" />
                                        </StackPanel>

                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SabCompactSectionStyle}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Подрезка вида" Style="{StaticResource SabPanelHeaderTextStyle}" VerticalAlignment="Center" />
                                        <Button x:Name="PickCropByExampleButton"
                                                Grid.Column="1"
                                                Content="Взять высоту с вида-примера"
                                                Style="{StaticResource SabOutlineButtonStyle}"
                                                MinWidth="210" />
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Сверху, мм" Style="{StaticResource SabFieldLabelTextStyle}" />
                                            <TextBox Text="{Binding TopOffsetMmText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SabTextBoxStyle}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Снизу, мм" Style="{StaticResource SabFieldLabelTextStyle}" />
                                            <TextBox Text="{Binding BottomOffsetMmText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SabTextBoxStyle}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="4">
                                            <TextBlock Text="Слева, мм" Style="{StaticResource SabFieldLabelTextStyle}" />
                                            <TextBox Text="{Binding LeftOffsetMmText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SabTextBoxStyle}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="6">
                                            <TextBlock Text="Справа, мм" Style="{StaticResource SabFieldLabelTextStyle}" />
                                            <TextBox Text="{Binding RightOffsetMmText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SabTextBoxStyle}" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </TabItem>

            <TabItem Header="Лист">
                <Border Style="{StaticResource SabPanelBorderStyle}" Margin="0,9,0,0" Padding="0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="14,14,10,4">
                            <Border Style="{StaticResource SabCompactSectionStyle}">
                                <StackPanel>
                                    <TextBlock Text="Размещение" Style="{StaticResource SabPanelHeaderTextStyle}" Margin="0,0,0,10" />
                                    <WrapPanel Margin="0,0,0,10">
                                        <RadioButton Content="Не размещать на листе"
                                                     GroupName="SheetPlacementMode"
                                                     IsChecked="{Binding DoNotPlaceViewsOnSheetMode, Mode=TwoWay}"
                                                     Style="{StaticResource SabRadioButtonStyle}"
                                                     Margin="0,0,18,0" />
                                        <RadioButton Content="Создать новый лист"
                                                     GroupName="SheetPlacementMode"
                                                     IsChecked="{Binding CreateNewSheetMode, Mode=TwoWay}"
                                                     Style="{StaticResource SabRadioButtonStyle}"
                                                     Margin="0,0,18,0" />
                                        <RadioButton Content="Добавить на существующий лист"
                                                     GroupName="SheetPlacementMode"
                                                     IsChecked="{Binding ExistingSheetMode, Mode=TwoWay}"
                                                     Style="{StaticResource SabRadioButtonStyle}"
                                                     Margin="0" />
                                    </WrapPanel>
                                    <CheckBox Content="Открыть целевой лист после выполнения"
                                              IsChecked="{Binding OpenCreatedSheet}"
                                              IsEnabled="{Binding PlaceViewsOnSheet}"
                                              Style="{StaticResource SabCheckBoxStyle}" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SabCompactSectionStyle}">
                                <StackPanel>
                                    <TextBlock Text="Целевой лист" Style="{StaticResource SabPanelHeaderTextStyle}" Margin="0,0,0,10" />

                                    <StackPanel>
                                        <StackPanel.Style>
                                            <Style TargetType="{x:Type StackPanel}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CreateSheet}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="14" />
                                                <ColumnDefinition Width="160" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Тип основной надписи" Style="{StaticResource SabFieldLabelTextStyle}" />
                                                <ComboBox ItemsSource="{Binding TitleBlockTypes}"
                                                          SelectedItem="{Binding SelectedTitleBlockType}"
                                                          DisplayMemberPath="DisplayName"
                                                          ToolTip="{Binding SelectedTitleBlockType.DisplayName}"
                                                          Style="{StaticResource SabComboBoxStyle}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Формат листа (А)" Style="{StaticResource SabFieldLabelTextStyle}" />
                                                <TextBox Text="{Binding SheetFormatAText, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource SabTextBoxStyle}" />
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Text="Формула имени листа" Style="{StaticResource SabFieldLabelTextStyle}" Margin="0,10,0,0" />
                                        <Border Style="{StaticResource SabFormulaEditorBorderStyle}">
                                            <RichTextBox x:Name="SheetNameFormulaEditor"
                                                         Style="{StaticResource SabFormulaEditorStyle}" />
                                        </Border>
                                        <TextBlock Text="Доступно: [Номер помещения], [Имя помещения], [Помещения]"
                                                   Style="{StaticResource SabFieldHintTextStyle}"
                                                   Margin="0,5,0,0" />
                                    </StackPanel>

                                    <StackPanel>
                                        <StackPanel.Style>
                                            <Style TargetType="{x:Type StackPanel}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding UseExistingSheet}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Text="Номер или имя листа" Style="{StaticResource SabFieldLabelTextStyle}" />
                                        <ComboBox ItemsSource="{Binding ExistingSheetsView}"
                                                  SelectedItem="{Binding SelectedExistingSheet, Mode=TwoWay}"
                                                  Text="{Binding ExistingSheetSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  IsDropDownOpen="{Binding IsExistingSheetDropDownOpen, Mode=TwoWay}"
                                                  DisplayMemberPath="DisplayName"
                                                  IsEditable="True"
                                                  IsTextSearchEnabled="False"
                                                  StaysOpenOnEdit="True"
                                                  ToolTip="Введите часть номера или имени листа"
                                                  Style="{StaticResource SabComboBoxStyle}" />
                                        <TextBlock Text="Список фильтруется по номеру и имени по мере ввода."
                                                   Style="{StaticResource SabFieldHintTextStyle}"
                                                   Margin="0,5,0,0" />
                                    </StackPanel>

                                    <TextBlock Text="Выберите способ размещения выше.">
                                        <TextBlock.Style>
                                            <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource SabFieldHintTextStyle}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DoNotPlaceViewsOnSheetMode}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SabCompactSectionStyle}" IsEnabled="{Binding PlaceViewsOnSheet}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Раскладка видов" Style="{StaticResource SabPanelHeaderTextStyle}" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <TextBlock Text="Точка: " Style="{StaticResource SabFieldHintTextStyle}" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding SheetPointSummary}" Style="{StaticResource SabFieldHintTextStyle}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                            <Button x:Name="PickSheetPointButton"
                                                    Content="{Binding PickSheetPointButtonText}"
                                                    Style="{StaticResource SabOutlineButtonStyle}"
                                                    MinWidth="190" />
                                        </StackPanel>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <StackPanel.Style>
                                            <Style TargetType="{x:Type StackPanel}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding UseExistingSheet}" Value="True" />
                                                            <Condition Binding="{Binding CreateRoomPlanScheme}" Value="True" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Text="План-схема: " Style="{StaticResource SabFieldHintTextStyle}" />
                                        <TextBlock Text="{Binding ExistingRoomPlanSummary}" Style="{StaticResource SabFieldHintTextStyle}" />
                                    </StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Колонки" Style="{StaticResource SabFieldLabelTextStyle}" />
                                            <TextBox Text="{Binding ColumnsCountText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SabTextBoxStyle}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Старт X, мм" Style="{StaticResource SabFieldLabelTextStyle}" />
                                            <TextBox Text="{Binding StartXmmText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SabTextBoxStyle}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="4">
                                            <TextBlock Text="Старт Y, мм" Style="{StaticResource SabFieldLabelTextStyle}" />
                                            <TextBox Text="{Binding StartYmmText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SabTextBoxStyle}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="6">
                                            <TextBlock Text="Зазор X, мм" Style="{StaticResource SabFieldLabelTextStyle}" />
                                            <TextBox Text="{Binding StepXmmText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SabTextBoxStyle}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="8">
                                            <TextBlock Text="Зазор Y, мм" Style="{StaticResource SabFieldLabelTextStyle}" />
                                            <TextBox Text="{Binding StepYmmText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SabTextBoxStyle}" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SabCompactSectionStyle}" IsEnabled="{Binding PlaceViewsOnSheet}">
                                <StackPanel>
                                    <TextBlock Text="Оформление видового экрана" Style="{StaticResource SabPanelHeaderTextStyle}" Margin="0,0,0,10" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="120" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Тип видового экрана" Style="{StaticResource SabFieldLabelTextStyle}" />
                                            <ComboBox ItemsSource="{Binding ViewportTypes}"
                                                      SelectedItem="{Binding SelectedViewportType}"
                                                      DisplayMemberPath="DisplayName"
                                                      ToolTip="{Binding SelectedViewportType.DisplayName}"
                                                      Style="{StaticResource SabComboBoxStyle}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Привязка заголовка" Style="{StaticResource SabFieldLabelTextStyle}" />
                                            <ComboBox ItemsSource="{Binding ViewTitleAnchors}"
                                                      SelectedItem="{Binding SelectedViewTitleAnchor}"
                                                      DisplayMemberPath="DisplayName"
                                                      Style="{StaticResource SabComboBoxStyle}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="4">
                                            <TextBlock Text="Смещение X, мм" Style="{StaticResource SabFieldLabelTextStyle}" />
                                            <TextBox Text="{Binding ViewTitleOffsetXmmText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SabTextBoxStyle}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="6">
                                            <TextBlock Text="Смещение Y, мм" Style="{StaticResource SabFieldLabelTextStyle}" />
                                            <TextBox Text="{Binding ViewTitleOffsetYmmText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SabTextBoxStyle}" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </TabItem>

            <TabItem Header="План-схема">
                <Border Style="{StaticResource SabPanelBorderStyle}" Margin="0,9,0,0" Padding="0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="14,14,10,4">
                            <Border Style="{StaticResource SabCompactSectionStyle}">
                                <StackPanel>
                                    <TextBlock Text="Создание и размещение" Style="{StaticResource SabPanelHeaderTextStyle}" Margin="0,0,0,10" />
                                    <WrapPanel>
                                        <CheckBox Content="{Binding RoomPlanOperationLabel}"
                                                  IsChecked="{Binding CreateRoomPlanScheme}"
                                                  Style="{StaticResource SabCheckBoxStyle}"
                                                  Margin="0,0,24,0" />
                                        <CheckBox Content="Разместить план-схему на листе"
                                                  IsChecked="{Binding PlaceRoomPlanSchemeOnSheet}"
                                                  IsEnabled="{Binding CanPlaceRoomPlanSchemeOnSheet}">
                                            <CheckBox.Style>
                                                <Style TargetType="{x:Type CheckBox}" BasedOn="{StaticResource SabCheckBoxStyle}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding UseExistingSheet}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </CheckBox.Style>
                                        </CheckBox>
                                    </WrapPanel>
                                    <TextBlock Text="{Binding RoomPlanModeHint}"
                                               Style="{StaticResource SabFieldHintTextStyle}"
                                               Margin="0,6,0,0" />
                                    <CheckBox Content="Включать категорию «Помещения / Объект» перед выбором помещения"
                                              IsChecked="{Binding EnableRoomObjectCategory}"
                                              Style="{StaticResource SabCheckBoxStyle}"
                                              Margin="0,10,0,0"
                                              ToolTip="Если выключено, плагин не изменяет видимость подкатегории «Объект» на виде и в его шаблоне." />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SabCompactSectionStyle}" IsEnabled="{Binding CanEditRoomPlanCreationParameters}">
                                <StackPanel>
                                    <TextBlock Text="Параметры план-схемы" Style="{StaticResource SabPanelHeaderTextStyle}" Margin="0,0,0,10" />
                                    <TextBlock Text="Формула имени вида" Style="{StaticResource SabFieldLabelTextStyle}" />
                                    <Border Style="{StaticResource SabFormulaEditorBorderStyle}" Margin="0,0,0,10">
                                        <RichTextBox x:Name="RoomPlanNameFormulaEditor"
                                                     Style="{StaticResource SabFormulaEditorStyle}" />
                                    </Border>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="160" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Шаблон вида" Style="{StaticResource SabFieldLabelTextStyle}" />
                                            <ComboBox ItemsSource="{Binding RoomPlanViewTemplates}"
                                                      SelectedItem="{Binding SelectedRoomPlanViewTemplate}"
                                                      DisplayMemberPath="DisplayName"
                                                      ToolTip="{Binding SelectedRoomPlanViewTemplate.DisplayName}"
                                                      Style="{StaticResource SabComboBoxStyle}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Масштаб" Style="{StaticResource SabFieldLabelTextStyle}" />
                                            <TextBox Text="{Binding RoomPlanViewScaleText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SabTextBoxStyle}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="4">
                                            <TextBlock Text="Отступ обрезки, мм" Style="{StaticResource SabFieldLabelTextStyle}" />
                                            <TextBox Text="{Binding RoomPlanCropOffsetMmText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SabTextBoxStyle}" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="Тип марки помещения" Style="{StaticResource SabFieldLabelTextStyle}" Margin="0,10,0,0" />
                                    <ComboBox ItemsSource="{Binding RoomPlanRoomTagTypes}"
                                              SelectedItem="{Binding SelectedRoomPlanRoomTagType}"
                                              DisplayMemberPath="DisplayName"
                                              ToolTip="{Binding SelectedRoomPlanRoomTagType.DisplayName}"
                                              Style="{StaticResource SabComboBoxStyle}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </TabItem>

            <TabItem Header="Марки">
                <Border Style="{StaticResource SabPanelBorderStyle}" Margin="0,9,0,0" Padding="0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="14,14,10,4">
                            <Border Style="{StaticResource SabCompactSectionStyle}">
                                <StackPanel>
                                    <TextBlock Text="Марки углов на плане" Style="{StaticResource SabPanelHeaderTextStyle}" Margin="0,0,0,10" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="20" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Тип марки" Style="{StaticResource SabFieldLabelTextStyle}" />
                                            <ComboBox ItemsSource="{Binding PlanCornerMarkTypes}"
                                                      SelectedItem="{Binding SelectedPlanCornerMarkType}"
                                                      DisplayMemberPath="DisplayName"
                                                      ToolTip="{Binding SelectedPlanCornerMarkType.DisplayName}"
                                                      Style="{StaticResource SabComboBoxStyle}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Состав подписи" Style="{StaticResource SabFieldLabelTextStyle}" />
                                            <RadioButton Content="Номер помещения и номер угла"
                                                         GroupName="CornerMarkLabelMode"
                                                         IsChecked="{Binding CornerMarksWithRoomNumber, Mode=TwoWay}"
                                                         Style="{StaticResource SabRadioButtonStyle}"
                                                         Margin="0,0,0,7" />
                                            <RadioButton Content="Только номер угла"
                                                         GroupName="CornerMarkLabelMode"
                                                         IsChecked="{Binding CornerMarksOnlyCornerNumber, Mode=TwoWay}"
                                                         Style="{StaticResource SabRadioButtonStyle}" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SabCompactSectionStyle}" IsEnabled="{Binding PlaceViewsOnSheet}">
                                <StackPanel>
                                    <TextBlock Text="Марки углов на листе" Style="{StaticResource SabPanelHeaderTextStyle}" Margin="0,0,0,10" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="20" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Тип марки" Style="{StaticResource SabFieldLabelTextStyle}" />
                                            <ComboBox ItemsSource="{Binding SheetCornerMarkTypes}"
                                                      SelectedItem="{Binding SelectedSheetCornerMarkType}"
                                                      DisplayMemberPath="DisplayName"
                                                      ToolTip="{Binding SelectedSheetCornerMarkType.DisplayName}"
                                                      Style="{StaticResource SabComboBoxStyle}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Положение относительно вида" Style="{StaticResource SabFieldLabelTextStyle}" />
                                            <RadioButton Content="Над видом"
                                                         GroupName="SheetCornerMarkPosition"
                                                         IsChecked="{Binding SheetCornerMarksAboveView, Mode=TwoWay}"
                                                         Style="{StaticResource SabRadioButtonStyle}"
                                                         Margin="0,0,0,7" />
                                            <RadioButton Content="Под видом"
                                                         GroupName="SheetCornerMarkPosition"
                                                         IsChecked="{Binding SheetCornerMarksBelowView, Mode=TwoWay}"
                                                         Style="{StaticResource SabRadioButtonStyle}" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </TabItem>
        </TabControl>

        <Border x:Name="WarningInfoBorder"
                Grid.Row="2"
                Style="{StaticResource SabAccentInfoPanelStyle}"
                Margin="18,0,18,10"
                Padding="10,7">
            <TextBlock x:Name="WarningInfoTextBlock"
                       Text="Перед созданием выберите линии и помещение."
                       TextWrapping="Wrap"
                       MaxHeight="48"
                       Style="{StaticResource SabAccentInfoTextStyle}" />
        </Border>

        <Border Grid.Row="3"
                Background="{StaticResource SabBrush.PanelBackground}"
                BorderBrush="{StaticResource SabBrush.Border}"
                BorderThickness="0,1,0,0"
                Padding="18,9">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Настройки сохраняются для следующего запуска."
                           Style="{StaticResource SabStatusTextStyle}"
                           VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="CancelButton"
                            Content="Отмена"
                            Width="110"
                            Style="{StaticResource SabNeutralButtonStyle}"
                            Margin="0,0,10,0" />
                    <Button x:Name="OkButton"
                            Content="Создать развертки"
                            Width="170"
                            IsEnabled="False"
                            Style="{StaticResource SabPrimaryButtonStyle}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
