<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SAB Развертки стен"
        Height="760"
        Width="680"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <GroupBox Grid.Row="0" Header="Параметры вида" Margin="0,0,0,8">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,8,8" VerticalAlignment="Center" Text="Тип вида развертки:" />
                    <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,8"
                              ItemsSource="{Binding ElevationViewFamilyTypes}"
                              SelectedItem="{Binding SelectedElevationViewFamilyType}"
                              DisplayMemberPath="DisplayName" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,0,8,8" VerticalAlignment="Center" Text="Шаблон вида развертки:" />
                    <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,8"
                              ItemsSource="{Binding ViewTemplates}"
                              SelectedItem="{Binding SelectedViewTemplate}"
                              DisplayMemberPath="DisplayName" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,0,8,8" VerticalAlignment="Center" Text="Масштаб вида:" />
                    <TextBox Grid.Row="2" Grid.Column="1" Margin="0,0,0,8" Text="{Binding ViewScaleText, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,0,8,0" VerticalAlignment="Center" Text="Тип марки угла на плане:" />
                    <ComboBox Grid.Row="3" Grid.Column="1"
                              ItemsSource="{Binding PlanCornerMarkTypes}"
                              SelectedItem="{Binding SelectedPlanCornerMarkType}"
                              DisplayMemberPath="DisplayName" />
                </Grid>
            </GroupBox>

            <GroupBox Grid.Row="1" Header="Параметры обрезки" Margin="0,0,0,8">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,8,8" VerticalAlignment="Center" Text="Верхний отступ (мм):" />
                    <TextBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,8" Text="{Binding TopOffsetMmText, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,0,8,8" VerticalAlignment="Center" Text="Нижний отступ (мм):" />
                    <TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,8" Text="{Binding BottomOffsetMmText, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,0,8,8" VerticalAlignment="Center" Text="Левый отступ (мм):" />
                    <TextBox Grid.Row="2" Grid.Column="1" Margin="0,0,0,8" Text="{Binding LeftOffsetMmText, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,0,8,8" VerticalAlignment="Center" Text="Правый отступ (мм):" />
                    <TextBox Grid.Row="3" Grid.Column="1" Margin="0,0,0,8" Text="{Binding RightOffsetMmText, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="4" Grid.Column="0" Margin="0,0,8,8" VerticalAlignment="Center" Text="Дальний предел секущего диапазона (мм):" />
                    <TextBox Grid.Row="4" Grid.Column="1" Margin="0,0,0,8" Text="{Binding ViewDepthMmText, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="5" Grid.Column="0" Margin="0,0,8,0" VerticalAlignment="Center" Text="Отступ вида от линии (мм):" />
                    <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding MarkerOffsetMmText, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
            </GroupBox>

            <GroupBox Grid.Row="2" Header="Параметры листа" Margin="0,0,0,8">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <CheckBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,8"
                              Content="Создать лист"
                              IsChecked="{Binding CreateSheet}" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,0,8,8" VerticalAlignment="Center" Text="Тип основной надписи:" />
                    <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,8"
                              ItemsSource="{Binding TitleBlockTypes}"
                              SelectedItem="{Binding SelectedTitleBlockType}"
                              DisplayMemberPath="DisplayName"
                              IsEnabled="{Binding CreateSheet}" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,0,8,8" VerticalAlignment="Center" Text="Тип марки угла на листе:" />
                    <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,0,0,8"
                              ItemsSource="{Binding SheetCornerMarkTypes}"
                              SelectedItem="{Binding SelectedSheetCornerMarkType}"
                              DisplayMemberPath="DisplayName"
                              IsEnabled="{Binding CreateSheet}" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,0,8,8" VerticalAlignment="Center" Text="Количество колонок:" />
                    <TextBox Grid.Row="3" Grid.Column="1" Margin="0,0,0,8"
                             Text="{Binding ColumnsCountText, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding CreateSheet}" />

                    <TextBlock Grid.Row="4" Grid.Column="0" Margin="0,0,8,8" VerticalAlignment="Center" Text="Старт X (мм):" />
                    <TextBox Grid.Row="4" Grid.Column="1" Margin="0,0,0,8"
                             Text="{Binding StartXmmText, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding CreateSheet}" />

                    <TextBlock Grid.Row="5" Grid.Column="0" Margin="0,0,8,8" VerticalAlignment="Center" Text="Старт Y (мм):" />
                    <TextBox Grid.Row="5" Grid.Column="1" Margin="0,0,0,8"
                             Text="{Binding StartYmmText, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding CreateSheet}" />

                    <TextBlock Grid.Row="6" Grid.Column="0" Margin="0,0,8,8" VerticalAlignment="Center" Text="Шаг X (мм):" />
                    <TextBox Grid.Row="6" Grid.Column="1" Margin="0,0,0,8"
                             Text="{Binding StepXmmText, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding CreateSheet}" />

                    <TextBlock Grid.Row="7" Grid.Column="0" Margin="0,0,8,0" VerticalAlignment="Center" Text="Шаг Y (мм):" />
                    <TextBox Grid.Row="7" Grid.Column="1"
                             Text="{Binding StepYmmText, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding CreateSheet}" />
                </Grid>
            </GroupBox>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="OkButton" Width="100" Height="30" Margin="0,0,8,0" Content="ОК" />
                <Button x:Name="CancelButton" Width="100" Height="30" Content="Отмена" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>
