<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SAB Развертки стен"
        Height="780"
        Width="1120"
        MinHeight="640"
        MinWidth="960"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        FontFamily="Segoe UI"
        FontSize="13"
        Background="{DynamicResource SabBrush.WindowBackground}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../UI/Styles/SABWindowStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="20,18,20,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource SabPanelBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
                        <Border Style="{StaticResource SabPanelIconBorderStyle}">
                            <TextBlock Text="□" Style="{StaticResource SabPanelIconTextStyle}" />
                        </Border>
                        <TextBlock Text="Основные параметры" Style="{StaticResource SabPanelHeaderTextStyle}" />
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,14,0">
                            <Expander Style="{StaticResource SabPanelExpanderStyle}"
                                      IsExpanded="True"
                                      Margin="0,0,0,10">
                                <Expander.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Style="{StaticResource SabPanelIconBorderStyle}">
                                            <TextBlock Text="☷" Style="{StaticResource SabPanelIconTextStyle}" />
                                        </Border>
                                        <TextBlock Text="Режим работы" Style="{StaticResource SabPanelHeaderTextStyle}" />
                                    </StackPanel>
                                </Expander.Header>

                                <StackPanel>
                                    <RadioButton x:Name="SingleGroupRadioButton"
                                                 Content="Одна группа линий"
                                                 GroupName="LineGroupSelectionMode"
                                                 IsChecked="True"
                                                 Style="{StaticResource SabStructureModeRadioButtonStyle}" />
                                    <RadioButton x:Name="MultipleGroupsRadioButton"
                                                 Content="Несколько групп линий"
                                                 GroupName="LineGroupSelectionMode"
                                                 Style="{StaticResource SabStructureModeRadioButtonStyle}"
                                                 Margin="0,0,0,10" />

                                    <Border Style="{StaticResource SabValidationPanelStyle}">
                                        <TextBlock x:Name="SelectionStatusTextBlock"
                                                   Text="Линии и помещение не выбраны."
                                                   Style="{StaticResource SabFieldHintTextStyle}" />
                                    </Border>
                                </StackPanel>
                            </Expander>

                            <TextBlock Text="Тип вида развертки" Style="{StaticResource SabFieldLabelTextStyle}" />
                            <ComboBox ItemsSource="{Binding ElevationViewFamilyTypes}"
                                      SelectedItem="{Binding SelectedElevationViewFamilyType}"
                                      DisplayMemberPath="DisplayName"
                                      ToolTip="{Binding SelectedElevationViewFamilyType.DisplayName}"
                                      Style="{StaticResource SabComboBoxStyle}"
                                      Margin="0,0,0,12" />

                            <TextBlock Text="Шаблон вида развертки" Style="{StaticResource SabFieldLabelTextStyle}" />
                            <ComboBox ItemsSource="{Binding ViewTemplates}"
                                      SelectedItem="{Binding SelectedViewTemplate}"
                                      DisplayMemberPath="DisplayName"
                                      ToolTip="{Binding SelectedViewTemplate.DisplayName}"
                                      Style="{StaticResource SabComboBoxStyle}"
                                      Margin="0,0,0,12" />

                            <TextBlock Text="Масштаб вида" Style="{StaticResource SabFieldLabelTextStyle}" />
                            <TextBox Text="{Binding ViewScaleText, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource SabTextBoxStyle}"
                                     Margin="0,0,0,12" />

                            <TextBlock Text="Глубина проекции" Style="{StaticResource SabFieldLabelTextStyle}" />
                            <TextBox Text="{Binding ViewDepthMmText, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource SabTextBoxStyle}"
                                     Margin="0,0,0,12" />

                            <TextBlock Text="Отступ вида от линии, мм" Style="{StaticResource SabFieldLabelTextStyle}" />
                            <TextBox Text="{Binding MarkerOffsetMmText, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource SabTextBoxStyle}"
                                     Margin="0,0,0,14" />

                            <Expander Style="{StaticResource SabPanelExpanderStyle}"
                                      IsExpanded="True"
                                      Margin="0,0,0,10">
                                <Expander.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Style="{StaticResource SabPanelIconBorderStyle}">
                                            <TextBlock Text="⌖" Style="{StaticResource SabPanelIconTextStyle}" />
                                        </Border>
                                        <TextBlock Text="Марки" Style="{StaticResource SabPanelHeaderTextStyle}" />
                                    </StackPanel>
                                </Expander.Header>

                                <StackPanel>
                                    <TextBlock Text="Тип марки угла на плане" Style="{StaticResource SabFieldLabelTextStyle}" />
                                    <ComboBox ItemsSource="{Binding PlanCornerMarkTypes}"
                                              SelectedItem="{Binding SelectedPlanCornerMarkType}"
                                              DisplayMemberPath="DisplayName"
                                              ToolTip="{Binding SelectedPlanCornerMarkType.DisplayName}"
                                              Style="{StaticResource SabComboBoxStyle}"
                                              Margin="0,0,0,12" />

                                    <TextBlock Text="Тип марки помещения план-схемы" Style="{StaticResource SabFieldLabelTextStyle}" />
                                    <ComboBox ItemsSource="{Binding RoomPlanRoomTagTypes}"
                                              SelectedItem="{Binding SelectedRoomPlanRoomTagType}"
                                              DisplayMemberPath="DisplayName"
                                              ToolTip="{Binding SelectedRoomPlanRoomTagType.DisplayName}"
                                              Style="{StaticResource SabComboBoxStyle}" />
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource SabPanelBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
                        <Border Style="{StaticResource SabPanelIconBorderStyle}">
                            <TextBlock Text="☷" Style="{StaticResource SabPanelIconTextStyle}" />
                        </Border>
                        <TextBlock Text="Настройки создания разверток" Style="{StaticResource SabPanelHeaderTextStyle}" />
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,14,0">
                            <Expander Style="{StaticResource SabPanelExpanderStyle}"
                                      IsExpanded="True"
                                      Margin="0,0,0,10">
                                <Expander.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Style="{StaticResource SabPanelIconBorderStyle}">
                                            <TextBlock Text="◱" Style="{StaticResource SabPanelIconTextStyle}" />
                                        </Border>
                                        <TextBlock Text="Обрезка вида" Style="{StaticResource SabPanelHeaderTextStyle}" />
                                    </StackPanel>
                                </Expander.Header>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="12" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Grid.Column="0">
                                        <TextBlock Text="Верхний отступ, мм" Style="{StaticResource SabFieldLabelTextStyle}" />
                                        <TextBox Text="{Binding TopOffsetMmText, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource SabTextBoxStyle}" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="0" Grid.Column="2">
                                        <TextBlock Text="Нижний отступ, мм" Style="{StaticResource SabFieldLabelTextStyle}" />
                                        <TextBox Text="{Binding BottomOffsetMmText, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource SabTextBoxStyle}" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="2" Grid.Column="0">
                                        <TextBlock Text="Левый отступ, мм" Style="{StaticResource SabFieldLabelTextStyle}" />
                                        <TextBox Text="{Binding LeftOffsetMmText, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource SabTextBoxStyle}" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="2" Grid.Column="2">
                                        <TextBlock Text="Правый отступ, мм" Style="{StaticResource SabFieldLabelTextStyle}" />
                                        <TextBox Text="{Binding RightOffsetMmText, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource SabTextBoxStyle}" />
                                    </StackPanel>
                                </Grid>
                            </Expander>

                            <Expander Style="{StaticResource SabPanelExpanderStyle}"
                                      IsExpanded="True"
                                      Margin="0,0,0,10">
                                <Expander.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Style="{StaticResource SabPanelIconBorderStyle}">
                                            <TextBlock Text="▤" Style="{StaticResource SabPanelIconTextStyle}" />
                                        </Border>
                                        <TextBlock Text="План-схема помещения" Style="{StaticResource SabPanelHeaderTextStyle}" />
                                    </StackPanel>
                                </Expander.Header>

                                <StackPanel>
                                    <TextBlock Text="Формула имени вида" Style="{StaticResource SabFieldLabelTextStyle}" />
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0"
                                                 Text="{Binding RoomPlanNamePart1Text, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource SabTextBoxStyle}"
                                                 ToolTip="Часть 1 имени план-схемы" />
                                        <TextBox Grid.Column="2"
                                                 Text="{Binding RoomPlanNamePart2Text, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource SabTextBoxStyle}"
                                                 ToolTip="Часть 2 имени план-схемы" />
                                        <TextBox Grid.Column="4"
                                                 Text="{Binding RoomPlanNamePart3Text, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource SabTextBoxStyle}"
                                                 ToolTip="Часть 3 имени план-схемы" />
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Шаблон вида" Style="{StaticResource SabFieldLabelTextStyle}" />
                                            <ComboBox ItemsSource="{Binding RoomPlanViewTemplates}"
                                                      SelectedItem="{Binding SelectedRoomPlanViewTemplate}"
                                                      DisplayMemberPath="DisplayName"
                                                      ToolTip="{Binding SelectedRoomPlanViewTemplate.DisplayName}"
                                                      Style="{StaticResource SabComboBoxStyle}" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Масштаб" Style="{StaticResource SabFieldLabelTextStyle}" />
                                            <TextBox Text="{Binding RoomPlanViewScaleText, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource SabTextBoxStyle}" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="4">
                                            <TextBlock Text="Отступ границы, мм" Style="{StaticResource SabFieldLabelTextStyle}" />
                                            <TextBox Text="{Binding RoomPlanCropOffsetMmText, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource SabTextBoxStyle}" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Expander>

                            <Expander Style="{StaticResource SabPanelExpanderStyle}"
                                      IsExpanded="True"
                                      Margin="0,0,0,10">
                                <Expander.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Style="{StaticResource SabPanelIconBorderStyle}">
                                            <TextBlock Text="□" Style="{StaticResource SabPanelIconTextStyle}" />
                                        </Border>
                                        <TextBlock Text="Лист" Style="{StaticResource SabPanelHeaderTextStyle}" />
                                    </StackPanel>
                                </Expander.Header>

                                <StackPanel>
                                    <Border Style="{StaticResource SabPrimarySettingBorderStyle}">
                                        <CheckBox Content="Создать лист"
                                                  IsChecked="{Binding CreateSheet}"
                                                  Style="{StaticResource SabCheckBoxStyle}" />
                                    </Border>

                                    <Grid IsEnabled="{Binding CreateSheet}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="12" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="12" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="12" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <StackPanel Grid.Row="0" Grid.Column="0">
                                            <TextBlock Text="Тип основной надписи" Style="{StaticResource SabFieldLabelTextStyle}" />
                                            <ComboBox ItemsSource="{Binding TitleBlockTypes}"
                                                      SelectedItem="{Binding SelectedTitleBlockType}"
                                                      DisplayMemberPath="DisplayName"
                                                      ToolTip="{Binding SelectedTitleBlockType.DisplayName}"
                                                      Style="{StaticResource SabComboBoxStyle}" />
                                        </StackPanel>

                                        <StackPanel Grid.Row="0" Grid.Column="2">
                                            <TextBlock Text="Тип марки угла на листе" Style="{StaticResource SabFieldLabelTextStyle}" />
                                            <ComboBox ItemsSource="{Binding SheetCornerMarkTypes}"
                                                      SelectedItem="{Binding SelectedSheetCornerMarkType}"
                                                      DisplayMemberPath="DisplayName"
                                                      ToolTip="{Binding SelectedSheetCornerMarkType.DisplayName}"
                                                      Style="{StaticResource SabComboBoxStyle}" />
                                        </StackPanel>

                                        <StackPanel Grid.Row="2" Grid.Column="0">
                                            <TextBlock Text="Формат листа (Формат А)" Style="{StaticResource SabFieldLabelTextStyle}" />
                                            <TextBox Text="{Binding SheetFormatAText, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource SabTextBoxStyle}" />
                                        </StackPanel>

                                        <StackPanel Grid.Row="2" Grid.Column="2">
                                            <TextBlock Text="Количество колонок" Style="{StaticResource SabFieldLabelTextStyle}" />
                                            <TextBox Text="{Binding ColumnsCountText, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource SabTextBoxStyle}" />
                                        </StackPanel>

                                        <StackPanel Grid.Row="4" Grid.Column="0">
                                            <TextBlock Text="Точка размещения вида" Style="{StaticResource SabFieldLabelTextStyle}" />
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="12" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="Старт X, мм" Style="{StaticResource SabFieldLabelTextStyle}" />
                                                    <TextBox Text="{Binding StartXmmText, UpdateSourceTrigger=PropertyChanged}"
                                                             Style="{StaticResource SabTextBoxStyle}"
                                                             Margin="0,0,0,8" />

                                                    <TextBlock Text="Старт Y, мм" Style="{StaticResource SabFieldLabelTextStyle}" />
                                                    <TextBox Text="{Binding StartYmmText, UpdateSourceTrigger=PropertyChanged}"
                                                             Style="{StaticResource SabTextBoxStyle}" />
                                                </StackPanel>

                                                <StackPanel Grid.Column="2" VerticalAlignment="Top" Margin="0,12,0,0">
                                                    <RadioButton x:Name="ManualSheetPointRadioButton"
                                                                 Content="Ручной ввод"
                                                                 GroupName="SheetPointMode"
                                                                 IsChecked="{Binding IsSheetPointManualMode, Mode=TwoWay}"
                                                                 Style="{StaticResource SabRadioButtonStyle}"
                                                                 Margin="0,0,0,12" />
                                                    <RadioButton x:Name="PickSheetPointRadioButton"
                                                                 Content="Указать точку"
                                                                 GroupName="SheetPointMode"
                                                                 IsChecked="{Binding IsSheetPointPointMode, Mode=TwoWay}"
                                                                 Style="{StaticResource SabRadioButtonStyle}"
                                                                 Margin="0" />

                                                    <StackPanel Margin="0,20,0,0">
                                                        <StackPanel.Style>
                                                            <Style TargetType="{x:Type StackPanel}">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsSheetPointPointMode}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </StackPanel.Style>
                                                        <Button x:Name="PickSheetPointButton"
                                                                Style="{StaticResource SabOutlineButtonStyle}"
                                                                HorizontalAlignment="Stretch">
                                                            <TextBlock Text="Указать точку размещения вида"
                                                                       TextAlignment="Center"
                                                                       TextWrapping="Wrap" />
                                                        </Button>
                                                        <TextBlock Text="{Binding SheetPointSummary}"
                                                                   Style="{StaticResource SabFieldHintTextStyle}"
                                                                   TextWrapping="Wrap"
                                                                   Margin="0,6,0,0" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>

                                        <StackPanel Grid.Row="4" Grid.Column="2">
                                            <TextBlock Text="Шаг видов друг от друга" Style="{StaticResource SabFieldLabelTextStyle}" />
                                            <TextBlock Text="Шаг X, мм" Style="{StaticResource SabFieldLabelTextStyle}" />
                                            <TextBox Text="{Binding StepXmmText, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource SabTextBoxStyle}"
                                                     Margin="0,0,0,8" />

                                            <TextBlock Text="Шаг Y, мм" Style="{StaticResource SabFieldLabelTextStyle}" />
                                            <TextBox Text="{Binding StepYmmText, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource SabTextBoxStyle}" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Expander>

                            <Border Style="{StaticResource SabValidationPanelStyle}">
                                <StackPanel>
                                    <TextBlock Text="Перед созданием нажмите Выбрать линии, затем укажите линии детализации и помещение в активном плане."
                                               Style="{StaticResource SabFieldHintTextStyle}" />
                                    <TextBlock Text="Параметры сохраняются и будут использованы при следующем запуске команды."
                                               Style="{StaticResource SabFieldHintTextStyle}"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="1"
                Background="{StaticResource SabBrush.PanelBackground}"
                BorderBrush="{StaticResource SabBrush.Border}"
                BorderThickness="0,1,0,0"
                Padding="20,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="Выберите линии и помещение, затем нажмите Создать развертки."
                           Style="{StaticResource SabStatusTextStyle}" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CancelButton"
                            Content="Отмена"
                            Width="120"
                            Style="{StaticResource SabNeutralButtonStyle}"
                            Margin="0,0,10,0" />
                    <Button x:Name="PickLinesButton"
                            Content="Выбрать линии"
                            Width="140"
                            Style="{StaticResource SabOutlineButtonStyle}"
                            Margin="0,0,10,0" />
                    <Button x:Name="OkButton"
                            Content="Создать развертки"
                            Width="170"
                            Style="{StaticResource SabPrimaryButtonStyle}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
