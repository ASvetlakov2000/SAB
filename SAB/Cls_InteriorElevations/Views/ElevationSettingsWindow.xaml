<?xml version='1.0' encoding='utf-8'?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:design="clr-namespace:SAB.UI.FluentLight;assembly=SAB" xmlns:ui="clr-namespace:SAB.UI;assembly=SAB" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="SAB · Настройки развёрток" Width="1280" Height="880" MinWidth="800" MinHeight="650" ResizeMode="CanResize" WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" FontSize="13" Background="{DynamicResource SabBrush.WindowBackground}" UseLayoutRounding="True">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../../UI/Styles/SABFluentLight.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>
  <Grid Background="{DynamicResource SabBrush.WindowBackground}" x:Name="WindowRoot">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Border Background="White" BorderBrush="{DynamicResource SabBrush.Border}" BorderThickness="0,0,0,1" Padding="24,12" x:Name="TitleBar">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="SAB" TextWrapping="Wrap" Style="{StaticResource SabPanelHeaderTextStyle}" />
        <TextBlock Grid.Column="1" Text="Развёртки" Foreground="{DynamicResource SabBrush.TextSecondary}" VerticalAlignment="Center" Margin="20,0,0,0" />
        <StackPanel Grid.Column="2" Orientation="Horizontal">
          <Button Visibility="Collapsed" x:Name="MinimizeWindowButton" />
          <Button Visibility="Collapsed" x:Name="CloseWindowButton" />
        </StackPanel>
      </Grid>
    </Border>
    <TextBlock Grid.Row="1" Text="Настройки развёрток" Style="{StaticResource SabWindowTitleTextStyle}" Margin="24,20,24,16" />
    <Grid Grid.Row="2" Margin="24,0,24,16">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <Border Margin="0,0,0,16" Style="{StaticResource SabPanelBorderStyle}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0">
            <TextBlock Text="Помещения за один запуск" TextWrapping="Wrap" Style="{StaticResource SabFieldLabelTextStyle}" />
            <Grid MinHeight="34" Margin="0,4,0,12" design:Capsule.IsGroup="True">
              <Border CornerRadius="17" Background="{DynamicResource SabBrush.TableHeaderBackground}" BorderBrush="{DynamicResource SabBrush.Border}" BorderThickness="1" />
              <Border Tag="CapsuleIndicator" CornerRadius="15" Background="{DynamicResource SabBrush.Accent}" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False" />
              <Grid Margin="2">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <RadioButton Content="Одно помещение" GroupName="RoomSelectionMode" IsChecked="{Binding IsSingleRoomPerSheet, Mode=TwoWay}" Style="{StaticResource SabRadioButtonStyle}" Margin="0" Grid.Column="0" />
                <RadioButton Content="Несколько помещений" GroupName="RoomSelectionMode" IsChecked="{Binding IsMultipleRoomsOnSheet, Mode=TwoWay}" Style="{StaticResource SabRadioButtonStyle}" Margin="0" Grid.Column="1" />
              </Grid>
            </Grid>
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Text="Источник помещения" TextWrapping="Wrap" Style="{StaticResource SabFieldLabelTextStyle}" />
            <Grid MinHeight="34" Margin="0,4,0,12" design:Capsule.IsGroup="True">
              <Border CornerRadius="17" Background="{DynamicResource SabBrush.TableHeaderBackground}" BorderBrush="{DynamicResource SabBrush.Border}" BorderThickness="1" />
              <Border Tag="CapsuleIndicator" CornerRadius="15" Background="{DynamicResource SabBrush.Accent}" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False" />
              <Grid Margin="2">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <RadioButton Content="Текущая модель" GroupName="RoomSourceMode" IsChecked="{Binding PickRoomFromHost, Mode=TwoWay}" Style="{StaticResource SabRadioButtonStyle}" Margin="0" Grid.Column="0" />
                <RadioButton Content="Связанный файл" GroupName="RoomSourceMode" IsChecked="{Binding PickRoomFromLink, Mode=TwoWay}" Style="{StaticResource SabRadioButtonStyle}" Margin="0" Grid.Column="1" />
              </Grid>
            </Grid>
          </StackPanel>
          <Border x:Name="SelectionStatusBorder" Style="{StaticResource SabSelectionPendingPanelStyle}" Padding="10,7" Visibility="Collapsed">
            <TextBlock x:Name="SelectionStatusTextBlock" Text="Линии и помещение не выбраны." Style="{StaticResource SabSelectionPendingTextStyle}" TextWrapping="Wrap" />
          </Border>
        </Grid>
      </Border>
      <TabControl x:Name="SettingsTabControl" Grid.Row="1" Margin="0">
        <TabItem Header="Развертки">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,12,0" design:ScrollEdges.Enabled="True">
            <StackPanel>
              <GroupBox Header="Наименование вида" Margin="0,0,0,16">
                <StackPanel>
                  <TextBlock Text="Формула имени вида" Style="{StaticResource SabFieldLabelTextStyle}" TextWrapping="Wrap" />
                  <Border Style="{StaticResource SabFormulaEditorBorderStyle}" Margin="0,0,0,10">
                    <RichTextBox x:Name="ElevationNameFormulaEditor" Style="{StaticResource SabFormulaEditorStyle}" />
                  </Border>
                  <TextBlock Text="Заголовок вида" Style="{StaticResource SabFieldLabelTextStyle}" TextWrapping="Wrap" />
                  <Border Style="{StaticResource SabFormulaEditorBorderStyle}">
                    <RichTextBox x:Name="ElevationTitleFormulaEditor" Style="{StaticResource SabFormulaEditorStyle}" />
                  </Border>
                  <Border BorderBrush="{StaticResource SabBrush.Border}" BorderThickness="0,1,0,0" Margin="0,11,0,0" Padding="0,10,0,0">
                    <StackPanel>
                      <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Результат наименований" Style="{StaticResource SabFieldLabelTextStyle}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Grid.Column="1" Text="{Binding NamingPreviewStatusText}" Style="{StaticResource SabFieldHintTextStyle}" TextWrapping="Wrap" />
                      </Grid>
                      <Border MaxHeight="170" BorderBrush="{StaticResource SabBrush.Border}" BorderThickness="1" CornerRadius="5">
                        <Border.Style>
                          <Style TargetType="{x:Type Border}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding HasNamingPreview}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Border.Style>
                        <ScrollViewer Style="{StaticResource SabFormScrollViewerStyle}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                          <ItemsControl ItemsSource="{Binding NamingPreviewItems}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate>
                                <ui:AdaptiveSettingsGrid Margin="8,6">
                                  <ui:AdaptiveSettingsGrid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                  </ui:AdaptiveSettingsGrid.ColumnDefinitions>
                                  <StackPanel Grid.Column="0">
                                    <TextBlock Text="Имя вида" Style="{StaticResource SabFieldHintTextStyle}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding ViewName}" Foreground="{StaticResource SabBrush.Text}" TextWrapping="Wrap" />
                                  </StackPanel>
                                  <StackPanel Grid.Column="2">
                                    <TextBlock Text="Заголовок вида" Style="{StaticResource SabFieldHintTextStyle}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding ViewTitle}" Foreground="{StaticResource SabBrush.Text}" TextWrapping="Wrap" />
                                  </StackPanel>
                                </ui:AdaptiveSettingsGrid>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </ScrollViewer>
                      </Border>
                    </StackPanel>
                  </Border>
                  <Border x:Name="DetailNumberSettings" BorderBrush="{StaticResource SabBrush.Border}" BorderThickness="0,1,0,0" Margin="0,12,0,0" Padding="0,10,0,0">
                    <StackPanel>
                      <TextBlock Text="Номер вида" Style="{StaticResource SabFieldLabelTextStyle}" FontWeight="SemiBold" Margin="0,0,0,8" />
                      <ui:AdaptiveSettingsGrid>
                        <ui:AdaptiveSettingsGrid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="14" />
                          <ColumnDefinition Width="*" />
                        </ui:AdaptiveSettingsGrid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                          <TextBlock Text="Префикс" Style="{StaticResource SabFieldLabelTextStyle}" />
                          <TextBox x:Name="DetailNumberPrefixEditor" Text="{Binding DetailNumberPrefix, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                          <TextBlock Text="Суффикс" Style="{StaticResource SabFieldLabelTextStyle}" />
                          <TextBox x:Name="DetailNumberSuffixEditor" Text="{Binding DetailNumberSuffix, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                      </ui:AdaptiveSettingsGrid>
                      <TextBlock x:Name="DetailNumberPreviewText" Text="{Binding DetailNumberPreview}" Style="{StaticResource SabFieldHintTextStyle}" TextWrapping="Wrap" Margin="0,8,0,0" />
                    </StackPanel>
                  </Border>
                </StackPanel>
              </GroupBox>
              <GroupBox Header="Параметры вида" Margin="0,0,0,16">
                <StackPanel>
                  <ui:AdaptiveSettingsGrid>
                    <ui:AdaptiveSettingsGrid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="14" />
                      <ColumnDefinition Width="*" />
                    </ui:AdaptiveSettingsGrid.ColumnDefinitions>
                    <ui:AdaptiveSettingsGrid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="10" />
                      <RowDefinition Height="Auto" />
                    </ui:AdaptiveSettingsGrid.RowDefinitions>
                    <StackPanel Grid.Row="0" Grid.Column="0">
                      <TextBlock Text="Тип вида развертки" Style="{StaticResource SabFieldLabelTextStyle}" TextWrapping="Wrap" />
                      <ComboBox ItemsSource="{Binding ElevationViewFamilyTypes}" SelectedItem="{Binding SelectedElevationViewFamilyType}" DisplayMemberPath="DisplayName" ToolTip="{Binding SelectedElevationViewFamilyType.DisplayName}" Style="{StaticResource SabComboBoxStyle}" VerticalAlignment="Center" Margin="0,4,0,12" />
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="2">
                      <TextBlock Text="Шаблон вида" Style="{StaticResource SabFieldLabelTextStyle}" TextWrapping="Wrap" />
                      <ComboBox ItemsSource="{Binding ViewTemplates}" SelectedItem="{Binding SelectedViewTemplate}" DisplayMemberPath="DisplayName" ToolTip="{Binding SelectedViewTemplate.DisplayName}" Style="{StaticResource SabComboBoxStyle}" VerticalAlignment="Center" Margin="0,4,0,12" />
                    </StackPanel>
                    <ui:AdaptiveSettingsGrid Grid.Row="2" Grid.Column="0">
                      <ui:AdaptiveSettingsGrid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                      </ui:AdaptiveSettingsGrid.ColumnDefinitions>
                      <StackPanel Grid.Column="0">
                        <TextBlock Text="Масштаб" Style="{StaticResource SabFieldLabelTextStyle}" TextWrapping="Wrap" />
                        <TextBox Text="{Binding ViewScaleText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SabTextBoxStyle}" VerticalAlignment="Center" Margin="0,4,0,12" />
                      </StackPanel>
                      <StackPanel Grid.Column="2">
                        <TextBlock Text="Глубина, мм" Style="{StaticResource SabFieldLabelTextStyle}" TextWrapping="Wrap" />
                        <TextBox Text="{Binding ViewDepthMmText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SabTextBoxStyle}" VerticalAlignment="Center" Margin="0,4,0,12" />
                      </StackPanel>
                    </ui:AdaptiveSettingsGrid>
                    <StackPanel Grid.Row="2" Grid.Column="2">
                      <TextBlock Text="Отступ вида от линии, мм" Style="{StaticResource SabFieldLabelTextStyle}" TextWrapping="Wrap" />
                      <TextBox Text="{Binding MarkerOffsetMmText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SabTextBoxStyle}" VerticalAlignment="Center" Margin="0,4,0,12" />
                    </StackPanel>
                  </ui:AdaptiveSettingsGrid>
                </StackPanel>
              </GroupBox>
              <GroupBox Margin="0,0,0,16">
                <GroupBox.Header>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Подрезка вида" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
                    <Button x:Name="PickCropByExampleButton" Grid.Column="1" Content="Взять высоту с вида-примера" Style="{StaticResource SabOutlineButtonStyle}" VerticalAlignment="Center" />
                  </Grid>
                </GroupBox.Header>
                <StackPanel>
                  <ui:AdaptiveSettingsGrid>
                    <ui:AdaptiveSettingsGrid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="10" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="10" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="10" />
                      <ColumnDefinition Width="*" />
                    </ui:AdaptiveSettingsGrid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                      <TextBlock Text="Сверху, мм" Style="{StaticResource SabFieldLabelTextStyle}" TextWrapping="Wrap" />
                      <TextBox Text="{Binding TopOffsetMmText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SabTextBoxStyle}" VerticalAlignment="Center" Margin="0,4,0,12" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                      <TextBlock Text="Снизу, мм" Style="{StaticResource SabFieldLabelTextStyle}" TextWrapping="Wrap" />
                      <TextBox Text="{Binding BottomOffsetMmText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SabTextBoxStyle}" VerticalAlignment="Center" Margin="0,4,0,12" />
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                      <TextBlock Text="Слева, мм" Style="{StaticResource SabFieldLabelTextStyle}" TextWrapping="Wrap" />
                      <TextBox Text="{Binding LeftOffsetMmText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SabTextBoxStyle}" VerticalAlignment="Center" Margin="0,4,0,12" />
                    </StackPanel>
                    <StackPanel Grid.Column="6">
                      <TextBlock Text="Справа, мм" Style="{StaticResource SabFieldLabelTextStyle}" TextWrapping="Wrap" />
                      <TextBox Text="{Binding RightOffsetMmText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SabTextBoxStyle}" VerticalAlignment="Center" Margin="0,4,0,12" />
                    </StackPanel>
                  </ui:AdaptiveSettingsGrid>
                </StackPanel>
              </GroupBox>
              <GroupBox Header="Оси на развертке" Margin="0,0,0,16">
                <StackPanel>
                  <ui:AdaptiveSettingsGrid>
                    <ui:AdaptiveSettingsGrid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="20" />
                      <ColumnDefinition Width="*" />
                    </ui:AdaptiveSettingsGrid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                      <TextBlock Text="Выступ сверху, мм на листе" Style="{StaticResource SabFieldLabelTextStyle}" TextWrapping="Wrap" />
                      <TextBox Text="{Binding GridTopExtensionPaperMmText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SabTextBoxStyle}" VerticalAlignment="Center" Margin="0,4,0,12" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                      <TextBlock Text="Выступ снизу, мм на листе" Style="{StaticResource SabFieldLabelTextStyle}" TextWrapping="Wrap" />
                      <TextBox Text="{Binding GridBottomExtensionPaperMmText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SabTextBoxStyle}" VerticalAlignment="Center" Margin="0,4,0,12" />
                    </StackPanel>
                  </ui:AdaptiveSettingsGrid>
                </StackPanel>
              </GroupBox>
            </StackPanel>
          </ScrollViewer>
        </TabItem>
        <TabItem x:Name="SheetTabItem" Header="Лист">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,12,0" design:ScrollEdges.Enabled="True">
            <StackPanel>
              <GroupBox Header="Размещение" Margin="0,0,0,16">
                <StackPanel>
                  <Grid Margin="0,4,0,12" design:Capsule.IsGroup="True">
                    <Border CornerRadius="17" Background="{DynamicResource SabBrush.TableHeaderBackground}" BorderBrush="{DynamicResource SabBrush.Border}" BorderThickness="1" />
                    <Border Tag="CapsuleIndicator" CornerRadius="15" Background="{DynamicResource SabBrush.Accent}" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False" />
                    <Grid Margin="2">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <RadioButton Content="Не размещать на листе" GroupName="SheetPlacementMode" IsChecked="{Binding DoNotPlaceViewsOnSheetMode, Mode=TwoWay}" Style="{StaticResource SabRadioButtonStyle}" Margin="0" Grid.Column="0" />
                      <RadioButton Content="Создать новый лист" GroupName="SheetPlacementMode" IsChecked="{Binding CreateNewSheetMode, Mode=TwoWay}" Style="{StaticResource SabRadioButtonStyle}" Margin="0" Grid.Column="1" />
                      <RadioButton Content="Добавить на существующий лист" GroupName="SheetPlacementMode" IsChecked="{Binding ExistingSheetMode, Mode=TwoWay}" Style="{StaticResource SabRadioButtonStyle}" Margin="0" Grid.Column="2" />
                    </Grid>
                  </Grid>
                  <CheckBox Content="Открыть целевой лист после выполнения" IsChecked="{Binding OpenCreatedSheet}" IsEnabled="{Binding PlaceViewsOnSheet}" Style="{StaticResource SabCheckBoxStyle}" />
                </StackPanel>
              </GroupBox>
              <GroupBox x:Name="TargetSheetCard" Header="Целевой лист" Margin="0,0,0,16">
                <GroupBox.Style>
                  <Style TargetType="GroupBox" BasedOn="{StaticResource {x:Type GroupBox}}">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding DoNotPlaceViewsOnSheetMode}" Value="True">
                        <Setter Property="Visibility" Value="Collapsed" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </GroupBox.Style>
                <StackPanel>
                  <StackPanel>
                    <StackPanel.Style>
                      <Style TargetType="{x:Type StackPanel}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding CreateSheet}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </StackPanel.Style>
                    <ui:AdaptiveSettingsGrid>
                      <ui:AdaptiveSettingsGrid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="160" />
                      </ui:AdaptiveSettingsGrid.ColumnDefinitions>
                      <StackPanel Grid.Column="0">
                        <TextBlock Text="Тип основной надписи" Style="{StaticResource SabFieldLabelTextStyle}" TextWrapping="Wrap" />
                        <ComboBox ItemsSource="{Binding TitleBlockTypes}" SelectedItem="{Binding SelectedTitleBlockType}" DisplayMemberPath="DisplayName" ToolTip="{Binding SelectedTitleBlockType.DisplayName}" Style="{StaticResource SabComboBoxStyle}" VerticalAlignment="Center" Margin="0,4,0,12" />
                      </StackPanel>
                      <StackPanel Grid.Column="2">
                        <TextBlock Text="Формат листа (А)" Style="{StaticResource SabFieldLabelTextStyle}" TextWrapping="Wrap" />
                        <TextBox Text="{Binding SheetFormatAText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SabTextBoxStyle}" VerticalAlignment="Center" Margin="0,4,0,12" />
                      </StackPanel>
                    </ui:AdaptiveSettingsGrid>
                    <TextBlock Text="Формула имени листа" Style="{StaticResource SabFieldLabelTextStyle}" Margin="0,10,0,0" TextWrapping="Wrap" />
                    <Border Style="{StaticResource SabFormulaEditorBorderStyle}">
                      <RichTextBox x:Name="SheetNameFormulaEditor" Style="{StaticResource SabFormulaEditorStyle}" />
                    </Border>
                  </StackPanel>
                  <StackPanel>
                    <StackPanel.Style>
                      <Style TargetType="{x:Type StackPanel}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding UseExistingSheet}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </StackPanel.Style>
                    <TextBlock Text="Номер или имя листа" Style="{StaticResource SabFieldLabelTextStyle}" TextWrapping="Wrap" />
                    <ComboBox ItemsSource="{Binding ExistingSheetsView}" SelectedItem="{Binding SelectedExistingSheet, Mode=TwoWay}" Text="{Binding ExistingSheetSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsDropDownOpen="{Binding IsExistingSheetDropDownOpen, Mode=TwoWay}" DisplayMemberPath="DisplayName" IsEditable="True" IsTextSearchEnabled="False" StaysOpenOnEdit="True" ToolTip="Введите часть номера или имени листа" Style="{StaticResource SabComboBoxStyle}" VerticalAlignment="Center" Margin="0,4,0,12" />
                  </StackPanel>
                </StackPanel>
              </GroupBox>
              <GroupBox IsEnabled="{Binding PlaceViewsOnSheet}" Margin="0,0,0,16">
                <GroupBox.Header>
                  <ui:AdaptiveSettingsGrid>
                    <ui:AdaptiveSettingsGrid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </ui:AdaptiveSettingsGrid.ColumnDefinitions>
                    <TextBlock Text="Раскладка видов" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0" />
                    <TextBlock Grid.Column="1" Style="{StaticResource SabFieldHintTextStyle}" VerticalAlignment="Center" Margin="0,0,10,0" TextWrapping="Wrap">
                      <Run Text="Точка: " />
                      <Run Text="{Binding SheetPointSummary, Mode=OneWay}" />
                    </TextBlock>
                    <Button Grid.Column="2" x:Name="PickSheetPointButton" Content="{Binding PickSheetPointButtonText}" Style="{StaticResource SabOutlineButtonStyle}" VerticalAlignment="Center" />
                  </ui:AdaptiveSettingsGrid>
                </GroupBox.Header>
                <StackPanel>
                  <StackPanel Margin="0,0,0,10">
                    <StackPanel.Style>
                      <Style TargetType="{x:Type StackPanel}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                          <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                              <Condition Binding="{Binding UseExistingSheet}" Value="True" />
                              <Condition Binding="{Binding CreateRoomPlanScheme}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" />
                          </MultiDataTrigger>
                        </Style.Triggers>
                      </Style>
                    </StackPanel.Style>
                    <TextBlock Text="План-схема: " Style="{StaticResource SabFieldHintTextStyle}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding ExistingRoomPlanSummary}" Style="{StaticResource SabFieldHintTextStyle}" TextWrapping="Wrap" />
                  </StackPanel>
                  <Grid Margin="0,4,0,12" design:Capsule.IsGroup="True">
                    <Border CornerRadius="17" Background="{DynamicResource SabBrush.TableHeaderBackground}" BorderBrush="{DynamicResource SabBrush.Border}" BorderThickness="1" />
                    <Border Tag="CapsuleIndicator" CornerRadius="15" Background="{DynamicResource SabBrush.Accent}" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False" />
                    <Grid Margin="2">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <RadioButton Content="Автоматическое размещение" IsChecked="{Binding UseAutomaticSheetPlacement}" Margin="0" Style="{StaticResource SabRadioButtonStyle}" Grid.Column="0" />
                      <RadioButton Content="Ручные настройки" IsChecked="{Binding UseManualSheetPlacement}" Style="{StaticResource SabRadioButtonStyle}" Grid.Column="1" Margin="0" />
                    </Grid>
                  </Grid>
                  <ui:AdaptiveSettingsGrid>
                    <ui:AdaptiveSettingsGrid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="10" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="10" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="10" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="10" />
                      <ColumnDefinition Width="*" />
                    </ui:AdaptiveSettingsGrid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                      <TextBlock Text="Видов в строке" Style="{StaticResource SabFieldLabelTextStyle}" TextWrapping="Wrap" />
                      <TextBox Text="{Binding ColumnsCountText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SabTextBoxStyle}" ToolTip="Число видов в строке для ручной расстановки и перехода при неудаче автоматической компоновки." VerticalAlignment="Center" Margin="0,4,0,12" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                      <TextBlock Text="Старт X, мм" Style="{StaticResource SabFieldLabelTextStyle}" TextWrapping="Wrap" />
                      <TextBox Text="{Binding StartXmmText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SabTextBoxStyle}" VerticalAlignment="Center" Margin="0,4,0,12" />
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                      <TextBlock Text="Старт Y, мм" Style="{StaticResource SabFieldLabelTextStyle}" TextWrapping="Wrap" />
                      <TextBox Text="{Binding StartYmmText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SabTextBoxStyle}" VerticalAlignment="Center" Margin="0,4,0,12" />
                    </StackPanel>
                    <StackPanel Grid.Column="6">
                      <TextBlock Text="Зазор X, мм" Style="{StaticResource SabFieldLabelTextStyle}" TextWrapping="Wrap" />
                      <TextBox Text="{Binding StepXmmText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SabTextBoxStyle}" VerticalAlignment="Center" Margin="0,4,0,12" />
                    </StackPanel>
                    <StackPanel Grid.Column="8">
                      <TextBlock Text="Зазор Y, мм" Style="{StaticResource SabFieldLabelTextStyle}" TextWrapping="Wrap" />
                      <TextBox Text="{Binding StepYmmText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SabTextBoxStyle}" VerticalAlignment="Center" Margin="0,4,0,12" />
                    </StackPanel>
                  </ui:AdaptiveSettingsGrid>
                </StackPanel>
              </GroupBox>
              <GroupBox Header="Оформление видового экрана" IsEnabled="{Binding PlaceViewsOnSheet}" Margin="0,0,0,16">
                <StackPanel>
                  <ui:AdaptiveSettingsGrid>
                    <ui:AdaptiveSettingsGrid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="12" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="12" />
                      <ColumnDefinition Width="120" />
                      <ColumnDefinition Width="12" />
                      <ColumnDefinition Width="120" />
                    </ui:AdaptiveSettingsGrid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                      <TextBlock Text="Тип видового экрана" Style="{StaticResource SabFieldLabelTextStyle}" TextWrapping="Wrap" />
                      <ComboBox ItemsSource="{Binding ViewportTypes}" SelectedItem="{Binding SelectedViewportType}" DisplayMemberPath="DisplayName" ToolTip="{Binding SelectedViewportType.DisplayName}" Style="{StaticResource SabComboBoxStyle}" VerticalAlignment="Center" Margin="0,4,0,12" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                      <TextBlock Text="Привязка заголовка" Style="{StaticResource SabFieldLabelTextStyle}" TextWrapping="Wrap" />
                      <ComboBox ItemsSource="{Binding ViewTitleAnchors}" SelectedItem="{Binding SelectedViewTitleAnchor}" DisplayMemberPath="DisplayName" Style="{StaticResource SabComboBoxStyle}" VerticalAlignment="Center" Margin="0,4,0,12" />
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                      <TextBlock Text="Смещение X, мм" Style="{StaticResource SabFieldLabelTextStyle}" TextWrapping="Wrap" />
                      <TextBox Text="{Binding ViewTitleOffsetXmmText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SabTextBoxStyle}" VerticalAlignment="Center" Margin="0,4,0,12" />
                    </StackPanel>
                    <StackPanel Grid.Column="6">
                      <TextBlock Text="Смещение Y, мм" Style="{StaticResource SabFieldLabelTextStyle}" TextWrapping="Wrap" />
                      <TextBox Text="{Binding ViewTitleOffsetYmmText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SabTextBoxStyle}" VerticalAlignment="Center" Margin="0,4,0,12" />
                    </StackPanel>
                  </ui:AdaptiveSettingsGrid>
                </StackPanel>
              </GroupBox>
            </StackPanel>
          </ScrollViewer>
        </TabItem>
        <TabItem Header="План-схема">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,12,0" design:ScrollEdges.Enabled="True">
            <StackPanel>
              <GroupBox Header="Создание и размещение" Margin="0,0,0,16">
                <StackPanel>
                  <WrapPanel>
                    <CheckBox Content="{Binding RoomPlanOperationLabel}" IsChecked="{Binding CreateRoomPlanScheme}" ToolTip="Создание план-схемы можно отключить независимо от размещения разверток." Style="{StaticResource SabCheckBoxStyle}" Margin="0,0,24,0" />
                    <CheckBox Content="Размещать план-схему на листах" IsChecked="{Binding PlaceRoomPlanSchemeOnSheet}" IsEnabled="{Binding CanPlaceRoomPlanSchemeOnSheet}" ToolTip="Размещать план-схему снизу справа на каждом листе с развертками." Style="{StaticResource SabCheckBoxStyle}" />
                  </WrapPanel>
                  <CheckBox Content="Включать категорию «Помещения / Объект» перед выбором помещения" IsChecked="{Binding EnableRoomObjectCategory}" Style="{StaticResource SabCheckBoxStyle}" Margin="0,10,0,0" ToolTip="Если выключено, плагин не изменяет видимость подкатегории «Объект» на виде и в его шаблоне." />
                </StackPanel>
              </GroupBox>
              <GroupBox Header="Положение на листе" IsEnabled="{Binding CanPositionRoomPlan}" Margin="0,0,0,16">
                <StackPanel>
                  <CheckBox Content="Задать положение план-схемы вручную" IsChecked="{Binding UseManualRoomPlanPosition}" Style="{StaticResource SabCheckBoxStyle}" />
                  <ui:AdaptiveSettingsGrid IsEnabled="{Binding UseManualRoomPlanPosition}">
                    <ui:AdaptiveSettingsGrid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="12" />
                      <ColumnDefinition Width="*" />
                    </ui:AdaptiveSettingsGrid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                      <TextBlock Text="Отступ справа, мм" Style="{StaticResource SabFieldLabelTextStyle}" TextWrapping="Wrap" />
                      <TextBox Text="{Binding RoomPlanOffsetRightMmText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SabTextBoxStyle}" VerticalAlignment="Center" Margin="0,4,0,12" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                      <TextBlock Text="Отступ снизу, мм" Style="{StaticResource SabFieldLabelTextStyle}" TextWrapping="Wrap" />
                      <TextBox Text="{Binding RoomPlanOffsetBottomMmText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SabTextBoxStyle}" VerticalAlignment="Center" Margin="0,4,0,12" />
                    </StackPanel>
                  </ui:AdaptiveSettingsGrid>
                  <Button x:Name="PickRoomPlanPointButton" Content="Указать точку план-схемы на листе" Style="{StaticResource SabOutlineButtonStyle}" HorizontalAlignment="Left" Margin="0,10,0,0" VerticalAlignment="Center" />
                </StackPanel>
              </GroupBox>
              <GroupBox Header="Параметры план-схемы" IsEnabled="{Binding CanEditRoomPlanCreationParameters}" Margin="0,0,0,16">
                <StackPanel>
                  <TextBlock Text="Формула имени вида" Style="{StaticResource SabFieldLabelTextStyle}" TextWrapping="Wrap" />
                  <Border Style="{StaticResource SabFormulaEditorBorderStyle}" Margin="0,0,0,10">
                    <RichTextBox x:Name="RoomPlanNameFormulaEditor" Style="{StaticResource SabFormulaEditorStyle}" />
                  </Border>
                  <ui:AdaptiveSettingsGrid>
                    <ui:AdaptiveSettingsGrid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="12" />
                      <ColumnDefinition Width="130" />
                      <ColumnDefinition Width="12" />
                      <ColumnDefinition Width="160" />
                    </ui:AdaptiveSettingsGrid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                      <TextBlock Text="Шаблон вида" Style="{StaticResource SabFieldLabelTextStyle}" TextWrapping="Wrap" />
                      <ComboBox ItemsSource="{Binding RoomPlanViewTemplates}" SelectedItem="{Binding SelectedRoomPlanViewTemplate}" DisplayMemberPath="DisplayName" ToolTip="{Binding SelectedRoomPlanViewTemplate.DisplayName}" Style="{StaticResource SabComboBoxStyle}" VerticalAlignment="Center" Margin="0,4,0,12" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                      <TextBlock Text="Масштаб" Style="{StaticResource SabFieldLabelTextStyle}" TextWrapping="Wrap" />
                      <TextBox Text="{Binding RoomPlanViewScaleText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SabTextBoxStyle}" VerticalAlignment="Center" Margin="0,4,0,12" />
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                      <TextBlock Text="Отступ обрезки, мм" Style="{StaticResource SabFieldLabelTextStyle}" TextWrapping="Wrap" />
                      <TextBox Text="{Binding RoomPlanCropOffsetMmText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SabTextBoxStyle}" VerticalAlignment="Center" Margin="0,4,0,12" />
                    </StackPanel>
                  </ui:AdaptiveSettingsGrid>
                  <TextBlock Text="Тип марки помещения" Style="{StaticResource SabFieldLabelTextStyle}" Margin="0,10,0,0" TextWrapping="Wrap" />
                  <ComboBox ItemsSource="{Binding RoomPlanRoomTagTypes}" SelectedItem="{Binding SelectedRoomPlanRoomTagType}" DisplayMemberPath="DisplayName" ToolTip="{Binding SelectedRoomPlanRoomTagType.DisplayName}" Style="{StaticResource SabComboBoxStyle}" VerticalAlignment="Center" Margin="0,4,0,12" />
                </StackPanel>
              </GroupBox>
            </StackPanel>
          </ScrollViewer>
        </TabItem>
        <TabItem Header="Марки">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,12,0" design:ScrollEdges.Enabled="True">
            <StackPanel>
              <GroupBox Header="Марки углов на плане" Margin="0,0,0,16">
                <StackPanel>
                  <TextBlock Text="Тип марки" Style="{StaticResource SabFieldLabelTextStyle}" TextWrapping="Wrap" />
                  <ComboBox ItemsSource="{Binding PlanCornerMarkTypes}" SelectedItem="{Binding SelectedPlanCornerMarkType}" DisplayMemberPath="DisplayName" ToolTip="{Binding SelectedPlanCornerMarkType.DisplayName}" Style="{StaticResource SabComboBoxStyle}" VerticalAlignment="Center" Margin="0,4,0,12" />
                </StackPanel>
              </GroupBox>
              <GroupBox Header="Марки углов на листе" IsEnabled="{Binding PlaceViewsOnSheet}" Margin="0,0,0,16">
                <StackPanel>
                  <TextBlock Text="Тип марки" Style="{StaticResource SabFieldLabelTextStyle}" TextWrapping="Wrap" />
                  <ComboBox ItemsSource="{Binding SheetCornerMarkTypes}" SelectedItem="{Binding SelectedSheetCornerMarkType}" DisplayMemberPath="DisplayName" ToolTip="{Binding SelectedSheetCornerMarkType.DisplayName}" Style="{StaticResource SabComboBoxStyle}" VerticalAlignment="Center" Margin="0,4,0,12" />
                </StackPanel>
              </GroupBox>
              <GroupBox Grid.Column="2" Header="Настройки марок" Margin="0,0,0,16">
                <StackPanel>
                  <TextBlock Text="Состав подписи" Style="{StaticResource SabFieldLabelTextStyle}" TextWrapping="Wrap" />
                  <Grid Margin="0,4,0,12" design:Capsule.IsGroup="True">
                    <Border CornerRadius="17" Background="{DynamicResource SabBrush.TableHeaderBackground}" BorderBrush="{DynamicResource SabBrush.Border}" BorderThickness="1" />
                    <Border Tag="CapsuleIndicator" CornerRadius="15" Background="{DynamicResource SabBrush.Accent}" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False" />
                    <Grid Margin="2">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <RadioButton x:Name="CornerMarksWithRoomNumberRadio" Content="Номер помещения и номер угла" GroupName="CornerMarkLabelMode" IsChecked="{Binding CornerMarksWithRoomNumber, Mode=TwoWay}" Style="{StaticResource SabRadioButtonStyle}" Margin="0" Grid.Column="0" />
                      <RadioButton x:Name="CornerMarksOnlyCornerNumberRadio" Content="Только номер угла" GroupName="CornerMarkLabelMode" IsChecked="{Binding CornerMarksOnlyCornerNumber, Mode=TwoWay}" Style="{StaticResource SabRadioButtonStyle}" Grid.Column="1" Margin="0" />
                    </Grid>
                  </Grid>
                  <StackPanel IsEnabled="{Binding PlaceViewsOnSheet}" Margin="0,18,0,0">
                    <TextBlock Text="Положение относительно вида" Style="{StaticResource SabFieldLabelTextStyle}" TextWrapping="Wrap" />
                    <Grid Margin="0,4,0,12" design:Capsule.IsGroup="True">
                      <Border CornerRadius="17" Background="{DynamicResource SabBrush.TableHeaderBackground}" BorderBrush="{DynamicResource SabBrush.Border}" BorderThickness="1" />
                      <Border Tag="CapsuleIndicator" CornerRadius="15" Background="{DynamicResource SabBrush.Accent}" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False" />
                      <Grid Margin="2">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <RadioButton x:Name="SheetCornerMarksAboveViewRadio" Content="Над видом" GroupName="SheetCornerMarkPosition" IsChecked="{Binding SheetCornerMarksAboveView, Mode=TwoWay}" Style="{StaticResource SabRadioButtonStyle}" Margin="0" Grid.Column="0" />
                        <RadioButton x:Name="SheetCornerMarksBelowViewRadio" Content="Под видом" GroupName="SheetCornerMarkPosition" IsChecked="{Binding SheetCornerMarksBelowView, Mode=TwoWay}" Style="{StaticResource SabRadioButtonStyle}" Grid.Column="1" Margin="0" />
                      </Grid>
                    </Grid>
                  </StackPanel>
                </StackPanel>
              </GroupBox>
            </StackPanel>
          </ScrollViewer>
        </TabItem>
      </TabControl>
    </Grid>
    <Border Background="White" BorderBrush="{DynamicResource SabBrush.Border}" BorderThickness="0,1,0,0" Padding="24,12" Grid.Row="3">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border x:Name="WarningInfoBorder" Grid.Row="0" Style="{StaticResource SabInformationBorderStyle}" Margin="0,0,0,8" Padding="10,7">
          <ScrollViewer MaxHeight="84" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <TextBlock x:Name="WarningInfoTextBlock" Text="" TextWrapping="Wrap" Style="{StaticResource SabAccentInfoTextStyle}" />
          </ScrollViewer>
        </Border>
        <Grid Grid.Row="1">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Button Content="Инструкция" design:Instructions.File="SAB_HTML_Sozdanie_i_korrektirovka_razvertok.html" />
          <WrapPanel Grid.Column="2" HorizontalAlignment="Right">
            <Button Content="Список помещений" Margin="8,0,0,0" x:Name="SelectionListButton" />
            <Button x:Name="ShowDirectionPreviewButton" Content="Показать превью" Style="{StaticResource SabPrimaryButtonStyle}" VerticalAlignment="Center" Margin="8,0,0,0" />
            <Button x:Name="PickLinesButton" Content="Выбрать линии" Style="{StaticResource SabPrimaryButtonStyle}" VerticalAlignment="Center" Margin="8,0,0,0" />
            <Button Content="Создать развёртки" Margin="8,0,0,0" x:Name="OkButton" Style="{StaticResource SabPrimaryButtonStyle}" />
          </WrapPanel>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</Window>
