<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" xmlns:ui="clr-namespace:SAB.UI;assembly=SAB" Title="SAB Развертки стен" Height="900" Width="1400" MinHeight="700" MinWidth="1100" WindowStartupLocation="CenterScreen" WindowStyle="None" AllowsTransparency="True" ResizeMode="CanResizeWithGrip" FontFamily="Segoe UI" FontSize="13" Background="Transparent">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="10" CornerRadius="8" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../UI/Styles/SABRedesignStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="SabSelectionPendingPanelStyle" TargetType="{x:Type Border}" BasedOn="{StaticResource SabValidationPanelStyle}">
                <Setter Property="Background" Value="{StaticResource SabBrush.PanelBackground}"/>
                <Setter Property="BorderBrush" Value="{StaticResource SabBrush.Border}"/>
            </Style>
            <Style x:Key="SabAccentInfoPanelStyle" TargetType="{x:Type Border}" BasedOn="{StaticResource SabValidationPanelStyle}">
                <Setter Property="Background" Value="{StaticResource SabBrush.AccentLight}"/>
                <Setter Property="BorderBrush" Value="{StaticResource SabBrush.Accent}"/>
                <Setter Property="BorderThickness" Value="1.5"/>
            </Style>
            <Style x:Key="SabSelectionPendingTextStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource SabFieldHintTextStyle}">
                <Setter Property="Foreground" Value="{StaticResource SabBrush.TextSecondary}"/>
            </Style>
            <Style x:Key="SabAccentInfoTextStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource SabFieldHintTextStyle}">
                <Setter Property="Foreground" Value="{StaticResource SabBrush.Accent}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Style>
            <SolidColorBrush x:Key="SabBrush.FormulaText" Color="#C65911"/>
            <Style x:Key="SabFormulaEditorBorderStyle" TargetType="{x:Type Border}">
                <Setter Property="Background" Value="{StaticResource SabBrush.PanelBackground}"/>
                <Setter Property="BorderBrush" Value="{StaticResource SabBrush.Border}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="5"/>
                <Style.Triggers>
                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                        <Setter Property="BorderBrush" Value="{StaticResource SabBrush.Accent}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="SabFormulaEditorStyle" TargetType="{x:Type RichTextBox}">
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Validation.ErrorTemplate" Value="{x:Null}"/>
                <Setter Property="CaretBrush" Value="{StaticResource SabBrush.Accent}"/>
                <Setter Property="Height" Value="72"/>
                <Setter Property="Padding" Value="8,5"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{StaticResource SabBrush.FormulaText}"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="AcceptsReturn" Value="False"/>
                <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
                <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
            </Style>
            <Style x:Key="ElevationTabControlStyle" TargetType="{x:Type TabControl}">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            </Style>
            <Style x:Key="ElevationWrappingCheckBoxStyle" TargetType="{x:Type CheckBox}" BasedOn="{StaticResource SabCheckBoxStyle}">
                <Setter Property="ContentTemplate">
                    <Setter.Value>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                        </DataTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="ElevationWrappingRadioButtonStyle" TargetType="{x:Type RadioButton}" BasedOn="{StaticResource SabRadioButtonStyle}">
                <Setter Property="ContentTemplate">
                    <Setter.Value>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                        </DataTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="ElevationTabItemStyle" TargetType="{x:Type TabItem}">
                <Setter Property="Foreground" Value="{DynamicResource SabBrush.TextSecondary}"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="FontWeight" Value="Normal"/>
                <Setter Property="Padding" Value="14,9,14,10"/>
                <Setter Property="Margin" Value="0,0,4,0"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type TabItem}">
                            <Grid Background="Transparent" Cursor="Hand">
                                <Border x:Name="HoverBackground" Margin="2,3" Background="{StaticResource SabBrush.AccentLight}" CornerRadius="4" Opacity="0"/>
                                <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                                <Border x:Name="SelectedLine" Height="3" Width="0" Background="{DynamicResource SabBrush.Accent}" CornerRadius="2,2,0,0" HorizontalAlignment="Center" VerticalAlignment="Bottom" Visibility="Visible"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="HoverBackground" Property="Opacity" Value="0.72"/>
                                    <Setter Property="Foreground" Value="{DynamicResource SabBrush.Accent}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource SabBrush.Accent}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter TargetName="SelectedLine" Property="Width" Value="54"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <ui:ShortSettingsWindowConverter xmlns:ui="clr-namespace:SAB.UI;assembly=SAB" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Key="ShortSettingsWindowConverter"/>
            <Style TargetType="ScrollViewer" BasedOn="{StaticResource SabFormScrollViewerStyle}" x:Key="ElevationSourceScrollStyle">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ShortSettingsWindowConverter}}" Value="True">
                        <Setter Property="MaxHeight" Value="140"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Border Style="{StaticResource SabWindowFrameStyle}">
        <Grid x:Name="WindowRoot" ClipToBounds="True">
            <Grid.RenderTransform>
                <TranslateTransform Y="0"/>
            </Grid.RenderTransform>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border x:Name="TitleBar" Grid.Row="0" Background="{StaticResource SabBrush.PanelBackground}" BorderBrush="{StaticResource SabBrush.BorderWeak}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                        <Border Width="21" Height="21" CornerRadius="4" Background="{StaticResource SabBrush.Accent}">
                            <TextBlock Text="S" Foreground="White" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </Border>
                        <TextBlock Text="SAB  РАЗВЕРТКИ СТЕН" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource SabBrush.Text}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="MinimizeWindowButton" Content="─" ToolTip="Свернуть" Style="{StaticResource SabWindowChromeButtonStyle}"/>
                        <Button x:Name="CloseWindowButton" Content="✕" ToolTip="Закрыть" Style="{StaticResource SabWindowCloseButtonStyle}"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Grid Grid.Row="1" Margin="18,15,18,10">
                <StackPanel>
                    <TextBlock Text="Настройки разверток" Style="{StaticResource SabWindowTitleTextStyle}" TextWrapping="Wrap"/>
                    <TextBlock Text="Создание видов, размещение на листе и маркировка в одном рабочем окне." Margin="0,3,0,0" Style="{StaticResource SabWindowSubtitleTextStyle}" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
            <Border x:Name="WarningInfoBorder" Grid.Row="4" Style="{StaticResource SabAccentInfoPanelStyle}" Margin="18,0,18,10" Padding="10,7">
                <TextBlock x:Name="WarningInfoTextBlock" Text="Перед созданием выберите линии и помещение." TextWrapping="Wrap" MaxHeight="48" Style="{StaticResource SabAccentInfoTextStyle}"/>
            </Border>
            <Border Grid.Row="5" Background="{StaticResource SabBrush.PanelBackground}" BorderBrush="{StaticResource SabBrush.Border}" BorderThickness="0,1,0,0" Padding="18,9">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="CancelButton" Content="Отмена" Width="110" Style="{StaticResource SabNeutralButtonStyle}" Margin="0,0,10,0"/>
                        <ns2:Button xmlns:ns2="clr-namespace:Wpf.Ui.Controls;assembly=Wpf.Ui" x:Name="OkButton" Width="170" IsEnabled="False" Appearance="Primary">
                            <TextBlock Text="Создать развертки" TextWrapping="Wrap" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </ns2:Button>
                    </StackPanel>
                </Grid>
            </Border>
            <ScrollViewer Grid.Row="2" Margin="18,0,18,12" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Style="{StaticResource SabFormScrollViewerStyle}" MaxHeight="164">
                <GroupBox Header="Исходные данные" Style="{StaticResource SabLayeredSettingsGroupStyle}" Margin="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <ui:AdaptiveSettingsGrid Grid.Row="0" Margin="0,0,0,9">
                            <ui:AdaptiveSettingsGrid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </ui:AdaptiveSettingsGrid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Помещения за один запуск" Style="{StaticResource SabFieldLabelTextStyle}" TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Content="Одно помещение" GroupName="RoomSelectionMode" IsChecked="{Binding IsSingleRoomPerSheet, Mode=TwoWay}" Style="{StaticResource ElevationWrappingRadioButtonStyle}" Margin="0,0,10,0"/>
                                    <RadioButton Content="Несколько помещений" GroupName="RoomSelectionMode" IsChecked="{Binding IsMultipleRoomsOnSheet, Mode=TwoWay}" Style="{StaticResource ElevationWrappingRadioButtonStyle}" Margin="0"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Источник помещения" Style="{StaticResource SabFieldLabelTextStyle}" TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Content="Текущая модель" GroupName="RoomSourceMode" IsChecked="{Binding PickRoomFromHost, Mode=TwoWay}" Style="{StaticResource ElevationWrappingRadioButtonStyle}" Margin="0,0,10,0"/>
                                    <RadioButton Content="Связанный файл" GroupName="RoomSourceMode" IsChecked="{Binding PickRoomFromLink, Mode=TwoWay}" Style="{StaticResource ElevationWrappingRadioButtonStyle}" Margin="0"/>
                                </StackPanel>
                            </StackPanel>
                        </ui:AdaptiveSettingsGrid>
                        <ui:AdaptiveSettingsGrid Grid.Row="1">
                            <ui:AdaptiveSettingsGrid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="Auto"/>
                            </ui:AdaptiveSettingsGrid.ColumnDefinitions>
                            <Border x:Name="SelectionStatusBorder" Grid.Column="0" Style="{StaticResource SabSelectionPendingPanelStyle}" Padding="10,7">
                                <TextBlock x:Name="SelectionStatusTextBlock" Text="Линии и помещение не выбраны." TextTrimming="CharacterEllipsis" Style="{StaticResource SabSelectionPendingTextStyle}" TextWrapping="Wrap"/>
                            </Border>
                            <Button x:Name="PickLinesButton" Grid.Column="2" Content="Выбрать / изменить" Width="155" Style="{StaticResource SabOutlineButtonStyle}"/>
                        </ui:AdaptiveSettingsGrid>
                    </Grid>
                </GroupBox>
            </ScrollViewer>
            <Grid Grid.Row="3" Margin="18,0,18,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="340"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource SabReviewPanelStyle}" Padding="12">
                    <TabControl x:Name="SettingsTabControl" Margin="0" Style="{StaticResource ElevationTabControlStyle}" ItemContainerStyle="{StaticResource SabReviewTabItemStyle}">
                        <TabItem Header="Развертки">
                            <Border Style="{StaticResource SabLayeredTabSurfaceStyle}" Margin="0,9,0,0">
                                <ScrollViewer Style="{StaticResource SabFormScrollViewerStyle}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel Margin="0,8,0,4">
                                        <GroupBox Header="Наименование вида" Style="{StaticResource SabLayeredSettingsGroupStyle}">
                                            <StackPanel>
                                                <TextBlock TextWrapping="Wrap" Margin="0,0,0,9" Style="{StaticResource SabFieldHintTextStyle}">
                                                    <Run Text="Введите обычный текст как есть. Параметры пишите в квадратных скобках. Синий текст — параметр распознан, оранжевый — обычный текст."/>
                                                </TextBlock>
                                                <TextBlock Text="Формула имени вида" Style="{StaticResource SabFieldLabelTextStyle}" TextWrapping="Wrap"/>
                                                <Border Style="{StaticResource SabFormulaEditorBorderStyle}" Margin="0,0,0,10">
                                                    <RichTextBox x:Name="ElevationNameFormulaEditor" Style="{StaticResource SabFormulaEditorStyle}"/>
                                                </Border>
                                                <TextBlock Text="Заголовок вида" Style="{StaticResource SabFieldLabelTextStyle}" TextWrapping="Wrap"/>
                                                <Border Style="{StaticResource SabFormulaEditorBorderStyle}">
                                                    <RichTextBox x:Name="ElevationTitleFormulaEditor" Style="{StaticResource SabFormulaEditorStyle}"/>
                                                </Border>
                                                <TextBlock TextWrapping="Wrap" Margin="0,7,0,0" Style="{StaticResource SabFieldHintTextStyle}">
                                                    <Run Text="Доступно: "/>
                                                    <Run Text="[Номер помещения]" Foreground="{StaticResource SabBrush.Accent}" FontWeight="SemiBold"/>
                                                    <Run Text="  "/>
                                                    <Run Text="[Имя помещения]" Foreground="{StaticResource SabBrush.Accent}" FontWeight="SemiBold"/>
                                                    <Run Text="  "/>
                                                    <Run Text="[Начальный угол]" Foreground="{StaticResource SabBrush.Accent}" FontWeight="SemiBold"/>
                                                    <Run Text="  "/>
                                                    <Run Text="[Конечный угол]" Foreground="{StaticResource SabBrush.Accent}" FontWeight="SemiBold"/>
                                                </TextBlock>
                                            </StackPanel>
                                        </GroupBox>
                                        <GroupBox Header="Параметры вида" Style="{StaticResource SabLayeredSettingsGroupStyle}">
                                            <StackPanel>
                                                <ui:AdaptiveSettingsGrid ForceCompact="True">
                                                    <ui:AdaptiveSettingsGrid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="14"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </ui:AdaptiveSettingsGrid.ColumnDefinitions>
                                                    <ui:AdaptiveSettingsGrid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="10"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </ui:AdaptiveSettingsGrid.RowDefinitions>
                                                    <StackPanel Grid.Row="0" Grid.Column="0">
                                                        <TextBlock Text="Тип вида развертки" Style="{StaticResource SabFieldLabelTextStyle}" TextWrapping="Wrap"/>
                                                        <ComboBox ItemsSource="{Binding ElevationViewFamilyTypes}" SelectedItem="{Binding SelectedElevationViewFamilyType}" DisplayMemberPath="DisplayName" ToolTip="{Binding SelectedElevationViewFamilyType.DisplayName}" Style="{StaticResource SabComboBoxStyle}"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Row="0" Grid.Column="2">
                                                        <TextBlock Text="Шаблон вида" Style="{StaticResource SabFieldLabelTextStyle}" TextWrapping="Wrap"/>
                                                        <ComboBox ItemsSource="{Binding ViewTemplates}" SelectedItem="{Binding SelectedViewTemplate}" DisplayMemberPath="DisplayName" ToolTip="{Binding SelectedViewTemplate.DisplayName}" Style="{StaticResource SabComboBoxStyle}"/>
                                                    </StackPanel>
                                                    <ui:AdaptiveSettingsGrid Grid.Row="2" Grid.Column="0" ForceCompact="True">
                                                        <ui:AdaptiveSettingsGrid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="10"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </ui:AdaptiveSettingsGrid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock Text="Масштаб" Style="{StaticResource SabFieldLabelTextStyle}" TextWrapping="Wrap"/>
                                                            <TextBox Text="{Binding ViewScaleText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SabTextBoxStyle}"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2">
                                                            <TextBlock Text="Глубина, мм" Style="{StaticResource SabFieldLabelTextStyle}" TextWrapping="Wrap"/>
                                                            <TextBox Text="{Binding ViewDepthMmText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SabTextBoxStyle}"/>
                                                        </StackPanel>
                                                    </ui:AdaptiveSettingsGrid>
                                                    <StackPanel Grid.Row="2" Grid.Column="2">
                                                        <TextBlock Text="Отступ вида от линии, мм" Style="{StaticResource SabFieldLabelTextStyle}" TextWrapping="Wrap"/>
                                                        <TextBox Text="{Binding MarkerOffsetMmText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SabTextBoxStyle}"/>
                                                    </StackPanel>
                                                </ui:AdaptiveSettingsGrid>
                                            </StackPanel>
                                        </GroupBox>
                                        <GroupBox Style="{StaticResource SabLayeredSettingsGroupStyle}">
                                            <GroupBox.Header>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Подрезка вида" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                                    <Button x:Name="PickCropByExampleButton" Grid.Column="1" Content="Взять высоту с вида-примера" Style="{StaticResource SabOutlineButtonStyle}" MinWidth="210"/>
                                                </Grid>
                                            </GroupBox.Header>
                                            <StackPanel>
                                                <ui:AdaptiveSettingsGrid ForceCompact="True">
                                                    <ui:AdaptiveSettingsGrid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="10"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="10"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="10"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </ui:AdaptiveSettingsGrid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="Сверху, мм" Style="{StaticResource SabFieldLabelTextStyle}" TextWrapping="Wrap"/>
                                                        <TextBox Text="{Binding TopOffsetMmText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SabTextBoxStyle}"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="Снизу, мм" Style="{StaticResource SabFieldLabelTextStyle}" TextWrapping="Wrap"/>
                                                        <TextBox Text="{Binding BottomOffsetMmText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SabTextBoxStyle}"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="4">
                                                        <TextBlock Text="Слева, мм" Style="{StaticResource SabFieldLabelTextStyle}" TextWrapping="Wrap"/>
                                                        <TextBox Text="{Binding LeftOffsetMmText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SabTextBoxStyle}"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="6">
                                                        <TextBlock Text="Справа, мм" Style="{StaticResource SabFieldLabelTextStyle}" TextWrapping="Wrap"/>
                                                        <TextBox Text="{Binding RightOffsetMmText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SabTextBoxStyle}"/>
                                                    </StackPanel>
                                                </ui:AdaptiveSettingsGrid>
                                            </StackPanel>
                                        </GroupBox>
                                        <GroupBox Header="Оси на развертке" Style="{StaticResource SabLayeredSettingsGroupStyle}">
                                            <StackPanel>
                                                <TextBlock Text="Оси основной модели подрезаются относительно рамки вида. Размер задаётся на листе и автоматически пересчитывается с учётом масштаба. Верхний пузырёк отключается, нижний остаётся включённым. Оси связей не изменяются." TextWrapping="Wrap" Style="{StaticResource SabFieldHintTextStyle}" Margin="0,0,0,10"/>
                                                <ui:AdaptiveSettingsGrid ForceCompact="True">
                                                    <ui:AdaptiveSettingsGrid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="20"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </ui:AdaptiveSettingsGrid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="Выступ сверху, мм на листе" Style="{StaticResource SabFieldLabelTextStyle}" TextWrapping="Wrap"/>
                                                        <TextBox Text="{Binding GridTopExtensionPaperMmText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SabTextBoxStyle}"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="Выступ снизу, мм на листе" Style="{StaticResource SabFieldLabelTextStyle}" TextWrapping="Wrap"/>
                                                        <TextBox Text="{Binding GridBottomExtensionPaperMmText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SabTextBoxStyle}"/>
                                                    </StackPanel>
                                                </ui:AdaptiveSettingsGrid>
                                            </StackPanel>
                                        </GroupBox>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>
                        </TabItem>
                        <TabItem x:Name="SheetTabItem" Header="Лист">
                            <Border Style="{StaticResource SabLayeredTabSurfaceStyle}" Margin="0,9,0,0">
                                <ScrollViewer Style="{StaticResource SabFormScrollViewerStyle}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel Margin="0,8,0,4">
                                        <GroupBox Header="Размещение" Style="{StaticResource SabLayeredSettingsGroupStyle}">
                                            <StackPanel>
                                                <WrapPanel Margin="0,0,0,10">
                                                    <RadioButton Content="Не размещать на листе" GroupName="SheetPlacementMode" IsChecked="{Binding DoNotPlaceViewsOnSheetMode, Mode=TwoWay}" Style="{StaticResource ElevationWrappingRadioButtonStyle}" Margin="0,0,18,0"/>
                                                    <RadioButton Content="Создать новый лист" GroupName="SheetPlacementMode" IsChecked="{Binding CreateNewSheetMode, Mode=TwoWay}" Style="{StaticResource ElevationWrappingRadioButtonStyle}" Margin="0,0,18,0"/>
                                                    <RadioButton Content="Добавить на существующий лист" GroupName="SheetPlacementMode" IsChecked="{Binding ExistingSheetMode, Mode=TwoWay}" Style="{StaticResource ElevationWrappingRadioButtonStyle}" Margin="0"/>
                                                </WrapPanel>
                                                <CheckBox Content="Открыть целевой лист после выполнения" IsChecked="{Binding OpenCreatedSheet}" IsEnabled="{Binding PlaceViewsOnSheet}" Style="{StaticResource ElevationWrappingCheckBoxStyle}"/>
                                            </StackPanel>
                                        </GroupBox>
                                        <GroupBox Header="Целевой лист" Style="{StaticResource SabLayeredSettingsGroupStyle}">
                                            <StackPanel>
                                                <StackPanel>
                                                    <StackPanel.Style>
                                                        <Style TargetType="{x:Type StackPanel}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding CreateSheet}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>
                                                    <ui:AdaptiveSettingsGrid ForceCompact="True">
                                                        <ui:AdaptiveSettingsGrid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="14"/>
                                                            <ColumnDefinition Width="160"/>
                                                        </ui:AdaptiveSettingsGrid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock Text="Тип основной надписи" Style="{StaticResource SabFieldLabelTextStyle}" TextWrapping="Wrap"/>
                                                            <ComboBox ItemsSource="{Binding TitleBlockTypes}" SelectedItem="{Binding SelectedTitleBlockType}" DisplayMemberPath="DisplayName" ToolTip="{Binding SelectedTitleBlockType.DisplayName}" Style="{StaticResource SabComboBoxStyle}"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2">
                                                            <TextBlock Text="Формат листа (А)" Style="{StaticResource SabFieldLabelTextStyle}" TextWrapping="Wrap"/>
                                                            <TextBox Text="{Binding SheetFormatAText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SabTextBoxStyle}"/>
                                                        </StackPanel>
                                                    </ui:AdaptiveSettingsGrid>
                                                    <TextBlock Text="Формула имени листа" Style="{StaticResource SabFieldLabelTextStyle}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                                                    <Border Style="{StaticResource SabFormulaEditorBorderStyle}">
                                                        <RichTextBox x:Name="SheetNameFormulaEditor" Style="{StaticResource SabFormulaEditorStyle}"/>
                                                    </Border>
                                                    <TextBlock Text="Доступно: [Номер помещения], [Имя помещения], [Помещения]" Style="{StaticResource SabFieldHintTextStyle}" Margin="0,5,0,0" TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <StackPanel>
                                                    <StackPanel.Style>
                                                        <Style TargetType="{x:Type StackPanel}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding UseExistingSheet}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>
                                                    <TextBlock Text="Номер или имя листа" Style="{StaticResource SabFieldLabelTextStyle}" TextWrapping="Wrap"/>
                                                    <ComboBox ItemsSource="{Binding ExistingSheetsView}" SelectedItem="{Binding SelectedExistingSheet, Mode=TwoWay}" Text="{Binding ExistingSheetSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsDropDownOpen="{Binding IsExistingSheetDropDownOpen, Mode=TwoWay}" DisplayMemberPath="DisplayName" IsEditable="True" IsTextSearchEnabled="False" StaysOpenOnEdit="True" ToolTip="Введите часть номера или имени листа" Style="{StaticResource SabComboBoxStyle}"/>
                                                    <TextBlock Text="Список фильтруется по номеру и имени по мере ввода." Style="{StaticResource SabFieldHintTextStyle}" Margin="0,5,0,0" TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <TextBlock Text="Выберите способ размещения выше." TextWrapping="Wrap">
                                                    <TextBlock.Style>
                                                        <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource SabFieldHintTextStyle}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding DoNotPlaceViewsOnSheetMode}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </GroupBox>
                                        <GroupBox Style="{StaticResource SabLayeredSettingsGroupStyle}" IsEnabled="{Binding PlaceViewsOnSheet}">
                                            <GroupBox.Header>
                                                <ui:AdaptiveSettingsGrid ForceCompact="True">
                                                    <ui:AdaptiveSettingsGrid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </ui:AdaptiveSettingsGrid.ColumnDefinitions>
                                                    <TextBlock Text="Раскладка видов" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                        <TextBlock Text="Точка: " Style="{StaticResource SabFieldHintTextStyle}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                                        <TextBlock Text="{Binding SheetPointSummary}" Style="{StaticResource SabFieldHintTextStyle}" VerticalAlignment="Center" Margin="0,0,10,0" TextWrapping="Wrap"/>
                                                        <Button x:Name="PickSheetPointButton" Content="{Binding PickSheetPointButtonText}" Style="{StaticResource SabOutlineButtonStyle}" MinWidth="190"/>
                                                    </StackPanel>
                                                </ui:AdaptiveSettingsGrid>
                                            </GroupBox.Header>
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                                    <StackPanel.Style>
                                                        <Style TargetType="{x:Type StackPanel}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding UseExistingSheet}" Value="True"/>
                                                                        <Condition Binding="{Binding CreateRoomPlanScheme}" Value="True"/>
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </MultiDataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>
                                                    <TextBlock Text="План-схема: " Style="{StaticResource SabFieldHintTextStyle}" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding ExistingRoomPlanSummary}" Style="{StaticResource SabFieldHintTextStyle}" TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <WrapPanel Margin="0,0,0,8">
                                                    <RadioButton Content="Автоматическое размещение" IsChecked="{Binding UseAutomaticSheetPlacement}" Margin="0,0,20,0" Style="{StaticResource ElevationWrappingRadioButtonStyle}"/>
                                                    <RadioButton Content="Ручные настройки" IsChecked="{Binding UseManualSheetPlacement}" Style="{StaticResource ElevationWrappingRadioButtonStyle}"/>
                                                </WrapPanel>
                                                <TextBlock Text="Если автоматическая компоновка не получится, виды разместятся по заданному числу в строке. Ручная расстановка допускает выход за рамку листа." Style="{StaticResource SabFieldHintTextStyle}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                                <ui:AdaptiveSettingsGrid ForceCompact="True">
                                                    <ui:AdaptiveSettingsGrid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="10"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="10"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="10"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="10"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </ui:AdaptiveSettingsGrid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="Видов в строке" Style="{StaticResource SabFieldLabelTextStyle}" TextWrapping="Wrap"/>
                                                        <TextBox Text="{Binding ColumnsCountText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SabTextBoxStyle}" ToolTip="Число видов в строке для ручной расстановки и перехода при неудаче автоматической компоновки."/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="Старт X, мм" Style="{StaticResource SabFieldLabelTextStyle}" TextWrapping="Wrap"/>
                                                        <TextBox Text="{Binding StartXmmText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SabTextBoxStyle}"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="4">
                                                        <TextBlock Text="Старт Y, мм" Style="{StaticResource SabFieldLabelTextStyle}" TextWrapping="Wrap"/>
                                                        <TextBox Text="{Binding StartYmmText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SabTextBoxStyle}"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="6">
                                                        <TextBlock Text="Зазор X, мм" Style="{StaticResource SabFieldLabelTextStyle}" TextWrapping="Wrap"/>
                                                        <TextBox Text="{Binding StepXmmText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SabTextBoxStyle}"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="8">
                                                        <TextBlock Text="Зазор Y, мм" Style="{StaticResource SabFieldLabelTextStyle}" TextWrapping="Wrap"/>
                                                        <TextBox Text="{Binding StepYmmText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SabTextBoxStyle}"/>
                                                    </StackPanel>
                                                </ui:AdaptiveSettingsGrid>
                                            </StackPanel>
                                        </GroupBox>
                                        <GroupBox Header="Оформление видового экрана" Style="{StaticResource SabLayeredSettingsGroupStyle}" IsEnabled="{Binding PlaceViewsOnSheet}">
                                            <StackPanel>
                                                <ui:AdaptiveSettingsGrid ForceCompact="True">
                                                    <ui:AdaptiveSettingsGrid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="12"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="12"/>
                                                        <ColumnDefinition Width="120"/>
                                                        <ColumnDefinition Width="12"/>
                                                        <ColumnDefinition Width="120"/>
                                                    </ui:AdaptiveSettingsGrid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="Тип видового экрана" Style="{StaticResource SabFieldLabelTextStyle}" TextWrapping="Wrap"/>
                                                        <ComboBox ItemsSource="{Binding ViewportTypes}" SelectedItem="{Binding SelectedViewportType}" DisplayMemberPath="DisplayName" ToolTip="{Binding SelectedViewportType.DisplayName}" Style="{StaticResource SabComboBoxStyle}"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="Привязка заголовка" Style="{StaticResource SabFieldLabelTextStyle}" TextWrapping="Wrap"/>
                                                        <ComboBox ItemsSource="{Binding ViewTitleAnchors}" SelectedItem="{Binding SelectedViewTitleAnchor}" DisplayMemberPath="DisplayName" Style="{StaticResource SabComboBoxStyle}"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="4">
                                                        <TextBlock Text="Смещение X, мм" Style="{StaticResource SabFieldLabelTextStyle}" TextWrapping="Wrap"/>
                                                        <TextBox Text="{Binding ViewTitleOffsetXmmText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SabTextBoxStyle}"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="6">
                                                        <TextBlock Text="Смещение Y, мм" Style="{StaticResource SabFieldLabelTextStyle}" TextWrapping="Wrap"/>
                                                        <TextBox Text="{Binding ViewTitleOffsetYmmText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SabTextBoxStyle}"/>
                                                    </StackPanel>
                                                </ui:AdaptiveSettingsGrid>
                                            </StackPanel>
                                        </GroupBox>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>
                        </TabItem>
                        <TabItem Header="План-схема">
                            <Border Style="{StaticResource SabLayeredTabSurfaceStyle}" Margin="0,9,0,0">
                                <ScrollViewer Style="{StaticResource SabFormScrollViewerStyle}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel Margin="0,8,0,4">
                                        <GroupBox Header="Создание и размещение" Style="{StaticResource SabLayeredSettingsGroupStyle}">
                                            <StackPanel>
                                                <WrapPanel>
                                                    <CheckBox Content="{Binding RoomPlanOperationLabel}" IsChecked="{Binding CreateRoomPlanScheme}" ToolTip="Создание план-схемы можно отключить независимо от размещения разверток." Style="{StaticResource ElevationWrappingCheckBoxStyle}" Margin="0,0,24,0"/>
                                                    <CheckBox Content="Размещать план-схему на листах" IsChecked="{Binding PlaceRoomPlanSchemeOnSheet}" IsEnabled="{Binding CanPlaceRoomPlanSchemeOnSheet}" ToolTip="Размещать план-схему снизу справа на каждом листе с развертками." Style="{StaticResource ElevationWrappingCheckBoxStyle}"/>
                                                </WrapPanel>
                                                <TextBlock Text="План-схема размещается снизу справа и повторяется на каждом листе с развертками." TextWrapping="Wrap" Margin="0,6,0,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource SabFieldHintTextStyle}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding CreateRoomPlanScheme}" Value="True"/>
                                                                        <Condition Binding="{Binding PlaceViewsOnSheet}" Value="True"/>
                                                                        <Condition Binding="{Binding PlaceRoomPlanSchemeOnSheet}" Value="True"/>
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </MultiDataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Text="{Binding RoomPlanModeHint}" Style="{StaticResource SabFieldHintTextStyle}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                                <CheckBox Content="Включать категорию «Помещения / Объект» перед выбором помещения" IsChecked="{Binding EnableRoomObjectCategory}" Style="{StaticResource ElevationWrappingCheckBoxStyle}" Margin="0,10,0,0" ToolTip="Если выключено, плагин не изменяет видимость подкатегории «Объект» на виде и в его шаблоне."/>
                                            </StackPanel>
                                        </GroupBox>
                                        <GroupBox Header="Положение на листе" Style="{StaticResource SabLayeredSettingsGroupStyle}" IsEnabled="{Binding CanPositionRoomPlan}">
                                            <StackPanel>
                                                <CheckBox Content="Задать положение план-схемы вручную" IsChecked="{Binding UseManualRoomPlanPosition}" Style="{StaticResource ElevationWrappingCheckBoxStyle}"/>
                                                <TextBlock Text="Привязка — нижний правый угол схемы вместе с заголовком и марками. Отступы считаются от правого и нижнего краёв рабочей области листа, заданной стартовой точкой разверток." Style="{StaticResource SabFieldHintTextStyle}" TextWrapping="Wrap" Margin="0,6,0,10"/>
                                                <ui:AdaptiveSettingsGrid IsEnabled="{Binding UseManualRoomPlanPosition}" ForceCompact="True">
                                                    <ui:AdaptiveSettingsGrid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="12"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </ui:AdaptiveSettingsGrid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="Отступ справа, мм" Style="{StaticResource SabFieldLabelTextStyle}" TextWrapping="Wrap"/>
                                                        <TextBox Text="{Binding RoomPlanOffsetRightMmText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SabTextBoxStyle}"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="Отступ снизу, мм" Style="{StaticResource SabFieldLabelTextStyle}" TextWrapping="Wrap"/>
                                                        <TextBox Text="{Binding RoomPlanOffsetBottomMmText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SabTextBoxStyle}"/>
                                                    </StackPanel>
                                                </ui:AdaptiveSettingsGrid>
                                                <Button x:Name="PickRoomPlanPointButton" Content="Указать точку план-схемы на листе" Style="{StaticResource SabOutlineButtonStyle}" HorizontalAlignment="Left" Margin="0,10,0,0"/>
                                                <TextBlock Text="Выбор точки заполняет оба отступа и включает ручное положение. Положительные значения сдвигают схему влево и вверх; положение повторяется на листах продолжения." Style="{StaticResource SabFieldHintTextStyle}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                            </StackPanel>
                                        </GroupBox>
                                        <GroupBox Header="Параметры план-схемы" Style="{StaticResource SabLayeredSettingsGroupStyle}" IsEnabled="{Binding CanEditRoomPlanCreationParameters}">
                                            <StackPanel>
                                                <TextBlock Text="Формула имени вида" Style="{StaticResource SabFieldLabelTextStyle}" TextWrapping="Wrap"/>
                                                <Border Style="{StaticResource SabFormulaEditorBorderStyle}" Margin="0,0,0,10">
                                                    <RichTextBox x:Name="RoomPlanNameFormulaEditor" Style="{StaticResource SabFormulaEditorStyle}"/>
                                                </Border>
                                                <ui:AdaptiveSettingsGrid ForceCompact="True">
                                                    <ui:AdaptiveSettingsGrid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="12"/>
                                                        <ColumnDefinition Width="130"/>
                                                        <ColumnDefinition Width="12"/>
                                                        <ColumnDefinition Width="160"/>
                                                    </ui:AdaptiveSettingsGrid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="Шаблон вида" Style="{StaticResource SabFieldLabelTextStyle}" TextWrapping="Wrap"/>
                                                        <ComboBox ItemsSource="{Binding RoomPlanViewTemplates}" SelectedItem="{Binding SelectedRoomPlanViewTemplate}" DisplayMemberPath="DisplayName" ToolTip="{Binding SelectedRoomPlanViewTemplate.DisplayName}" Style="{StaticResource SabComboBoxStyle}"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="Масштаб" Style="{StaticResource SabFieldLabelTextStyle}" TextWrapping="Wrap"/>
                                                        <TextBox Text="{Binding RoomPlanViewScaleText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SabTextBoxStyle}"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="4">
                                                        <TextBlock Text="Отступ обрезки, мм" Style="{StaticResource SabFieldLabelTextStyle}" TextWrapping="Wrap"/>
                                                        <TextBox Text="{Binding RoomPlanCropOffsetMmText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SabTextBoxStyle}"/>
                                                    </StackPanel>
                                                </ui:AdaptiveSettingsGrid>
                                                <TextBlock Text="Тип марки помещения" Style="{StaticResource SabFieldLabelTextStyle}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                                                <ComboBox ItemsSource="{Binding RoomPlanRoomTagTypes}" SelectedItem="{Binding SelectedRoomPlanRoomTagType}" DisplayMemberPath="DisplayName" ToolTip="{Binding SelectedRoomPlanRoomTagType.DisplayName}" Style="{StaticResource SabComboBoxStyle}"/>
                                            </StackPanel>
                                        </GroupBox>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>
                        </TabItem>
                        <TabItem Header="Марки">
                            <Border Style="{StaticResource SabLayeredTabSurfaceStyle}" Margin="0,9,0,0">
                                <ScrollViewer Style="{StaticResource SabFormScrollViewerStyle}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <ui:AdaptiveSettingsGrid Margin="0,14,10,4" ForceCompact="True">
                                        <ui:AdaptiveSettingsGrid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                        </ui:AdaptiveSettingsGrid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <GroupBox Header="Марки углов на плане" Style="{StaticResource SabLayeredSettingsGroupStyle}">
                                                <StackPanel>
                                                    <TextBlock Text="Тип марки" Style="{StaticResource SabFieldLabelTextStyle}" TextWrapping="Wrap"/>
                                                    <ComboBox ItemsSource="{Binding PlanCornerMarkTypes}" SelectedItem="{Binding SelectedPlanCornerMarkType}" DisplayMemberPath="DisplayName" ToolTip="{Binding SelectedPlanCornerMarkType.DisplayName}" Style="{StaticResource SabComboBoxStyle}"/>
                                                </StackPanel>
                                            </GroupBox>
                                            <GroupBox Header="Марки углов на листе" Style="{StaticResource SabLayeredSettingsGroupStyle}" IsEnabled="{Binding PlaceViewsOnSheet}">
                                                <StackPanel>
                                                    <TextBlock Text="Тип марки" Style="{StaticResource SabFieldLabelTextStyle}" TextWrapping="Wrap"/>
                                                    <ComboBox ItemsSource="{Binding SheetCornerMarkTypes}" SelectedItem="{Binding SelectedSheetCornerMarkType}" DisplayMemberPath="DisplayName" ToolTip="{Binding SelectedSheetCornerMarkType.DisplayName}" Style="{StaticResource SabComboBoxStyle}"/>
                                                </StackPanel>
                                            </GroupBox>
                                        </StackPanel>
                                        <GroupBox Grid.Column="2" Header="Настройки марок" Style="{StaticResource SabLayeredSettingsGroupStyle}">
                                            <StackPanel>
                                                <TextBlock Text="Состав подписи" Style="{StaticResource SabFieldLabelTextStyle}" TextWrapping="Wrap"/>
                                                <RadioButton x:Name="CornerMarksWithRoomNumberRadio" Content="Номер помещения и номер угла" GroupName="CornerMarkLabelMode" IsChecked="{Binding CornerMarksWithRoomNumber, Mode=TwoWay}" Style="{StaticResource ElevationWrappingRadioButtonStyle}" Margin="0,0,0,7"/>
                                                <RadioButton x:Name="CornerMarksOnlyCornerNumberRadio" Content="Только номер угла" GroupName="CornerMarkLabelMode" IsChecked="{Binding CornerMarksOnlyCornerNumber, Mode=TwoWay}" Style="{StaticResource ElevationWrappingRadioButtonStyle}"/>
                                                <StackPanel IsEnabled="{Binding PlaceViewsOnSheet}" Margin="0,18,0,0">
                                                    <TextBlock Text="Положение относительно вида" Style="{StaticResource SabFieldLabelTextStyle}" TextWrapping="Wrap"/>
                                                    <RadioButton x:Name="SheetCornerMarksAboveViewRadio" Content="Над видом" GroupName="SheetCornerMarkPosition" IsChecked="{Binding SheetCornerMarksAboveView, Mode=TwoWay}" Style="{StaticResource ElevationWrappingRadioButtonStyle}" Margin="0,0,0,7"/>
                                                    <RadioButton x:Name="SheetCornerMarksBelowViewRadio" Content="Под видом" GroupName="SheetCornerMarkPosition" IsChecked="{Binding SheetCornerMarksBelowView, Mode=TwoWay}" Style="{StaticResource ElevationWrappingRadioButtonStyle}"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </GroupBox>
                                    </ui:AdaptiveSettingsGrid>
                                </ScrollViewer>
                            </Border>
                        </TabItem>
                    </TabControl>
                </Border>
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Style="{StaticResource SabReviewPanelStyle}">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                                <TextBlock Text="Развёртки по выбранным линиям" TextWrapping="Wrap" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock Text="Предпросмотр наименований. Геометрия и порядок задаются выбранным контуром." TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource SabBrush.TextSecondary}" Margin="0,5,0,0"/>
                            </StackPanel>
                            <DataGrid ItemsSource="{Binding NamingPreviewItems}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column" RowHeaderWidth="0" SelectionMode="Single" Style="{StaticResource SabDataGridStyle}" x:Name="ElevationPreviewDataGrid" SelectedIndex="0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Помещение" Binding="{Binding RoomName}" Width="1.2*" ElementStyle="{StaticResource SabDataGridTextBlockStyle}"/>
                                    <DataGridTextColumn Header="Углы" Binding="{Binding Corners}" Width="70" ElementStyle="{StaticResource SabDataGridTextBlockStyle}"/>
                                    <DataGridTextColumn Header="Имя вида" Binding="{Binding ViewName}" Width="2*" ElementStyle="{StaticResource SabDataGridTextBlockStyle}"/>
                                    <DataGridTextColumn Header="Заголовок на листе" Binding="{Binding ViewTitle}" Width="1.5*" ElementStyle="{StaticResource SabDataGridTextBlockStyle}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>
                    <Border x:Name="ElevationTextPreview" Margin="0,12,0,0" Padding="16" Grid.Row="1" Style="{StaticResource SabReviewPanelStyle}">
                        <StackPanel>
                            <TextBlock Text="Предпросмотр выбранной развёртки" TextWrapping="Wrap" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <TextBlock TextWrapping="Wrap" Margin="0,2" x:Name="ElevationPreviewViewName" Text="{Binding SelectedItem.ViewName, ElementName=ElevationPreviewDataGrid, TargetNullValue=Выберите строку, StringFormat='Имя вида: {0}'}">
                                </TextBlock>
                            <TextBlock TextWrapping="Wrap" Margin="0,2" x:Name="ElevationPreviewViewTitle" Text="{Binding SelectedItem.ViewTitle, ElementName=ElevationPreviewDataGrid, TargetNullValue=Выберите строку, StringFormat='Заголовок на листе: {0}'}">
                                </TextBlock>
                            <TextBlock Text="{Binding NamingPreviewStatusText}" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource SabBrush.TextSecondary}" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
