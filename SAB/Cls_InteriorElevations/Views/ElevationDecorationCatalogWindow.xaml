<?xml version='1.0' encoding='utf-8'?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:design="clr-namespace:SAB.UI.FluentLight;assembly=SAB" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="SAB · Каталог оформления" Width="1020" Height="720" MinWidth="820" MinHeight="520" ResizeMode="CanResize" WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" FontSize="13" Background="{DynamicResource SabBrush.WindowBackground}" UseLayoutRounding="True">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../../UI/Styles/SABFluentLight.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>
  <Grid Background="{DynamicResource SabBrush.WindowBackground}" x:Name="WindowRoot">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Border Background="White" BorderBrush="{DynamicResource SabBrush.Border}" BorderThickness="0,0,0,1" Padding="24,12" x:Name="TitleBar">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="SAB" TextWrapping="Wrap" Style="{StaticResource SabPanelHeaderTextStyle}" />
        <TextBlock Grid.Column="1" Text="Развёртки" Foreground="{DynamicResource SabBrush.TextSecondary}" VerticalAlignment="Center" Margin="20,0,0,0" />
        <StackPanel Grid.Column="2" Orientation="Horizontal">
          <Button Visibility="Collapsed" x:Name="MinimizeWindowButton" />
          <Button Visibility="Collapsed" x:Name="CloseWindowButton" />
        </StackPanel>
      </Grid>
    </Border>
    <TextBlock Grid.Row="1" Text="Каталог оформления" Style="{StaticResource SabWindowTitleTextStyle}" Margin="24,20,24,16" />
    <Grid Grid.Row="2" Margin="24,0,24,16">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <StackPanel>
        <TextBlock Text="Роль элемента" TextWrapping="Wrap" Style="{StaticResource SabFieldLabelTextStyle}" />
        <ComboBox x:Name="RoleComboBox" DisplayMemberPath="DisplayName" Style="{StaticResource SabComboBoxStyle}" VerticalAlignment="Center" Margin="0,4,0,12" />
        <WrapPanel Margin="0,0,0,12">
          <Button x:Name="AddHostButton" Content="Выбрать в текущей модели" Margin="0,0,8,8" Style="{StaticResource SabPrimaryButtonStyle}" VerticalAlignment="Center" />
          <Button x:Name="AddLinkedButton" Content="Выбрать в связанных файлах" Style="{StaticResource SabNeutralButtonStyle}" VerticalAlignment="Center" Margin="0,0,8,8" />
          <Button x:Name="RemoveSelectedButton" Content="Удалить выбранное" Margin="0,0,8,8" Style="{StaticResource SabNeutralButtonStyle}" VerticalAlignment="Center" />
          <Button x:Name="ClearRoleButton" Content="Очистить роль" Style="{StaticResource SabNeutralButtonStyle}" VerticalAlignment="Center" Margin="0,0,8,8" />
        </WrapPanel>
      </StackPanel>
      <Border Tag="CollectionFrame" Style="{StaticResource SabCollectionBorderStyle}" Grid.Row="1">
        <DataGrid AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" RowHeight="44" ColumnHeaderHeight="38" BorderThickness="0" x:Name="EntriesListView">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Типоразмер" Binding="{Binding TypeDisplayName}" Width="3*" MinWidth="180" ElementStyle="{StaticResource SabDataGridTextBlockStyle}" />
            <DataGridTextColumn Header="Источник" Binding="{Binding SourceDocumentTitle}" Width="2*" MinWidth="180" ElementStyle="{StaticResource SabDataGridTextBlockStyle}" />
          </DataGrid.Columns>
        </DataGrid>
      </Border>
    </Grid>
    <Border Background="White" BorderBrush="{DynamicResource SabBrush.Border}" BorderThickness="0,1,0,0" Padding="24,12" Grid.Row="3">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="1">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Button Content="Инструкция" design:Instructions.File="SAB_HTML_Oformlenie_razvertok.html" />
          <WrapPanel Grid.Column="2" HorizontalAlignment="Right">
            <Button Content="Готово" Margin="8,0,0,0" x:Name="DoneButton" Style="{StaticResource SabPrimaryButtonStyle}" />
          </WrapPanel>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</Window>
