<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="SAB Каталог оформления"
        Height="620"
        Width="880"
        MinHeight="520"
        MinWidth="760"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResizeWithGrip"
        FontFamily="Segoe UI"
        FontSize="13"
        Background="Transparent">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                                  ResizeBorderThickness="7"
                                  CornerRadius="8"
                                  GlassFrameThickness="0"
                                  UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../UI/Styles/SABWindowStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border Style="{StaticResource SabWindowFrameStyle}">
        <Grid x:Name="WindowRoot" ClipToBounds="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="32" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border x:Name="TitleBar"
                    Grid.Row="0"
                    Background="{StaticResource SabBrush.PanelBackground}"
                    BorderBrush="{StaticResource SabBrush.BorderWeak}"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                        <Border Width="21" Height="21" CornerRadius="4" Background="{StaticResource SabBrush.Accent}">
                            <TextBlock Text="S"
                                       Foreground="White"
                                       FontWeight="Bold"
                                       FontSize="12"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="SAB  КАТАЛОГ ОФОРМЛЕНИЯ"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource SabBrush.Text}"
                                   FontSize="12"
                                   FontWeight="SemiBold" />
                    </StackPanel>
                    <Button x:Name="CloseWindowButton"
                            Grid.Column="1"
                            Content="✕"
                            ToolTip="Закрыть"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Style="{StaticResource SabWindowCloseButtonStyle}" />
                </Grid>
            </Border>

            <StackPanel Grid.Row="1" Margin="18,15,18,12">
                <TextBlock Text="Каталог типоразмеров"
                           Style="{StaticResource SabWindowTitleTextStyle}" />
                <TextBlock Text="Выберите роль, затем укажите экземпляры на активном виде. В каталог сохраняются их типоразмеры, поэтому достаточно выбрать по одному экземпляру каждого нужного типа."
                           Margin="0,3,0,0"
                           TextWrapping="Wrap"
                           Style="{StaticResource SabWindowSubtitleTextStyle}" />
            </StackPanel>

            <Grid Grid.Row="2" Margin="18,0,18,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <GroupBox Header="Роль элемента" Style="{StaticResource SabLayeredSettingsGroupStyle}">
                    <ComboBox x:Name="RoleComboBox"
                              DisplayMemberPath="DisplayName"
                              Style="{StaticResource SabComboBoxStyle}" />
                </GroupBox>

                <Border Grid.Row="1"
                        Margin="0,10,0,10"
                        Padding="12"
                        Style="{StaticResource SabValidationPanelStyle}">
                    <StackPanel>
                        <TextBlock Text="Добавить типоразмеры выбранной роли"
                                   Style="{StaticResource SabFieldLabelTextStyle}" />
                        <WrapPanel Margin="0,8,0,0">
                            <Button x:Name="AddHostButton"
                                    Content="Выбрать в текущей модели"
                                    Width="220"
                                    Margin="0,0,10,0"
                                    Style="{StaticResource SabPrimaryButtonStyle}" />
                            <Button x:Name="AddLinkedButton"
                                    Content="Выбрать в связанных файлах"
                                    Width="230"
                                    Style="{StaticResource SabNeutralButtonStyle}" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <GroupBox Grid.Row="2"
                          Header="Типоразмеры выбранной роли"
                          Style="{StaticResource SabLayeredSettingsGroupStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ListView x:Name="EntriesListView"
                                  MinHeight="180"
                                  BorderBrush="{StaticResource SabBrush.BorderWeak}"
                                  BorderThickness="1">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Типоразмер" Width="420" DisplayMemberBinding="{Binding TypeDisplayName}" />
                                    <GridViewColumn Header="Источник" Width="250" DisplayMemberBinding="{Binding SourceDocumentTitle}" />
                                </GridView>
                            </ListView.View>
                        </ListView>
                        <StackPanel Grid.Row="1"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Margin="0,10,0,0">
                            <Button x:Name="RemoveSelectedButton"
                                    Content="Удалить выбранное"
                                    MinWidth="160"
                                    Margin="0,0,10,0"
                                    Style="{StaticResource SabNeutralButtonStyle}" />
                            <Button x:Name="ClearRoleButton"
                                    Content="Очистить роль"
                                    MinWidth="130"
                                    Style="{StaticResource SabNeutralButtonStyle}" />
                        </StackPanel>
                    </Grid>
                </GroupBox>
            </Grid>

            <Border Grid.Row="3"
                    Background="{StaticResource SabBrush.PanelBackground}"
                    BorderBrush="{StaticResource SabBrush.Border}"
                    BorderThickness="0,1,0,0"
                    Padding="18,11">
                <Button x:Name="DoneButton"
                        Content="Готово"
                        MinWidth="120"
                        HorizontalAlignment="Right"
                        Style="{StaticResource SabPrimaryButtonStyle}" />
            </Border>
        </Grid>
    </Border>
</Window>
