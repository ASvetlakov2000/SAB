<Window x:Class="SAB.ModPlusInspiredElevationPrototype.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="SAB Развертки стен — прототип"
        Width="980"
        Height="700"
        MinWidth="850"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResizeWithGrip"
        Background="Transparent"
        FontFamily="Segoe UI"
        FontSize="13"
        Loaded="Window_Loaded">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="7"
                            CornerRadius="8"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border Style="{StaticResource PrototypeWindowFrameStyle}">
        <Grid x:Name="WindowRoot" ClipToBounds="True" Opacity="0">
            <Grid.RenderTransform>
                <TranslateTransform Y="8" />
            </Grid.RenderTransform>
            <Grid.RowDefinitions>
                <RowDefinition Height="32" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="58" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{StaticResource SabBrush.PanelBackground}"
                    BorderBrush="{StaticResource SabBrush.BorderWeak}"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                        <Border Width="21" Height="21" CornerRadius="4" Background="{StaticResource SabBrush.Accent}">
                            <TextBlock Text="S"
                                       Foreground="White"
                                       FontWeight="Bold"
                                       FontSize="12"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="SAB  РАЗВЕРТКИ СТЕН"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource SabBrush.Text}"
                                   FontSize="12"
                                   FontWeight="SemiBold" />
                        <Border Width="1" Height="14" Background="{StaticResource SabBrush.Border}" Margin="10,0" />
                        <TextBlock Text="тестовый дизайн"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource SabBrush.TextSecondary}"
                                   FontSize="12" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="─"
                                ToolTip="Свернуть"
                                Style="{StaticResource PrototypeChromeButtonStyle}"
                                Click="MinimizeButton_Click" />
                        <Button Content="✕"
                                ToolTip="Закрыть"
                                Style="{StaticResource PrototypeCloseButtonStyle}"
                                Click="CloseButton_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="18,15,18,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Настройки разверток"
                               Style="{StaticResource SabWindowTitleTextStyle}" />
                    <TextBlock Text="Создание видов, размещение на листе и маркировка — в одном спокойном рабочем окне."
                               Margin="0,3,0,0"
                               Style="{StaticResource SabWindowSubtitleTextStyle}" />
                </StackPanel>
                <Border Grid.Column="1"
                        VerticalAlignment="Center"
                        Style="{StaticResource PrototypeInfoPanelStyle}"
                        Padding="10,6">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" Fill="{StaticResource SabBrush.Warning}" Margin="0,0,7,0" />
                        <TextBlock Text="Линии и помещение не выбраны"
                                   Foreground="{StaticResource SabBrush.TextSecondary}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>

            <TabControl x:Name="SettingsTabs"
                        Grid.Row="2"
                        Margin="18,0,18,12"
                        SelectedIndex="0"
                        Style="{StaticResource PrototypeTabControlStyle}"
                        ItemContainerStyle="{StaticResource PrototypeTabItemStyle}"
                        SelectionChanged="SettingsTabs_SelectionChanged">
                <TabItem Header="Развертки">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.92*" MinWidth="330" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="1.08*" MinWidth="380" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <GroupBox Grid.Column="0"
                                  Header="Геометрия разверток"
                                  Style="{StaticResource PrototypeGroupBoxStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="126" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="Разбиение кривых" VerticalAlignment="Center" />
                                <Grid Grid.Row="0" Grid.Column="1" Margin="0,0,0,7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="30" />
                                    </Grid.ColumnDefinitions>
                                    <Button Content="−" Tag="CurveSplitText|-1" Click="StepButton_Click" Style="{StaticResource PrototypeStepperButtonStyle}" />
                                    <TextBox x:Name="CurveSplitText" Grid.Column="1" Text="10" TextAlignment="Center" Style="{StaticResource SabTextBoxStyle}" Height="30" />
                                    <Button Grid.Column="2" Content="+" Tag="CurveSplitText|1" Click="StepButton_Click" Style="{StaticResource PrototypeStepperButtonStyle}" />
                                </Grid>

                                <TextBlock Grid.Row="1" Text="Глубина проецирования, мм" VerticalAlignment="Center" />
                                <Grid Grid.Row="1" Grid.Column="1" Margin="0,0,0,7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="30" />
                                    </Grid.ColumnDefinitions>
                                    <Button Content="−" Tag="ProjectionText|-10" Click="StepButton_Click" Style="{StaticResource PrototypeStepperButtonStyle}" />
                                    <TextBox x:Name="ProjectionText" Grid.Column="1" Text="100" TextAlignment="Center" Style="{StaticResource SabTextBoxStyle}" Height="30" />
                                    <Button Grid.Column="2" Content="+" Tag="ProjectionText|10" Click="StepButton_Click" Style="{StaticResource PrototypeStepperButtonStyle}" />
                                </Grid>

                                <TextBlock Grid.Row="2" Text="Отступ внутрь, мм" VerticalAlignment="Center" />
                                <TextBox Grid.Row="2" Grid.Column="1" Text="0" TextAlignment="Center" Style="{StaticResource SabTextBoxStyle}" Height="30" Margin="0,0,0,7" />
                                <TextBlock Grid.Row="3" Text="Отступ вверх, мм" VerticalAlignment="Center" />
                                <TextBox Grid.Row="3" Grid.Column="1" Text="0" TextAlignment="Center" Style="{StaticResource SabTextBoxStyle}" Height="30" Margin="0,0,0,7" />
                                <TextBlock Grid.Row="4" Text="Отступ вниз, мм" VerticalAlignment="Center" />
                                <TextBox Grid.Row="4" Grid.Column="1" Text="0" TextAlignment="Center" Style="{StaticResource SabTextBoxStyle}" Height="30" Margin="0,0,0,7" />
                                <TextBlock Grid.Row="5" Text="Боковой отступ, мм" VerticalAlignment="Center" />
                                <TextBox Grid.Row="5" Grid.Column="1" Text="0" TextAlignment="Center" Style="{StaticResource SabTextBoxStyle}" Height="30" />
                            </Grid>
                        </GroupBox>

                        <GroupBox Grid.Column="2"
                                  Header="Вид и именование"
                                  Style="{StaticResource PrototypeGroupBoxStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Grid.Column="0">
                                    <TextBlock Text="Создать" Style="{StaticResource SabFieldLabelTextStyle}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,10">
                                        <RadioButton Content="Фасад" GroupName="ViewKind" Style="{StaticResource PrototypeRadioButtonStyle}" />
                                        <RadioButton Content="Разрез" GroupName="ViewKind" IsChecked="True" Style="{StaticResource PrototypeRadioButtonStyle}" Margin="0" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="2">
                                    <TextBlock Text="Создать по" Style="{StaticResource SabFieldLabelTextStyle}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,10">
                                        <RadioButton Content="Помещению" GroupName="SourceKind" IsChecked="True" Style="{StaticResource PrototypeRadioButtonStyle}" />
                                        <RadioButton Content="Стене" GroupName="SourceKind" Style="{StaticResource PrototypeRadioButtonStyle}" Margin="0" />
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3">
                                    <TextBlock Text="Шаблон вида" Style="{StaticResource SabFieldLabelTextStyle}" />
                                    <ComboBox SelectedIndex="0" Style="{StaticResource SabComboBoxStyle}" Margin="0,0,0,10">
                                        <ComboBoxItem Content="АР_Развертка_Рабочая" />
                                        <ComboBoxItem Content="АР_Развертка_Чистовая" />
                                        <ComboBoxItem Content="Без шаблона" />
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3">
                                    <TextBlock Text="Формула имени вида" Style="{StaticResource SabFieldLabelTextStyle}" />
                                    <TextBox Text="[Номер помещения] — [Начальный угол]-[Конечный угол]"
                                             Style="{StaticResource SabTextBoxStyle}"
                                             Margin="0,0,0,6" />
                                    <TextBlock Style="{StaticResource SabFieldHintTextStyle}" TextWrapping="Wrap">
                                        <Run Text="Параметры: " />
                                        <Run Text="[Номер помещения]" Foreground="{StaticResource SabBrush.Accent}" FontWeight="SemiBold" />
                                        <Run Text=", " />
                                        <Run Text="[Имя помещения]" Foreground="{StaticResource SabBrush.Accent}" FontWeight="SemiBold" />
                                        <Run Text=", " />
                                        <Run Text="[Начальный угол]" Foreground="{StaticResource SabBrush.Accent}" FontWeight="SemiBold" />
                                    </TextBlock>
                                </StackPanel>

                                <Border Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,12,0,0" Style="{StaticResource PrototypeInfoPanelStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Предпросмотр" FontWeight="SemiBold" Foreground="{StaticResource SabBrush.Accent}" />
                                        <TextBlock Text="101 — угол 1-2" Margin="0,3,0,0" Foreground="{StaticResource SabBrush.Text}" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </GroupBox>

                        <GroupBox Grid.Row="1"
                                  Grid.Column="0"
                                  Grid.ColumnSpan="3"
                                  Header="Выбор элементов"
                                  Margin="0,12,0,0"
                                  Style="{StaticResource PrototypeGroupBoxStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="SelectionStatusText"
                                           Text="Выберите линии детализации и помещение в активном плане."
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource SabBrush.TextSecondary}"
                                           TextTrimming="CharacterEllipsis" />
                                <Button Grid.Column="1"
                                        Content="Очистить"
                                        Margin="10,0,8,0"
                                        Style="{StaticResource PrototypeSecondaryButtonStyle}"
                                        Click="ClearSelectionButton_Click" />
                                <Grid Grid.Column="2">
                                    <Button x:Name="SelectionButton"
                                            Content="Выбрать элементы"
                                            Style="{StaticResource PrototypeSecondaryButtonStyle}"
                                            Click="SelectionButton_Click" />
                                    <Popup x:Name="SelectionPopup"
                                           PlacementTarget="{Binding ElementName=SelectionButton}"
                                           Placement="Top"
                                           VerticalOffset="-6"
                                           AllowsTransparency="True"
                                           StaysOpen="False"
                                           Opened="SelectionPopup_Opened">
                                        <Border x:Name="SelectionPopupCard"
                                                Padding="6"
                                                Background="{StaticResource SabBrush.PanelBackground}"
                                                BorderBrush="{StaticResource SabBrush.Border}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Opacity="0">
                                            <Border.RenderTransform>
                                                <TranslateTransform Y="7" />
                                            </Border.RenderTransform>
                                            <StackPanel>
                                                <Button Content="В текущем документе"
                                                        Tag="Выбор в текущем документе готов"
                                                        Style="{StaticResource PrototypeFlatActionButtonStyle}"
                                                        Click="SelectionOption_Click" />
                                                <Button Content="В связанном документе"
                                                        Tag="Выбор в связанном документе готов"
                                                        Style="{StaticResource PrototypeFlatActionButtonStyle}"
                                                        Click="SelectionOption_Click" />
                                                <Button Content="На активном виде"
                                                        Tag="Выбор на активном виде готов"
                                                        Style="{StaticResource PrototypeFlatActionButtonStyle}"
                                                        Click="SelectionOption_Click" />
                                            </StackPanel>
                                        </Border>
                                    </Popup>
                                </Grid>
                            </Grid>
                        </GroupBox>
                    </Grid>
                </TabItem>

                <TabItem Header="Лист">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <GroupBox Header="Размещение"
                                  Style="{StaticResource PrototypeGroupBoxStyle}">
                            <StackPanel>
                                <CheckBox Content="Размещать созданные виды на листе"
                                          IsChecked="True"
                                          Style="{StaticResource PrototypeCheckBoxStyle}"
                                          Margin="0,0,0,12" />
                                <TextBlock Text="Основная надпись" Style="{StaticResource SabFieldLabelTextStyle}" />
                                <ComboBox SelectedIndex="0" Style="{StaticResource SabComboBoxStyle}" Margin="0,0,0,12">
                                    <ComboBoxItem Content="SAB_А2_Основная надпись" />
                                    <ComboBoxItem Content="SAB_А1_Основная надпись" />
                                </ComboBox>
                                <TextBlock Text="Ориентация видов" Style="{StaticResource SabFieldLabelTextStyle}" />
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <RadioButton Content="По стенам" GroupName="Placement" IsChecked="True" Style="{StaticResource PrototypeRadioButtonStyle}" />
                                    <RadioButton Content="По сетке" GroupName="Placement" Style="{StaticResource PrototypeRadioButtonStyle}" Margin="0" />
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Grid.Column="2"
                                  Header="Имя и номер листа"
                                  Style="{StaticResource PrototypeGroupBoxStyle}">
                            <StackPanel>
                                <TextBlock Text="Формула номера" Style="{StaticResource SabFieldLabelTextStyle}" />
                                <TextBox Text="АР-[Номер помещения]" Style="{StaticResource SabTextBoxStyle}" Margin="0,0,0,12" />
                                <TextBlock Text="Формула имени" Style="{StaticResource SabFieldLabelTextStyle}" />
                                <TextBox Text="Развертки помещения [Номер помещения]" Style="{StaticResource SabTextBoxStyle}" Margin="0,0,0,12" />
                                <Border Style="{StaticResource PrototypeInfoPanelStyle}">
                                    <TextBlock Text="АР-101  ·  Развертки помещения 101"
                                               Foreground="{StaticResource SabBrush.Accent}"
                                               FontWeight="SemiBold" />
                                </Border>
                            </StackPanel>
                        </GroupBox>
                    </Grid>
                </TabItem>

                <TabItem Header="Марки">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <GroupBox Header="Марки углов"
                                  Style="{StaticResource PrototypeGroupBoxStyle}">
                            <StackPanel>
                                <TextBlock Text="Тип марки на плане" Style="{StaticResource SabFieldLabelTextStyle}" />
                                <ComboBox SelectedIndex="0" Style="{StaticResource SabComboBoxStyle}" Margin="0,0,0,12">
                                    <ComboBoxItem Content="SAB_Марка угла_План" />
                                </ComboBox>
                                <TextBlock Text="Тип марки на развертке" Style="{StaticResource SabFieldLabelTextStyle}" />
                                <ComboBox SelectedIndex="0" Style="{StaticResource SabComboBoxStyle}">
                                    <ComboBoxItem Content="SAB_Марка угла_Развертки" />
                                </ComboBox>
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Grid.Column="2"
                                  Header="Подпись и положение"
                                  Style="{StaticResource PrototypeGroupBoxStyle}">
                            <StackPanel>
                                <TextBlock Text="Состав подписи" Style="{StaticResource SabFieldLabelTextStyle}" />
                                <RadioButton Content="Номер помещения и номер угла"
                                             GroupName="MarkLabel"
                                             IsChecked="True"
                                             Style="{StaticResource PrototypeRadioButtonStyle}"
                                             Margin="0,2,0,9" />
                                <RadioButton Content="Только номер угла"
                                             GroupName="MarkLabel"
                                             Style="{StaticResource PrototypeRadioButtonStyle}"
                                             Margin="0,0,0,16" />
                                <TextBlock Text="Положение относительно вида" Style="{StaticResource SabFieldLabelTextStyle}" />
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <RadioButton Content="Над видом" GroupName="MarkPosition" IsChecked="True" Style="{StaticResource PrototypeRadioButtonStyle}" />
                                    <RadioButton Content="Под видом" GroupName="MarkPosition" Style="{StaticResource PrototypeRadioButtonStyle}" Margin="0" />
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>
                    </Grid>
                </TabItem>

                <TabItem Header="План помещения">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <GroupBox Header="Создание плана"
                                  Style="{StaticResource PrototypeGroupBoxStyle}">
                            <StackPanel>
                                <CheckBox Content="Создать план помещения"
                                          IsChecked="True"
                                          Style="{StaticResource PrototypeCheckBoxStyle}"
                                          Margin="0,0,0,12" />
                                <TextBlock Text="Масштаб" Style="{StaticResource SabFieldLabelTextStyle}" />
                                <ComboBox SelectedIndex="1" Style="{StaticResource SabComboBoxStyle}" Margin="0,0,0,12">
                                    <ComboBoxItem Content="1:25" />
                                    <ComboBoxItem Content="1:50" />
                                    <ComboBoxItem Content="1:100" />
                                </ComboBox>
                                <TextBlock Text="Шаблон вида" Style="{StaticResource SabFieldLabelTextStyle}" />
                                <ComboBox SelectedIndex="0" Style="{StaticResource SabComboBoxStyle}">
                                    <ComboBoxItem Content="АР_План помещения" />
                                </ComboBox>
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Grid.Column="2"
                                  Header="Наименование"
                                  Style="{StaticResource PrototypeGroupBoxStyle}">
                            <StackPanel>
                                <TextBlock Text="Формула имени вида" Style="{StaticResource SabFieldLabelTextStyle}" />
                                <TextBox Text="План помещения [Номер помещения]" Style="{StaticResource SabTextBoxStyle}" Margin="0,0,0,12" />
                                <TextBlock Text="Марка помещения" Style="{StaticResource SabFieldLabelTextStyle}" />
                                <ComboBox SelectedIndex="0" Style="{StaticResource SabComboBoxStyle}" Margin="0,0,0,12">
                                    <ComboBoxItem Content="SAB_Марка_Помещение" />
                                </ComboBox>
                                <Border Style="{StaticResource PrototypeInfoPanelStyle}">
                                    <TextBlock Text="План помещения 101"
                                               Foreground="{StaticResource SabBrush.Accent}"
                                               FontWeight="SemiBold" />
                                </Border>
                            </StackPanel>
                        </GroupBox>
                    </Grid>
                </TabItem>
            </TabControl>

            <Border Grid.Row="3"
                    Background="{StaticResource SabBrush.PanelBackground}"
                    BorderBrush="{StaticResource SabBrush.Border}"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,8,8"
                    Padding="18,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="StatusDot"
                                 Width="8" Height="8"
                                 Fill="{StaticResource SabBrush.Warning}"
                                 Margin="0,0,8,0" />
                        <TextBlock x:Name="PrototypeStatusText"
                                   Text="Прототип: данные Revit не изменяются"
                                   Foreground="{StaticResource SabBrush.TextSecondary}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="Отмена"
                                Margin="0,0,8,0"
                                Style="{StaticResource PrototypeSecondaryButtonStyle}"
                                Click="CloseButton_Click" />
                        <Button Content="Создать"
                                Style="{StaticResource PrototypePrimaryButtonStyle}"
                                Click="CreatePrototypeButton_Click" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
