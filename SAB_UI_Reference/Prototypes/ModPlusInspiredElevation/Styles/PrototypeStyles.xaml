<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework">

    <Duration x:Key="Prototype.Motion.Fast">0:0:0.12</Duration>
    <Duration x:Key="Prototype.Motion.Normal">0:0:0.20</Duration>
    <Duration x:Key="Prototype.Motion.Ripple">0:0:0.30</Duration>

    <Style x:Key="PrototypeWindowFrameStyle" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{StaticResource SabBrush.WindowBackground}" />
        <Setter Property="BorderBrush" Value="{StaticResource SabBrush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="PrototypeGroupBoxStyle" TargetType="{x:Type GroupBox}">
        <Setter Property="Background" Value="{StaticResource SabBrush.PanelBackground}" />
        <Setter Property="Foreground" Value="{StaticResource SabBrush.Text}" />
        <Setter Property="BorderBrush" Value="{StaticResource SabBrush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="14,4,14,14" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GroupBox}">
                    <Border x:Name="Card"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Margin="14,0,14,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="3" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Border Width="44"
                                        Height="3"
                                        HorizontalAlignment="Left"
                                        Background="{StaticResource SabBrush.Accent}"
                                        CornerRadius="0,0,2,2" />
                                <ContentPresenter Grid.Row="1"
                                                  Margin="0,9,0,10"
                                                  ContentSource="Header"
                                                  RecognizesAccessKey="True"
                                                  TextElement.FontSize="14"
                                                  TextElement.FontWeight="SemiBold"
                                                  TextElement.Foreground="{StaticResource SabBrush.Text}" />
                            </Grid>

                            <ContentPresenter Grid.Row="1"
                                              Margin="{TemplateBinding Padding}"
                                              ContentSource="Content" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Card" Property="Opacity" Value="0.56" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PrototypePrimaryButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Height" Value="34" />
        <Setter Property="MinWidth" Value="104" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="Background" Value="{StaticResource SabBrush.Accent}" />
        <Setter Property="BorderBrush" Value="{StaticResource SabBrush.Accent}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid ClipToBounds="True">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5" />
                        <Border x:Name="HoverOverlay"
                                Background="{StaticResource SabBrush.AccentHover}"
                                CornerRadius="5"
                                Opacity="0" />
                        <Border x:Name="ClickFlash"
                                Margin="3"
                                Background="White"
                                CornerRadius="4"
                                Opacity="0"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="0.82" ScaleY="0.82" />
                            </Border.RenderTransform>
                        </Border>
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <EventTrigger RoutedEvent="Mouse.MouseEnter">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="HoverOverlay"
                                                     Storyboard.TargetProperty="Opacity"
                                                     To="1"
                                                     Duration="{StaticResource Prototype.Motion.Fast}" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                        <EventTrigger RoutedEvent="Mouse.MouseLeave">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="HoverOverlay"
                                                     Storyboard.TargetProperty="Opacity"
                                                     To="0"
                                                     Duration="{StaticResource Prototype.Motion.Fast}" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                        <EventTrigger RoutedEvent="Button.Click">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="ClickFlash"
                                                     Storyboard.TargetProperty="Opacity"
                                                     From="0.16" To="0"
                                                     Duration="{StaticResource Prototype.Motion.Normal}" />
                                    <DoubleAnimation Storyboard.TargetName="ClickFlash"
                                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                     From="0.82" To="1.02"
                                                     Duration="{StaticResource Prototype.Motion.Normal}" />
                                    <DoubleAnimation Storyboard.TargetName="ClickFlash"
                                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                     From="0.82" To="1.02"
                                                     Duration="{StaticResource Prototype.Motion.Normal}" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource SabBrush.DisabledBackground}" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource SabBrush.Border}" />
                            <Setter Property="Foreground" Value="{StaticResource SabBrush.DisabledText}" />
                            <Setter TargetName="HoverOverlay" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PrototypeSecondaryButtonStyle"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource PrototypePrimaryButtonStyle}">
        <Setter Property="Background" Value="{StaticResource SabBrush.PanelBackground}" />
        <Setter Property="BorderBrush" Value="{StaticResource SabBrush.Border}" />
        <Setter Property="Foreground" Value="{StaticResource SabBrush.Text}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid ClipToBounds="True">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5" />
                        <Border x:Name="HoverOverlay"
                                Background="{StaticResource SabBrush.AccentLight}"
                                CornerRadius="5"
                                Opacity="0" />
                        <Border x:Name="AccentBorder"
                                BorderBrush="{StaticResource SabBrush.Accent}"
                                BorderThickness="1"
                                CornerRadius="5"
                                Opacity="0" />
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <EventTrigger RoutedEvent="Mouse.MouseEnter">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="HoverOverlay"
                                                     Storyboard.TargetProperty="Opacity"
                                                     To="1"
                                                     Duration="{StaticResource Prototype.Motion.Fast}" />
                                    <DoubleAnimation Storyboard.TargetName="AccentBorder"
                                                     Storyboard.TargetProperty="Opacity"
                                                     To="1"
                                                     Duration="{StaticResource Prototype.Motion.Fast}" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                        <EventTrigger RoutedEvent="Mouse.MouseLeave">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="HoverOverlay"
                                                     Storyboard.TargetProperty="Opacity"
                                                     To="0"
                                                     Duration="{StaticResource Prototype.Motion.Fast}" />
                                    <DoubleAnimation Storyboard.TargetName="AccentBorder"
                                                     Storyboard.TargetProperty="Opacity"
                                                     To="0"
                                                     Duration="{StaticResource Prototype.Motion.Fast}" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource SabBrush.DisabledBackground}" />
                            <Setter Property="Foreground" Value="{StaticResource SabBrush.DisabledText}" />
                            <Setter TargetName="HoverOverlay" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="AccentBorder" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PrototypeFlatActionButtonStyle"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource PrototypeSecondaryButtonStyle}">
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="MinWidth" Value="230" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style x:Key="PrototypeChromeButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Width" Value="42" />
        <Setter Property="Height" Value="31" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource SabBrush.TextSecondary}" />
        <Setter Property="FontFamily" Value="Segoe UI Symbol" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Root" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource SabBrush.AccentLight}" />
                            <Setter Property="Foreground" Value="{StaticResource SabBrush.Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PrototypeCloseButtonStyle"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource PrototypeChromeButtonStyle}">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource SabBrush.Error}" />
                <Setter Property="Foreground" Value="White" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="PrototypeTabControlStyle" TargetType="{x:Type TabControl}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
    </Style>

    <Style x:Key="PrototypeTabItemStyle" TargetType="{x:Type TabItem}">
        <Setter Property="Foreground" Value="{StaticResource SabBrush.TextSecondary}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="14,9,14,10" />
        <Setter Property="Margin" Value="0,0,4,0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TabItem}">
                    <Grid Background="Transparent" Cursor="Hand">
                        <Border x:Name="HoverBackground"
                                Margin="2,3"
                                Background="{StaticResource SabBrush.AccentLight}"
                                CornerRadius="4"
                                Opacity="0" />
                        <ContentPresenter ContentSource="Header"
                                          RecognizesAccessKey="True"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}" />
                        <Border x:Name="SelectedLine"
                                Height="3"
                                Width="0"
                                Background="{StaticResource SabBrush.Accent}"
                                CornerRadius="2,2,0,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Bottom" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="HoverBackground" Property="Opacity" Value="0.72" />
                            <Setter Property="Foreground" Value="{StaticResource SabBrush.Accent}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource SabBrush.Accent}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter TargetName="SelectedLine" Property="Width" Value="54" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PrototypeRadioButtonStyle" TargetType="{x:Type RadioButton}">
        <Setter Property="Foreground" Value="{StaticResource SabBrush.Text}" />
        <Setter Property="Margin" Value="0,0,14,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RadioButton}">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Canvas Width="18" Height="18" VerticalAlignment="Center">
                            <Ellipse Width="16" Height="16" Canvas.Left="1" Canvas.Top="1"
                                     Stroke="{StaticResource SabBrush.TextSecondary}"
                                     StrokeThickness="1.2"
                                     Fill="{StaticResource SabBrush.PanelBackground}" />
                            <Ellipse x:Name="Dot"
                                     Width="8" Height="8"
                                     Canvas.Left="5" Canvas.Top="5"
                                     Fill="{StaticResource SabBrush.Accent}"
                                     Opacity="0" />
                            <Ellipse x:Name="Ripple"
                                     Width="0" Height="0"
                                     Canvas.Left="9" Canvas.Top="9"
                                     Fill="{StaticResource SabBrush.Accent}"
                                     Opacity="0"
                                     IsHitTestVisible="False" />
                        </Canvas>
                        <ContentPresenter Grid.Column="1"
                                          Margin="6,0,0,0"
                                          VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <EventTrigger RoutedEvent="Button.Click">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Ripple" Storyboard.TargetProperty="Width"
                                                     From="0" To="46" Duration="{StaticResource Prototype.Motion.Ripple}" />
                                    <DoubleAnimation Storyboard.TargetName="Ripple" Storyboard.TargetProperty="Height"
                                                     From="0" To="46" Duration="{StaticResource Prototype.Motion.Ripple}" />
                                    <DoubleAnimation Storyboard.TargetName="Ripple" Storyboard.TargetProperty="(Canvas.Left)"
                                                     From="9" To="-14" Duration="{StaticResource Prototype.Motion.Ripple}" />
                                    <DoubleAnimation Storyboard.TargetName="Ripple" Storyboard.TargetProperty="(Canvas.Top)"
                                                     From="9" To="-14" Duration="{StaticResource Prototype.Motion.Ripple}" />
                                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Ripple" Storyboard.TargetProperty="Opacity">
                                        <DiscreteDoubleKeyFrame KeyTime="0" Value="0.22" />
                                        <SplineDoubleKeyFrame KeyTime="0:0:0.30" Value="0" />
                                    </DoubleAnimationUsingKeyFrames>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Dot" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.56" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PrototypeCheckBoxStyle" TargetType="{x:Type CheckBox}">
        <Setter Property="Foreground" Value="{StaticResource SabBrush.Text}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type CheckBox}">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Canvas Width="18" Height="18" VerticalAlignment="Center">
                            <Border x:Name="Box"
                                    Width="16" Height="16"
                                    Canvas.Left="1" Canvas.Top="1"
                                    Background="{StaticResource SabBrush.PanelBackground}"
                                    BorderBrush="{StaticResource SabBrush.TextSecondary}"
                                    BorderThickness="1.2"
                                    CornerRadius="3" />
                            <Path x:Name="Check"
                                  Width="10" Height="8"
                                  Canvas.Left="4" Canvas.Top="5"
                                  Stroke="White"
                                  StrokeThickness="2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Data="M 0 4 L 3.5 7 L 10 0"
                                  Opacity="0" />
                            <Ellipse x:Name="Ripple"
                                     Width="0" Height="0"
                                     Canvas.Left="9" Canvas.Top="9"
                                     Fill="{StaticResource SabBrush.Accent}"
                                     Opacity="0"
                                     IsHitTestVisible="False" />
                        </Canvas>
                        <ContentPresenter Grid.Column="1"
                                          Margin="6,0,0,0"
                                          VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <EventTrigger RoutedEvent="Button.Click">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Ripple" Storyboard.TargetProperty="Width"
                                                     From="0" To="46" Duration="{StaticResource Prototype.Motion.Ripple}" />
                                    <DoubleAnimation Storyboard.TargetName="Ripple" Storyboard.TargetProperty="Height"
                                                     From="0" To="46" Duration="{StaticResource Prototype.Motion.Ripple}" />
                                    <DoubleAnimation Storyboard.TargetName="Ripple" Storyboard.TargetProperty="(Canvas.Left)"
                                                     From="9" To="-14" Duration="{StaticResource Prototype.Motion.Ripple}" />
                                    <DoubleAnimation Storyboard.TargetName="Ripple" Storyboard.TargetProperty="(Canvas.Top)"
                                                     From="9" To="-14" Duration="{StaticResource Prototype.Motion.Ripple}" />
                                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Ripple" Storyboard.TargetProperty="Opacity">
                                        <DiscreteDoubleKeyFrame KeyTime="0" Value="0.22" />
                                        <SplineDoubleKeyFrame KeyTime="0:0:0.30" Value="0" />
                                    </DoubleAnimationUsingKeyFrames>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource SabBrush.Accent}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource SabBrush.Accent}" />
                            <Setter TargetName="Check" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.56" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PrototypeStepperButtonStyle"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource PrototypeSecondaryButtonStyle}">
        <Setter Property="Width" Value="30" />
        <Setter Property="MinWidth" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="Normal" />
    </Style>

    <Style x:Key="PrototypeInfoPanelStyle" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{StaticResource SabBrush.AccentLight}" />
        <Setter Property="BorderBrush" Value="{StaticResource SabBrush.Accent}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="Padding" Value="12,9" />
    </Style>
</ResourceDictionary>
