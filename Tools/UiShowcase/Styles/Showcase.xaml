<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Supplement to the adapted SAB templates. All scope is the standalone preview. -->
  <Style x:Key="SabUi.FocusVisual" TargetType="Control">
    <Setter Property="Template"><Setter.Value><ControlTemplate><Rectangle Margin="-3" Stroke="{DynamicResource SabBrush.Accent}" StrokeThickness="1" StrokeDashArray="2 1" RadiusX="5" RadiusY="5"/></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TextBlock"><Setter Property="FontSize" Value="13"/></Style>
  <Style x:Key="Secondary" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource SabBrush.TextSecondary}"/><Setter Property="FontSize" Value="12"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style x:Key="Section" TargetType="TextBlock"><Setter Property="FontSize" Value="15"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,12"/></Style>
  <Style TargetType="Button" BasedOn="{StaticResource SabOutlineButtonStyle}"><Setter Property="Padding" Value="12,0"/><Setter Property="Margin" Value="0,0,8,0"/></Style>
  <Style TargetType="TextBox" BasedOn="{StaticResource SabTextBoxStyle}"><Setter Property="FocusVisualStyle" Value="{x:Null}"/></Style>
  <Style TargetType="ComboBox" BasedOn="{StaticResource SabComboBoxStyle}"><Setter Property="FocusVisualStyle" Value="{x:Null}"/></Style>
  <Style TargetType="CheckBox" BasedOn="{StaticResource SabCheckBoxStyle}"><Setter Property="FocusVisualStyle" Value="{StaticResource SabUi.FocusVisual}"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
  <Style TargetType="RadioButton" BasedOn="{StaticResource SabRadioButtonStyle}"><Setter Property="FocusVisualStyle" Value="{StaticResource SabUi.FocusVisual}"/></Style>
  <Style TargetType="Expander" BasedOn="{StaticResource SabPanelExpanderStyle}"/>
  <Style TargetType="GroupBox" BasedOn="{StaticResource SabLayeredSettingsGroupStyle}"/>
  <Style x:Key="SabUi.Tab" TargetType="TabItem">
    <Setter Property="Padding" Value="16,10"/><Setter Property="FocusVisualStyle" Value="{StaticResource SabUi.FocusVisual}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
      <Border x:Name="Frame" BorderThickness="0,0,0,2" BorderBrush="Transparent" Background="Transparent" Padding="{TemplateBinding Padding}">
        <ContentPresenter x:Name="HeaderText" ContentSource="Header" RecognizesAccessKey="True" TextElement.Foreground="{DynamicResource SabBrush.Text}"/>
      </Border><ControlTemplate.Triggers>
        <Trigger Property="IsSelected" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource SabBrush.Accent}"/><Setter TargetName="HeaderText" Property="TextElement.Foreground" Value="{DynamicResource SabBrush.Accent}"/></Trigger>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource SabBrush.AccentLight}"/></Trigger>
        <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource SabBrush.AccentLight}"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource SabBrush.DisabledText}"/></Trigger>
      </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TabItem" BasedOn="{StaticResource SabUi.Tab}"/>
  <Style TargetType="TabControl">
    <Setter Property="Background" Value="{DynamicResource SabBrush.PanelBackground}"/><Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabControl"><Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource SabBrush.Border}"><TabPanel IsItemsHost="True" Background="{TemplateBinding Background}"/></Border>
      <Border Grid.Row="1" Background="{TemplateBinding Background}" Padding="16"><ContentPresenter ContentSource="SelectedContent" TextElement.Foreground="{DynamicResource SabBrush.Text}"/></Border>
    </Grid></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="SabUi.CategoryToggle" TargetType="ToggleButton">
    <Setter Property="Padding" Value="12,7"/><Setter Property="Margin" Value="0,0,0,4"/><Setter Property="HorizontalContentAlignment" Value="Left"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource SabUi.FocusVisual}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton"><Border x:Name="Frame" Padding="{TemplateBinding Padding}" CornerRadius="{DynamicResource SabUi.ControlRadius}" BorderThickness="1" BorderBrush="{DynamicResource SabBrush.BorderWeak}" Background="White"><ContentPresenter/></Border>
      <ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource SabBrush.AccentLight}"/><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource SabBrush.Accent}"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource SabBrush.Accent}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55"/></Trigger></ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="SabUi.Message" TargetType="Border"><Setter Property="Padding" Value="12,10"/><Setter Property="CornerRadius" Value="{DynamicResource SabUi.ControlRadius}"/><Setter Property="Background" Value="{DynamicResource SabBrush.AccentLight}"/><Setter Property="Margin" Value="0,0,0,12"/></Style>
</ResourceDictionary>
