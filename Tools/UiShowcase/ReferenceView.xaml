<UserControl x:Class="SAB.UiShowcase.ReferenceView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:SAB.UiShowcase">
 <Grid Margin="{DynamicResource SabUi.PagePadding}">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel><TextBlock Text="Настройки параметров" FontSize="{DynamicResource SabUi.TitleSize}" FontWeight="SemiBold"/><TextBlock Text="Назначьте параметры и настройте правила заполнения элементов." Style="{StaticResource Secondary}" Margin="0,5,0,0"/></StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="Импорт…" Click="ImportDemo"/><Button Content="Экспорт…" Click="ExportDemo" Margin="0"/></StackPanel>
  </Grid>
  <Border Grid.Row="1" BorderBrush="{DynamicResource SabBrush.Border}" BorderThickness="1" Background="{DynamicResource SabBrush.PanelBackground}" CornerRadius="{DynamicResource SabUi.ControlRadius}">
   <TabControl x:Name="WorkspaceTabs">
    <TabItem Header="Правила"><Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <DockPanel Margin="0,0,0,12"><StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><Button Content="Добавить правило" Command="{Binding Add}"/><Button Content="Удалить" Command="{Binding Remove}" Margin="0"/></StackPanel><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="Правила заполнения" FontWeight="SemiBold"/><TextBlock Text="{Binding RuleCount, StringFormat= · {0}}" Style="{StaticResource Secondary}" Margin="6,0,0,0" VerticalAlignment="Center"/></StackPanel></DockPanel>
     <Grid Grid.Row="1"><DataGrid x:Name="RulesGrid" ItemsSource="{Binding Rules}" SelectedItem="{Binding SelectedRule}" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single" SelectionUnit="FullRow" HeadersVisibility="Column" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Правила заполнения">
      <DataGrid.Columns>
       <DataGridCheckBoxColumn Header="Вкл." Width="48" Binding="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}" ElementStyle="{StaticResource SabCheckBoxStyle}"/>
       <DataGridTemplateColumn Header="Сущность" Width="1.05*" MinWidth="145"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBox Text="{Binding Entity, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" Margin="8,0" ToolTip="{Binding ErrorText}" AutomationProperties.Name="Название сущности"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
       <DataGridTemplateColumn Header="Параметр назначения" Width="1.55*" MinWidth="270"><DataGridTemplateColumn.CellTemplate><DataTemplate><local:ParameterPicker Options="{Binding DataContext.Parameters, RelativeSource={RelativeSource AncestorType=DataGrid}}" SelectedParameter="{Binding Parameter, Mode=TwoWay}" Margin="8,0"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
       <DataGridTemplateColumn Header="Источник значения" Width="1.05*" MinWidth="180"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox ItemsSource="{Binding DataContext.Sources, RelativeSource={RelativeSource AncestorType=DataGrid}}" SelectedItem="{Binding Source, UpdateSourceTrigger=PropertyChanged}" Margin="8,0" AutomationProperties.Name="Источник значения"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
       <DataGridTemplateColumn Header="" Width="102"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="Настроить" Click="ConfigureSource" ToolTip="Настроить источник выбранного правила" Margin="6,0"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
      </DataGrid.Columns>
     </DataGrid>
     <Border x:Name="EmptyState" Background="{DynamicResource SabBrush.PanelBackground}" Visibility="Collapsed"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="Правил пока нет" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="Добавьте правило и выберите параметр назначения." Style="{StaticResource Secondary}" Margin="0,8,0,16"/><Button Content="Добавить первое правило" Command="{Binding Add}" HorizontalAlignment="Center"/></StackPanel></Border></Grid>
     <TextBlock Grid.Row="2" Text="Каждая строка связывает сущность, параметр и источник. GUID доступен в подсказке и списке параметров." Style="{StaticResource Secondary}" Margin="0,12,0,0"/>
    </Grid></TabItem>
    <TabItem Header="Источники"><ScrollViewer VerticalScrollBarVisibility="Auto"><Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <StackPanel><TextBlock Text="Источник для правила" Style="{StaticResource Section}"/><TextBlock Text="Правило" Margin="0,0,0,6"/><ComboBox ItemsSource="{Binding Rules}" SelectedItem="{Binding SelectedRule}" DisplayMemberPath="Entity" Margin="0,0,0,18"/><TextBlock Text="Способ получения значения" Margin="0,0,0,6"/><ComboBox ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedRule.Source}" Margin="0,0,0,18"/><TextBlock Text="Параметр назначения" Margin="0,0,0,6"/><local:ParameterPicker Options="{Binding Parameters}" SelectedParameter="{Binding SelectedRule.Parameter, Mode=TwoWay}"/><TextBlock Text="Значение вручную" Margin="0,18,0,6"/><TextBox Text="АР"/><CheckBox Content="Применять только к пустым значениям" Margin="0,18,0,0" IsChecked="True"/></StackPanel>
     <StackPanel Grid.Column="2"><TextBlock Text="Как заполняется параметр" Style="{StaticResource Section}"/><Border Style="{StaticResource SabUi.Message}"><TextBlock Text="Сначала выберите правило, затем укажите источник. Таблицы замен и уровней находятся на вкладке «Значения»." TextWrapping="Wrap"/></Border><TextBlock Text="Пример результата" FontWeight="SemiBold" Margin="0,12,0,8"/><TextBlock Text="Бетон B25 → SAB_Материал_Имя" TextWrapping="Wrap"/><TextBlock Text="Все значения в этом стенде демонстрационные." Style="{StaticResource Secondary}" Margin="0,8,0,0"/></StackPanel>
    </Grid></ScrollViewer></TabItem>
    <TabItem Header="Значения"><Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="Замена значений" Style="{StaticResource Section}"/><DataGrid Grid.Row="1" ItemsSource="{Binding Values}" AutoGenerateColumns="False" CanUserAddRows="False" RowHeight="38"><DataGrid.Columns><DataGridTextColumn Header="Исходное значение" Binding="{Binding Source}" Width="*"/><DataGridTextColumn Header="Новое значение" Binding="{Binding Target}" Width="*"/></DataGrid.Columns></DataGrid></Grid>
     <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="Префиксы по уровням" Style="{StaticResource Section}"/><DataGrid Grid.Row="1" ItemsSource="{Binding Levels}" AutoGenerateColumns="False" CanUserAddRows="False" RowHeight="38"><DataGrid.Columns><DataGridTextColumn Header="Уровень" Binding="{Binding Name}" Width="*" IsReadOnly="True"/><DataGridTextColumn Header="Отметка, м" Binding="{Binding Elevation}" Width="100" IsReadOnly="True"/><DataGridTextColumn Header="Префикс" Binding="{Binding Prefix}" Width="90"/></DataGrid.Columns></DataGrid></Grid>
    </Grid></TabItem>
    <TabItem Header="Категории"><local:CategorySelectionControl x:Name="CategorySelector" Items="{Binding Categories}"/></TabItem>
   </TabControl>
  </Border>
  <Grid Grid.Row="2" Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="StatusText" Text="{Binding Status}" Style="{StaticResource Secondary}" VerticalAlignment="Center" Margin="0,0,20,0"/><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="Сбросить демо" Command="{Binding Reset}"/><Button x:Name="SaveButton" Content="Сохранить настройки" Command="{Binding Save}" Style="{StaticResource SabPrimaryButtonStyle}" Padding="18,0"/></StackPanel></Grid>
 </Grid>
</UserControl>
