<Window x:Class="SAB.UiShowcase.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:SAB.UiShowcase"
 Title="SAB UI Preview · концепции и компоненты" Width="1200" Height="840" MinWidth="980" MinHeight="680" FontFamily="Segoe UI" FontSize="13" Background="{DynamicResource SabBrush.WindowBackground}" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
 <Grid x:Name="RenderRoot" Background="{DynamicResource SabBrush.WindowBackground}">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Border Background="{DynamicResource SabBrush.PanelBackground}" BorderBrush="{DynamicResource SabBrush.Border}" BorderThickness="0,0,0,1" Padding="20,10">
   <DockPanel LastChildFill="True">
    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="SAB" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource SabBrush.Accent}" Margin="0,0,12,0"/><TextBlock Text="UI Preview" VerticalAlignment="Center"/><TextBlock Text="Черновик · 0.1" Style="{StaticResource Secondary}" Margin="16,0,20,0" VerticalAlignment="Center"/></StackPanel>
    <ComboBox x:Name="ConceptSelector" DockPanel.Dock="Right" Width="190" SelectionChanged="ConceptChanged" AutomationProperties.Name="Концепция оформления"><ComboBoxItem Content="Fluent Light" Tag="FluentLight"/><ComboBoxItem Content="Fluent Compact" Tag="FluentCompact"/><ComboBoxItem Content="Minimal SaaS" Tag="MinimalSaas"/><ComboBoxItem Content="SAB Unified" Tag="Unified" IsSelected="True"/></ComboBox>
    <ComboBox x:Name="PageSelector" DockPanel.Dock="Right" Width="190" Margin="0,0,12,0" SelectionChanged="PageChanged" AutomationProperties.Name="Раздел стенда"><ComboBoxItem Content="Эталонное окно" IsSelected="True"/><ComboBoxItem Content="Компоненты"/><ComboBoxItem Content="Состояния"/><ComboBoxItem Content="Схемы компоновки"/></ComboBox>
    <TextBlock Text=""/>
   </DockPanel>
  </Border>
  <Grid Grid.Row="1" x:Name="PageHost"/>
 </Grid>
</Window>
